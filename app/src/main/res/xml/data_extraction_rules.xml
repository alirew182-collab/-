<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: прогресс и настройки переезжают в облачную копию и при переносе на новый телефон.
     API-ключи не копируются: они зашифрованы ключом, который живёт только в этом телефоне. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="neuron.db" />
        <include domain="sharedpref" path="neuron_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="neuron.db" />
        <include domain="sharedpref" path="neuron_settings.xml" />
    </device-transfer>
</data-extraction-rules>
