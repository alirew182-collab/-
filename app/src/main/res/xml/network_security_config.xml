<?xml version="1.0" encoding="utf-8"?>
<!-- HTTP разрешён для локальных моделей (Ollama, LM Studio в домашней сети). Облачные API работают по HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
