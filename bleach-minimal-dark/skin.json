{
    "name": "Bleach Minimal Dark",
    "description": "Тёмный минимализм с эстетикой Bleach: чёрное косоде, белое хаори, reiatsu-свечение, shunpo-анимации и мазки туши. Ручная проработка библиотеки, страницы игры, друзей, чата, настроек и магазина. Пять пресетов акцента.",
    "author": "alirew182-collab",
    "version": "2.0.0",
    "tags": [
        "Dark",
        "Minimal",
        "Anime",
        "Library",
        "Store",
        "Friends"
    ],
    "credits": "Подход вдохновлён Minimal Dark (SaiyajinK). Карта классов Steam (какой хэш отвечает за какой элемент) сверена по Adwaita-for-Steam (tkashkin, MIT). Код темы написан с нуля.",
    "UseDefaultPatches": false,
    "RootColors": "colors.css",
    "Patches": [
        {
            "MatchRegexString": ".DesktopUI",
            "TargetCss": [
                "core/tokens.css",
                "fallback/steam-colors.css",
                "fallback/steam-palette.css",
                "core/base.css",
                "widgets/controls.css",
                "widgets/menus.css",
                "widgets/dialogs.css",
                "main/frame.css",
                "main/sidebar.css",
                "main/home.css",
                "main/details.css"
            ]
        },
        {
            "MatchRegexString": "^Steam$",
            "TargetCss": [
                "core/tokens.css",
                "fallback/steam-colors.css",
                "fallback/steam-palette.css",
                "core/base.css",
                "widgets/controls.css",
                "widgets/menus.css",
                "widgets/dialogs.css",
                "main/frame.css",
                "main/sidebar.css",
                "main/home.css",
                "main/details.css"
            ]
        },
        {
            "MatchRegexString": ".friendsui-container",
            "TargetCss": [
                "core/tokens.css",
                "fallback/steam-colors.css",
                "fallback/steam-palette.css",
                "core/base.css",
                "widgets/controls.css",
                "widgets/menus.css",
                "widgets/dialogs.css",
                "friends/friends.css",
                "friends/chat.css"
            ]
        },
        {
            "MatchRegexString": ".ModalDialogPopup",
            "TargetCss": [
                "core/tokens.css",
                "fallback/steam-colors.css",
                "fallback/steam-palette.css",
                "core/base.css",
                "widgets/controls.css",
                "widgets/menus.css",
                "widgets/dialogs.css",
                "settings/settings.css"
            ]
        },
        {
            "MatchRegexString": ".FullModalOverlay",
            "TargetCss": [
                "core/tokens.css",
                "fallback/steam-colors.css",
                "fallback/steam-palette.css",
                "core/base.css",
                "widgets/controls.css",
                "widgets/menus.css",
                "widgets/dialogs.css",
                "settings/settings.css"
            ]
        },
        {
            "MatchRegexString": "Menu$",
            "TargetCss": [
                "core/tokens.css",
                "widgets/menus.css"
            ]
        },
        {
            "MatchRegexString": "Supernav$",
            "TargetCss": [
                "core/tokens.css",
                "widgets/menus.css"
            ]
        },
        {
            "MatchRegexString": "https://store\\.steampowered\\.com/.*",
            "TargetCss": [
                "core/tokens.css",
                "store/store.css"
            ]
        }
    ],
    "Conditions": {
        "Пресет акцента": {
            "tab": "Пресет",
            "description": "Getsuga — алый, Reiatsu — голубой, Hollow — кость и красный, Quincy — холодный бело-голубой, Свой — цвета «Свой · …» из редактора цветов.",
            "default": "Getsuga",
            "values": {
                "Getsuga": {
                    "TargetCss": {
                        "affects": [
                            ".DesktopUI",
                            "^Steam$",
                            ".friendsui-container",
                            ".ModalDialogPopup",
                            ".FullModalOverlay",
                            "Menu$",
                            "Supernav$",
                            "https://store\\.steampowered\\.com/.*"
                        ],
                        "src": "presets/getsuga.css"
                    }
                },
                "Reiatsu": {
                    "TargetCss": {
                        "affects": [
                            ".DesktopUI",
                            "^Steam$",
                            ".friendsui-container",
                            ".ModalDialogPopup",
                            ".FullModalOverlay",
                            "Menu$",
                            "Supernav$",
                            "https://store\\.steampowered\\.com/.*"
                        ],
                        "src": "presets/reiatsu.css"
                    }
                },
                "Hollow": {
                    "TargetCss": {
                        "affects": [
                            ".DesktopUI",
                            "^Steam$",
                            ".friendsui-container",
                            ".ModalDialogPopup",
                            ".FullModalOverlay",
                            "Menu$",
                            "Supernav$",
                            "https://store\\.steampowered\\.com/.*"
                        ],
                        "src": "presets/hollow.css"
                    }
                },
                "Quincy": {
                    "TargetCss": {
                        "affects": [
                            ".DesktopUI",
                            "^Steam$",
                            ".friendsui-container",
                            ".ModalDialogPopup",
                            ".FullModalOverlay",
                            "Menu$",
                            "Supernav$",
                            "https://store\\.steampowered\\.com/.*"
                        ],
                        "src": "presets/quincy.css"
                    }
                },
                "Свой": {
                    "TargetCss": {
                        "affects": [
                            ".DesktopUI",
                            "^Steam$",
                            ".friendsui-container",
                            ".ModalDialogPopup",
                            ".FullModalOverlay",
                            "Menu$",
                            "Supernav$",
                            "https://store\\.steampowered\\.com/.*"
                        ],
                        "src": "presets/custom.css"
                    }
                }
            }
        },
        "Reiatsu-свечение": {
            "tab": "Эффекты",
            "description": "Мягкое свечение цвета пресета на hover у кнопок и на активных вкладках.",
            "default": "Вкл",
            "values": {
                "Вкл": {
                    "TargetCss": {
                        "affects": [
                            ".DesktopUI",
                            "^Steam$",
                            ".friendsui-container",
                            ".ModalDialogPopup",
                            ".FullModalOverlay",
                            "https://store\\.steampowered\\.com/.*"
                        ],
                        "src": "effects/reiatsu-glow.css"
                    }
                },
                "Выкл": {}
            }
        },
        "Shunpo-анимация карточек": {
            "tab": "Эффекты",
            "description": "Резкий сдвиг с остаточным образом (120–180 мс) при наведении на обложки в библиотеке и карточки магазина. Анимируется только translate — без нагрузки на раскладку.",
            "default": "Вкл",
            "values": {
                "Вкл": {
                    "TargetCss": {
                        "affects": [
                            ".DesktopUI",
                            "^Steam$",
                            "https://store\\.steampowered\\.com/.*"
                        ],
                        "src": "effects/shunpo.css"
                    }
                },
                "Выкл": {}
            }
        },
        "Скорость shunpo": {
            "tab": "Эффекты",
            "description": "Длительность shunpo-анимации в миллисекундах.",
            "default": "150",
            "slider": {
                "min": 120,
                "max": 180,
                "step": 10,
                "unit": "ms",
                "cssVariable": "--bleach-shunpo-duration"
            }
        },
        "Мазки туши": {
            "tab": "Эффекты",
            "description": "Абстрактные мазки кисти вместо прямых разделителей под заголовками и в меню.",
            "default": "Вкл",
            "values": {
                "Вкл": {
                    "TargetCss": {
                        "affects": [
                            ".DesktopUI",
                            "^Steam$",
                            ".friendsui-container",
                            ".ModalDialogPopup",
                            ".FullModalOverlay",
                            "Menu$",
                            "Supernav$",
                            "https://store\\.steampowered\\.com/.*"
                        ],
                        "src": "effects/ink-strokes.css"
                    }
                },
                "Выкл": {}
            }
        },
        "Фоновое изображение": {
            "tab": "Фон",
            "description": "Ваша картинка assets/background.jpg с затемнением и размытием. Без файла фон остаётся чёрным.",
            "default": "Выкл",
            "values": {
                "Выкл": {},
                "Клиент": {
                    "TargetCss": {
                        "affects": [
                            ".DesktopUI",
                            "^Steam$"
                        ],
                        "src": "effects/background.css"
                    }
                },
                "Клиент и друзья": {
                    "TargetCss": {
                        "affects": [
                            ".DesktopUI",
                            "^Steam$",
                            ".friendsui-container"
                        ],
                        "src": "effects/background.css"
                    }
                },
                "Клиент, друзья и магазин": {
                    "TargetCss": {
                        "affects": [
                            ".DesktopUI",
                            "^Steam$",
                            ".friendsui-container",
                            "https://store\\.steampowered\\.com/.*"
                        ],
                        "src": "effects/background.css"
                    }
                }
            }
        },
        "Затемнение фона": {
            "tab": "Фон",
            "description": "Насколько сильно фон перекрыт чёрным (выше — лучше читается текст).",
            "default": "78",
            "slider": {
                "min": 40,
                "max": 95,
                "step": 1,
                "unit": "%",
                "cssVariable": "--bleach-bg-dim"
            }
        },
        "Размытие фона": {
            "tab": "Фон",
            "description": "Размытие картинки в пикселях.",
            "default": "6",
            "slider": {
                "min": 0,
                "max": 24,
                "step": 1,
                "unit": "px",
                "cssVariable": "--bleach-bg-blur"
            }
        },
        "Шрифт заголовков": {
            "tab": "Шрифт",
            "description": "Шрифт с острыми «клинковыми» засечками для заголовков (Google Fonts). Кириллица подставляется из Cormorant.",
            "default": "Стандартный",
            "values": {
                "Стандартный": {},
                "Cinzel": {
                    "TargetCss": {
                        "affects": [
                            ".DesktopUI",
                            "^Steam$",
                            ".friendsui-container",
                            ".ModalDialogPopup",
                            ".FullModalOverlay",
                            "Menu$",
                            "Supernav$",
                            "https://store\\.steampowered\\.com/.*"
                        ],
                        "src": "fonts/blade-cinzel.css"
                    }
                },
                "Shippori Mincho": {
                    "TargetCss": {
                        "affects": [
                            ".DesktopUI",
                            "^Steam$",
                            ".friendsui-container",
                            ".ModalDialogPopup",
                            ".FullModalOverlay",
                            "Menu$",
                            "Supernav$",
                            "https://store\\.steampowered\\.com/.*"
                        ],
                        "src": "fonts/blade-shippori.css"
                    }
                }
            }
        }
    }
}
