]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Единый список Remote-ов. Сервер создаёт их в ReplicatedStorage/Remotes,
	клиент ждёт. Имя, которого нет в списке, = ошибка (защита от опечаток).

	Соглашение для RemoteFunction: сервер всегда отвечает таблицей { ok = boolean, err = string?, ... }.
	err — ключ локализации (ERR_*), клиент покажет его тостом.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "Remotes"

local Net = {}

-- RemoteEvent
Net.Events = {
	-- сервер → клиент
	DataSync = true, -- полный снимок данных игрока
	DataPatch = true, -- изменившиеся ключи верхнего уровня
	SystemNotify = true, -- окно Системы
	Toast = true, -- короткое сообщение внизу экрана
	OpenPanel = true, -- открыть окно (кузня, торговец)
	GateState = true, -- состояние группы/забега во Вратах
	TradeInvite = true, -- кто-то предлагает обмен
	TradeState = true, -- состояние окна обмена
	-- клиент → сервер
	CombatAttack = true,
	CombatBlock = true,
	ForgeCancel = true,
	SetLanguage = true,
	SetSetting = true,
	GateStart = true,
	GateLeave = true,
	TradeRespond = true,
	TradeReady = true,
	TradeConfirm = true,
	TradeCancel = true,
}

-- UnreliableRemoteEvent (косметика, можно потерять)
Net.Unreliable = {
	Fx = true,
}

-- RemoteFunction (клиент → сервер с ответом)
Net.Functions = {
	RequestData = true,
	ForgeStart = true,
	ForgeSubmit = true,
	EquipWeapon = true,
	EquipPickaxe = true,
	SellWeapons = true,
	SellOres = true,
	BuyPickaxe = true,
	RedeemCode = true,
	TradeSetOffer = true,
	ShopList = true,
	ShopUnlist = true,
	ShopBuy = true,
	ShopFetch = true,
}

local function getFolder(): Instance
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
		return folder :: Instance
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME)
end

local function getOrCreate(name: string, className: string): Instance
	local folder = getFolder()
	if RunService:IsServer() then
		local existing = folder:FindFirstChild(name)
		if existing then
			return existing
		end
		local remote = Instance.new(className)
		remote.Name = name
		remote.Parent = folder
		return remote
	end
	return folder:WaitForChild(name)
end

-- Сервер: создать все Remote заранее, чтобы клиент не ждал вечно
function Net.Setup()
	assert(RunService:IsServer(), "Net.Setup только на сервере")
	for name in Net.Events do
		getOrCreate(name, "RemoteEvent")
	end
	for name in Net.Unreliable do
		getOrCreate(name, "UnreliableRemoteEvent")
	end
	for name in Net.Functions do
		getOrCreate(name, "RemoteFunction")
	end
end

function Net.Event(name: string): RemoteEvent
	assert((Net.Events :: any)[name], `Неизвестный RemoteEvent: {name}`)
	return getOrCreate(name, "RemoteEvent") :: RemoteEvent
end

function Net.UnreliableEvent(name: string): UnreliableRemoteEvent
	assert((Net.Unreliable :: any)[name], `Неизвестный UnreliableRemoteEvent: {name}`)
	return getOrCreate(name, "UnreliableRemoteEvent") :: UnreliableRemoteEvent
end

function Net.Function(name: string): RemoteFunction
	assert((Net.Functions :: any)[name], `Неизвестная RemoteFunction: {name}`)
	return getOrCreate(name, "RemoteFunction") :: RemoteFunction
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[--!strict
-- Минимальный Signal без BindableEvent (быстрее и не копирует таблицы).

export type Connection = {
	Disconnect: (self: Connection) -> (),
}

export type Signal = {
	Connect: (self: Signal, fn: (...any) -> ()) -> Connection,
	Once: (self: Signal, fn: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
	Wait: (self: Signal) -> ...any,
}

local Signal = {}

function Signal.new(): Signal
	local handlers: { [{}]: (...any) -> () } = {}
	local self = {}

	function self:Connect(fn: (...any) -> ()): Connection
		local key = {}
		handlers[key] = fn
		local connection = {}
		function connection:Disconnect()
			handlers[key] = nil
		end
		return connection :: any
	end

	function self:Once(fn: (...any) -> ()): Connection
		local connection: Connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			fn(...)
		end)
		return connection
	end

	function self:Fire(...: any)
		-- копия списка: обработчик может (от)подписаться во время вызова
		local list = {}
		for _, fn in handlers do
			table.insert(list, fn)
		end
		for _, fn in list do
			task.spawn(fn, ...)
		end
	end

	function self:Wait(): ...any
		local thread = coroutine.running()
		self:Once(function(...)
			task.spawn(thread, ...)
		end)
		return coroutine.yield()
	end

	return self :: any
end

return Signal
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">Types</string><ProtectedString name="Source"><![CDATA[--!strict
-- Общие типы данных клиента и сервера.

export type WeaponData = {
	Id: string,
	Type: string, -- ключ Config.Weapons
	Ore: string, -- ключ Config.Ores
	Quality: number, -- 0..100
	Rarity: string, -- ключ Config.Rarities
	Traits: { string }, -- Этап 2
	Xp: number, -- опыт оружия (пробуждение — Этап 3)
	CreatedAt: number,
}

export type TutorialData = {
	Step: number,
	Progress: number,
	Done: boolean,
	Awakened: boolean,
}

export type PlayerData = {
	SchemaVersion: number,
	Gold: number,
	Level: number,
	Xp: number,
	Rank: string,
	Ores: { [string]: number },
	Weapons: { [string]: WeaponData },
	EquippedWeapon: string, -- "" = ничего
	Pickaxe: string,
	OwnedPickaxes: { [string]: boolean },
	Tutorial: TutorialData,
	Stats: { [string]: number },
	Settings: { Language: string },
	ProcessedReceipts: { [string]: boolean },
	FirstJoinAt: number,
	LastJoinAt: number,
}

export type NotifyPayload = {
	Kind: string, -- Awakening | Quest | QuestDone | LevelUp | Reward | Info | Warning | Boss | GateCleared | GateFailed | Forge
	Title: string, -- ключ локализации
	Body: string?, -- ключ локализации
	Args: { [string]: any }?, -- подстановки {name}; значения-ключи с префиксом "@" тоже переводятся
}

export type Response = {
	ok: boolean,
	err: string?,
	[string]: any,
}

return {}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">WeaponMath</string><ProtectedString name="Source"><![CDATA[--!strict
-- Формулы оружия, редкостей, рангов: одинаковые на клиенте (превью, шансы) и сервере (истина).

local Config = require(script.Parent.Config)

local WeaponMath = {}

type WeaponLike = { Type: string, Ore: string, Quality: number, Rarity: string, Traits: { string }? }

function WeaponMath.QualityMult(quality: number): number
	local f = Config.Forging
	local q = math.clamp(quality, 0, 100) / 100
	return f.QualityMultMin + (f.QualityMultMax - f.QualityMultMin) * q
end

function WeaponMath.HasTrait(weapon: WeaponLike?, traitId: string): boolean
	return weapon ~= nil and weapon.Traits ~= nil and table.find(weapon.Traits, traitId) ~= nil
end

-- Произведение поля черт (DamageMult / CooldownMult)
local function traitProduct(weapon: WeaponLike, field: string): number
	local mult = 1
	if weapon.Traits then
		for _, id in weapon.Traits do
			local t = Config.Traits[id]
			local v = t and (t :: any)[field]
			if type(v) == "number" then
				mult *= v
			end
		end
	end
	return mult
end

function WeaponMath.Damage(weapon: WeaponLike): number
	local wt = Config.Weapons[weapon.Type]
	local ore = Config.Ores[weapon.Ore]
	if not wt or not ore then
		return 1
	end
	local rarity = Config.Rarities[weapon.Rarity]
	local rarityMult = if rarity then rarity.DamageMult else 1
	local raw = wt.BaseDamage * ore.PowerMult * WeaponMath.QualityMult(weapon.Quality) * rarityMult
		* traitProduct(weapon, "DamageMult")
	return math.max(1, math.floor(raw + 0.5))
end

function WeaponMath.Cooldown(weapon: WeaponLike?): number
	if not weapon then
		return Config.Combat.Fists.AttackCooldown
	end
	local wt = Config.Weapons[weapon.Type]
	if not wt then
		return Config.Combat.Fists.AttackCooldown
	end
	return wt.AttackCooldown * traitProduct(weapon, "CooldownMult")
end

function WeaponMath.SellPrice(weapon: WeaponLike): number
	local wt = Config.Weapons[weapon.Type]
	local ore = Config.Ores[weapon.Ore]
	if not wt or not ore then
		return 1
	end
	local rarity = Config.Rarities[weapon.Rarity]
	local rarityMult = if rarity then rarity.SellMult else 1
	local raw = ore.SellPrice
		* wt.OreCost
		* wt.SellMult
		* Config.Economy.WeaponSellBonus
		* WeaponMath.QualityMult(weapon.Quality)
		* rarityMult
	return math.max(1, math.floor(raw + 0.5))
end

-- Превью урона до ковки (Common, без черт)
function WeaponMath.Preview(weaponType: string, oreId: string, quality: number): number
	return WeaponMath.Damage({ Type = weaponType, Ore = oreId, Quality = quality, Rarity = "Common" })
end

-- ===== Редкости =====

function WeaponMath.SortedRarities(): { any }
	local list = {}
	for _, r in Config.Rarities do
		table.insert(list, r)
	end
	table.sort(list, function(a, b)
		return a.Order < b.Order
	end)
	return list
end

-- Шансы редкостей: { { Id, Chance (0..1) } } по возрастанию редкости
function WeaponMath.RarityOdds(quality: number, oreId: string): { { Id: string, Chance: number } }
	local ore = Config.Ores[oreId]
	local luck = 1 + math.clamp(quality, 0, 100) / 100 * Config.Forging.RarityLuckPerQuality + (if ore then ore.RarityLuck else 0)
	local list = WeaponMath.SortedRarities()
	local total = 0
	local weights = {}
	for i, r in list do
		local w = r.Weight * luck ^ (r.Order - 1)
		weights[i] = w
		total += w
	end
	local odds = {}
	for i, r in list do
		table.insert(odds, { Id = r.Id, Chance = weights[i] / total })
	end
	return odds
end

function WeaponMath.RarityAtLeast(rarityId: string, minId: string): boolean
	local r = Config.Rarities[rarityId]
	local m = Config.Rarities[minId]
	return r ~= nil and m ~= nil and r.Order >= m.Order
end

-- ===== Уровни и ранги =====

function WeaponMath.XpToNext(level: number): number
	local l = Config.Leveling
	return math.floor(l.XpBase * level ^ l.XpExponent)
end

function WeaponMath.RankFor(level: number): any
	local best = Config.Ranks[1]
	for _, rank in Config.Ranks do
		if level >= rank.MinLevel then
			best = rank
		end
	end
	return best
end

function WeaponMath.RankById(id: string): any
	for _, rank in Config.Ranks do
		if rank.Id == id then
			return rank
		end
	end
	return Config.Ranks[1]
end

function WeaponMath.LevelDamageMult(level: number): number
	return (1 + (level - 1) * Config.Leveling.DamagePerLevel) * (1 + WeaponMath.RankFor(level).DamageBonus)
end

function WeaponMath.MaxHealth(level: number): number
	local l = Config.Leveling
	return l.BaseHealth + (level - 1) * l.HealthPerLevel
end

return WeaponMath
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000005F"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000043"><Properties><string name="Name">Server</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ТОЧКА ВХОДА СЕРВЕРА.
	Порядок: все сервисы → :Init() (создают свои папки/Remote) → :Start() (подписки, циклы).
	Сервисы зависят друг от друга через require без циклов.
]]

local DevMap = require(script.Util.DevMap)
local WorldBuilder = require(script.World.WorldBuilder)

local ORDER = {
	"NetService",
	"DataService",
	"SystemService",
	"EconomyService",
	"LevelService",
	"SocialService",
	"TutorialService",
	"DailyService",
	"ProgressService",
	"InventoryService",
	"MiningService",
	"ForgeService",
	"MerchantService",
	"CombatState",
	"MobService",
	"CombatService",
	"GateService",
	"WorldMobService",
	"ShopService",
	"TradeService",
	"CodesService",
	"LeaderboardService",
}

-- карта: полный мир кодом (если нет своих объектов с тегами) или минимальные заглушки
if WorldBuilder.ShouldBuild() then
	WorldBuilder.Build()
else
	DevMap.BuildIfEmpty()
end

local services: { [string]: any } = {}
for _, name in ORDER do
	services[name] = require(script.Services:FindFirstChild(name) :: ModuleScript)
end

for _, name in ORDER do
	local service = services[name]
	if type(service.Init) == "function" then
		service:Init()
	end
end

for _, name in ORDER do
	local service = services[name]
	if type(service.Start) == "function" then
		local ok, err = pcall(function()
			service:Start()
		end)
		if not ok then
			warn(`[Server] {name}:Start() — {err}`)
		end
	end
end

-- игроков начинаем загружать только когда все сервисы подписались на события
services.DataService:BeginLoading()

print("[SystemBlacksmith] сервер запущен")
]]></ProtectedString></Properties><Item class="Folder" referent="RBX00000021"><Properties><string name="Name">Data</string></Properties><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">FallbackStore</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ЗАГЛУШКА ProfileStore — ТОЛЬКО ДЛЯ ТЕСТА В STUDIO, ДАННЫЕ НЕ СОХРАНЯЮТСЯ.
	Используется, если в ServerStorage нет модуля ProfileStore.
	Повторяет нужную нам часть API ProfileStore: New / StartSessionAsync / profile.Data /
	Reconcile / AddUserId / EndSession / IsActive / OnSessionEnd.
]]

local Signal = require(game:GetService("ReplicatedStorage").Shared.Signal)

local FallbackStore = {}

local function deepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value :: any do
		copy[deepCopy(k)] = deepCopy(v)
	end
	return copy :: any
end

local function reconcile(target: any, template: any)
	for k, v in template do
		if type(k) == "string" then
			if target[k] == nil then
				target[k] = deepCopy(v)
			elseif type(target[k]) == "table" and type(v) == "table" then
				reconcile(target[k], v)
			end
		end
	end
end

function FallbackStore.New(_name: string, template: any)
	local store = {}

	function store:StartSessionAsync(_key: string, _params: any): any
		local active = true
		local onEnd = Signal.new()
		local profile = {
			Data = deepCopy(template),
			OnSessionEnd = onEnd,
		}
		function profile:Reconcile()
			reconcile(profile.Data, template)
		end
		function profile:AddUserId(_userId: number) end
		function profile:IsActive(): boolean
			return active
		end
		function profile:Save() end
		function profile:EndSession()
			if active then
				active = false
				onEnd:Fire()
			end
		end
		return profile
	end

	return store
end

return FallbackStore
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">Migrations</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	МИГРАЦИИ СХЕМЫ ДАННЫХ.
	Steps[N] переводит данные из версии N в версию N+1. Вызываются по цепочке при загрузке.
	Пример на будущее (v1 → v2: переименовать Gold в Coins):
		[1] = function(data)
			data.Coins = data.Gold
			data.Gold = nil
		end,
]]

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local Migrations = {}

local Steps: { [number]: (data: any) -> () } = {
	-- пока пусто: текущая версия схемы = 1
}

-- false → данные новее, чем знает этот сервер (старый сервер после обновления). Не трогаем их.
function Migrations.Apply(data: any): boolean
	local target = Config.Data.SchemaVersion
	local version = tonumber(data.SchemaVersion) or 1
	if version > target then
		return false
	end
	while version < target do
		local step = Steps[version]
		if step then
			step(data)
		end
		version += 1
		data.SchemaVersion = version
	end
	return true
end

return Migrations
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Template</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ШАБЛОН ДАННЫХ ИГРОКА (схема v1).
	Новое поле: просто добавь сюда — ProfileStore:Reconcile() допишет его старым профилям.
	Переименование/преобразование поля: подними Config.Data.SchemaVersion и добавь шаг в Migrations.
	Значения nil в шаблоне нельзя — используй "" / 0 / {}.
]]

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)

local Template = {
	SchemaVersion = Config.Data.SchemaVersion,
	Gold = Config.Economy.StartingGold,
	Level = 1,
	Xp = 0,
	Rank = Config.Leveling.StartingRank,
	Ores = {} :: { [string]: number },
	Weapons = {} :: { [string]: any },
	EquippedWeapon = "",
	Pickaxe = Config.Economy.StartingPickaxe,
	OwnedPickaxes = { [Config.Economy.StartingPickaxe] = true } :: { [string]: boolean },
	Tutorial = {
		Step = 1,
		Progress = 0,
		Done = false,
		Awakened = false,
	},
	Stats = {
		OresMined = 0,
		WeaponsForged = 0,
		BestQuality = 0,
		MobsKilled = 0,
		BossesKilled = 0,
		GatesCleared = 0,
		GoldEarned = 0,
		Parries = 0,
		BestDamage = 0,
		EliteKills = 0,
		MythicForged = 0,
		Trades = 0,
		ShopSales = 0,
	} :: { [string]: number },
	Settings = {
		Language = "", -- "" = определить по языку Roblox
		Sfx = true,
		Music = true,
		DamageNumbers = true,
		LowGraphics = false,
	},
	Daily = {
		LastClaimDay = 0, -- номер дня (UTC), когда забрана награда за вход
		Streak = 0,
		QuestDay = 0,
		Quests = {} :: { any }, -- { { Id, Progress, Done } }
	},
	RedeemedCodes = {} :: { [string]: boolean },
	Shop = {
		Listings = {} :: { [string]: number }, -- id оружия → цена
		Earned = 0,
		LastOnlineAt = 0, -- для офлайн-продаж
	},
	ProcessedReceipts = {} :: { [string]: boolean }, -- для идемпотентного ProcessReceipt (Этап 3)
	FirstJoinAt = 0,
	LastJoinAt = 0,
}

return Template
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000038"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">CodesService</string><ProtectedString name="Source"><![CDATA[--!strict
-- КОДЫ: игрок вводит код из соцсетей → разовая награда. Список кодов — Config/Codes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Guards = require(script.Parent.Parent.Util.Guards)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local LevelService = require(script.Parent.LevelService)
local NetService = require(script.Parent.NetService)

local CodesService = {}

local function redeem(player: Player, raw: any)
	local data = DataService:Get(player)
	if not data then
		return { ok = false, err = "ERR_NOT_LOADED" }
	end
	if not Guards.String(raw, 40) then
		return { ok = false, err = "ERR_CODE_INVALID" }
	end
	local code = string.upper((string.gsub(raw, "%s", "")))
	local def = Config.Codes[code]
	if not def then
		return { ok = false, err = "ERR_CODE_INVALID" }
	end
	if data.RedeemedCodes[code] then
		return { ok = false, err = "ERR_CODE_USED" }
	end
	if def.Expires > 0 and os.time() > def.Expires then
		return { ok = false, err = "ERR_CODE_EXPIRED" }
	end

	data.RedeemedCodes[code] = true -- сначала отмечаем, потом выдаём (нет двойной выдачи)
	if def.Gold then
		EconomyService:AddGold(player, def.Gold)
	end
	if def.Xp then
		LevelService:AddXp(player, def.Xp, true)
	end
	if def.Ores then
		for oreId, count in def.Ores do
			EconomyService:AddOre(player, oreId, count)
		end
	end
	return { ok = true, gold = def.Gold or 0, xp = def.Xp or 0 }
end

function CodesService:Start()
	NetService:OnInvoke("RedeemCode", redeem)
end

return CodesService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">CombatService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	БОЙ ИГРОКА. Клиент шлёт только «я ударил» / «я держу блок».
	Сервер сам решает: кулдаун оружия, кого задело (дистанция + угол перед игроком), сколько урона.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local WeaponMath = require(ReplicatedStorage.Shared.WeaponMath)
local Char = require(script.Parent.Parent.Util.Char)
local Guards = require(script.Parent.Parent.Util.Guards)
local CombatState = require(script.Parent.CombatState)
local DataService = require(script.Parent.DataService)
local InventoryService = require(script.Parent.InventoryService)
local LevelService = require(script.Parent.LevelService)
local MobService = require(script.Parent.MobService)
local NetService = require(script.Parent.NetService)
local ProgressService = require(script.Parent.ProgressService)

local CombatService = {}

local lastAttack: { [Player]: number } = {}
local rng = Random.new()

-- Сетевой допуск: клиентский кулдаун и серверный могут разойтись на пинг
local COOLDOWN_TOLERANCE = 0.85

local function attack(player: Player)
	if not DataService:IsLoaded(player) or not Char.IsAlive(player) then
		return
	end
	local root = Char.Root(player) :: BasePart

	local weapon = InventoryService:GetEquipped(player)
	local def = if weapon then Config.Weapons[weapon.Type] else nil
	local stats = def or Config.Combat.Fists
	local now = os.clock()
	if (lastAttack[player] or 0) + WeaponMath.Cooldown(weapon) * COOLDOWN_TOLERANCE > now then
		return
	end
	lastAttack[player] = now

	local baseDamage = if weapon then WeaponMath.Damage(weapon) else Config.Combat.Fists.Damage
	local look = root.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z).Unit

	local candidates = MobService:GetMobsInRadius(root.Position, stats.Range)
	table.sort(candidates, function(a, b)
		return (a.Root.Position - root.Position).Magnitude < (b.Root.Position - root.Position).Magnitude
	end)

	-- черты оружия
	local critChance, critMult, lifeSteal, burnFraction, burnSeconds = 0, 1, 0, 0, 0
	if weapon and weapon.Traits then
		for _, id in weapon.Traits do
			local t = Config.Traits[id]
			if t then
				critChance += t.CritChance or 0
				critMult = math.max(critMult, t.CritMult or 1)
				lifeSteal += t.LifeSteal or 0
				burnFraction += t.BurnFraction or 0
				burnSeconds = math.max(burnSeconds, t.BurnSeconds or 0)
			end
		end
	end
	local humanoid = Char.Humanoid(player)

	local hits = 0
	for _, mob in candidates do
		if hits >= stats.MaxTargets then
			break
		end
		local offset = mob.Root.Position - root.Position
		local flat = Vector3.new(offset.X, 0, offset.Z)
		-- вплотную — попадаем всегда, иначе проверяем угол
		local inArc = flat.Magnitude < 2 or flatLook:Dot(flat.Unit) >= stats.Arc
		if inArc then
			hits += 1
			local raw = baseDamage * LevelService:DamageMult(player) * rng:NextNumber(0.9, 1.1)
			local crit = critChance > 0 and rng:NextNumber() < critChance
			if crit then
				raw *= critMult
			end
			local damage = math.max(1, math.floor(raw + 0.5))
			MobService:Damage(mob, damage, player)
			if burnFraction > 0 then
				MobService:ApplyBurn(mob, damage * burnFraction, burnSeconds, player)
			end
			if lifeSteal > 0 and humanoid and humanoid.Health > 0 then
				humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + damage * lifeSteal)
			end
			NetService:FxNear(mob.Root.Position, Config.Combat.DamageFxRadius, {
				Kind = "Damage",
				Position = mob.Root.Position + Vector3.new(0, mob.Def.Size.Y / 2, 0),
				Amount = damage,
				Crit = crit,
				ByUserId = player.UserId,
			})
		end
	end
end

function CombatService:Start()
	NetService:OnEvent("CombatAttack", attack)

	NetService:OnEvent("CombatBlock", function(player: Player, blocking: any)
		if not Guards.Boolean(blocking) then
			return
		end
		if blocking and not Char.IsAlive(player) then
			return
		end
		CombatState.SetBlocking(player, blocking)
	end)

	MobService.PlayerParried:Connect(function(player: Player)
		-- надпись «ПАРИРОВАНИЕ!» показывает клиент по Fx (быстрее, чем окно Системы)
		DataService:AddStat(player, "Parries", 1)
		ProgressService:Record(player, "Parry")
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastAttack[player] = nil
	end)
end

return CombatService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">CombatState</string><ProtectedString name="Source"><![CDATA[--!strict
-- Состояние блока/парирования игроков. Используется MobService (входящий урон) и CombatService.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Char = require(script.Parent.Parent.Util.Char)

local CombatState = {}

type State = { Blocking: boolean, BlockStartedAt: number, LastToggle: number }
local states: { [Player]: State } = {}

local function get(player: Player): State
	local s = states[player]
	if not s then
		s = { Blocking = false, BlockStartedAt = 0, LastToggle = 0 }
		states[player] = s
	end
	return s
end

function CombatState.SetBlocking(player: Player, blocking: boolean)
	local s = get(player)
	if s.Blocking == blocking then
		return
	end
	local now = os.clock()
	if blocking and now - s.LastToggle < Config.Combat.BlockToggleCooldown then
		return -- спам блоком ради окна парирования не пройдёт
	end
	s.LastToggle = now
	s.Blocking = blocking
	if blocking then
		s.BlockStartedAt = now
	end
	local humanoid = Char.Humanoid(player)
	if humanoid then
		humanoid.WalkSpeed = if blocking then Config.Combat.BlockWalkSpeed else Config.Combat.DefaultWalkSpeed
	end
end

function CombatState.IsBlocking(player: Player): boolean
	return get(player).Blocking
end

-- Итоговый урон по игроку и результат: "hit" | "block" | "parry"
function CombatState.Resolve(player: Player, damage: number): (number, string)
	local s = get(player)
	if not s.Blocking then
		return damage, "hit"
	end
	if os.clock() - s.BlockStartedAt <= Config.Combat.ParryWindowSeconds then
		return 0, "parry"
	end
	return math.floor(damage * (1 - Config.Combat.BlockDamageReduction) + 0.5), "block"
end

function CombatState:Start()
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			states[player] = nil -- новый персонаж — без блока
		end)
	end)
	for _, player in Players:GetPlayers() do
		player.CharacterAdded:Connect(function()
			states[player] = nil
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
end

return CombatState
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">DailyService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ЕЖЕДНЕВНОЕ: награда за вход с серией (7-дневный цикл) и 3 задания Системы на день.
	Невыполненные вчера задания → шуточный «штраф» Системы (без настоящего наказания).
	Прогресс приходит через ProgressService:Record.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local LevelService = require(script.Parent.LevelService)
local SystemService = require(script.Parent.SystemService)

local DailyService = {}

local D = Config.Daily
local rng = Random.new()

local function today(): number
	return os.time() // 86400
end

local function questDef(id: string): any
	for _, q in D.QuestPool do
		if q.Id == id then
			return q
		end
	end
	return nil
end

local function rollQuests(): { any }
	local pool = table.clone(D.QuestPool)
	local list = {}
	for _ = 1, math.min(D.QuestCount, #pool) do
		local q = table.remove(pool, rng:NextInteger(1, #pool))
		table.insert(list, { Id = q.Id, Progress = 0, Done = false })
	end
	return list
end

local function refresh(player: Player, data: any, announceDelay: number)
	local day = today()
	local daily = data.Daily
	local changed = false

	-- награда за вход
	if daily.LastClaimDay < day then
		daily.Streak = if daily.LastClaimDay == day - 1 then daily.Streak + 1 else 1
		daily.LastClaimDay = day
		changed = true
		local reward = D.Rewards[((daily.Streak - 1) % #D.Rewards) + 1]
		task.delay(announceDelay, function()
			if not DataService:IsLoaded(player) then
				return
			end
			EconomyService:AddGold(player, reward.Gold)
			if reward.Ores then
				for oreId, count in reward.Ores do
					EconomyService:AddOre(player, oreId, count)
					SystemService:Toast(player, "TOAST_ORE", { count = count, ore = "@" .. Config.Ores[oreId].NameKey }, "ore")
				end
			end
			SystemService:Notify(player, "Daily", "SYS_DAILY_TITLE", "SYS_DAILY_BODY", { day = daily.Streak, gold = reward.Gold })
		end)
	end

	-- задания дня
	if daily.QuestDay ~= day then
		local missed = false
		if daily.QuestDay > 0 then
			for _, q in daily.Quests do
				if not q.Done then
					missed = true
				end
			end
		end
		daily.QuestDay = day
		daily.Quests = rollQuests()
		changed = true
		task.delay(announceDelay + 1, function()
			if not DataService:IsLoaded(player) then
				return
			end
			if missed then
				SystemService:Notify(player, "Penalty", "SYS_PENALTY_TITLE", "SYS_PENALTY_BODY")
			end
			SystemService:Notify(player, "Quest", "SYS_DAILYQ_NEW_TITLE", "SYS_DAILYQ_NEW_BODY")
		end)
	end

	if changed then
		DataService:Replicate(player, "Daily")
	end
end

function DailyService:Record(player: Player, event: string, amount: number)
	local data = DataService:Get(player)
	if not data then
		return
	end
	local changed = false
	for _, q in data.Daily.Quests do
		local def = questDef(q.Id)
		if def and not q.Done and def.Event == event then
			q.Progress = math.min(def.Count, q.Progress + amount)
			changed = true
			if q.Progress >= def.Count then
				q.Done = true
				EconomyService:AddGold(player, def.RewardGold)
				LevelService:AddXp(player, def.RewardXp)
				SystemService:Notify(player, "QuestDone", def.TitleKey, "SYS_REWARD_LINE", {
					count = def.Count,
					gold = def.RewardGold,
					xp = def.RewardXp,
				})
			end
		end
	end
	if changed then
		DataService:Replicate(player, "Daily")
	end
end

function DailyService:Start()
	DataService.Loaded:Connect(function(player: Player, data: any)
		-- новичку сначала показываем пробуждение и обучение
		refresh(player, data, if data.Tutorial.Done then 3 else 12)
	end)

	-- смена дня во время игры (полночь UTC)
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in Players:GetPlayers() do
				local data = DataService:Get(player)
				if data then
					refresh(player, data, 0)
				end
			end
		end
	end)
end

return DailyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ДАННЫЕ ИГРОКА через ProfileStore (session locking → защита от дюпа между серверами).

	ProfileStore положи ModuleScript-ом в ServerStorage/ProfileStore (см. README).
	Если его нет — используется FallbackStore (данные НЕ сохраняются, только для теста).

	Правила, которые защищают от потери/дюпа:
	1. Все изменения данных — только на сервере и только через сервисы.
	2. Предмет сначала удаляется из одного места, потом добавляется в другое — в одном потоке без yield.
	3. Каждый предмет имеет уникальный GUID — продажа/надевание идут по Id.
	4. Если профиль открыт на другом сервере — сессия здесь закрывается и игрока кикает.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Localization = require(ReplicatedStorage.Shared.Localization)
local Signal = require(ReplicatedStorage.Shared.Signal)
local NetService = require(script.Parent.NetService)
local Template = require(script.Parent.Parent.Data.Template)
local Migrations = require(script.Parent.Parent.Data.Migrations)
local FallbackStore = require(script.Parent.Parent.Data.FallbackStore)

local DataService = {}

DataService.Loaded = Signal.new() -- (player, data)
DataService.Releasing = Signal.new() -- (player, data) — перед закрытием сессии

local profiles: { [Player]: any } = {}
local store: any = nil
DataService.UsingFallback = false

local function onPlayerAdded(player: Player)
	local profile = store:StartSessionAsync(`Player_{player.UserId}`, {
		Cancel = function()
			return player.Parent ~= Players
		end,
	})

	if profile == nil then
		-- Roblox не дал загрузить данные (или игрок вышел, пока грузилось)
		if player.Parent == Players then
			player:Kick("Could not load your data. Please rejoin. / Не удалось загрузить данные, перезайди.")
		end
		return
	end

	profile:AddUserId(player.UserId) -- GDPR
	profile:Reconcile()

	if not Migrations.Apply(profile.Data) then
		profile:EndSession()
		player:Kick("The game was updated. Please rejoin. / Игра обновилась, перезайди.")
		return
	end

	profile.OnSessionEnd:Connect(function()
		-- если мы сами закрыли сессию при выходе игрока, profiles[player] уже пуст
		local wasActive = profiles[player] == profile
		profiles[player] = nil
		if wasActive and player.Parent == Players then
			player:Kick("Your data was opened on another server. Please rejoin. / Данные открыты на другом сервере, перезайди.")
		end
	end)

	if player.Parent ~= Players then
		profile:EndSession()
		return
	end

	local data = profile.Data
	local now = os.time()
	if data.FirstJoinAt == 0 then
		data.FirstJoinAt = now
	end
	data.LastJoinAt = now

	profiles[player] = profile

	-- leaderstats (видно в списке игроков)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local level = Instance.new("IntValue")
	level.Name = "Level"
	level.Value = data.Level
	level.Parent = leaderstats
	local gold = Instance.new("IntValue")
	gold.Name = "Gold"
	gold.Value = data.Gold
	gold.Parent = leaderstats
	leaderstats.Parent = player

	player:SetAttribute("DataLoaded", true)
	NetService:Fire(player, "DataSync", data)
	DataService.Loaded:Fire(player, data)
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if profile then
		DataService.Releasing:Fire(player, profile.Data)
		profiles[player] = nil
		profile:EndSession()
	end
end

function DataService:Init()
	local module = ServerStorage:FindFirstChild("ProfileStore")
	if module and module:IsA("ModuleScript") then
		local ProfileStore = require(module) :: any
		store = ProfileStore.New(Config.Data.StoreName, Template)
	else
		DataService.UsingFallback = true
		warn(
			"[DataService] ServerStorage/ProfileStore не найден — данные НЕ сохраняются! "
				.. "Скачай ProfileStore (см. README) перед публикацией."
		)
		store = FallbackStore.New(Config.Data.StoreName, Template)
	end
end

function DataService:Start()
	NetService:OnInvoke("RequestData", function(player: Player)
		local profile = profiles[player]
		if not profile then
			return { ok = false, err = "ERR_NOT_LOADED" }
		end
		return { ok = true, data = profile.Data }
	end)

	NetService:OnEvent("SetLanguage", function(player: Player, lang: any)
		local data = DataService:Get(player)
		if data and type(lang) == "string" and Localization.IsSupported(lang) then
			data.Settings.Language = lang
		end
	end)

	-- настройки игрока (булевы, по белому списку)
	local SETTINGS = { Sfx = true, Music = true, DamageNumbers = true, LowGraphics = true }
	NetService:OnEvent("SetSetting", function(player: Player, key: any, value: any)
		local data = DataService:Get(player)
		if data and type(key) == "string" and SETTINGS[key] and type(value) == "boolean" then
			data.Settings[key] = value
		end
	end)

	Players.PlayerRemoving:Connect(onPlayerRemoving)
end

-- Вызывается загрузчиком ПОСЛЕ :Start() всех сервисов, чтобы никто не пропустил DataService.Loaded
function DataService:BeginLoading()
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

-- Данные игрока или nil, если ещё не загружены / уже выгружены
function DataService:Get(player: Player): any
	local profile = profiles[player]
	return if profile then profile.Data else nil
end

function DataService:IsLoaded(player: Player): boolean
	return profiles[player] ~= nil
end

-- Отправить клиенту изменившиеся ключи верхнего уровня
function DataService:Replicate(player: Player, ...: string)
	local data = DataService:Get(player)
	if not data then
		return
	end
	local patch = {}
	for _, key in { ... } do
		patch[key] = data[key]
	end
	NetService:Fire(player, "DataPatch", patch)

	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local level = leaderstats:FindFirstChild("Level") :: IntValue?
		local gold = leaderstats:FindFirstChild("Gold") :: IntValue?
		if level then
			level.Value = data.Level
		end
		if gold then
			gold.Value = data.Gold
		end
	end
end

-- Немедленное сохранение (после обмена и покупки): сужает окно, в котором сбой сервера
-- мог бы сохранить одну сторону сделки без другой.
function DataService:SaveNow(player: Player)
	local profile = profiles[player]
	if profile and type(profile.Save) == "function" then
		pcall(function()
			profile:Save()
		end)
	end
end

function DataService:AddStat(player: Player, stat: string, amount: number)
	local data = DataService:Get(player)
	if data then
		data.Stats[stat] = (data.Stats[stat] or 0) + amount
		DataService:Replicate(player, "Stats")
	end
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Золото и руда. Единственное место, где они меняются.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)

local EconomyService = {}

function EconomyService:AddGold(player: Player, amount: number)
	local data = DataService:Get(player)
	if not data or amount <= 0 then
		return
	end
	amount = math.floor(amount)
	data.Gold += amount
	data.Stats.GoldEarned = (data.Stats.GoldEarned or 0) + amount
	DataService:Replicate(player, "Gold")
end

function EconomyService:TrySpendGold(player: Player, amount: number): boolean
	local data = DataService:Get(player)
	if not data or amount < 0 or data.Gold < amount then
		return false
	end
	data.Gold -= math.floor(amount)
	DataService:Replicate(player, "Gold")
	return true
end

-- Перевод золота между игроками (обмен, покупка в лавке). Не считается «заработком».
-- tax — доля, которая сгорает (комиссия рынка). Возвращает сумму, дошедшую получателю.
function EconomyService:TransferGold(from: Player, to: Player, amount: number, tax: number?): number?
	local a = DataService:Get(from)
	local b = DataService:Get(to)
	amount = math.floor(amount)
	if not a or not b or amount < 0 or a.Gold < amount then
		return nil
	end
	local received = amount - math.floor(amount * (tax or 0) + 0.5)
	a.Gold -= amount
	b.Gold += received
	return received
end

function EconomyService:GetOre(player: Player, oreId: string): number
	local data = DataService:Get(player)
	if not data then
		return 0
	end
	return data.Ores[oreId] or 0
end

function EconomyService:AddOre(player: Player, oreId: string, count: number)
	local data = DataService:Get(player)
	if not data or count <= 0 or not Config.Ores[oreId] then
		return
	end
	data.Ores[oreId] = (data.Ores[oreId] or 0) + math.floor(count)
	DataService:Replicate(player, "Ores")
end

function EconomyService:TrySpendOre(player: Player, oreId: string, count: number): boolean
	local data = DataService:Get(player)
	if not data or count <= 0 then
		return false
	end
	local have = data.Ores[oreId] or 0
	if have < count then
		return false
	end
	data.Ores[oreId] = have - count
	DataService:Replicate(player, "Ores")
	return true
end

return EconomyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">ForgeService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	КОВКА. Наковальня = Part/Model с тегом "Forge".

	Поток:
	1. Игрок жмёт подсказку «Ковать» → клиенту открывается окно кузни.
	2. ForgeStart(type, ore): сервер проверяет дистанцию, уровень, руду, место в инвентаре
	   и выдаёт сессию со СЛУЧАЙНЫМИ параметрами мини-игры (зона мехов, линия заливки, ритм).
	3. Клиент проводит мини-игру и шлёт сырые замеры: доля времени в зоне, уровень заливки,
	   отклонения ударов от ритма.
	4. ForgeSubmit: сервер проверяет сессию и реальное время (быстрее физически невозможного → отказ),
	   сам считает качество, списывает руду и создаёт оружие.

	Честно: мини-игру на клиенте нельзя сделать 100% защищённой от читов. Мы ограничиваем вред:
	параметры случайные и знает их только эта сессия, время проверяется сервером, качество влияет
	на урон лишь в пределах QualityMultMin..Max, а подозрительные серии 100% пишутся в лог.
]]

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local WeaponMath = require(ReplicatedStorage.Shared.WeaponMath)
local Guards = require(script.Parent.Parent.Util.Guards)
local Proximity = require(script.Parent.Parent.Util.Proximity)
local Prompts = require(script.Parent.Parent.Util.Prompts)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local InventoryService = require(script.Parent.InventoryService)
local LevelService = require(script.Parent.LevelService)
local NetService = require(script.Parent.NetService)
local ProgressService = require(script.Parent.ProgressService)
local SystemService = require(script.Parent.SystemService)
local Char = require(script.Parent.Parent.Util.Char)

local ForgeService = {}

type Session = {
	Id: string,
	Type: string,
	Ore: string,
	StartedAt: number,
	Params: {
		Bellows: { Duration: number, ZoneMin: number, ZoneMax: number, Decay: number, PerPump: number },
		Pour: { Target: number, FillPerSecond: number },
		Hammer: { Beats: number, Interval: number, LeadIn: number },
	},
}

local sessions: { [Player]: Session } = {}
local perfectStreak: { [Player]: number } = {}
local rng = Random.new()

local F = Config.Forging

local function makeParams()
	local zoneCenter = rng:NextNumber(F.Bellows.ZoneCenterMin, F.Bellows.ZoneCenterMax)
	return {
		Bellows = {
			Duration = F.Bellows.DurationSeconds,
			ZoneMin = zoneCenter - F.Bellows.ZoneWidth / 2,
			ZoneMax = zoneCenter + F.Bellows.ZoneWidth / 2,
			Decay = F.Bellows.HeatDecayPerSecond,
			PerPump = F.Bellows.HeatPerPump,
		},
		Pour = {
			Target = rng:NextNumber(F.Pour.TargetMin, F.Pour.TargetMax),
			FillPerSecond = F.Pour.FillPerSecond,
		},
		Hammer = {
			Beats = F.Hammer.Beats,
			Interval = rng:NextNumber(F.Hammer.IntervalMin, F.Hammer.IntervalMax),
			LeadIn = F.Hammer.LeadInSeconds,
		},
	}
end

local function minDuration(session: Session): number
	local p = session.Params
	return p.Bellows.Duration + F.Pour.MinSeconds + p.Hammer.LeadIn + p.Hammer.Interval * p.Hammer.Beats
end

-- Счёт шагов 0..1 — считает только сервер
local function scoreBellows(fractionInZone: number): number
	return math.clamp(fractionInZone / F.Bellows.FullScoreFraction, 0, 1)
end

local function scorePour(level: number, target: number): number
	local diff = math.abs(level - target)
	if diff <= F.Pour.PerfectTolerance then
		return 1
	end
	return math.clamp(1 - (diff - F.Pour.PerfectTolerance) / (F.Pour.Tolerance - F.Pour.PerfectTolerance), 0, 1)
end

local function scoreHammer(offsets: { number }, beats: number): number
	local total = 0
	for i = 1, beats do
		local o = offsets[i]
		if o ~= nil then
			local a = math.abs(o)
			if a <= F.Hammer.PerfectWindow then
				total += 1
			elseif a <= F.Hammer.HitWindow then
				total += 1 - (a - F.Hammer.PerfectWindow) / (F.Hammer.HitWindow - F.Hammer.PerfectWindow)
			end
		end
	end
	return total / beats
end

-- Редкость по честным шансам (те же, что видит игрок в кузне)
local function rollRarity(quality: number, oreId: string): string
	local odds = WeaponMath.RarityOdds(quality, oreId)
	local roll = rng:NextNumber()
	local acc = 0
	for _, o in odds do
		acc += o.Chance
		if roll <= acc then
			return o.Id
		end
	end
	return odds[#odds].Id
end

local function rollTraits(count: number): { string }
	local pool = {}
	for id, t in Config.Traits do
		table.insert(pool, { Id = id, Weight = t.Weight })
	end
	local result = {}
	for _ = 1, math.min(count, #pool) do
		local total = 0
		for _, t in pool do
			total += t.Weight
		end
		local roll = rng:NextNumber(0, total)
		for i, t in pool do
			roll -= t.Weight
			if roll <= 0 then
				table.insert(result, t.Id)
				table.remove(pool, i)
				break
			end
		end
	end
	return result
end

local function startForge(player: Player, weaponType: any, oreId: any)
	local data = DataService:Get(player)
	if not data then
		return { ok = false, err = "ERR_NOT_LOADED" }
	end
	if not Guards.String(weaponType, 32) or not Guards.String(oreId, 32) then
		return { ok = false, err = "ERR_BAD_REQUEST" }
	end
	local def = Config.Weapons[weaponType]
	local ore = Config.Ores[oreId]
	if not def or not ore then
		return { ok = false, err = "ERR_BAD_REQUEST" }
	end
	if not Proximity.NearTagged(player, Config.Tags.Forge, Config.Economy.InteractMaxDistance) then
		return { ok = false, err = "ERR_TOO_FAR" }
	end
	if data.Level < ore.RequiredLevel then
		return { ok = false, err = "ERR_LEVEL_LOW", args = { level = ore.RequiredLevel } }
	end
	if (data.Ores[oreId] or 0) < def.OreCost then
		return { ok = false, err = "ERR_NOT_ENOUGH_ORE" }
	end
	if InventoryService:IsFull(player) then
		return { ok = false, err = "ERR_INVENTORY_FULL" }
	end

	local session: Session = {
		Id = HttpService:GenerateGUID(false),
		Type = weaponType,
		Ore = oreId,
		StartedAt = os.clock(),
		Params = makeParams(),
	}
	sessions[player] = session
	return { ok = true, sessionId = session.Id, params = session.Params }
end

local function submitForge(player: Player, sessionId: any, results: any)
	local session = sessions[player]
	if not session or sessionId ~= session.Id then
		return { ok = false, err = "ERR_NO_SESSION" }
	end
	sessions[player] = nil -- сессия одноразовая

	local elapsed = os.clock() - session.StartedAt
	if elapsed > F.SessionTimeoutSeconds then
		return { ok = false, err = "ERR_NO_SESSION" }
	end
	if elapsed < minDuration(session) * F.MinDurationTolerance then
		if Config.Debug.LogSuspicious then
			warn(`[Forge] {player.Name}: слишком быстро ({string.format("%.2f", elapsed)}с)`)
		end
		return { ok = false, err = "ERR_TOO_FAST" }
	end

	if type(results) ~= "table" then
		return { ok = false, err = "ERR_BAD_REQUEST" }
	end
	local beats = session.Params.Hammer.Beats
	if
		not Guards.Number(results.Bellows, 0, 1)
		or not Guards.Number(results.Pour, 0, 1.5)
		or not Guards.NumberArray(results.Hammer, beats, -60, 60)
	then
		return { ok = false, err = "ERR_BAD_REQUEST" }
	end

	local sb = scoreBellows(results.Bellows)
	local sp = scorePour(results.Pour, session.Params.Pour.Target)
	local sh = scoreHammer(results.Hammer, beats)
	local quality = math.floor(100 * (F.Bellows.Weight * sb + F.Pour.Weight * sp + F.Hammer.Weight * sh) + 0.5)

	-- анти-чит: серия идеальных ковок подряд
	if sb == 1 and sp == 1 and sh == 1 then
		perfectStreak[player] = (perfectStreak[player] or 0) + 1
		if perfectStreak[player] >= 5 and Config.Debug.LogSuspicious then
			warn(`[Forge] {player.Name}: {perfectStreak[player]} идеальных ковок подряд`)
		end
	else
		perfectStreak[player] = 0
	end

	local def = Config.Weapons[session.Type]
	local ore = Config.Ores[session.Ore]
	if InventoryService:IsFull(player) then
		return { ok = false, err = "ERR_INVENTORY_FULL" }
	end
	if not EconomyService:TrySpendOre(player, session.Ore, def.OreCost) then
		return { ok = false, err = "ERR_NOT_ENOUGH_ORE" }
	end
	local rarityId = rollRarity(quality, session.Ore)
	local rarity = Config.Rarities[rarityId]
	local weapon = InventoryService:AddWeapon(player, session.Type, session.Ore, quality, rarityId, rollTraits(rarity.Traits))
	if not weapon then
		EconomyService:AddOre(player, session.Ore, def.OreCost) -- вернуть руду
		return { ok = false, err = "ERR_INVENTORY_FULL" }
	end

	local data = DataService:Get(player)
	DataService:AddStat(player, "WeaponsForged", 1)
	if data and quality > (data.Stats.BestQuality or 0) then
		data.Stats.BestQuality = quality
	end
	LevelService:AddXp(player, F.XpBase + def.OreCost * ore.XpPerOre * F.XpOreFactor)

	local damage = WeaponMath.Damage(weapon)
	if data and damage > (data.Stats.BestDamage or 0) then
		data.Stats.BestDamage = damage
	end
	SystemService:Notify(
		player,
		"Forge",
		"SYS_FORGE_TITLE",
		if quality >= 95 then "SYS_FORGE_BODY_MASTER" else "SYS_FORGE_BODY",
		{
			-- имя оружия переводит клиент на своём языке
			weapon = `@WEAPON:{session.Type}:{session.Ore}`,
			rarity = "@" .. rarity.NameKey,
			quality = quality,
			damage = damage,
		}
	)

	-- редкое оружие: эффект у игрока, Mythic+ — объявление на весь сервер (моменты для видео)
	local root = Char.Root(player)
	if WeaponMath.RarityAtLeast(rarityId, F.CelebrateMinRarity) and root then
		NetService:FxNear(root.Position, 250, {
			Kind = "Celebrate",
			Position = root.Position,
			Rarity = rarityId,
			UserId = player.UserId,
		})
	end
	if WeaponMath.RarityAtLeast(rarityId, F.AnnounceMinRarity) then
		DataService:AddStat(player, "MythicForged", 1)
		SystemService:Announce("Legendary", "SYS_ANNOUNCE_FORGE_TITLE", "SYS_ANNOUNCE_FORGE_BODY", {
			name = player.DisplayName,
			rarity = "@" .. rarity.NameKey,
			weapon = `@WEAPON:{session.Type}:{session.Ore}`,
			damage = damage,
		})
	end

	ProgressService:Record(player, "WeaponForged")
	if quality >= 80 then
		ProgressService:Record(player, "QualityForge80")
	end

	return {
		ok = true,
		weapon = weapon,
		quality = quality,
		damage = damage,
		scores = { Bellows = sb, Pour = sp, Hammer = sh },
	}
end

local function setupForge(instance: Instance)
	local anchor = Proximity.AnchorPart(instance)
	if not anchor or anchor:FindFirstChild("GamePrompt") then
		return
	end
	local prompt = Prompts.Create(anchor, "PROMPT_FORGE", { Distance = 12 })
	prompt.Triggered:Connect(function(player: Player)
		if DataService:IsLoaded(player) then
			NetService:Fire(player, "OpenPanel", { Panel = "Forge" })
		end
	end)
end

function ForgeService:Start()
	NetService:OnInvoke("ForgeStart", startForge)
	NetService:OnInvoke("ForgeSubmit", submitForge)
	NetService:OnEvent("ForgeCancel", function(player: Player)
		sessions[player] = nil
	end)

	for _, instance in CollectionService:GetTagged(Config.Tags.Forge) do
		setupForge(instance)
	end
	CollectionService:GetInstanceAddedSignal(Config.Tags.Forge):Connect(setupForge)

	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
		perfectStreak[player] = nil
	end)
end

return ForgeService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">GateService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ВРАТА (ДАНЖИ).
	1. По таймеру на точке с тегом "GateSpawn" открывается портал (объявление на весь сервер).
	2. Игроки жмут «Войти во Врата» → группа до 4 человек, обратный отсчёт; лидер может начать раньше.
	3. Группа переносится на свою арену (далеко от лобби, слоты не пересекаются), волны мобов → босс.
	4. Победа: награда всем участникам (+бонус за группу). Поражение: все пали или вышло время.
	Портал одноразовый: после старта забега он исчезает.
]]

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Char = require(script.Parent.Parent.Util.Char)
local Prompts = require(script.Parent.Parent.Util.Prompts)
local Stud = require(script.Parent.Parent.World.Stud)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local LevelService = require(script.Parent.LevelService)
local MobService = require(script.Parent.MobService)
local NetService = require(script.Parent.NetService)
local SystemService = require(script.Parent.SystemService)
local ProgressService = require(script.Parent.ProgressService)

local GateService = {}

local G = Config.Gates

type Portal = {
	Id: string,
	Gate: any,
	IsRed: boolean,
	Part: BasePart,
	Label: TextLabel,
	SpawnPoint: Instance?,
	ExpiresAt: number,
	Party: { Player },
	CountdownEndsAt: number?,
	State: string, -- open | closed
}

type Arena = {
	Root: Instance,
	Center: Vector3,
	Size: number,
	PlayerSpawns: { CFrame },
	MobSpawns: { CFrame },
}

type Run = {
	Id: string,
	Gate: any,
	IsRed: boolean,
	Slot: number,
	Arena: Arena,
	Players: { Player },
	Dead: { [Player]: boolean },
	Wave: number,
	Mobs: { [any]: boolean },
	Boss: any?,
	BossPhase: boolean,
	EndsAt: number,
	State: string, -- fighting | ended
	ReturnCFrame: CFrame,
	LastBossUpdate: number,
}

local portals: { Portal } = {}
local runs: { [string]: Run } = {}
local playerPortal: { [Player]: Portal } = {}
local playerRun: { [Player]: Run } = {}
local slots: { [number]: Run } = {}
local arenas: { [string]: Arena } = {}
local rng = Random.new()

local arenasFolder: Folder
local portalsFolder: Folder

local function now(): number
	return workspace:GetServerTimeNow()
end

local function partyBonus(count: number): number
	return 1 + math.max(0, count - 1) * G.PartyXpBonusPerPlayer
end

-- ===== Арены =====

local function collectSpawns(root: Instance, name: string): { CFrame }
	local list = {}
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") and d.Name == name then
			table.insert(list, d.CFrame + Vector3.new(0, 3, 0))
			d.Transparency = 1
			d.CanCollide = false
		end
	end
	return list
end

-- Запасная арена в стад-стиле: каменный пол со светлой серединой, ярусные стены, жаровни по углам
local function buildFallbackArena(origin: Vector3): Instance
	local size = G.Arena.FallbackSize
	local model = Instance.new("Model")
	model.Name = "FallbackArena"
	local SC = Stud.Color

	Stud.brick(model, Vector3.new(size, 2, size), CFrame.new(origin), SC.StoneDark, { Name = "Floor" })
	Stud.brick(model, Vector3.new(size - 24, 0.4, size - 24), CFrame.new(origin + Vector3.new(0, 1.2, 0)), SC.Stone, { Pattern = "StudsNoGrid" })
	local half = size / 2
	for _, side in {
		{ Vector3.new(0, 0, -half), Vector3.new(size, 0, 4) },
		{ Vector3.new(0, 0, half), Vector3.new(size, 0, 4) },
		{ Vector3.new(half, 0, 0), Vector3.new(4, 0, size) },
		{ Vector3.new(-half, 0, 0), Vector3.new(4, 0, size) },
	} do
		local at, span = side[1], side[2]
		Stud.brick(model, Vector3.new(span.X, 10, span.Z), CFrame.new(origin + at + Vector3.new(0, 6, 0)), SC.StoneDark)
		Stud.brick(model, Vector3.new(span.X * 0.98 + 0.1, 6, span.Z * 0.6 + 0.1), CFrame.new(origin + at + Vector3.new(0, 14, 0)), SC.Stone)
		Stud.brick(model, Vector3.new(span.X + 0.6, 0.6, span.Z * 0.6 + 0.8), CFrame.new(origin + at + Vector3.new(0, 17.3, 0)), SC.StoneLight, { Pattern = "StudsNoGrid" })
	end
	-- жаровни по углам: единственный светящийся акцент арены
	for _, cx in { -1, 1 } do
		for _, cz in { -1, 1 } do
			local p = origin + Vector3.new(cx * (half - 8), 1, cz * (half - 8))
			Stud.brick(model, Vector3.new(3, 3, 3), CFrame.new(p + Vector3.new(0, 1.5, 0)), SC.Iron, { Pattern = "Weld" })
			local fire = Stud.brick(model, Vector3.new(2, 0.4, 2), CFrame.new(p + Vector3.new(0, 3.2, 0)), SC.Ember, { Neon = true, Collide = false })
			local l = Instance.new("PointLight")
			l.Color = Color3.fromRGB(255, 150, 70)
			l.Range = 30
			l.Brightness = 2
			l.Parent = fire
		end
	end

	for i = 1, 4 do
		local x = (i - 2.5) * 6
		Stud.brick(model, Vector3.new(2, 1, 2), CFrame.new(origin + Vector3.new(x, 1.5, half - 15)), SC.White, { Name = "PlayerSpawn" })
	end
	for i = 1, 6 do
		local x = (i - 3.5) * 14
		Stud.brick(model, Vector3.new(2, 1, 2), CFrame.new(origin + Vector3.new(x, 1.5, -half + 20)), SC.White, { Name = "MobSpawn" })
	end
	return model
end

local function getArena(slot: number, gate: any): Arena
	local key = `{slot}:{gate.Arena}`
	local cached = arenas[key]
	if cached then
		return cached
	end
	local origin = G.Arena.Origin + Vector3.new(G.Arena.SlotSpacing * (slot - 1), 0, 0)
	local folder = ServerStorage:FindFirstChild("Arenas")
	local template = folder and folder:FindFirstChild(gate.Arena)
	local root: Instance
	local size = G.Arena.FallbackSize
	if template and template:IsA("Model") then
		local model = template:Clone()
		model:PivotTo(CFrame.new(origin))
		local _, extents = model:GetBoundingBox()
		size = math.max(extents.X, extents.Z)
		root = model
	else
		root = buildFallbackArena(origin)
	end
	-- арену держим загруженной у клиентов целиком, когда они рядом
	if root:IsA("Model") then
		root.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end
	root.Parent = arenasFolder

	local arena: Arena = {
		Root = root,
		Center = origin,
		Size = size,
		PlayerSpawns = collectSpawns(root, "PlayerSpawn"),
		MobSpawns = collectSpawns(root, "MobSpawn"),
	}
	if #arena.PlayerSpawns == 0 then
		arena.PlayerSpawns = { CFrame.new(origin + Vector3.new(0, 5, size / 3)) }
	end
	if #arena.MobSpawns == 0 then
		arena.MobSpawns = { CFrame.new(origin + Vector3.new(0, 5, -size / 3)) }
	end
	arenas[key] = arena
	return arena
end

local function freeSlot(): number?
	for i = 1, G.Arena.MaxConcurrentRuns do
		if slots[i] == nil then
			return i
		end
	end
	return nil
end

-- ===== Состояние для клиента =====

local function sendLobbyState(portal: Portal)
	local t = now()
	for i, player in portal.Party do
		NetService:Fire(player, "GateState", {
			Phase = "lobby",
			IsRed = portal.IsRed,
			GateNameKey = portal.Gate.NameKey,
			Rank = portal.Gate.Rank,
			Count = #portal.Party,
			Max = G.MaxPartySize,
			StartsIn = if portal.CountdownEndsAt then math.max(0, portal.CountdownEndsAt - t) else nil,
			IsLeader = i == 1,
		})
	end
end

local function activeMembers(run: Run): { Player }
	local list = {}
	for _, player in run.Players do
		if playerRun[player] == run and player.Parent == Players then
			table.insert(list, player)
		end
	end
	return list
end

local function sendRunState(run: Run)
	local members = activeMembers(run)
	local alive = 0
	for _, player in members do
		if not run.Dead[player] then
			alive += 1
		end
	end
	local boss = run.Boss
	NetService:FireList(members, "GateState", {
		Phase = "run",
		IsRed = run.IsRed,
		GateNameKey = run.Gate.NameKey,
		Rank = run.Gate.Rank,
		Wave = run.Wave,
		TotalWaves = #run.Gate.Waves,
		BossPhase = run.BossPhase,
		TimeLeft = math.max(0, run.EndsAt - now()),
		Alive = alive,
		Total = #members,
		Boss = if boss
			then { NameKey = boss.Def.NameKey, Health = boss.Health, MaxHealth = boss.MaxHealth }
			else nil,
	})
end

-- ===== Порталы =====

local function removeFromParty(player: Player, toastKey: string?)
	local portal = playerPortal[player]
	if not portal then
		return
	end
	playerPortal[player] = nil
	local index = table.find(portal.Party, player)
	if index then
		table.remove(portal.Party, index)
	end
	if #portal.Party == 0 then
		portal.CountdownEndsAt = nil
	end
	if player.Parent == Players then
		NetService:Fire(player, "GateState", { Phase = "none" })
		if toastKey then
			SystemService:Toast(player, toastKey)
		end
	end
	sendLobbyState(portal)
end

local function closePortal(portal: Portal)
	portal.State = "closed"
	local index = table.find(portals, portal)
	if index then
		table.remove(portals, index)
	end
	for _, player in table.clone(portal.Party) do
		removeFromParty(player, "TOAST_GATE_CLOSED")
	end
	portal.Part:Destroy()
end

local function pickGateType(): any
	local total = 0
	for _, gate in G.Types do
		total += gate.SpawnWeight
	end
	local roll = rng:NextNumber(0, total)
	local last = nil
	for _, gate in G.Types do
		last = gate
		roll -= gate.SpawnWeight
		if roll <= 0 then
			return gate
		end
	end
	return last
end

local warnedNoSpawns = false

local function spawnPortal()
	local used: { [Instance]: boolean } = {}
	for _, other in portals do
		if other.SpawnPoint then
			used[other.SpawnPoint] = true
		end
	end
	local candidates = {}
	for _, point in CollectionService:GetTagged(Config.Tags.GateSpawn) do
		if point:IsA("BasePart") and point:IsDescendantOf(workspace) and not used[point] then
			table.insert(candidates, point)
		end
	end

	local point: BasePart? = nil
	local baseCFrame: CFrame
	if #candidates > 0 then
		point = candidates[rng:NextInteger(1, #candidates)]
		baseCFrame = (point :: BasePart).CFrame
	else
		if #CollectionService:GetTagged(Config.Tags.GateSpawn) > 0 then
			return -- все точки заняты
		end
		if not warnedNoSpawns then
			warnedNoSpawns = true
			warn("[Gates] Нет Part с тегом GateSpawn — портал появится возле центра карты")
		end
		if #portals > 0 then
			return
		end
		baseCFrame = CFrame.new(0, 0.5, 45)
	end

	-- новичкам всегда должны быть доступны Врата самого низкого ранга
	local easiest: any = nil
	for _, g in G.Types do
		if not easiest or g.RequiredLevel < easiest.RequiredLevel then
			easiest = g
		end
	end
	local hasEasy = false
	for _, other in portals do
		if other.Gate == easiest then
			hasEasy = true
		end
	end
	local gate = if hasEasy then pickGateType() else easiest
	if not gate then
		return
	end
	local isRed = rng:NextNumber() < G.RedGate.Chance
	local color = if isRed then G.RedGate.Color else gate.PortalColor

	local part = Instance.new("Part")
	part.Name = "GatePortal"
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(0.8, 11, 11)
	part.CFrame = baseCFrame * CFrame.new(0, 6, 0)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = true
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.2
	part:SetAttribute("GateType", gate.Id)

	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 18
	light.Brightness = 3
	light.Parent = part

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(160, 50)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 7.5, 0)
	billboard.MaxDistance = 200
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Text = `[{gate.Rank}]`
	label.TextColor3 = if isRed then Color3.fromRGB(255, 90, 90) else Color3.new(1, 1, 1)
	label.Parent = billboard
	billboard.Parent = part

	local portal: Portal = {
		Id = HttpService:GenerateGUID(false),
		Gate = gate,
		IsRed = isRed,
		Part = part,
		Label = label,
		SpawnPoint = point,
		ExpiresAt = now() + G.PortalLifetimeSeconds,
		Party = {},
		CountdownEndsAt = nil,
		State = "open",
	}

	local prompt = Prompts.Create(part, "PROMPT_ENTER_GATE", { ObjectKey = gate.NameKey, Distance = 14 })
	prompt.Triggered:Connect(function(player: Player)
		GateService:Join(player, portal)
	end)

	part.Parent = portalsFolder
	CollectionService:AddTag(part, Config.Tags.GatePortal)
	table.insert(portals, portal)

	if isRed then
		SystemService:Announce("Warning", "SYS_REDGATE_TITLE", "SYS_REDGATE_BODY", {
			gate = "@" .. gate.NameKey,
			mult = G.RedGate.RewardMult,
		})
	else
		SystemService:Announce("Info", "SYS_GATE_OPEN_TITLE", "SYS_GATE_OPEN_BODY", {
			gate = "@" .. gate.NameKey,
			minutes = math.floor(G.PortalLifetimeSeconds / 60),
		})
	end
end

function GateService:Join(player: Player, portal: Portal)
	local data = DataService:Get(player)
	if not data or not Char.IsAlive(player) then
		return
	end
	if playerRun[player] then
		SystemService:Error(player, "ERR_IN_GATE")
		return
	end
	if portal.State ~= "open" then
		SystemService:Error(player, "ERR_GATE_BUSY")
		return
	end
	if playerPortal[player] == portal then
		sendLobbyState(portal)
		return
	end
	if data.Level < portal.Gate.RequiredLevel then
		SystemService:Error(player, "ERR_LEVEL_LOW", { level = portal.Gate.RequiredLevel })
		return
	end
	if #portal.Party >= G.MaxPartySize then
		SystemService:Error(player, "ERR_PARTY_FULL")
		return
	end
	if playerPortal[player] then
		removeFromParty(player)
	end

	local others = table.clone(portal.Party)
	table.insert(portal.Party, player)
	playerPortal[player] = portal
	if not portal.CountdownEndsAt then
		portal.CountdownEndsAt = now() + G.LobbyCountdownSeconds
	end
	SystemService:Toast(player, "TOAST_JOINED_PARTY")
	SystemService:ToastList(others, "TOAST_PARTY_JOINED", { name = player.DisplayName })
	sendLobbyState(portal)
end

-- ===== Забег =====

local function teleport(player: Player, cframe: CFrame)
	local character = player.Character
	if not character or not Char.IsAlive(player) then
		return
	end
	pcall(function()
		player:RequestStreamAroundAsync(cframe.Position, 5)
	end)
	if player.Character == character then
		character:PivotTo(cframe)
	end
end

local function runTargets(run: Run): { Player }
	local list = {}
	local radius = run.Arena.Size
	for _, player in run.Players do
		if playerRun[player] == run and not run.Dead[player] then
			local root = Char.Root(player)
			if root and (root.Position - run.Arena.Center).Magnitude < radius then
				table.insert(list, player)
			end
		end
	end
	return list
end

local function randomMobSpawn(run: Run): CFrame
	local spawns = run.Arena.MobSpawns
	local base = spawns[rng:NextInteger(1, #spawns)]
	return base * CFrame.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4))
end

local function spawnWave(run: Run, index: number)
	if run.State ~= "fighting" then
		return
	end
	run.Wave = index
	local healthMult = (1 + math.max(0, #activeMembers(run) - 1) * G.HealthPerExtraPlayer)
		* (if run.IsRed then G.RedGate.HealthMult else 1)
	local damageMult = if run.IsRed then G.RedGate.DamageMult else 1
	for _, entry in run.Gate.Waves[index] do
		for _ = 1, entry.Count do
			local mob = MobService:Spawn(entry.Mob, randomMobSpawn(run), {
				RunId = run.Id,
				HealthMult = healthMult,
				DamageMult = damageMult,
				GetTargets = function()
					return runTargets(run)
				end,
			})
			if mob then
				run.Mobs[mob] = true
			end
		end
	end
	SystemService:ToastList(activeMembers(run), "TOAST_WAVE", { wave = index, total = #run.Gate.Waves })
	sendRunState(run)
end

local function spawnBoss(run: Run)
	if run.State ~= "fighting" then
		return
	end
	run.BossPhase = true
	local healthMult = (1 + math.max(0, #activeMembers(run) - 1) * G.HealthPerExtraPlayer)
		* (if run.IsRed then G.RedGate.HealthMult else 1)
	local damageMult = if run.IsRed then G.RedGate.DamageMult else 1
	local boss = MobService:Spawn(run.Gate.Boss, CFrame.new(run.Arena.Center + Vector3.new(0, 6, -run.Arena.Size / 4)), {
		RunId = run.Id,
		HealthMult = healthMult,
		DamageMult = damageMult,
		GetTargets = function()
			return runTargets(run)
		end,
	})
	if not boss then
		return
	end
	run.Boss = boss
	run.Mobs[boss] = true
	SystemService:NotifyList(activeMembers(run), "Boss", "SYS_BOSS_TITLE", "SYS_BOSS_BODY", {
		boss = "@" .. boss.Def.NameKey,
	})
	sendRunState(run)
end

local function finishRun(run: Run, won: boolean)
	if run.State ~= "fighting" then
		return
	end
	run.State = "ended"
	MobService:DespawnRun(run.Id)

	local members = activeMembers(run)
	local gate = run.Gate
	if won then
		local bonus = partyBonus(#members)
		for _, player in members do
			local rewardMult = if run.IsRed then G.RedGate.RewardMult else 1
			local gold = math.floor(gate.Rewards.Gold * rewardMult)
			local xp = math.floor(gate.Rewards.Xp * bonus * rewardMult)
			EconomyService:AddGold(player, gold)
			LevelService:AddXp(player, xp)
			for _, drop in gate.Rewards.OreDrops do
				if rng:NextNumber() <= drop.Chance then
					local count = math.floor(rng:NextInteger(drop.Min, drop.Max) * rewardMult + 0.5)
					EconomyService:AddOre(player, drop.OreId, count)
					SystemService:Toast(player, "TOAST_ORE", {
						count = count,
						ore = "@" .. Config.Ores[drop.OreId].NameKey,
					}, "ore")
				end
			end
			DataService:AddStat(player, "GatesCleared", 1)
			DataService:AddStat(player, "BossesKilled", 1)
			SystemService:Notify(player, "GateCleared", gate.NameKey, "SYS_GATE_CLEARED_BODY", { gold = gold, xp = xp })
			ProgressService:Record(player, "GateCleared")
		end
	else
		SystemService:NotifyList(members, "GateFailed", gate.NameKey, "SYS_GATE_FAILED_BODY")
	end
	NetService:FireList(members, "GateState", { Phase = "ended", Won = won, GateNameKey = gate.NameKey })

	task.delay(G.ReturnDelaySeconds, function()
		for _, player in activeMembers(run) do
			playerRun[player] = nil
			local offset = CFrame.new(rng:NextNumber(-5, 5), 0, rng:NextNumber(-5, 5))
			teleport(player, run.ReturnCFrame * offset)
			NetService:Fire(player, "GateState", { Phase = "none" })
		end
		for _, player in run.Players do
			if playerRun[player] == run then
				playerRun[player] = nil
			end
		end
		slots[run.Slot] = nil
		runs[run.Id] = nil
	end)
end

local function startRun(portal: Portal)
	local slot = freeSlot()
	if not slot then
		portal.CountdownEndsAt = now() + 10
		SystemService:ToastList(portal.Party, "ERR_ARENAS_FULL", nil, "error")
		return
	end

	local members = {}
	for _, player in portal.Party do
		playerPortal[player] = nil
		if player.Parent == Players and Char.IsAlive(player) and not playerRun[player] then
			table.insert(members, player)
		end
	end
	portal.Party = {}
	local returnCFrame = portal.Part.CFrame * CFrame.new(0, -3, 8)
	closePortal(portal)
	if #members == 0 then
		return
	end

	local gate = portal.Gate
	local isRed = portal.IsRed
	local arena = getArena(slot, gate)
	local run: Run = {
		Id = HttpService:GenerateGUID(false),
		Gate = gate,
		IsRed = isRed,
		Slot = slot,
		Arena = arena,
		Players = members,
		Dead = {},
		Wave = 0,
		Mobs = {},
		Boss = nil,
		BossPhase = false,
		EndsAt = now() + G.RunTimeLimitSeconds + G.WaveStartDelaySeconds,
		State = "fighting",
		ReturnCFrame = returnCFrame,
		LastBossUpdate = 0,
	}
	slots[slot] = run
	runs[run.Id] = run

	for i, player in members do
		playerRun[player] = run
		local spawnCf = arena.PlayerSpawns[((i - 1) % #arena.PlayerSpawns) + 1]
		task.spawn(teleport, player, spawnCf)
		ProgressService:Record(player, "GateEntered")
	end
	sendRunState(run)
	task.delay(G.WaveStartDelaySeconds, spawnWave, run, 1)
end

local function leave(player: Player)
	if playerPortal[player] then
		removeFromParty(player, "TOAST_LEFT_PARTY")
		return
	end
	local run = playerRun[player]
	if run then
		playerRun[player] = nil
		NetService:Fire(player, "GateState", { Phase = "none" })
		if run.State == "fighting" then
			teleport(player, run.ReturnCFrame)
			if #activeMembers(run) == 0 then
				finishRun(run, false)
			else
				sendRunState(run)
			end
		end
	end
end

-- ===== Подписки =====

local function onMobDied(mob: any, killer: Player?)
	local run = runs[mob.RunId]
	if not run or run.State ~= "fighting" then
		return
	end
	run.Mobs[mob] = nil
	if killer and playerRun[killer] == run then
		local bonus = partyBonus(#activeMembers(run))
		LevelService:AddXp(killer, mob.Def.XpReward * bonus)
		EconomyService:AddGold(killer, mob.Def.GoldReward)
		DataService:AddStat(killer, "MobsKilled", 1)
		ProgressService:Record(killer, "MobKilled")
	end

	if mob == run.Boss then
		run.Boss = nil
		finishRun(run, true)
		return
	end
	if next(run.Mobs) == nil then
		if run.Wave < #run.Gate.Waves then
			task.delay(1.5, spawnWave, run, run.Wave + 1)
		elseif not run.BossPhase then
			task.delay(1.5, spawnBoss, run)
		end
	end
	sendRunState(run)
end

local function onMobDamaged(mob: any)
	local run = runs[mob.RunId]
	if not run or mob ~= run.Boss then
		return
	end
	local t = os.clock()
	if t - run.LastBossUpdate < 0.2 then
		return
	end
	run.LastBossUpdate = t
	sendRunState(run)
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	humanoid.Died:Connect(function()
		local run = playerRun[player]
		if not run or run.State ~= "fighting" then
			return
		end
		run.Dead[player] = true
		SystemService:Toast(player, "TOAST_DIED")
		local anyAlive = false
		for _, member in activeMembers(run) do
			if not run.Dead[member] then
				anyAlive = true
				break
			end
		end
		if anyAlive then
			sendRunState(run)
		else
			finishRun(run, false)
		end
	end)
end

local function tick()
	local t = now()

	for _, portal in table.clone(portals) do
		if portal.State ~= "open" then
			continue
		end
		for _, player in table.clone(portal.Party) do
			local root = Char.Root(player)
			if player.Parent ~= Players or not root or (root.Position - portal.Part.Position).Magnitude > G.LobbyLeaveRadius then
				removeFromParty(player, "TOAST_LEFT_PARTY")
			end
		end
		if portal.CountdownEndsAt and #portal.Party > 0 then
			if t >= portal.CountdownEndsAt then
				startRun(portal)
				continue
			end
			portal.Label.Text = `[{portal.Gate.Rank}{if portal.IsRed then "!" else ""}]  {Format.Time(portal.CountdownEndsAt - t)}`
			sendLobbyState(portal)
		elseif t >= portal.ExpiresAt then
			closePortal(portal)
		else
			portal.Label.Text = `[{portal.Gate.Rank}{if portal.IsRed then "!" else ""}]  {Format.Time(portal.ExpiresAt - t)}`
		end
	end

	for _, run in runs do
		if run.State == "fighting" then
			if t >= run.EndsAt or #activeMembers(run) == 0 then
				finishRun(run, false)
			else
				sendRunState(run)
			end
		end
	end
end

function GateService:Init()
	arenasFolder = Instance.new("Folder")
	arenasFolder.Name = "GateArenas"
	arenasFolder.Parent = workspace
	portalsFolder = Instance.new("Folder")
	portalsFolder.Name = "GatePortals"
	portalsFolder.Parent = workspace
end

function GateService:Start()
	NetService:OnEvent("GateLeave", leave)
	NetService:OnEvent("GateStart", function(player: Player)
		local portal = playerPortal[player]
		if not portal or portal.State ~= "open" then
			return
		end
		if portal.Party[1] ~= player then
			SystemService:Error(player, "ERR_NOT_LEADER")
			return
		end
		startRun(portal)
	end)

	MobService.MobDied:Connect(onMobDied)
	MobService.MobDamaged:Connect(onMobDamaged)

	local function hookPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
		if player.Character then
			task.spawn(onCharacterAdded, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(hookPlayer)
	for _, player in Players:GetPlayers() do
		hookPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		leave(player)
		playerPortal[player] = nil
		playerRun[player] = nil
	end)

	task.spawn(function()
		local firstDelay = G.FirstSpawnDelaySeconds
		if RunService:IsStudio() and Config.Debug.StudioFastGates then
			firstDelay = 5
		end
		local nextSpawnAt = now() + firstDelay
		while true do
			task.wait(1)
			local ok, err = pcall(tick)
			if not ok then
				warn(`[Gates] {err}`)
			end
			if now() >= nextSpawnAt then
				nextSpawnAt = now() + G.SpawnIntervalSeconds
				if #portals < G.MaxActivePortals then
					local spawned, spawnErr = pcall(spawnPortal)
					if not spawned then
						warn(`[Gates] {spawnErr}`)
					end
				end
			end
		end
	end)
end

return GateService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ИНВЕНТАРЬ: оружие (по уникальному GUID), надетое оружие и его модель в руке, кирки.
	Модель оружия: ServerStorage/WeaponModels/<Type> (Model или BasePart).
	В модели можно добавить Attachment "Grip" в главную часть — за него оружие берётся в руку.
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)
local Guards = require(script.Parent.Parent.Util.Guards)
local DataService = require(script.Parent.DataService)
local NetService = require(script.Parent.NetService)
local ProgressService = require(script.Parent.ProgressService)

local InventoryService = {}

local VISUAL_NAME = "EquippedWeapon"

function InventoryService:Capacity(_player: Player): number
	return Config.Economy.InventoryCapacity -- Этап 3: x2 за геймпасс
end

function InventoryService:Count(player: Player): number
	local data = DataService:Get(player)
	if not data then
		return 0
	end
	local n = 0
	for _ in data.Weapons do
		n += 1
	end
	return n
end

function InventoryService:IsFull(player: Player): boolean
	return InventoryService:Count(player) >= InventoryService:Capacity(player)
end

function InventoryService:AddWeapon(
	player: Player,
	weaponType: string,
	oreId: string,
	quality: number,
	rarity: string,
	traits: { string }?
): Types.WeaponData?
	local data = DataService:Get(player)
	if not data or InventoryService:IsFull(player) then
		return nil
	end
	local weapon: Types.WeaponData = {
		Id = HttpService:GenerateGUID(false),
		Type = weaponType,
		Ore = oreId,
		Quality = math.clamp(math.floor(quality), 0, 100),
		Rarity = rarity,
		Traits = traits or {},
		Xp = 0,
		CreatedAt = os.time(),
	}
	data.Weapons[weapon.Id] = weapon
	DataService:Replicate(player, "Weapons")
	return weapon
end

-- Удаляет оружие и возвращает его (или nil). Надетое снимается.
-- silent = true → не отправлять клиенту (для пакетной продажи; вызывающий сам сделает Replicate)
function InventoryService:RemoveWeapon(player: Player, weaponId: string, silent: boolean?): Types.WeaponData?
	local data = DataService:Get(player)
	if not data then
		return nil
	end
	local weapon = data.Weapons[weaponId]
	if not weapon then
		return nil
	end
	data.Weapons[weaponId] = nil
	data.Shop.Listings[weaponId] = nil
	if data.EquippedWeapon == weaponId then
		data.EquippedWeapon = ""
		InventoryService:RefreshVisual(player)
	end
	if not silent then
		DataService:Replicate(player, "Weapons", "EquippedWeapon")
	end
	return weapon
end

function InventoryService:IsListed(player: Player, weaponId: string): boolean
	local data = DataService:Get(player)
	return data ~= nil and data.Shop.Listings[weaponId] ~= nil
end

-- Можно ли отдать оружие другому игроку (обмен): своё, не надето, не в лавке
function InventoryService:CanTransfer(player: Player, weaponId: string): boolean
	local data = DataService:Get(player)
	return data ~= nil
		and data.Weapons[weaponId] ~= nil
		and data.EquippedWeapon ~= weaponId
		and data.Shop.Listings[weaponId] == nil
end

-- Передача между игроками: оружие переходит с тем же Id.
-- Вызывается только из TradeService/ShopService внутри одного блока без yield.
function InventoryService:TakeForTransfer(player: Player, weaponId: string): Types.WeaponData?
	local data = DataService:Get(player)
	if not data then
		return nil
	end
	local weapon = data.Weapons[weaponId]
	if not weapon then
		return nil
	end
	data.Weapons[weaponId] = nil
	data.Shop.Listings[weaponId] = nil
	if data.EquippedWeapon == weaponId then
		data.EquippedWeapon = ""
		InventoryService:RefreshVisual(player)
	end
	return weapon
end

function InventoryService:GiveTransferred(player: Player, weapon: Types.WeaponData): boolean
	local data = DataService:Get(player)
	if not data or data.Weapons[weapon.Id] ~= nil then
		-- тот же Id уже есть у получателя: это был бы дюп
		warn(`[Inventory] отказ: {player.Name} уже владеет {weapon.Id}`)
		return false
	end
	data.Weapons[weapon.Id] = table.clone(weapon)
	return true
end

function InventoryService:GetEquipped(player: Player): Types.WeaponData?
	local data = DataService:Get(player)
	if not data or data.EquippedWeapon == "" then
		return nil
	end
	return data.Weapons[data.EquippedWeapon]
end

local buildVisual: (weapon: Types.WeaponData) -> (Instance?, BasePart?)

-- Модель оружия для витрины лавки (без сварки с рукой)
function InventoryService:BuildWeaponVisual(weapon: Types.WeaponData): (Instance?, BasePart?)
	return buildVisual(weapon)
end

function buildVisual(weapon: Types.WeaponData): (Instance?, BasePart?)
	local def = Config.Weapons[weapon.Type]
	if not def then
		return nil, nil
	end
	local folder = ServerStorage:FindFirstChild("WeaponModels")
	local template = folder and folder:FindFirstChild(weapon.Type)
	local root: Instance
	local primary: BasePart?

	if template and (template:IsA("Model") or template:IsA("BasePart")) then
		root = template:Clone()
		if root:IsA("BasePart") then
			primary = root
		else
			local model = root :: Model
			primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
		end
	else
		-- заглушка: цвет руды
		local ore = Config.Ores[weapon.Ore]
		local part = Instance.new("Part")
		part.Size = def.Size
		part.Material = Enum.Material.Plastic -- стад-стиль: пластик с узором Weld
		part.TopSurface = Enum.SurfaceType.Weld
		part.BottomSurface = Enum.SurfaceType.Weld
		part.Color = if ore then ore.Color else Color3.new(0.7, 0.7, 0.7)
		root = part
		primary = part
	end

	if not primary then
		root:Destroy()
		return nil, nil
	end

	local parts: { BasePart } = {}
	if root:IsA("BasePart") then
		table.insert(parts, root)
	end
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end
	for _, part in parts do
		part.Anchored = false
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		if part ~= primary then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = primary
			weld.Part1 = part
			weld.Parent = part
		end
	end
	root.Name = VISUAL_NAME
	return root, primary
end

function InventoryService:RefreshVisual(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local old = character:FindFirstChild(VISUAL_NAME)
	if old then
		old:Destroy()
	end
	local weapon = InventoryService:GetEquipped(player)
	if not weapon then
		return
	end
	local hand = (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")) :: BasePart?
	if not hand then
		return
	end
	local visual, primary = buildVisual(weapon)
	if not visual or not primary then
		return
	end
	local weld = Instance.new("Weld")
	weld.Part0 = hand
	weld.Part1 = primary
	weld.C0 = CFrame.new(0, -hand.Size.Y / 2, 0)
	local grip = primary:FindFirstChild("Grip")
	if grip and grip:IsA("Attachment") then
		weld.C1 = grip.CFrame
	else
		-- клинок торчит вперёд из кулака
		weld.C1 = CFrame.new(0, 0, primary.Size.Z / 2 - 0.4)
	end
	weld.Parent = primary

	-- аура редкого оружия (Epic+): частицы цвета редкости, у Divine ещё и свет
	local rarity = Config.Rarities[weapon.Rarity]
	if rarity and rarity.Order >= 3 then
		local aura = Instance.new("ParticleEmitter")
		aura.Name = "RarityAura"
		aura.Color = ColorSequence.new(rarity.Color)
		aura.LightEmission = 1
		aura.Rate = 4 + rarity.Order * 3
		aura.Lifetime = NumberRange.new(0.4, 0.8)
		aura.Speed = NumberRange.new(0.5, 1.5)
		aura.Size = NumberSequence.new(0.25, 0)
		aura.SpreadAngle = Vector2.new(180, 180)
		aura.Parent = primary
		if rarity.Order >= 6 then
			local glow = Instance.new("PointLight")
			glow.Color = rarity.Color
			glow.Range = 8
			glow.Brightness = 1.5
			glow.Parent = primary
		end
	end
	visual.Parent = character
end

function InventoryService:Equip(player: Player, weaponId: string): (boolean, string?)
	local data = DataService:Get(player)
	if not data then
		return false, "ERR_NOT_LOADED"
	end
	local weapon = data.Weapons[weaponId]
	if not weapon then
		return false, "ERR_UNKNOWN_ITEM"
	end
	if data.Shop.Listings[weaponId] then
		return false, "ERR_LISTED"
	end
	data.EquippedWeapon = weaponId
	DataService:Replicate(player, "EquippedWeapon")
	InventoryService:RefreshVisual(player)
	ProgressService:Record(player, "WeaponEquipped")
	return true, nil
end

function InventoryService:Start()
	NetService:OnInvoke("EquipWeapon", function(player: Player, weaponId: any)
		if not Guards.String(weaponId, 64) then
			return { ok = false, err = "ERR_BAD_REQUEST" }
		end
		local ok, err = InventoryService:Equip(player, weaponId)
		return { ok = ok, err = err }
	end)

	NetService:OnInvoke("EquipPickaxe", function(player: Player, pickaxeId: any)
		local data = DataService:Get(player)
		if not data then
			return { ok = false, err = "ERR_NOT_LOADED" }
		end
		if not Guards.String(pickaxeId, 32) or not Config.Pickaxes[pickaxeId] then
			return { ok = false, err = "ERR_BAD_REQUEST" }
		end
		if not data.OwnedPickaxes[pickaxeId] then
			return { ok = false, err = "ERR_NOT_OWNED" }
		end
		data.Pickaxe = pickaxeId
		DataService:Replicate(player, "Pickaxe")
		return { ok = true }
	end)

	DataService.Loaded:Connect(function(player: Player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("RightHand", 5)
			InventoryService:RefreshVisual(player)
		end)
		if player.Character then
			InventoryService:RefreshVisual(player)
		end
	end)
end

return InventoryService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ГЛОБАЛЬНЫЕ ЛИДЕРБОРДЫ (OrderedDataStore): уровень, сильнейшее оружие, зачищенные Врата.
	Доски — Part с тегом "Leaderboard" и атрибутом Board = "Level" | "Damage" | "Gates".
	Без доступа к API (Studio без «Enable API Services») просто показывает «Ждём данные».
]]

local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)

local LeaderboardService = {}

type Board = { Id: string, TitleKey: string, Store: OrderedDataStore?, Value: (data: any) -> number, Format: (v: number) -> string }

local BOARDS: { Board } = {
	{
		Id = "Level",
		TitleKey = "LB_LEVEL",
		Store = nil,
		-- уровень * 1e6 + опыт: сортировка и по уровню, и по прогрессу внутри уровня
		Value = function(data)
			return data.Level * 1000000 + math.min(data.Xp, 999999)
		end,
		Format = function(v)
			return "Lv. " .. tostring(v // 1000000)
		end,
	},
	{
		Id = "Damage",
		TitleKey = "LB_DAMAGE",
		Store = nil,
		Value = function(data)
			return data.Stats.BestDamage or 0
		end,
		Format = function(v)
			return tostring(v)
		end,
	},
	{
		Id = "Gates",
		TitleKey = "LB_GATES",
		Store = nil,
		Value = function(data)
			return data.Stats.GatesCleared or 0
		end,
		Format = function(v)
			return tostring(v)
		end,
	},
}

local REFRESH_SECONDS = 120
local SAVE_SECONDS = 300
local nameCache: { [number]: string } = {}
local available = true

local function nameOf(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if ok and name then name else "#" .. userId
	nameCache[userId] = result
	return result
end

local function buildSurface(part: BasePart, board: Board): { TextLabel }
	local old = part:FindFirstChild("BoardGui")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.MaxDistance = 120

	local title = Instance.new("TextLabel")
	title.Size = UDim2.fromScale(1, 0.13)
	title.BackgroundColor3 = Color3.fromRGB(38, 36, 33)
	title.BorderSizePixel = 0
	title.Font = Enum.Font.GothamMedium
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(239, 233, 222)
	title.Text = board.TitleKey
	title:SetAttribute("LocKey", board.TitleKey) -- переводит клиент
	title.Parent = gui

	local rows = {}
	for i = 1, 10 do
		local row = Instance.new("TextLabel")
		row.Size = UDim2.fromScale(0.94, 0.08)
		row.Position = UDim2.fromScale(0.03, 0.15 + (i - 1) * 0.085)
		row.BackgroundTransparency = 1
		row.Font = if i <= 3 then Enum.Font.GothamMedium else Enum.Font.Gotham
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		-- первое место цветом углей, остальные — основной и второстепенный текст
		row.TextColor3 = if i == 1
			then Color3.fromRGB(238, 137, 64)
			elseif i <= 3 then Color3.fromRGB(239, 233, 222)
			else Color3.fromRGB(170, 163, 152)
		row.Text = if i == 1 then "LB_EMPTY" else ""
		if i == 1 then
			row:SetAttribute("LocKey", "LB_EMPTY")
		end
		row.Parent = gui
		table.insert(rows, row)
	end
	gui.Parent = part
	return rows
end

local function boardParts(id: string): { BasePart }
	local list = {}
	for _, inst in CollectionService:GetTagged(Config.Tags.Leaderboard) do
		if inst:IsA("BasePart") and inst:GetAttribute("Board") == id then
			table.insert(list, inst)
		end
	end
	return list
end

local function save(player: Player, data: any?)
	if not available then
		return
	end
	data = data or DataService:Get(player)
	if not data then
		return
	end
	for _, board in BOARDS do
		local store = board.Store
		if store then
			local value = math.floor(board.Value(data))
			if value > 0 then
				pcall(function()
					store:SetAsync(tostring(player.UserId), value)
				end)
			end
		end
	end
end

local function refresh()
	if not available then
		return
	end
	for _, board in BOARDS do
		local store = board.Store
		if store then
			local ok, pages = pcall(function()
				return store:GetSortedAsync(false, 10)
			end)
			if ok and pages then
				local entries = pages:GetCurrentPage()
				local lines = {}
				for i, entry in entries do
					local userId = tonumber(entry.key) or 0
					table.insert(lines, `{i}. {nameOf(userId)} — {board.Format(entry.value)}`)
				end
				for _, part in boardParts(board.Id) do
					local gui = part:FindFirstChild("BoardGui")
					if gui then
						local rows = {}
						for _, child in gui:GetChildren() do
							if child:IsA("TextLabel") and child.Position.Y.Scale > 0.14 then
								table.insert(rows, child)
							end
						end
						table.sort(rows, function(a, b)
							return a.Position.Y.Scale < b.Position.Y.Scale
						end)
						for i, row in rows do
							row:SetAttribute("LocKey", nil)
							row.Text = lines[i] or ""
						end
					end
				end
			end
		end
	end
end

function LeaderboardService:Start()
	for _, board in BOARDS do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore("LB_" .. board.Id)
		end)
		if ok then
			board.Store = store
		else
			available = false
		end
		for _, part in boardParts(board.Id) do
			buildSurface(part, board)
		end
	end
	CollectionService:GetInstanceAddedSignal(Config.Tags.Leaderboard):Connect(function(inst)
		for _, board in BOARDS do
			if inst:IsA("BasePart") and inst:GetAttribute("Board") == board.Id then
				buildSurface(inst, board)
			end
		end
	end)

	-- Releasing приходит до закрытия профиля, данные ещё доступны
	DataService.Releasing:Connect(save)
	task.spawn(function()
		local lastSave = os.clock()
		while true do
			refresh()
			task.wait(REFRESH_SECONDS)
			if os.clock() - lastSave >= SAVE_SECONDS then
				lastSave = os.clock()
				for _, player in Players:GetPlayers() do
					save(player)
				end
			end
		end
	end)
	-- Roblox даёт BindToClose ~30 с на всё. Сохраняем всех параллельно и ждём не дольше 20 с,
	-- чтобы осталось время ProfileStore (sharp edge SE-6 из roblox-game-skill)
	game:BindToClose(function()
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				save(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 20
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return LeaderboardService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">LevelService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Опыт, уровни, здоровье персонажа от уровня.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local WeaponMath = require(ReplicatedStorage.Shared.WeaponMath)
local DataService = require(script.Parent.DataService)
local SocialService = require(script.Parent.SocialService)
local SystemService = require(script.Parent.SystemService)

local LevelService = {}

local function applyStats(player: Player, heal: boolean)
	local data = DataService:Get(player)
	local character = player.Character
	if not data or not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local maxHealth = WeaponMath.MaxHealth(data.Level)
	humanoid.MaxHealth = maxHealth
	if heal or humanoid.Health > maxHealth then
		humanoid.Health = maxHealth
	end
end

-- Ранг по уровню (Config/Ranks). notify = показать окно «Новый ранг».
local function checkRank(player: Player, data: any, notify: boolean)
	local rank = WeaponMath.RankFor(data.Level)
	if data.Rank == rank.Id then
		return
	end
	local old = WeaponMath.RankById(data.Rank)
	data.Rank = rank.Id
	DataService:Replicate(player, "Rank")
	if notify and rank.MinLevel > old.MinLevel then
		SystemService:Notify(player, "RankUp", "SYS_RANKUP_TITLE", "SYS_RANKUP_BODY", {
			rank = "@" .. rank.NameKey,
			bonus = math.floor(rank.DamageBonus * 100 + 0.5),
		})
	end
end

-- noBonus = true: не умножать на бонус друзей/группы (коды, фиксированные награды)
function LevelService:AddXp(player: Player, amount: number, noBonus: boolean?)
	local data = DataService:Get(player)
	if not data or amount <= 0 then
		return
	end
	if not noBonus then
		amount *= SocialService:XpMult(player)
	end
	data.Xp += math.floor(amount)

	local maxLevel = Config.Leveling.MaxLevel
	local gained = 0
	while data.Level < maxLevel do
		local need = WeaponMath.XpToNext(data.Level)
		if data.Xp < need then
			break
		end
		data.Xp -= need
		data.Level += 1
		gained += 1
	end
	if data.Level >= maxLevel then
		data.Xp = 0
	end

	DataService:Replicate(player, "Level", "Xp")

	if gained > 0 then
		applyStats(player, true)
		SystemService:Notify(player, "LevelUp", "SYS_LEVELUP_TITLE", "SYS_LEVELUP_BODY", {
			level = data.Level,
			hp = Config.Leveling.HealthPerLevel * gained,
			dmg = math.floor(Config.Leveling.DamagePerLevel * 100 * gained + 0.5),
		})
		checkRank(player, data, true)
	end
end

function LevelService:GetLevel(player: Player): number
	local data = DataService:Get(player)
	return if data then data.Level else 1
end

function LevelService:DamageMult(player: Player): number
	return WeaponMath.LevelDamageMult(LevelService:GetLevel(player))
end

function LevelService:Start()
	DataService.Loaded:Connect(function(player: Player, data: any)
		checkRank(player, data, false)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Humanoid", 10)
			applyStats(player, true)
		end)
		if player.Character then
			applyStats(player, true)
		end
	end)
end

return LevelService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">MerchantService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ТОРГОВЕЦ (NPC). Part/Model с тегом "Merchant".
	Продажа оружия и руды, покупка кирок. Каждое действие проверяет, что игрок рядом с торговцем.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local WeaponMath = require(ReplicatedStorage.Shared.WeaponMath)
local Guards = require(script.Parent.Parent.Util.Guards)
local Proximity = require(script.Parent.Parent.Util.Proximity)
local Prompts = require(script.Parent.Parent.Util.Prompts)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local InventoryService = require(script.Parent.InventoryService)
local NetService = require(script.Parent.NetService)
local ProgressService = require(script.Parent.ProgressService)

local MerchantService = {}

local function nearMerchant(player: Player): boolean
	return Proximity.NearTagged(player, Config.Tags.Merchant, Config.Economy.InteractMaxDistance) ~= nil
end

local function sellWeapons(player: Player, ids: any)
	local data = DataService:Get(player)
	if not data then
		return { ok = false, err = "ERR_NOT_LOADED" }
	end
	if not Guards.StringArray(ids, Config.Economy.MaxSellBatch, 64) then
		return { ok = false, err = "ERR_BAD_REQUEST" }
	end
	if not nearMerchant(player) then
		return { ok = false, err = "ERR_TOO_FAR" }
	end

	local total, count = 0, 0
	local seen: { [string]: boolean } = {}
	for _, id in ids do
		if not seen[id] then
			seen[id] = true
			if id == data.EquippedWeapon or data.Shop.Listings[id] then
				continue -- надетое и выставленное в лавке не продаём
			end
			-- сначала удаляем, потом платим: никакого дюпа даже при ошибке ниже
			local weapon = InventoryService:RemoveWeapon(player, id, true)
			if weapon then
				total += WeaponMath.SellPrice(weapon)
				count += 1
			end
		end
	end
	if count == 0 then
		return { ok = false, err = if seen[data.EquippedWeapon] then "ERR_EQUIPPED" else "ERR_UNKNOWN_ITEM" }
	end
	DataService:Replicate(player, "Weapons", "EquippedWeapon")
	EconomyService:AddGold(player, total)
	ProgressService:Record(player, "ItemSold", { Count = count })
	return { ok = true, gold = total, count = count }
end

local function sellOres(player: Player, oreId: any, count: any)
	local data = DataService:Get(player)
	if not data then
		return { ok = false, err = "ERR_NOT_LOADED" }
	end
	if not Guards.String(oreId, 32) or not Config.Ores[oreId] or not Guards.Integer(count, 1, 1e6) then
		return { ok = false, err = "ERR_BAD_REQUEST" }
	end
	if not nearMerchant(player) then
		return { ok = false, err = "ERR_TOO_FAR" }
	end
	if not EconomyService:TrySpendOre(player, oreId, count) then
		return { ok = false, err = "ERR_NOT_ENOUGH_ORE" }
	end
	local gold = Config.Ores[oreId].SellPrice * count
	EconomyService:AddGold(player, gold)
	ProgressService:Record(player, "ItemSold", { Count = 1 })
	return { ok = true, gold = gold, count = count }
end

local function buyPickaxe(player: Player, pickaxeId: any)
	local data = DataService:Get(player)
	if not data then
		return { ok = false, err = "ERR_NOT_LOADED" }
	end
	if not Guards.String(pickaxeId, 32) then
		return { ok = false, err = "ERR_BAD_REQUEST" }
	end
	local def = Config.Pickaxes[pickaxeId]
	if not def then
		return { ok = false, err = "ERR_BAD_REQUEST" }
	end
	if not nearMerchant(player) then
		return { ok = false, err = "ERR_TOO_FAR" }
	end
	if data.OwnedPickaxes[pickaxeId] then
		return { ok = false, err = "ERR_ALREADY_OWNED" }
	end
	if data.Level < def.RequiredLevel then
		return { ok = false, err = "ERR_LEVEL_LOW", args = { level = def.RequiredLevel } }
	end
	if not EconomyService:TrySpendGold(player, def.Price) then
		return { ok = false, err = "ERR_NOT_ENOUGH_GOLD" }
	end
	data.OwnedPickaxes[pickaxeId] = true
	data.Pickaxe = pickaxeId
	DataService:Replicate(player, "OwnedPickaxes", "Pickaxe")
	return { ok = true }
end

local function setupMerchant(instance: Instance)
	local anchor = Proximity.AnchorPart(instance)
	if not anchor or anchor:FindFirstChild("GamePrompt") then
		return
	end
	local prompt = Prompts.Create(anchor, "PROMPT_TRADE", { Distance = 12 })
	prompt.Triggered:Connect(function(player: Player)
		if DataService:IsLoaded(player) then
			NetService:Fire(player, "OpenPanel", { Panel = "Merchant" })
			ProgressService:Record(player, "MerchantOpened")
		end
	end)
end

function MerchantService:Start()
	NetService:OnInvoke("SellWeapons", sellWeapons)
	NetService:OnInvoke("SellOres", sellOres)
	NetService:OnInvoke("BuyPickaxe", buyPickaxe)

	for _, instance in CollectionService:GetTagged(Config.Tags.Merchant) do
		setupMerchant(instance)
	end
	CollectionService:GetInstanceAddedSignal(Config.Tags.Merchant):Connect(setupMerchant)
end

return MerchantService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">MiningService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ДОБЫЧА. Жила = BasePart (или Model) с тегом "OreNode" и атрибутом OreId ("Copper" | "Iron" | ...).
	Атрибут AutoStyle = false → не перекрашивать твою модель в цвет руды.

	Каждое нажатие подсказки «Добыть» = один удар киркой (сила кирки).
	Разбил жилу — получил руду; жила «спит» RespawnSeconds и появляется снова.
	Все проверки (дистанция, кулдаун, уровень, кирка) — на сервере.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Proximity = require(script.Parent.Parent.Util.Proximity)
local Prompts = require(script.Parent.Parent.Util.Prompts)
local DataService = require(script.Parent.DataService)
local InventoryService = require(script.Parent.InventoryService)
local EconomyService = require(script.Parent.EconomyService)
local LevelService = require(script.Parent.LevelService)
local NetService = require(script.Parent.NetService)
local SystemService = require(script.Parent.SystemService)
local ProgressService = require(script.Parent.ProgressService)

local MiningService = {}

type NodeState = {
	Instance: Instance,
	Anchor: BasePart,
	OreId: string,
	Health: number,
	Depleted: boolean,
	Prompt: ProximityPrompt,
	Parts: { BasePart },
	Transparency: { [BasePart]: number },
	Collide: { [BasePart]: boolean },
}

local nodes: { [Instance]: NodeState } = {}
local lastHit: { [Player]: number } = {}

local function setDepletedVisual(state: NodeState, depleted: boolean)
	for _, part in state.Parts do
		part.Transparency = if depleted then 0.85 else state.Transparency[part]
		part.CanCollide = if depleted then false else state.Collide[part]
	end
	state.Prompt.Enabled = not depleted
end

local function onHit(player: Player, state: NodeState)
	if state.Depleted then
		return
	end
	local data = DataService:Get(player)
	if not data then
		return
	end

	local now = os.clock()
	if (lastHit[player] or 0) + Config.Economy.Mining.HitCooldownSeconds > now then
		return
	end
	lastHit[player] = now

	if Proximity.DistanceTo(player, state.Anchor.Position) > Config.Economy.Mining.MaxDistance then
		SystemService:Error(player, "ERR_TOO_FAR")
		return
	end

	local ore = Config.Ores[state.OreId]
	local pickaxe = Config.Pickaxes[data.Pickaxe] or Config.Pickaxes[Config.Economy.StartingPickaxe]
	if data.Level < ore.RequiredLevel then
		SystemService:Error(player, "ERR_LEVEL_LOW", { level = ore.RequiredLevel })
		return
	end
	if pickaxe.Tier < ore.RequiredPickaxeTier then
		SystemService:Error(player, "ERR_PICKAXE_WEAK")
		return
	end

	state.Health -= pickaxe.Power
	NetService:FxNear(state.Anchor.Position, 80, {
		Kind = "MineHit",
		Position = state.Anchor.Position,
		Color = ore.Color,
		Progress = math.clamp(1 - state.Health / ore.NodeHealth, 0, 1),
	})

	if state.Health > 0 then
		return
	end

	-- жила разбита: награда последнему ударившему
	state.Depleted = true
	setDepletedVisual(state, true)

	local amount = math.random(ore.YieldMin, ore.YieldMax)
	-- черта «Удача» у надетого оружия
	local weapon = InventoryService:GetEquipped(player)
	if weapon and weapon.Traits then
		for _, id in weapon.Traits do
			local t = Config.Traits[id]
			if t and t.ExtraOreChance and math.random() < t.ExtraOreChance then
				amount += 1
			end
		end
	end
	EconomyService:AddOre(player, ore.Id, amount)
	LevelService:AddXp(player, ore.XpPerOre * amount)
	DataService:AddStat(player, "OresMined", amount)
	SystemService:Toast(player, "TOAST_ORE", { count = amount, ore = "@" .. ore.NameKey }, "ore")
	NetService:FxNear(state.Anchor.Position, 80, { Kind = "OreBreak", Position = state.Anchor.Position, Color = ore.Color })
	ProgressService:Record(player, "OreMined", { OreId = ore.Id, Count = amount })

	task.delay(ore.RespawnSeconds, function()
		if nodes[state.Instance] == state then
			state.Health = ore.NodeHealth
			state.Depleted = false
			setDepletedVisual(state, false)
		end
	end)
end

local function setupNode(instance: Instance)
	if nodes[instance] then
		return
	end
	local oreId = instance:GetAttribute("OreId")
	if type(oreId) ~= "string" or not Config.Ores[oreId] then
		warn(`[Mining] {instance:GetFullName()}: нет атрибута OreId или руда не найдена в Config.Ores`)
		return
	end
	local anchor = Proximity.AnchorPart(instance)
	if not anchor then
		return
	end
	local ore = Config.Ores[oreId]

	local parts: { BasePart } = {}
	if instance:IsA("BasePart") then
		table.insert(parts, instance)
	end
	for _, d in instance:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end
	local transparency = {}
	local collide = {}
	for _, part in parts do
		transparency[part] = part.Transparency
		collide[part] = part.CanCollide
	end

	if instance:GetAttribute("AutoStyle") ~= false then
		for _, part in parts do
			part.Color = ore.Color
			part.Material = ore.Material
		end
	end

	local prompt = Prompts.Create(anchor, "PROMPT_MINE", { ObjectKey = ore.NameKey, Distance = 10 })

	local state: NodeState = {
		Instance = instance,
		Anchor = anchor,
		OreId = oreId,
		Health = ore.NodeHealth,
		Depleted = false,
		Prompt = prompt,
		Parts = parts,
		Transparency = transparency,
		Collide = collide,
	}
	nodes[instance] = state

	prompt.Triggered:Connect(function(player: Player)
		onHit(player, state)
	end)
end

function MiningService:Start()
	for _, instance in CollectionService:GetTagged(Config.Tags.OreNode) do
		setupNode(instance)
	end
	CollectionService:GetInstanceAddedSignal(Config.Tags.OreNode):Connect(setupNode)
	CollectionService:GetInstanceRemovedSignal(Config.Tags.OreNode):Connect(function(instance)
		local state = nodes[instance]
		if state then
			nodes[instance] = nil
			state.Prompt:Destroy()
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastHit[player] = nil
	end)

	if #CollectionService:GetTagged(Config.Tags.OreNode) == 0 then
		warn("[Mining] В карте нет Part с тегом OreNode — см. README, раздел «Карта»")
	end
end

return MiningService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">MobService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	МОБЫ: спавн из пула объектов, простой ИИ на сервере (догнать → замах → удар),
	у боссов — удар по площади с красным кругом-предупреждением.
	Здоровье мобов считаем сами (Humanoid только для ходьбы) — так дешевле и нет «смерти» Humanoid.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Char = require(script.Parent.Parent.Util.Char)
local CombatState = require(script.Parent.CombatState)
local NetService = require(script.Parent.NetService)

local MobService = {}

MobService.MobDied = Signal.new() -- (mob, killer: Player?)
MobService.MobDamaged = Signal.new() -- (mob, amount, attacker: Player?)
MobService.PlayerParried = Signal.new() -- (player, mob)

export type Mob = {
	Id: number,
	Def: any,
	Model: Model,
	Root: BasePart,
	Humanoid: Humanoid,
	Alert: BillboardGui, -- «!» над головой во время замаха
	BarFill: Frame,
	Burn: ParticleEmitter,
	Health: number,
	MaxHealth: number,
	DamageMult: number,
	RunId: string,
	GetTargets: () -> { Player },
	State: string, -- chase | windup | slam | stunned | dead
	Target: Player?,
	ActionEndsAt: number,
	NextAttackAt: number,
	NextSlamAt: number,
	StunUntil: number,
	SlamPosition: Vector3?,
	SlamMarker: BasePart?,
	Home: Vector3?,
	LeashRadius: number?,
	AggroRadius: number?,
	BurnUntil: number,
	BurnDps: number,
	BurnAcc: number,
	BurnAttacker: Player?,
}

export type SpawnOptions = {
	RunId: string,
	HealthMult: number?,
	DamageMult: number?,
	GetTargets: () -> { Player },
	Home: Vector3?, -- мобы открытого мира возвращаются сюда
	LeashRadius: number?,
	AggroRadius: number?,
}

local active: { [Mob]: boolean } = {}
local pool: { [string]: { Model } } = {}
local nextId = 0

local mobsFolder: Folder
local poolFolder: Folder

-- ===== Сборка модели =====

local function addHealthBar(root: BasePart, def: any): Frame
	local gui = Instance.new("BillboardGui")
	gui.Name = "HealthBar"
	gui.Size = UDim2.new(if def.IsBoss then 8 else 4.5, 0, if def.IsBoss then 1.6 else 1.1, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, def.Size.Y / 2 + 1.4, 0)
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	gui.Adornee = root
	-- имя переводит клиент (LocalizationController): атрибуты LocKey + name + level
	local name = Instance.new("TextLabel")
	name.Name = "MobName"
	name.Size = UDim2.fromScale(1, 0.55)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.GothamBold
	name.TextScaled = true
	name.TextColor3 = if def.IsBoss then Color3.fromRGB(255, 120, 120) else Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.3
	name.Text = def.Id
	name:SetAttribute("LocKey", "UI_MOB_NAME")
	name:SetAttribute("name", "@" .. def.NameKey)
	name:SetAttribute("level", def.Level or 1)
	name.Parent = gui
	local bg = Instance.new("Frame")
	bg.Name = "Bg"
	bg.Size = UDim2.fromScale(1, 0.38)
	bg.Position = UDim2.fromScale(0, 0.62)
	bg.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
	bg.BorderSizePixel = 0
	bg.Parent = gui
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = if def.IsBoss then Color3.fromRGB(255, 70, 70) else Color3.fromRGB(230, 90, 60)
	fill.BorderSizePixel = 0
	fill.Parent = bg
	gui.Parent = root
	return fill
end

local function buildModel(def: any): Model
	local folder = ServerStorage:FindFirstChild("Mobs")
	local template = folder and folder:FindFirstChild(def.Id)
	if
		template
		and template:IsA("Model")
		and template:FindFirstChildOfClass("Humanoid")
		and template:FindFirstChild("HumanoidRootPart")
	then
		local model = template:Clone()
		model.PrimaryPart = model:FindFirstChild("HumanoidRootPart") :: BasePart
		return model
	end

	-- заглушка: блок с «глазами»
	local model = Instance.new("Model")
	model.Name = def.Id
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = def.Size
	root.Color = def.Color
	-- стад-стиль: пластик с шипами на всех гранях
	root.Material = Enum.Material.Plastic
	for _, surfaceName in { "TopSurface", "BottomSurface", "FrontSurface", "BackSurface", "LeftSurface", "RightSurface" } do
		(root :: any)[surfaceName] = Enum.SurfaceType.Studs
	end
	root.CanCollide = false
	root.Parent = model

	local eye = Instance.new("Part")
	eye.Name = "Eyes"
	eye.Size = Vector3.new(def.Size.X * 0.6, math.max(0.3, def.Size.Y * 0.08), 0.1)
	eye.Color = Color3.fromRGB(255, 170, 60)
	eye.Material = Enum.Material.Neon
	eye.CanCollide = false
	eye.CanQuery = false
	eye.Massless = true
	eye.CFrame = root.CFrame * CFrame.new(0, def.Size.Y * 0.3, -def.Size.Z / 2 - 0.05)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = eye
	weld.Parent = eye
	eye.Parent = model

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 0.05
	humanoid.Parent = model

	model.PrimaryPart = root
	return model
end

local function prepareModel(def: any): Model
	local model = buildModel(def)
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

	local root = model.PrimaryPart :: BasePart

	-- «!» над головой во время замаха (Highlight не используем: их максимум 31 на экране)
	local alert = Instance.new("BillboardGui")
	alert.Name = "Alert"
	alert.Size = UDim2.fromScale(2.2, 2.2)
	alert.StudsOffsetWorldSpace = Vector3.new(0, def.Size.Y / 2 + (if def.IsBoss then 4 else 3), 0)
	alert.AlwaysOnTop = true
	alert.LightInfluence = 0
	alert.MaxDistance = 80
	alert.Enabled = false
	local mark = Instance.new("TextLabel")
	mark.Size = UDim2.fromScale(1, 1)
	mark.BackgroundTransparency = 1
	mark.Font = Enum.Font.GothamBlack
	mark.TextScaled = true
	mark.Text = "!"
	mark.TextColor3 = Color3.fromRGB(255, 60, 60)
	mark.TextStrokeTransparency = 0
	mark.Parent = alert
	alert.Parent = root

	local burn = Instance.new("ParticleEmitter")
	burn.Name = "Burn"
	burn.Enabled = false
	burn.Rate = 15
	burn.Lifetime = NumberRange.new(0.4, 0.8)
	burn.Speed = NumberRange.new(2, 5)
	burn.Color = ColorSequence.new(Color3.fromRGB(255, 160, 40), Color3.fromRGB(255, 50, 20))
	burn.Size = NumberSequence.new(0.8, 0)
	burn.LightEmission = 1
	burn.Parent = root

	addHealthBar(root, def)
	return model
end

-- ===== Публичное API =====

function MobService:Spawn(mobId: string, cframe: CFrame, options: SpawnOptions): Mob?
	local def = Config.Mobs[mobId]
	if not def then
		warn(`[Mobs] неизвестный моб {mobId}`)
		return nil
	end

	local list = pool[mobId]
	local model: Model
	if list and #list > 0 then
		model = table.remove(list) :: Model
	else
		model = prepareModel(def)
	end

	local root = model.PrimaryPart :: BasePart
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local alert = root:FindFirstChild("Alert") :: BillboardGui
	local burn = root:FindFirstChild("Burn") :: ParticleEmitter
	local bar = root:FindFirstChild("HealthBar") :: BillboardGui
	local fill = (bar:FindFirstChild("Bg") :: Frame):FindFirstChild("Fill") :: Frame

	local maxHealth = math.floor(def.MaxHealth * (options.HealthMult or 1))
	fill.Size = UDim2.fromScale(1, 1)
	alert.Enabled = false
	burn.Enabled = false
	humanoid.WalkSpeed = def.WalkSpeed

	model:PivotTo(cframe)
	model.Parent = mobsFolder
	if root:CanSetNetworkOwnership() then
		root:SetNetworkOwner(nil) -- физикой мобов владеет сервер
	end

	nextId += 1
	local now = os.clock()
	local mob: Mob = {
		Id = nextId,
		Def = def,
		Model = model,
		Root = root,
		Humanoid = humanoid,
		Alert = alert,
		BarFill = fill,
		Burn = burn,
		Health = maxHealth,
		MaxHealth = maxHealth,
		DamageMult = options.DamageMult or 1,
		RunId = options.RunId,
		GetTargets = options.GetTargets,
		State = "chase",
		Target = nil,
		ActionEndsAt = 0,
		NextAttackAt = now + 1, -- секунда на «появление»
		NextSlamAt = now + 4,
		StunUntil = 0,
		SlamPosition = nil,
		SlamMarker = nil,
		Home = options.Home,
		LeashRadius = options.LeashRadius,
		AggroRadius = options.AggroRadius,
		BurnUntil = 0,
		BurnDps = 0,
		BurnAcc = 0,
		BurnAttacker = nil,
	}
	active[mob] = true
	return mob
end

local function clearSlam(mob: Mob)
	if mob.SlamMarker then
		mob.SlamMarker:Destroy()
		mob.SlamMarker = nil
	end
	mob.SlamPosition = nil
end

local function release(mob: Mob)
	active[mob] = nil
	clearSlam(mob)
	mob.Alert.Enabled = false
	mob.Burn.Enabled = false
	mob.BurnUntil = 0
	mob.Model.Parent = poolFolder
	local list = pool[mob.Def.Id]
	if not list then
		list = {}
		pool[mob.Def.Id] = list
	end
	table.insert(list, mob.Model)
end

local function setBar(mob: Mob)
	mob.BarFill.Size = UDim2.fromScale(math.clamp(mob.Health / mob.MaxHealth, 0, 1), 1)
end

function MobService:IsAlive(mob: Mob): boolean
	return active[mob] == true and mob.State ~= "dead"
end

-- true, если моб умер от этого удара
function MobService:Damage(mob: Mob, amount: number, attacker: Player?): boolean
	if not MobService:IsAlive(mob) then
		return false
	end
	mob.Health = math.max(0, mob.Health - amount)
	setBar(mob)
	MobService.MobDamaged:Fire(mob, amount, attacker)
	if mob.Health > 0 then
		return false
	end

	mob.State = "dead"
	clearSlam(mob)
	mob.Alert.Enabled = false
	mob.Humanoid:MoveTo(mob.Root.Position)
	NetService:FxNear(mob.Root.Position, Config.Combat.DamageFxRadius, {
		Kind = "MobDeath",
		Position = mob.Root.Position,
		Boss = mob.Def.IsBoss,
	})
	MobService.MobDied:Fire(mob, attacker)
	task.delay(0.4, function()
		if active[mob] then
			release(mob)
		end
	end)
	return true
end

function MobService:Stun(mob: Mob, seconds: number)
	if not MobService:IsAlive(mob) then
		return
	end
	mob.State = "stunned"
	mob.StunUntil = os.clock() + seconds
	mob.Alert.Enabled = false
	clearSlam(mob)
	mob.Humanoid:MoveTo(mob.Root.Position)
end

-- Горение (черта оружия «Огонь»): dps урона в секунду в течение seconds
function MobService:ApplyBurn(mob: Mob, dps: number, seconds: number, attacker: Player?)
	if not MobService:IsAlive(mob) or dps <= 0 then
		return
	end
	mob.BurnDps = math.max(mob.BurnDps, dps)
	mob.BurnUntil = os.clock() + seconds
	mob.BurnAttacker = attacker
	mob.Burn.Enabled = true
end

-- Живые мобы в радиусе (с учётом их размера)
function MobService:GetMobsInRadius(position: Vector3, radius: number): { Mob }
	local result = {}
	for mob in active do
		if mob.State ~= "dead" then
			local offset = mob.Root.Position - position
			local flat = Vector3.new(offset.X, 0, offset.Z).Magnitude
			local half = math.max(mob.Def.Size.X, mob.Def.Size.Z) / 2
			if flat - half <= radius and math.abs(offset.Y) < 12 + mob.Def.Size.Y then
				table.insert(result, mob)
			end
		end
	end
	return result
end

function MobService:DespawnRun(runId: string)
	local list = {}
	for mob in active do
		if mob.RunId == runId then
			table.insert(list, mob)
		end
	end
	for _, mob in list do
		mob.State = "dead"
		release(mob)
	end
end

-- ===== ИИ =====

local function hitPlayer(mob: Mob, player: Player, rawDamage: number)
	local humanoid = Char.Humanoid(player)
	local root = Char.Root(player)
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	local damage = math.floor(rawDamage * mob.DamageMult + 0.5)
	local final, result = CombatState.Resolve(player, damage)
	if result == "parry" then
		MobService:Stun(mob, Config.Combat.ParryStunSeconds)
		MobService.PlayerParried:Fire(player, mob)
	else
		humanoid:TakeDamage(final)
	end
	NetService:FxNear(root.Position, Config.Combat.DamageFxRadius, {
		Kind = "PlayerHit",
		Position = root.Position,
		Amount = final,
		Result = result,
		UserId = player.UserId,
	})
end

local function nearestTarget(mob: Mob): (Player?, BasePart?, number)
	local best: Player? = nil
	local bestRoot: BasePart? = nil
	local bestDist = math.huge
	for _, player in mob.GetTargets() do
		if Char.IsAlive(player) then
			local root = Char.Root(player) :: BasePart
			local d = (root.Position - mob.Root.Position).Magnitude
			if d < bestDist then
				best, bestRoot, bestDist = player, root, d
			end
		end
	end
	return best, bestRoot, bestDist
end

local function face(mob: Mob, position: Vector3)
	local from = mob.Root.Position
	local flat = Vector3.new(position.X, from.Y, position.Z)
	if (flat - from).Magnitude > 0.1 then
		mob.Root.CFrame = CFrame.lookAt(from, flat)
	end
end

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude

local function startSlam(mob: Mob, targetRoot: BasePart, now: number)
	local def = mob.Def
	raycastParams.FilterDescendantsInstances = { mobsFolder, targetRoot.Parent :: Instance }
	local hit = workspace:Raycast(targetRoot.Position, Vector3.new(0, -25, 0), raycastParams)
	local ground = if hit then hit.Position else targetRoot.Position - Vector3.new(0, 3, 0)

	mob.State = "slam"
	mob.ActionEndsAt = now + def.SlamWindup
	mob.NextSlamAt = now + def.SlamCooldown
	mob.SlamPosition = ground
	mob.Alert.Enabled = true
	mob.Humanoid:MoveTo(mob.Root.Position)
	face(mob, ground)

	local marker = Instance.new("Part")
	marker.Name = "SlamWarning"
	marker.Shape = Enum.PartType.Cylinder
	marker.Size = Vector3.new(0.2, def.SlamRadius * 2, def.SlamRadius * 2)
	marker.CFrame = CFrame.new(ground + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90))
	marker.Anchored = true
	marker.CanCollide = false
	marker.CanQuery = false
	marker.CanTouch = false
	marker.Material = Enum.Material.Neon
	marker.Color = Color3.fromRGB(255, 40, 40)
	marker.Transparency = 0.55
	marker.Parent = mobsFolder
	mob.SlamMarker = marker
end

local function resolveSlam(mob: Mob)
	local center = mob.SlamPosition
	if center then
		for _, player in mob.GetTargets() do
			local root = Char.Root(player)
			if root and Char.IsAlive(player) then
				local offset = root.Position - center
				if Vector3.new(offset.X, 0, offset.Z).Magnitude <= mob.Def.SlamRadius and math.abs(offset.Y) < 8 then
					hitPlayer(mob, player, mob.Def.SlamDamage)
				end
			end
		end
		NetService:FxNear(center, Config.Combat.DamageFxRadius, { Kind = "Slam", Position = center, Radius = mob.Def.SlamRadius })
	end
	clearSlam(mob)
	mob.Alert.Enabled = false
	mob.State = "chase"
end

local function tickBurn(mob: Mob, now: number): boolean
	if mob.BurnUntil <= 0 then
		return false
	end
	if now >= mob.BurnUntil then
		mob.BurnUntil = 0
		mob.BurnDps = 0
		mob.BurnAcc = 0
		mob.Burn.Enabled = false
		return false
	end
	mob.BurnAcc += mob.BurnDps * Config.Combat.MobAiTickSeconds
	if mob.BurnAcc >= 1 then
		local damage = math.floor(mob.BurnAcc)
		mob.BurnAcc -= damage
		NetService:FxNear(mob.Root.Position, Config.Combat.DamageFxRadius, {
			Kind = "Burn",
			Position = mob.Root.Position + Vector3.new(0, mob.Def.Size.Y / 2, 0),
			Amount = damage,
		})
		return MobService:Damage(mob, damage, mob.BurnAttacker)
	end
	return false
end

local function tickMob(mob: Mob, now: number)
	local state = mob.State
	if state == "dead" then
		return
	end
	if tickBurn(mob, now) then
		return -- сгорел
	end
	if state == "stunned" then
		if now < mob.StunUntil then
			return
		end
		mob.State = "chase"
	elseif state == "windup" then
		if now < mob.ActionEndsAt then
			return
		end
		mob.Alert.Enabled = false
		mob.State = "chase"
		local target = mob.Target
		local targetRoot = target and Char.Root(target)
		if target and targetRoot and (targetRoot.Position - mob.Root.Position).Magnitude <= mob.Def.AttackRange * 1.4 then
			hitPlayer(mob, target, mob.Def.Damage)
		end
		return
	elseif state == "slam" then
		if now >= mob.ActionEndsAt then
			resolveSlam(mob)
		end
		return
	end

	-- погоня
	local target, targetRoot, dist = nearestTarget(mob)
	if target and targetRoot then
		-- мобы открытого мира: не видят далёких и не уходят далеко от дома
		if mob.AggroRadius and dist > mob.AggroRadius then
			target, targetRoot = nil, nil
		elseif mob.Home and mob.LeashRadius and (targetRoot.Position - mob.Home).Magnitude > mob.LeashRadius then
			target, targetRoot = nil, nil
		end
	end
	if not target or not targetRoot then
		local home = mob.Home
		if home and (mob.Root.Position - home).Magnitude > 4 then
			mob.Humanoid:MoveTo(home)
		else
			mob.Humanoid:MoveTo(mob.Root.Position)
		end
		-- вне боя быстро восстанавливается (нельзя «кайтить» по чуть-чуть)
		if home and mob.Health < mob.MaxHealth then
			mob.Health = math.min(mob.MaxHealth, mob.Health + mob.MaxHealth * 0.08)
			setBar(mob)
		end
		return
	end
	local def = mob.Def
	local half = math.max(def.Size.X, def.Size.Z) / 2

	if def.IsBoss and def.SlamDamage and now >= mob.NextSlamAt and dist <= def.SlamTriggerRange + half then
		startSlam(mob, targetRoot, now)
	elseif dist <= def.AttackRange + half and now >= mob.NextAttackAt then
		mob.State = "windup"
		mob.Target = target
		mob.ActionEndsAt = now + def.WindupSeconds
		mob.NextAttackAt = now + def.AttackCooldown
		mob.Alert.Enabled = true
		mob.Humanoid:MoveTo(mob.Root.Position)
		face(mob, targetRoot.Position)
	elseif dist > def.AttackRange * 0.6 + half then
		mob.Humanoid:MoveTo(targetRoot.Position)
	else
		mob.Humanoid:MoveTo(mob.Root.Position)
		face(mob, targetRoot.Position)
	end
end

function MobService:Init()
	mobsFolder = Instance.new("Folder")
	mobsFolder.Name = "Mobs"
	mobsFolder.Parent = workspace
	poolFolder = Instance.new("Folder")
	poolFolder.Name = "MobPool"
	poolFolder.Parent = ServerStorage
end

function MobService:Start()
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < Config.Combat.MobAiTickSeconds then
			return
		end
		accumulator = 0
		local now = os.clock()
		for mob in active do
			local ok, err = pcall(tickMob, mob, now)
			if not ok then
				warn(`[Mobs] ошибка ИИ {mob.Def.Id}: {err}`)
				mob.State = "dead"
				release(mob)
			end
		end
	end)
end

return MobService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">NetService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Обёртка над Remote: rate-limit (token bucket на игрока и Remote), pcall вокруг обработчиков,
	единый формат ответа для RemoteFunction.
	Все сервисы подписываются на Remote ТОЛЬКО через NetService.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)

local NetService = {}

type Bucket = { tokens: number, last: number }
local buckets: { [Player]: { [string]: Bucket } } = {}
local warnedAt: { [Player]: number } = {}

local function allow(player: Player, name: string): boolean
	local limit = Config.Network.Limits[name] or Config.Network.Default
	local perPlayer = buckets[player]
	if not perPlayer then
		perPlayer = {}
		buckets[player] = perPlayer
	end
	local now = os.clock()
	local bucket = perPlayer[name]
	if not bucket then
		bucket = { tokens = limit.Burst, last = now }
		perPlayer[name] = bucket
	end
	bucket.tokens = math.min(limit.Burst, bucket.tokens + (now - bucket.last) * limit.PerSecond)
	bucket.last = now
	if bucket.tokens < 1 then
		if Config.Debug.LogSuspicious and (warnedAt[player] or 0) + 5 < now then
			warnedAt[player] = now
			warn(`[Net] rate limit: {player.Name} → {name}`)
		end
		return false
	end
	bucket.tokens -= 1
	return true
end

function NetService:Init()
	Net.Setup()
	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
		warnedAt[player] = nil
	end)
end

-- Клиент → сервер (RemoteEvent)
function NetService:OnEvent(name: string, handler: (player: Player, ...any) -> ())
	Net.Event(name).OnServerEvent:Connect(function(player: Player, ...: any)
		if not allow(player, name) then
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(`[Net] {name} ({player.Name}): {err}`)
		end
	end)
end

-- Клиент → сервер с ответом (RemoteFunction). handler обязан вернуть { ok = ..., ... }
function NetService:OnInvoke(name: string, handler: (player: Player, ...any) -> { [string]: any })
	Net.Function(name).OnServerInvoke = function(player: Player, ...: any)
		if not allow(player, name) then
			return { ok = false, err = "ERR_RATE_LIMIT" }
		end
		local ok, result = pcall(handler, player, ...)
		if not ok then
			warn(`[Net] {name} ({player.Name}): {result}`)
			return { ok = false, err = "ERR_SERVER" }
		end
		if type(result) ~= "table" then
			return { ok = false, err = "ERR_SERVER" }
		end
		return result
	end
end

function NetService:Fire(player: Player, name: string, ...: any)
	Net.Event(name):FireClient(player, ...)
end

function NetService:FireAll(name: string, ...: any)
	Net.Event(name):FireAllClients(...)
end

function NetService:FireList(players: { Player }, name: string, ...: any)
	local remote = Net.Event(name)
	for _, player in players do
		if player.Parent == Players then
			remote:FireClient(player, ...)
		end
	end
end

-- Косметика (цифры урона, искры): ненадёжный канал, всем в радиусе
function NetService:FxNear(position: Vector3, radius: number, payload: { [string]: any })
	local remote = Net.UnreliableEvent("Fx")
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and (root.Position - position).Magnitude <= radius then
			remote:FireClient(player, payload)
		end
	end
end

function NetService:FxTo(player: Player, payload: { [string]: any })
	Net.UnreliableEvent("Fx"):FireClient(player, payload)
end

return NetService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">ProgressService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ЕДИНАЯ ТОЧКА ДЛЯ ИГРОВЫХ СОБЫТИЙ. Сервисы сообщают сюда, что произошло,
	а ProgressService раздаёт это обучению и ежедневным заданиям (позже — достижениям, аналитике).

	События: OreMined, WeaponForged, QualityForge80, WeaponEquipped, MerchantOpened, ItemSold,
	         GateEntered, GateCleared, MobKilled, Parry
]]

local DailyService = require(script.Parent.DailyService)
local TutorialService = require(script.Parent.TutorialService)

local ProgressService = {}

function ProgressService:Record(player: Player, event: string, info: { OreId: string?, Count: number? }?)
	TutorialService:Record(player, event, info)
	DailyService:Record(player, event, (info and info.Count) or 1)
end

return ProgressService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ЛАВКИ ИГРОКОВ.
	• Каждому игроку на сервере — свой прилавок (тег ShopStall) в Торговом ряду.
	• Владелец выставляет оружие с ценой (откуда угодно: Инвентарь → «Моя лавка»).
	• Покупатель подходит к прилавку → «Лавка» → покупает. Сервер проверяет дистанцию,
	  что цена не изменилась, место в инвентаре и золото, затем переносит оружие (тот же Id)
	  и золото одним блоком без yield, сохраняет оба профиля и пишет запись в журнал.
	• Пока владелец не в игре, лавка продаёт NPC-покупателям (ограниченно, Config.Trading.Shop.Offline).
	Выставленное оружие нельзя надеть, продать торговцу или отдать в обмен.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local WeaponMath = require(ReplicatedStorage.Shared.WeaponMath)
local Guards = require(script.Parent.Parent.Util.Guards)
local MarketLog = require(script.Parent.Parent.Util.MarketLog)
local Prompts = require(script.Parent.Parent.Util.Prompts)
local Proximity = require(script.Parent.Parent.Util.Proximity)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local InventoryService = require(script.Parent.InventoryService)
local NetService = require(script.Parent.NetService)
local SystemService = require(script.Parent.SystemService)

local ShopService = {}

local SH = Config.Trading.Shop
local rng = Random.new()

local stallOwner: { [Model]: Player } = {}
local playerStall: { [Player]: Model } = {}

-- ===== Прилавки =====

local function stalls(): { Model }
	local list = {}
	for _, inst in CollectionService:GetTagged(Config.Tags.ShopStall) do
		if inst:IsA("Model") and inst:IsDescendantOf(workspace) then
			table.insert(list, inst)
		end
	end
	table.sort(list, function(a, b)
		return (a:GetAttribute("Slot") or 0) < (b:GetAttribute("Slot") or 0)
	end)
	return list
end

local function ownerLabel(stall: Model): TextLabel?
	return stall:FindFirstChild("Owner", true) :: TextLabel?
end

local function listingsOf(data: any): { { Weapon: any, Price: number } }
	local list = {}
	for id, price in data.Shop.Listings do
		local weapon = data.Weapons[id]
		if weapon then
			table.insert(list, { Weapon = weapon, Price = price })
		end
	end
	table.sort(list, function(a, b)
		return a.Price > b.Price
	end)
	return list
end

-- Витрина: 3 самых дорогих предмета на подставках
local function refreshDisplay(stall: Model)
	local old = stall:FindFirstChild("Display")
	if old then
		old:Destroy()
	end
	local owner = stallOwner[stall]
	local label = ownerLabel(stall)
	if label then
		if owner then
			label:SetAttribute("LocKey", nil)
			label.Text = owner.DisplayName
		else
			label.Text = "UI_STALL_FREE"
			label:SetAttribute("LocKey", "UI_STALL_FREE")
		end
	end
	local data = owner and DataService:Get(owner)
	if not data then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "Display"
	for i, entry in listingsOf(data) do
		if i > 3 then
			break
		end
		local pedestal = stall:FindFirstChild("Pedestal" .. i, true) :: BasePart?
		local visual, primary = InventoryService:BuildWeaponVisual(entry.Weapon)
		if pedestal and visual and primary then
			primary.Anchored = true
			-- клинок вертикально над подставкой
			primary.CFrame = pedestal.CFrame
				* CFrame.new(0, pedestal.Size.Y / 2 + primary.Size.Z / 2 + 0.2, 0)
				* CFrame.Angles(math.rad(90), 0, 0)
			visual.Parent = folder
		elseif visual then
			visual:Destroy()
		end
	end
	folder.Parent = stall
end

local function assignStall(player: Player)
	if playerStall[player] then
		return
	end
	for _, stall in stalls() do
		if not stallOwner[stall] then
			stallOwner[stall] = player
			playerStall[player] = stall
			player:SetAttribute("HasStall", true) -- клиент показывает подсказку, если прилавка нет
			refreshDisplay(stall)
			return
		end
	end
end

local function releaseStall(player: Player)
	local stall = playerStall[player]
	if stall then
		playerStall[player] = nil
		stallOwner[stall] = nil
		player:SetAttribute("HasStall", nil)
		refreshDisplay(stall)
	end
end

local function refreshPlayerStall(player: Player)
	local stall = playerStall[player]
	if stall then
		refreshDisplay(stall)
	end
end

local function browsePayload(owner: Player): { [string]: any }
	local data = DataService:Get(owner)
	local listings = {}
	if data then
		for _, entry in listingsOf(data) do
			table.insert(listings, { Weapon = entry.Weapon, Price = entry.Price })
		end
	end
	return {
		Panel = "Shop",
		Mode = "browse",
		OwnerUserId = owner.UserId,
		OwnerName = owner.DisplayName,
		Listings = listings,
	}
end

local function onStallTriggered(player: Player, stall: Model)
	if not DataService:IsLoaded(player) then
		return
	end
	local owner = stallOwner[stall]
	if owner == player then
		NetService:Fire(player, "OpenPanel", { Panel = "Shop", Mode = "manage" })
	elseif owner then
		NetService:Fire(player, "OpenPanel", browsePayload(owner))
	else
		SystemService:Toast(player, "UI_STALL_FREE")
	end
end

local function setupStall(stall: Instance)
	if not stall:IsA("Model") then
		return
	end
	local anchor = stall.PrimaryPart
	if not anchor or anchor:FindFirstChild("GamePrompt") then
		return
	end
	local prompt = Prompts.Create(anchor, "PROMPT_SHOP", { Distance = 12 })
	prompt.Triggered:Connect(function(player: Player)
		onStallTriggered(player, stall)
	end)
end

-- ===== Выставление =====

local function listWeapon(player: Player, weaponId: any, price: any)
	local data = DataService:Get(player)
	if not data then
		return { ok = false, err = "ERR_NOT_LOADED" }
	end
	if not Guards.String(weaponId, 64) then
		return { ok = false, err = "ERR_BAD_REQUEST" }
	end
	if not Guards.Integer(price, SH.MinPrice, SH.MaxPrice) then
		return { ok = false, err = "ERR_PRICE", args = { min = SH.MinPrice, max = SH.MaxPrice } }
	end
	if not data.Weapons[weaponId] then
		return { ok = false, err = "ERR_UNKNOWN_ITEM" }
	end
	if data.EquippedWeapon == weaponId then
		return { ok = false, err = "ERR_EQUIPPED" }
	end
	local count = 0
	for _ in data.Shop.Listings do
		count += 1
	end
	if not data.Shop.Listings[weaponId] and count >= SH.MaxListings then
		return { ok = false, err = "ERR_SHOP_FULL", args = { max = SH.MaxListings } }
	end
	data.Shop.Listings[weaponId] = price
	DataService:Replicate(player, "Shop")
	refreshPlayerStall(player)
	return { ok = true }
end

local function unlistWeapon(player: Player, weaponId: any)
	local data = DataService:Get(player)
	if not data then
		return { ok = false, err = "ERR_NOT_LOADED" }
	end
	if not Guards.String(weaponId, 64) or not data.Shop.Listings[weaponId] then
		return { ok = false, err = "ERR_UNKNOWN_ITEM" }
	end
	data.Shop.Listings[weaponId] = nil
	DataService:Replicate(player, "Shop")
	refreshPlayerStall(player)
	return { ok = true }
end

-- ===== Покупка у игрока на этом сервере =====

local function buy(player: Player, ownerUserId: any, weaponId: any, expectedPrice: any)
	local buyerData = DataService:Get(player)
	if not buyerData then
		return { ok = false, err = "ERR_NOT_LOADED" }
	end
	if not Guards.Integer(ownerUserId, 1, 1e15) or not Guards.String(weaponId, 64) or not Guards.Integer(expectedPrice, 0, 1e9) then
		return { ok = false, err = "ERR_BAD_REQUEST" }
	end
	local owner = Players:GetPlayerByUserId(ownerUserId)
	local ownerData = owner and DataService:Get(owner)
	if not owner or not ownerData then
		return { ok = false, err = "ERR_OWNER_OFFLINE" }
	end
	if owner == player then
		return { ok = false, err = "ERR_BAD_REQUEST" }
	end
	local stall = playerStall[owner]
	local anchor = stall and stall.PrimaryPart
	if not anchor or Proximity.DistanceTo(player, anchor.Position) > SH.InteractDistance then
		return { ok = false, err = "ERR_TOO_FAR" }
	end
	-- цена должна совпадать с той, что видел покупатель: продавец не подменит её в последний момент
	local price = ownerData.Shop.Listings[weaponId]
	local weapon = ownerData.Weapons[weaponId]
	if not price or not weapon or price ~= expectedPrice then
		return { ok = false, err = "ERR_SHOP_GONE" }
	end
	if InventoryService:IsFull(player) then
		return { ok = false, err = "ERR_INVENTORY_FULL" }
	end
	if buyerData.Gold < price then
		return { ok = false, err = "ERR_NOT_ENOUGH_GOLD" }
	end
	if buyerData.Weapons[weaponId] then
		return { ok = false, err = "ERR_SHOP_GONE" } -- такой Id уже есть: защита от дюпа
	end

	-- ===== перенос одним блоком, без yield =====
	local received = EconomyService:TransferGold(player, owner, price, SH.TaxRate)
	if not received then
		return { ok = false, err = "ERR_NOT_ENOUGH_GOLD" }
	end
	local taken = InventoryService:TakeForTransfer(owner, weaponId) :: any
	InventoryService:GiveTransferred(player, taken)
	ownerData.Shop.Earned += received
	ownerData.Stats.ShopSales = (ownerData.Stats.ShopSales or 0) + 1
	-- ============================================

	DataService:Replicate(player, "Gold", "Weapons")
	DataService:Replicate(owner, "Gold", "Weapons", "EquippedWeapon", "Shop", "Stats")
	refreshPlayerStall(owner)

	MarketLog.Write("shop", {
		Seller = owner.UserId,
		Buyer = player.UserId,
		Price = price,
		Received = received,
		Weapon = MarketLog.Weapon(taken),
	})
	SystemService:Notify(owner, "Shop", "SYS_SHOP_SOLD_TITLE", "SYS_SHOP_SOLD_BODY", {
		weapon = `@WEAPON:{taken.Type}:{taken.Ore}`,
		buyer = player.DisplayName,
		price = price,
		gold = received,
	})
	task.spawn(DataService.SaveNow, DataService, player)
	task.spawn(DataService.SaveNow, DataService, owner)
	return { ok = true, weapon = taken, price = price }
end

local function fetch(_player: Player, ownerUserId: any)
	if not Guards.Integer(ownerUserId, 1, 1e15) then
		return { ok = false, err = "ERR_BAD_REQUEST" }
	end
	local owner = Players:GetPlayerByUserId(ownerUserId)
	if not owner or not DataService:IsLoaded(owner) then
		return { ok = false, err = "ERR_OWNER_OFFLINE" }
	end
	local payload = browsePayload(owner)
	payload.ok = true
	return payload
end

-- ===== Офлайн-продажи =====

local function processOffline(player: Player, data: any)
	local O = SH.Offline
	local last = data.Shop.LastOnlineAt
	local away = os.time() - last
	if last <= 0 or away < O.MinAwaySeconds then
		return
	end
	local hours = math.min(away / 3600, O.MaxHours)
	local sales = math.min(O.MaxSales, math.floor(hours * O.SalesPerHour))
	local sold, gold = 0, 0
	for _ = 1, sales do
		local ids = {}
		for id in data.Shop.Listings do
			if data.Weapons[id] then
				table.insert(ids, id)
			end
		end
		if #ids == 0 then
			break
		end
		local id = ids[rng:NextInteger(1, #ids)]
		local weapon = data.Weapons[id]
		local cap = math.floor(WeaponMath.SellPrice(weapon) * O.MaxPriceMult)
		local price = math.min(data.Shop.Listings[id], cap)
		local received = price - math.floor(price * SH.TaxRate + 0.5)
		InventoryService:RemoveWeapon(player, id, true)
		data.Gold += received
		data.Shop.Earned += received
		data.Stats.ShopSales = (data.Stats.ShopSales or 0) + 1
		sold += 1
		gold += received
		MarketLog.Write("offline", { Seller = player.UserId, Price = price, Received = received, Weapon = MarketLog.Weapon(weapon) })
	end
	if sold > 0 then
		DataService:Replicate(player, "Gold", "Weapons", "EquippedWeapon", "Shop", "Stats")
		task.delay(4, function()
			if DataService:IsLoaded(player) then
				SystemService:Notify(player, "Shop", "SYS_SHOP_OFFLINE_TITLE", "SYS_SHOP_OFFLINE_BODY", { count = sold, gold = gold })
			end
		end)
	end
end

function ShopService:Start()
	NetService:OnInvoke("ShopList", listWeapon)
	NetService:OnInvoke("ShopUnlist", unlistWeapon)
	NetService:OnInvoke("ShopBuy", buy)
	NetService:OnInvoke("ShopFetch", fetch)

	for _, stall in CollectionService:GetTagged(Config.Tags.ShopStall) do
		setupStall(stall)
	end
	CollectionService:GetInstanceAddedSignal(Config.Tags.ShopStall):Connect(setupStall)

	DataService.Loaded:Connect(function(player: Player, data: any)
		processOffline(player, data)
		data.Shop.LastOnlineAt = os.time()
		assignStall(player)
	end)
	DataService.Releasing:Connect(function(player: Player, data: any)
		data.Shop.LastOnlineAt = os.time()
		releaseStall(player)
	end)
	Players.PlayerRemoving:Connect(releaseStall)

	-- отметка «был в игре» на случай падения сервера
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in Players:GetPlayers() do
				local data = DataService:Get(player)
				if data then
					data.Shop.LastOnlineAt = os.time()
				end
			end
		end
	end)
end

function ShopService:HasStall(player: Player): boolean
	return playerStall[player] ~= nil
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">SocialService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	СОЦИАЛЬНЫЕ БОНУСЫ К ОПЫТУ: друзья на сервере и участие в группе Roblox.
	Итоговый бонус кладётся в атрибут игрока XpBonus (0.15 = +15%) — его показывает HUD.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local SocialService = {}

local S = Config.Social
local inGroup: { [Player]: boolean } = {}
local friends: { [Player]: { [Player]: boolean } } = {}

local function update(player: Player)
	if player.Parent ~= Players then
		return
	end
	local count = 0
	for other in friends[player] or {} do
		if other.Parent == Players then
			count += 1
		end
	end
	local bonus = math.min(S.MaxFriendXpBonus, count * S.FriendXpBonusPerFriend)
	if inGroup[player] then
		bonus += S.GroupXpBonus
	end
	player:SetAttribute("XpBonus", bonus)
end

local function checkGroup(player: Player)
	if S.GroupId <= 0 then
		return
	end
	local ok, result = pcall(function()
		return player:IsInGroup(S.GroupId)
	end)
	inGroup[player] = ok and result == true
end

local function checkFriends(player: Player)
	friends[player] = friends[player] or {}
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local ok, isFriend = pcall(function()
				return player:IsFriendsWith(other.UserId)
			end)
			if ok and isFriend then
				friends[player][other] = true
				friends[other] = friends[other] or {}
				friends[other][player] = true
				update(other)
			end
		end
	end
end

function SocialService:XpMult(player: Player): number
	local bonus = player:GetAttribute("XpBonus")
	return 1 + (if type(bonus) == "number" then bonus else 0)
end

function SocialService:Start()
	local function onAdded(player: Player)
		task.spawn(function()
			checkGroup(player)
			checkFriends(player)
			update(player)
		end)
	end
	Players.PlayerAdded:Connect(onAdded)
	for _, player in Players:GetPlayers() do
		onAdded(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local list = friends[player]
		friends[player] = nil
		inGroup[player] = nil
		if list then
			for other in list do
				if friends[other] then
					friends[other][player] = nil
					update(other)
				end
			end
		end
	end)
end

return SocialService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">SystemService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	«СИСТЕМА» — окна в стиле маньхуа. Сервер решает, ЧТО показать (ключи локализации),
	клиент — КАК (анимация, звук, язык).

	Kind: Awakening | Quest | QuestDone | LevelUp | Reward | Info | Warning | Boss |
	      GateCleared | GateFailed | Forge
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Types = require(ReplicatedStorage.Shared.Types)
local NetService = require(script.Parent.NetService)

local SystemService = {}

local function payload(kind: string, title: string, body: string?, args: { [string]: any }?): Types.NotifyPayload
	return { Kind = kind, Title = title, Body = body, Args = args }
end

function SystemService:Notify(player: Player, kind: string, title: string, body: string?, args: { [string]: any }?)
	NetService:Fire(player, "SystemNotify", payload(kind, title, body, args))
end

function SystemService:NotifyList(players: { Player }, kind: string, title: string, body: string?, args: { [string]: any }?)
	NetService:FireList(players, "SystemNotify", payload(kind, title, body, args))
end

-- Объявление на весь сервер (открытие Врат; в Этапе 2 — ковка Mythic+)
function SystemService:Announce(kind: string, title: string, body: string?, args: { [string]: any }?)
	NetService:FireAll("SystemNotify", payload(kind, title, body, args))
end

-- Короткое сообщение внизу экрана. key — ключ локализации.
function SystemService:Toast(player: Player, key: string, args: { [string]: any }?, color: string?)
	NetService:Fire(player, "Toast", { Key = key, Args = args, Color = color })
end

function SystemService:ToastList(players: { Player }, key: string, args: { [string]: any }?, color: string?)
	NetService:FireList(players, "Toast", { Key = key, Args = args, Color = color })
end

function SystemService:Error(player: Player, key: string, args: { [string]: any }?)
	SystemService:Toast(player, key, args, "error")
end

return SystemService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">TradeService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ОБМЕН МЕЖДУ ИГРОКАМИ.
	1. Подойди к игроку → подсказка «Обмен» → ему приходит приглашение (20 с).
	2. Оба кладут оружие и золото. Каждый видит настоящие характеристики предметов другого.
	3. «Готов» у обоих → через ConfirmDelaySeconds можно нажать «Подтвердить обмен».
	4. Подтвердили оба → сервер ещё раз всё проверяет и меняет предметы одним блоком без yield.

	Защита от скама:
	• любое изменение предложения увеличивает Version и сбрасывает «Готов»/«Подтвердить» у обоих;
	• подтверждение принимается только для той Version, которую видел игрок;
	• задержка перед подтверждением не даёт подменить предмет в последнюю секунду.
	Защита от дюпа: передача внутри одного потока, Id предметов сохраняются, оба профиля
	сохраняются сразу после сделки, запись в журнал (MarketLog).
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Char = require(script.Parent.Parent.Util.Char)
local Guards = require(script.Parent.Parent.Util.Guards)
local MarketLog = require(script.Parent.Parent.Util.MarketLog)
local Prompts = require(script.Parent.Parent.Util.Prompts)
local DataService = require(script.Parent.DataService)
local InventoryService = require(script.Parent.InventoryService)
local NetService = require(script.Parent.NetService)
local SystemService = require(script.Parent.SystemService)

local TradeService = {}

local TR = Config.Trading.Trade

type Offer = { Weapons: { string }, Gold: number }
type Session = {
	Id: string,
	A: Player,
	B: Player,
	Offers: { [Player]: Offer },
	Ready: { [Player]: boolean },
	Confirmed: { [Player]: boolean },
	Version: number,
	Phase: string, -- open | confirm
	ConfirmAt: number,
}

local sessions: { [Player]: Session } = {}
local pending: { [Player]: { From: Player, ExpiresAt: number } } = {} -- ключ — кого пригласили

local function other(s: Session, player: Player): Player
	return if s.A == player then s.B else s.A
end

local function sideView(s: Session, player: Player): { [string]: any }
	local data = DataService:Get(player)
	local offer = s.Offers[player]
	local weapons = {}
	if data then
		for _, id in offer.Weapons do
			local w = data.Weapons[id]
			if w then
				table.insert(weapons, w)
			end
		end
	end
	return {
		Weapons = weapons,
		Gold = offer.Gold,
		Ready = s.Ready[player] == true,
		Confirmed = s.Confirmed[player] == true,
	}
end

local function push(s: Session)
	local now = os.clock()
	for _, player in { s.A, s.B } do
		local partner = other(s, player)
		NetService:Fire(player, "TradeState", {
			Id = s.Id,
			Phase = s.Phase,
			Version = s.Version,
			PartnerName = partner.DisplayName,
			ConfirmIn = math.max(0, s.ConfirmAt - now),
			You = sideView(s, player),
			Them = sideView(s, partner),
		})
	end
end

local function finish(s: Session, phase: string, toastKey: string?)
	for _, player in { s.A, s.B } do
		if sessions[player] == s then
			sessions[player] = nil
		end
		if player.Parent == Players then
			NetService:Fire(player, "TradeState", { Id = s.Id, Phase = phase })
			if toastKey then
				SystemService:Toast(player, toastKey, nil, if phase == "done" then "success" else "error")
			end
		end
	end
end

local function resetConfirmations(s: Session)
	s.Version += 1
	s.Ready = {}
	s.Confirmed = {}
	s.Phase = "open"
	s.ConfirmAt = 0
end

-- ===== Приглашение =====

local function request(from: Player, to: Player)
	if from == to or not DataService:IsLoaded(from) or not DataService:IsLoaded(to) then
		return
	end
	for _, player in { from, to } do
		local data = DataService:Get(player)
		if data.Level < TR.MinLevel then
			SystemService:Error(from, "ERR_LEVEL_LOW", { level = TR.MinLevel })
			return
		end
	end
	if sessions[from] or sessions[to] then
		SystemService:Error(from, "ERR_TRADE_BUSY")
		return
	end
	pending[to] = { From = from, ExpiresAt = os.clock() + TR.RequestTimeoutSeconds }
	NetService:Fire(to, "TradeInvite", {
		FromUserId = from.UserId,
		FromName = from.DisplayName,
		Timeout = TR.RequestTimeoutSeconds,
	})
	SystemService:Toast(from, "TOAST_TRADE_SENT", { name = to.DisplayName })
end

local function respond(to: Player, fromUserId: any, accept: any)
	if not Guards.Integer(fromUserId, 1, 1e15) or not Guards.Boolean(accept) then
		return
	end
	local invite = pending[to]
	if not invite or invite.From.UserId ~= fromUserId then
		return
	end
	pending[to] = nil
	local from = invite.From
	if os.clock() > invite.ExpiresAt or from.Parent ~= Players then
		SystemService:Error(to, "ERR_TRADE_EXPIRED")
		return
	end
	if not accept then
		SystemService:Toast(from, "TOAST_TRADE_DECLINED", { name = to.DisplayName }, "error")
		return
	end
	if sessions[from] or sessions[to] or not DataService:IsLoaded(from) or not DataService:IsLoaded(to) then
		SystemService:Error(to, "ERR_TRADE_BUSY")
		return
	end
	local s: Session = {
		Id = HttpService:GenerateGUID(false),
		A = from,
		B = to,
		Offers = { [from] = { Weapons = {}, Gold = 0 }, [to] = { Weapons = {}, Gold = 0 } },
		Ready = {},
		Confirmed = {},
		Version = 1,
		Phase = "open",
		ConfirmAt = 0,
	}
	sessions[from] = s
	sessions[to] = s
	push(s)
end

-- ===== Предложение и подтверждения =====

local function sessionFor(player: Player, sessionId: any): Session?
	local s = sessions[player]
	if s and s.Id == sessionId then
		return s
	end
	return nil
end

local function setOffer(player: Player, sessionId: any, ids: any, gold: any)
	local s = sessionFor(player, sessionId)
	local data = DataService:Get(player)
	if not s or not data then
		return { ok = false, err = "ERR_TRADE_EXPIRED" }
	end
	if not Guards.StringArray(ids, TR.MaxItems, 64) then
		return { ok = false, err = "ERR_TOO_MANY_ITEMS", args = { max = TR.MaxItems } }
	end
	if not Guards.Integer(gold, 0, TR.MaxGold) or gold > data.Gold then
		return { ok = false, err = "ERR_NOT_ENOUGH_GOLD" }
	end
	local unique: { string } = {}
	local seen: { [string]: boolean } = {}
	for _, id in ids do
		if not seen[id] then
			seen[id] = true
			if not InventoryService:CanTransfer(player, id) then
				return { ok = false, err = if InventoryService:IsListed(player, id) then "ERR_LISTED" else "ERR_UNKNOWN_ITEM" }
			end
			table.insert(unique, id)
		end
	end
	s.Offers[player] = { Weapons = unique, Gold = gold }
	resetConfirmations(s)
	push(s)
	return { ok = true }
end

local function execute(s: Session)
	local A, B = s.A, s.B
	local dataA, dataB = DataService:Get(A), DataService:Get(B)
	local offerA, offerB = s.Offers[A], s.Offers[B]
	local valid = dataA ~= nil and dataB ~= nil
	if valid then
		for _, side in { { A, offerA, B }, { B, offerB, A } } do
			local giver, offer, receiver = side[1], side[2], side[3]
			local receiverData = DataService:Get(receiver)
			for _, id in offer.Weapons do
				if not InventoryService:CanTransfer(giver, id) or receiverData.Weapons[id] ~= nil then
					valid = false
				end
			end
			if DataService:Get(giver).Gold < offer.Gold then
				valid = false
			end
		end
		local countA = InventoryService:Count(A) - #offerA.Weapons + #offerB.Weapons
		local countB = InventoryService:Count(B) - #offerB.Weapons + #offerA.Weapons
		if countA > InventoryService:Capacity(A) or countB > InventoryService:Capacity(B) then
			valid = false
		end
	end
	if not valid then
		finish(s, "cancelled", "ERR_TRADE_FAILED")
		return
	end

	-- ===== перенос одним блоком, без yield =====
	local movedA, movedB = {}, {}
	for _, id in offerA.Weapons do
		local w = InventoryService:TakeForTransfer(A, id)
		if w then
			InventoryService:GiveTransferred(B, w)
			table.insert(movedA, MarketLog.Weapon(w))
		end
	end
	for _, id in offerB.Weapons do
		local w = InventoryService:TakeForTransfer(B, id)
		if w then
			InventoryService:GiveTransferred(A, w)
			table.insert(movedB, MarketLog.Weapon(w))
		end
	end
	dataA.Gold += offerB.Gold - offerA.Gold
	dataB.Gold += offerA.Gold - offerB.Gold
	dataA.Stats.Trades = (dataA.Stats.Trades or 0) + 1
	dataB.Stats.Trades = (dataB.Stats.Trades or 0) + 1
	-- ============================================

	for _, player in { A, B } do
		DataService:Replicate(player, "Gold", "Weapons", "EquippedWeapon", "Shop", "Stats")
	end
	MarketLog.Write("trade", {
		TradeId = s.Id,
		A = A.UserId,
		B = B.UserId,
		AGave = movedA,
		BGave = movedB,
		AGold = offerA.Gold,
		BGold = offerB.Gold,
	})
	finish(s, "done", "TOAST_TRADE_DONE")
	task.spawn(DataService.SaveNow, DataService, A)
	task.spawn(DataService.SaveNow, DataService, B)
end

local function ready(player: Player, sessionId: any, version: any, flag: any)
	local s = sessionFor(player, sessionId)
	if not s or not Guards.Boolean(flag) then
		return
	end
	if version ~= s.Version then
		push(s) -- клиент видел старое предложение — показать актуальное
		return
	end
	s.Ready[player] = flag
	s.Confirmed = {}
	if s.Ready[s.A] and s.Ready[s.B] then
		s.Phase = "confirm"
		s.ConfirmAt = os.clock() + TR.ConfirmDelaySeconds
	else
		s.Phase = "open"
		s.ConfirmAt = 0
	end
	push(s)
end

local function confirm(player: Player, sessionId: any, version: any)
	local s = sessionFor(player, sessionId)
	if not s then
		return
	end
	if s.Phase ~= "confirm" or version ~= s.Version or os.clock() < s.ConfirmAt then
		SystemService:Error(player, "ERR_TRADE_CHANGED")
		push(s)
		return
	end
	s.Confirmed[player] = true
	if s.Confirmed[s.A] and s.Confirmed[s.B] then
		execute(s)
	else
		push(s)
	end
end

local function cancel(player: Player, sessionId: any)
	local s = sessionFor(player, sessionId)
	if s then
		finish(s, "cancelled", "TOAST_TRADE_CANCELLED")
	end
end

-- ===== Подсказка «Обмен» над каждым игроком =====

local function addPrompt(player: Player, character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root or not root:IsA("BasePart") then
		return
	end
	local prompt = Prompts.Create(root, "PROMPT_TRADE_PLAYER", { Distance = TR.PromptDistance, HoldDuration = 0.25, KeyCode = Enum.KeyCode.T })
	prompt.Name = "TradePrompt"
	prompt.ObjectText = player.DisplayName
	prompt.Triggered:Connect(function(requester: Player)
		if requester ~= player and Char.IsAlive(requester) then
			request(requester, player)
		end
	end)
end

function TradeService:Start()
	NetService:OnEvent("TradeRespond", respond)
	NetService:OnInvoke("TradeSetOffer", setOffer)
	NetService:OnEvent("TradeReady", ready)
	NetService:OnEvent("TradeConfirm", confirm)
	NetService:OnEvent("TradeCancel", cancel)

	local function hook(player: Player)
		player.CharacterAdded:Connect(function(character)
			addPrompt(player, character)
		end)
		if player.Character then
			task.spawn(addPrompt, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in Players:GetPlayers() do
		hook(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		pending[player] = nil
		local s = sessions[player]
		if s then
			finish(s, "cancelled", "TOAST_TRADE_CANCELLED")
		end
	end)
end

return TradeService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">TutorialService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ОБУЧЕНИЕ = цепочка квестов Системы (Config.Tutorial).
	Цель: за первые ~60 секунд игрок добывает руду, куёт первое оружие и видит окно Системы.

	Другие сервисы просто сообщают о событиях:
		TutorialService:Record(player, "OreMined", { OreId = "Copper", Count = 2 })
]]

local AnalyticsService = game:GetService("AnalyticsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local SystemService = require(script.Parent.SystemService)
local LevelService = require(script.Parent.LevelService)
local EconomyService = require(script.Parent.EconomyService)

local TutorialService = {}

local Steps = Config.Tutorial.Steps

local function announce(player: Player, stepIndex: number)
	local step = Steps[stepIndex]
	if not step then
		return
	end
	if step.RewardGold > 0 then
		SystemService:Notify(player, "Quest", step.TitleKey, "SYS_QUEST_REWARD", { xp = step.RewardXp, gold = step.RewardGold })
	else
		SystemService:Notify(player, "Quest", step.TitleKey, "SYS_QUEST_REWARD_XP", { xp = step.RewardXp })
	end
end

function TutorialService:Record(player: Player, event: string, info: { OreId: string?, Count: number? }?)
	local data = DataService:Get(player)
	if not data or data.Tutorial.Done then
		return
	end
	local tutorial = data.Tutorial
	local step = Steps[tutorial.Step]
	if not step or step.Event ~= event then
		return
	end
	if step.OreId and (not info or info.OreId ~= step.OreId) then
		return
	end

	tutorial.Progress += (info and info.Count) or 1
	if tutorial.Progress < step.Count then
		DataService:Replicate(player, "Tutorial")
		return
	end

	-- шаг выполнен → воронка обучения в Creator Hub (Analytics → Funnels)
	pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, tutorial.Step + 1, step.Id)
	end)
	tutorial.Step += 1
	tutorial.Progress = 0
	local finished = tutorial.Step > #Steps
	if finished then
		tutorial.Done = true
	end
	DataService:Replicate(player, "Tutorial")

	SystemService:Notify(
		player,
		"QuestDone",
		step.TitleKey,
		if step.RewardGold > 0 then "SYS_REWARD_LINE" else "SYS_REWARD_LINE_XP",
		{ xp = step.RewardXp, gold = step.RewardGold }
	)
	if step.RewardGold > 0 then
		EconomyService:AddGold(player, step.RewardGold)
	end
	if step.RewardXp > 0 then
		LevelService:AddXp(player, step.RewardXp)
	end

	if finished then
		SystemService:Notify(player, "Reward", "SYS_TUTORIAL_DONE_TITLE", "SYS_TUTORIAL_DONE_BODY")
	else
		announce(player, tutorial.Step)
	end
end

function TutorialService:Start()
	DataService.Loaded:Connect(function(player: Player, data: any)
		if data.Tutorial.Done then
			return
		end
		task.delay(2, function()
			if not DataService:IsLoaded(player) then
				return
			end
			if not data.Tutorial.Awakened then
				pcall(function()
					AnalyticsService:LogOnboardingFunnelStepEvent(player, 1, "Awakened")
				end)
				data.Tutorial.Awakened = true
				DataService:Replicate(player, "Tutorial")
				SystemService:Notify(player, "Awakening", "SYS_AWAKEN_TITLE", "SYS_AWAKEN_BODY")
			end
			announce(player, data.Tutorial.Step)
		end)
	end)
end

return TutorialService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000037"><Properties><string name="Name">WorldMobService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	МОБЫ ОТКРЫТОГО МИРА: держат заданное число мобов в каждой зоне (Config.World.MobSpawns),
	возрождают их по таймеру, выдают награды (опыт, золото, руда).
	ЭЛИТНЫЙ МОНСТР: по таймеру появляется в зоне, объявление на весь сервер,
	награду получают все, кто нанёс хотя бы MinDamageShare его здоровья.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Char = require(script.Parent.Parent.Util.Char)
local WorldBuilder = require(script.Parent.Parent.World.WorldBuilder)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local LevelService = require(script.Parent.LevelService)
local MobService = require(script.Parent.MobService)
local ProgressService = require(script.Parent.ProgressService)
local SystemService = require(script.Parent.SystemService)

local WorldMobService = {}

local W = Config.World
local rng = Random.new()

type Spawner = {
	Def: any,
	Zone: any,
	RunId: string,
	Alive: { [any]: boolean },
	Count: number,
	Pending: { number }, -- времена будущих возрождений
}

local spawners: { Spawner } = {}
local byRunId: { [string]: Spawner } = {}
local elite: any = nil
local eliteDamage: { [Player]: number } = {}

local function playersNear(zone: any, extra: number): { Player }
	local list = {}
	local center = zone.Center
	for _, player in Players:GetPlayers() do
		local root = Char.Root(player)
		if root and Char.IsAlive(player) then
			local offset = root.Position - center
			if Vector3.new(offset.X, 0, offset.Z).Magnitude <= zone.Radius + extra then
				table.insert(list, player)
			end
		end
	end
	return list
end

local function spawnPoint(zone: any): Vector3
	for _ = 1, 12 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(12, zone.Radius * 0.8)
		local x, z = zone.Center.X + math.cos(angle) * r, zone.Center.Z + math.sin(angle) * r
		local y = WorldBuilder.GroundAt(x, z)
		if y < 1.5 then -- не на вершинах холмов: оттуда мобу не слезть
			return Vector3.new(x, y + 3, z)
		end
	end
	return zone.Center + Vector3.new(0, 4, 0)
end

local function spawnOne(spawner: Spawner)
	local zone = spawner.Zone
	local pos = spawnPoint(zone)
	local mob = MobService:Spawn(spawner.Def.Mob, CFrame.new(pos), {
		RunId = spawner.RunId,
		Home = pos,
		LeashRadius = W.LeashRadius,
		AggroRadius = W.AggroRadius,
		GetTargets = function()
			return playersNear(zone, W.LeashRadius)
		end,
	})
	if mob then
		spawner.Alive[mob] = true
		spawner.Count += 1
	end
end

local function rollDrops(player: Player, drops: { any }?)
	if not drops then
		return
	end
	for _, drop in drops do
		if rng:NextNumber() <= drop.Chance then
			local count = rng:NextInteger(drop.Min, drop.Max)
			EconomyService:AddOre(player, drop.OreId, count)
			SystemService:Toast(player, "TOAST_ORE", { count = count, ore = "@" .. Config.Ores[drop.OreId].NameKey }, "ore")
		end
	end
end

local function rewardKill(player: Player, def: any)
	if not DataService:IsLoaded(player) then
		return
	end
	LevelService:AddXp(player, def.XpReward)
	EconomyService:AddGold(player, def.GoldReward)
	DataService:AddStat(player, "MobsKilled", 1)
	rollDrops(player, def.Drops)
	ProgressService:Record(player, "MobKilled")
end

local function spawnElite()
	local E = W.Elite
	local zone = W.Zones[E.Zone]
	if not zone then
		return
	end
	table.clear(eliteDamage)
	elite = MobService:Spawn(E.Mob, CFrame.new(spawnPoint(zone) + Vector3.new(0, 4, 0)), {
		RunId = "elite",
		Home = zone.Center,
		LeashRadius = zone.Radius,
		AggroRadius = 55,
		HealthMult = 1 + math.max(0, #Players:GetPlayers() - 1) * 0.3,
		GetTargets = function()
			return playersNear(zone, 20)
		end,
	})
	if elite then
		SystemService:Announce("Elite", "SYS_ELITE_TITLE", "SYS_ELITE_BODY", {
			boss = "@" .. Config.Mobs[E.Mob].NameKey,
			zone = "@" .. zone.NameKey,
			pct = math.floor(E.MinDamageShare * 100 + 0.5),
		})
	end
end

local function onEliteDied(mob: any)
	local E = W.Elite
	elite = nil
	local need = mob.MaxHealth * E.MinDamageShare
	for player, damage in eliteDamage do
		if player.Parent == Players and damage >= need and DataService:IsLoaded(player) then
			EconomyService:AddGold(player, E.Rewards.Gold)
			LevelService:AddXp(player, E.Rewards.Xp)
			rollDrops(player, mob.Def.Drops)
			DataService:AddStat(player, "EliteKills", 1)
			DataService:AddStat(player, "BossesKilled", 1)
			ProgressService:Record(player, "MobKilled")
			SystemService:Notify(player, "Reward", "SYS_ELITE_DEFEATED_TITLE", "SYS_REWARD_LINE", {
				boss = "@" .. mob.Def.NameKey,
				gold = E.Rewards.Gold,
				xp = E.Rewards.Xp,
			})
		end
	end
	table.clear(eliteDamage)
end

function WorldMobService:Start()
	if not WorldBuilder.Built and not W.MobsOnCustomMap then
		return
	end
	for i, def in W.MobSpawns do
		local zone = W.Zones[def.Zone]
		if zone and Config.Mobs[def.Mob] then
			local spawner: Spawner = {
				Def = def,
				Zone = zone,
				RunId = `world:{i}`,
				Alive = {},
				Count = 0,
				Pending = {},
			}
			table.insert(spawners, spawner)
			byRunId[spawner.RunId] = spawner
			for _ = 1, def.Max do
				spawnOne(spawner)
			end
		end
	end

	MobService.MobDamaged:Connect(function(mob: any, amount: number, attacker: Player?)
		if mob == elite and attacker then
			eliteDamage[attacker] = (eliteDamage[attacker] or 0) + amount
		end
	end)

	MobService.MobDied:Connect(function(mob: any, killer: Player?)
		if mob.RunId == "elite" then
			onEliteDied(mob)
			return
		end
		local spawner = byRunId[mob.RunId]
		if not spawner then
			return
		end
		if spawner.Alive[mob] then
			spawner.Alive[mob] = nil
			spawner.Count -= 1
			table.insert(spawner.Pending, os.clock() + spawner.Def.RespawnSeconds)
		end
		if killer then
			rewardKill(killer, mob.Def)
		end
	end)

	task.spawn(function()
		local nextElite = os.clock() + W.Elite.FirstDelaySeconds
		while true do
			task.wait(1)
			local now = os.clock()
			for _, spawner in spawners do
				for i = #spawner.Pending, 1, -1 do
					if now >= spawner.Pending[i] then
						table.remove(spawner.Pending, i)
						if spawner.Count < spawner.Def.Max then
							spawnOne(spawner)
						end
					end
				end
			end
			if elite == nil and now >= nextElite then
				nextElite = now + W.Elite.IntervalSeconds
				local ok, err = pcall(spawnElite)
				if not ok then
					warn("[WorldMobs] элита:", err)
				end
			end
		end
	end)
end

return WorldMobService
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX0000003F"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">Char</string><ProtectedString name="Source"><![CDATA[--!strict
-- Быстрый доступ к персонажу игрока.

local Char = {}

function Char.Root(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Char.Humanoid(player: Player): Humanoid?
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChildOfClass("Humanoid")
end

function Char.IsAlive(player: Player): boolean
	local humanoid = Char.Humanoid(player)
	return humanoid ~= nil and humanoid.Health > 0 and Char.Root(player) ~= nil
end

return Char
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">DevMap</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ТЕСТОВАЯ КАРТА-ЗАГЛУШКА.
	Если в карте ещё нет ни одного объекта с тегами OreNode / Forge / Merchant / GateSpawn,
	сервер ставит простые блоки рядом со спавном, чтобы игру можно было проверить сразу по Play.
	Как только ты расставишь свои объекты с тегами — заглушка перестанет появляться.
	Каждый блок подписан, а теги/атрибуты на нём ровно такие, какие нужны твоим моделям.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DevMap = {}

local folder: Folder

local function label(part: BasePart, text: string)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 40)
	gui.StudsOffsetWorldSpace = Vector3.new(0, part.Size.Y / 2 + 1.5, 0)
	gui.MaxDistance = 60
	gui.LightInfluence = 0
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamBold
	t.TextScaled = true
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.4
	t.Text = text
	t.Parent = gui
	gui.Parent = part
end

local function block(name: string, size: Vector3, position: Vector3, color: Color3, tag: string?, text: string?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Position = position
	p.Anchored = true
	p.Color = color
	p.Material = Enum.Material.Plastic
	p.TopSurface = Enum.SurfaceType.Studs
	if tag then
		CollectionService:AddTag(p, tag)
	end
	if text then
		label(p, text)
	end
	p.Parent = folder
	return p
end

local function hasAny(tag: string): boolean
	return #CollectionService:GetTagged(tag) > 0
end

local function hasFloor(): boolean
	for _, child in workspace:GetChildren() do
		if child:IsA("BasePart") and child.Size.X >= 100 and child.Size.Z >= 100 then
			return true
		end
	end
	return workspace:FindFirstChild("Baseplate") ~= nil
end

function DevMap.BuildIfEmpty()
	local T = Config.Tags
	local needOres = not hasAny(T.OreNode)
	local needForge = not hasAny(T.Forge)
	local needMerchant = not hasAny(T.Merchant)
	local needGates = not hasAny(T.GateSpawn)
	if not (needOres or needForge or needMerchant or needGates) then
		return
	end

	folder = Instance.new("Folder")
	folder.Name = "DevMap_Placeholder"
	folder.Parent = workspace
	warn("[DevMap] Карта пустая — ставлю тестовые заглушки (папка Workspace/DevMap_Placeholder)")

	if not hasFloor() then
		block("DevFloor", Vector3.new(400, 2, 400), Vector3.new(0, -1, 0), Color3.fromRGB(70, 90, 70))
	end

	if needForge then
		block("Anvil (tag Forge)", Vector3.new(4, 3, 2), Vector3.new(0, 1.5, -22), Color3.fromRGB(50, 50, 55), T.Forge, "Forge")
		block("Furnace", Vector3.new(6, 6, 4), Vector3.new(6, 3, -26), Color3.fromRGB(120, 50, 30))
	end

	if needMerchant then
		block("Merchant (tag Merchant)", Vector3.new(3, 6, 3), Vector3.new(24, 3, -10), Color3.fromRGB(230, 190, 60), T.Merchant, "Merchant")
	end

	if needOres then
		local layout = {
			{ Ore = "Copper", X = -24, Count = 6 },
			{ Ore = "Iron", X = -40, Count = 4 },
			{ Ore = "Moonsilver", X = -56, Count = 3 },
		}
		for _, row in layout do
			for i = 1, row.Count do
				local z = -12 + (i - 1) * 7
				local node = block(`{row.Ore}Node (tag OreNode)`, Vector3.new(4, 4, 4), Vector3.new(row.X, 2, z), Color3.new(1, 1, 1), nil, nil)
				node:SetAttribute("OreId", row.Ore)
				CollectionService:AddTag(node, T.OreNode)
			end
		end
	end

	if needGates then
		for i, pos in { Vector3.new(30, 0.5, 30), Vector3.new(-10, 0.5, 45) } do
			local spawnPoint = block(`GateSpawn{i} (tag GateSpawn)`, Vector3.new(6, 1, 6), pos, Color3.fromRGB(40, 60, 120), T.GateSpawn)
			spawnPoint.Transparency = 0.5
			spawnPoint.CanCollide = false
		end
	end
end

return DevMap
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003B"><Properties><string name="Name">Guards</string><ProtectedString name="Source"><![CDATA[--!strict
-- Проверка аргументов, пришедших от клиента. Клиенту НЕ доверяем ничего.

local Guards = {}

function Guards.String(v: any, maxLen: number?): boolean
	return type(v) == "string" and #v > 0 and #v <= (maxLen or 64)
end

function Guards.Number(v: any, min: number?, max: number?): boolean
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
		return false
	end
	if min and v < min then
		return false
	end
	if max and v > max then
		return false
	end
	return true
end

function Guards.Integer(v: any, min: number?, max: number?): boolean
	return Guards.Number(v, min, max) and math.floor(v) == v
end

function Guards.Boolean(v: any): boolean
	return type(v) == "boolean"
end

-- Строгий массив: ключи 1..n без дыр и лишних полей
local function isArray(v: any, maxCount: number): boolean
	if type(v) ~= "table" then
		return false
	end
	local count = 0
	for k in v do
		if type(k) ~= "number" then
			return false
		end
		count += 1
		if count > maxCount then
			return false
		end
	end
	return count == #v
end

function Guards.StringArray(v: any, maxCount: number, maxLen: number?): boolean
	if not isArray(v, maxCount) then
		return false
	end
	for _, item in v do
		if not Guards.String(item, maxLen) then
			return false
		end
	end
	return true
end

function Guards.NumberArray(v: any, maxCount: number, min: number?, max: number?): boolean
	if not isArray(v, maxCount) then
		return false
	end
	for _, item in v do
		if not Guards.Number(item, min, max) then
			return false
		end
	end
	return true
end

return Guards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003C"><Properties><string name="Name">MarketLog</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ЖУРНАЛ СДЕЛОК (обмены и покупки в лавках).
	Каждая запись — в Output сервера и в DataStore Config.Trading.LogStoreName (ключ = Id сделки),
	чтобы при жалобе на скам или дюп можно было найти, кто кому что отдал.
	Посмотреть записи: Studio → View → Data Stores, или DataStoreService в командной строке.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local MarketLog = {}

local store: DataStore? = nil
local ok = pcall(function()
	store = DataStoreService:GetDataStore(Config.Trading.LogStoreName)
end)
if not ok then
	store = nil -- Studio без доступа к API: пишем только в Output
end

-- kind: "trade" | "shop" | "offline"
function MarketLog.Write(kind: string, record: { [string]: any }): string
	local id = HttpService:GenerateGUID(false)
	record.Kind = kind
	record.Time = os.time()
	record.Id = id
	local okJson, json = pcall(function()
		return HttpService:JSONEncode(record)
	end)
	print(`[Market] {if okJson then json else kind}`)
	local s = store
	if s then
		task.spawn(function()
			pcall(function()
				s:SetAsync(id, record)
			end)
		end)
	end
	return id
end

-- Краткое описание оружия для журнала
function MarketLog.Weapon(weapon: any): { [string]: any }
	return {
		Id = weapon.Id,
		Type = weapon.Type,
		Ore = weapon.Ore,
		Rarity = weapon.Rarity,
		Quality = weapon.Quality,
	}
end

return MarketLog
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003D"><Properties><string name="Name">Prompts</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Создание ProximityPrompt. Текст ставится по-английски, а ключи локализации
	кладутся в атрибуты ActionKey/ObjectKey — клиент сам переводит подсказку на свой язык.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Localization = require(ReplicatedStorage.Shared.Localization)

local Prompts = {}

export type PromptOptions = {
	ObjectKey: string?,
	Distance: number?,
	HoldDuration: number?,
	KeyCode: Enum.KeyCode?,
}

function Prompts.Create(parent: Instance, actionKey: string, options: PromptOptions?): ProximityPrompt
	local opts: PromptOptions = options or {}
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "GamePrompt"
	prompt.ActionText = Localization.Get(actionKey)
	prompt:SetAttribute("ActionKey", actionKey)
	if opts.ObjectKey then
		prompt.ObjectText = Localization.Get(opts.ObjectKey)
		prompt:SetAttribute("ObjectKey", opts.ObjectKey)
	end
	prompt.HoldDuration = opts.HoldDuration or 0
	prompt.MaxActivationDistance = opts.Distance or 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = opts.KeyCode or Enum.KeyCode.E
	prompt.Parent = parent
	return prompt
end

return Prompts
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003E"><Properties><string name="Name">Proximity</string><ProtectedString name="Source"><![CDATA[--!strict
-- Серверная проверка дистанции до объектов карты (кузня, торговец, жила).

local CollectionService = game:GetService("CollectionService")

local Char = require(script.Parent.Char)

local Proximity = {}

function Proximity.PositionOf(instance: Instance): Vector3?
	if instance:IsA("BasePart") then
		return instance.Position
	elseif instance:IsA("Model") then
		return instance:GetPivot().Position
	elseif instance:IsA("Attachment") then
		return instance.WorldPosition
	end
	return nil
end

function Proximity.DistanceTo(player: Player, position: Vector3): number
	local root = Char.Root(player)
	if not root then
		return math.huge
	end
	return (root.Position - position).Magnitude
end

-- Ближайший объект с тегом в пределах maxDistance (или nil)
function Proximity.NearTagged(player: Player, tag: string, maxDistance: number): Instance?
	local root = Char.Root(player)
	if not root then
		return nil
	end
	local best: Instance? = nil
	local bestDist = maxDistance
	for _, instance in CollectionService:GetTagged(tag) do
		if instance:IsDescendantOf(workspace) then
			local pos = Proximity.PositionOf(instance)
			if pos then
				local d = (root.Position - pos).Magnitude
				if d <= bestDist then
					best = instance
					bestDist = d
				end
			end
		end
	end
	return best
end

-- Куда повесить ProximityPrompt / Attachment для объекта
function Proximity.AnchorPart(instance: Instance): BasePart?
	if instance:IsA("BasePart") then
		return instance
	elseif instance:IsA("Model") then
		return instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

return Proximity
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000042"><Properties><string name="Name">World</string></Properties><Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">Stud</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	СТАД-СТИЛЬ: одна функция brick() для всех деталей мира (правила скилла Studify, RoClicks).

	• Материал всегда Plastic. Узор шипов на всех гранях задаётся по РОЛИ детали:
	    Universal   — большие заливки: земля, плиты, массивы холмов
	    StudsNoGrid — крыши, полы, шапки травы (в фолбэке без вариантов → Studs)
	    Weld        — конструкции: столбы, перила, рамы, ящики
	    Studs       — стены и акценты
	  Если в MaterialService есть варианты с этими именами — используются они (рендер сильнее),
	  иначе узор ставится через SurfaceType на каждую грань.
	• Neon — только акцент (свечение руды, горна, порталов, кристалла Системы), без узора.
	• Камни: узор Inlet только сверху, бока гладкие.
	• Детали меньше 0.5 во всех измерениях — чистый пластик без узора.
	• Защита от мерцания совпадающих граней: каждая деталь чуть больше заданного размера
	  (от 0.0002 до 0.02, по счётчику), поэтому у соседей грани никогда не совпадают в одной
	  плоскости, а стыки всегда «утоплены» друг в друга, а не разъезжаются щелью.
]]

local MaterialService = game:GetService("MaterialService")

local Stud = {}

local VARIANTS = { "Universal", "StudsNoGrid", "Weld", "Studs" }
local hasVariant: { [string]: boolean } = {}
for _, name in VARIANTS do
	hasVariant[name] = MaterialService:FindFirstChild(name, true) ~= nil
end
Stud.UsingVariants = hasVariant.Universal == true

local counter = 0

export type Options = {
	Pattern: string?, -- Universal | StudsNoGrid | Weld | Studs
	Class: string?, -- Part | WedgePart | CornerWedgePart
	Name: string?,
	Neon: boolean?,
	Rock: boolean?,
	Collide: boolean?,
	Transparency: number?,
	Shadow: boolean?,
	Shape: Enum.PartType?,
}

local function surfaceFor(pattern: string): Enum.SurfaceType
	if pattern == "Weld" then
		return Enum.SurfaceType.Weld
	elseif pattern == "Universal" then
		return Enum.SurfaceType.Universal
	end
	return Enum.SurfaceType.Studs -- Studs и StudsNoGrid
end

local function setAllSurfaces(p: BasePart, surface: Enum.SurfaceType)
	p.TopSurface = surface
	p.BottomSurface = surface
	p.FrontSurface = surface
	p.BackSurface = surface
	p.LeftSurface = surface
	p.RightSurface = surface
end

function Stud.brick(parent: Instance, size: Vector3, cframe: CFrame, color: Color3, options: Options?): BasePart
	local o: Options = options or {}
	local p = Instance.new(o.Class or "Part") :: BasePart
	if o.Shape and p:IsA("Part") then
		(p :: Part).Shape = o.Shape
	end
	counter += 1
	local eps = ((counter % 97) + 1) * 0.0002
	p.Size = size + Vector3.new(eps, eps, eps)
	p.CFrame = cframe
	p.Color = color
	p.Anchored = true
	p.CanCollide = if o.Collide == nil then true else o.Collide
	if o.Collide == false then
		p.CanQuery = false
		p.CanTouch = false
	end
	if o.Transparency then
		p.Transparency = o.Transparency
	end
	if o.Shadow == false then
		p.CastShadow = false
	end
	if o.Name then
		p.Name = o.Name
	end

	local tiny = size.X < 0.5 and size.Y < 0.5 and size.Z < 0.5
	if o.Neon then
		p.Material = Enum.Material.Neon
		setAllSurfaces(p, Enum.SurfaceType.Smooth)
	elseif tiny then
		p.Material = Enum.Material.Plastic
		setAllSurfaces(p, Enum.SurfaceType.Smooth)
	elseif o.Rock then
		p.Material = Enum.Material.Plastic
		setAllSurfaces(p, Enum.SurfaceType.Smooth)
		p.TopSurface = Enum.SurfaceType.Inlet
	else
		p.Material = Enum.Material.Plastic
		local pattern = o.Pattern or "Universal"
		if hasVariant[pattern] then
			p.MaterialVariant = pattern
			setAllSurfaces(p, Enum.SurfaceType.Smooth)
		else
			setAllSurfaces(p, surfaceFor(pattern))
			p.BottomSurface = Enum.SurfaceType.Inlet
		end
	end
	p.Parent = parent
	return p
end

function Stud.model(name: string, parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

-- Палитра стад-стиля (пастель, «солнечный» свет). Земля — лососевая, камень — лавандовый.
Stud.Color = {
	Grass = Color3.fromRGB(126, 179, 60),
	GrassDark = Color3.fromRGB(84, 165, 59),
	GrassBright = Color3.fromRGB(113, 206, 42),
	Tuft = Color3.fromRGB(77, 150, 54),
	Dirt = Color3.fromRGB(207, 109, 76),
	DirtRose = Color3.fromRGB(218, 120, 110),
	DirtDeep = Color3.fromRGB(176, 92, 88),
	Coral = Color3.fromRGB(232, 126, 120),
	CoralDark = Color3.fromRGB(218, 110, 108),
	Sand = Color3.fromRGB(236, 208, 150),
	Peach = Color3.fromRGB(243, 180, 128),
	PeachDark = Color3.fromRGB(230, 160, 110),
	Stone = Color3.fromRGB(150, 158, 218),
	StoneDark = Color3.fromRGB(122, 128, 194),
	StoneLight = Color3.fromRGB(180, 186, 236),
	Wood = Color3.fromRGB(165, 105, 62),
	WoodDark = Color3.fromRGB(136, 83, 52),
	Water = Color3.fromRGB(64, 200, 240),
	Snow = Color3.fromRGB(236, 244, 255),
	Frost = Color3.fromRGB(190, 222, 250),
	Ice = Color3.fromRGB(160, 210, 250),
	Red = Color3.fromRGB(226, 72, 72),
	White = Color3.fromRGB(250, 248, 244),
	Gold = Color3.fromRGB(250, 196, 60),
	Blue = Color3.fromRGB(2, 106, 175),
	Roof = Color3.fromRGB(196, 72, 62),
	RoofDark = Color3.fromRGB(160, 56, 52),
	Iron = Color3.fromRGB(96, 100, 112),
	Ember = Color3.fromRGB(255, 136, 40),
	SystemBlue = Color3.fromRGB(88, 190, 255),
}

return Stud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000041"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ГЕНЕРАТОР МИРА В СТАД-СТИЛЕ (правила скилла Studify, RoClicks).
	Всё из деталей Plastic с узором шипов, без Terrain и без гладких материалов.
	Строится один раз при старте сервера, если в карте нет своих объектов с тегом OreNode.
	Детерминированный (Config.World.Seed): одинаковый мир на всех серверах.

	Раскладка (не менялась с прошлых этапов, это наш согласованный блок-аут):
	  Угольный Оплот (0, 0)        — площадь, фонтан с Кристаллом Системы, кузня, лавка, доски, Торговый ряд
	  Медные холмы (-200, 20)      — холмы из лососевой земли с травяными шапками, деревья, медь
	  Карьер Железный Клык (10,-210) — лавандовый камень, каменное кольцо с проходом, вагонетки, железо
	  Грот лунного серебра (210,-10) — зимний рескин: снег, морозные ели, ледяные кристаллы, лунное серебро
	  Равнина Врат (0, 210)        — каменные площадки для порталов
	  Озеро (130, 125), дорожки из плиток, кольцо плато по краю карты.

	Контракты с игровыми сервисами (теги и имена) те же, что раньше: Forge, Merchant, Leaderboard,
	GateSpawn, OreNode (+OreId), ShopStall (+Slot, Counter, Pedestal1..3, Owner), Spin.
	Все детали мира — пустые для игроков визуально, кроме того, что в папке Ground (по ней ходят).
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Stud = require(script.Parent.Stud)

local W = Config.World
local T = Config.Tags
local C = Stud.Color
local brick = Stud.brick
local model = Stud.model

local WorldBuilder = {}

WorldBuilder.Built = false -- true, если мир построен кодом (зоны совпадают с Config.World)

local rng = Random.new(W.Seed)
local root: Folder
local ground: Folder -- всё, по чему ходят (для GroundAt)

local function deg(d: number): number
	return math.rad(d)
end

local function yaw15(): number
	return deg(15 * rng:NextInteger(0, 23))
end

-- ===== Земля =====

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local function groundAt(x: number, z: number): number
	local hit = workspace:Raycast(Vector3.new(x, 250, z), Vector3.new(0, -500, 0), rayParams)
	return if hit then hit.Position.Y else 0
end

local function groundPos(x: number, z: number): Vector3
	return Vector3.new(x, groundAt(x, z), z)
end

-- Круг из горизонтальных полос: ступенчатый контур вместо гладкого (стиль «всё террасами»)
local function disc(parent: Instance, cx: number, cz: number, radius: number, bottom: number, thick: number, color: Color3, options: Stud.Options?)
	local strips = math.max(6, math.floor(radius / 6))
	local band = 2 * radius / strips
	for i = 0, strips - 1 do
		local zc = -radius + band * (i + 0.5)
		local half = math.floor(math.sqrt(math.max(0, radius * radius - zc * zc)) / 2) * 2
		if half >= 2 then
			brick(parent, Vector3.new(half * 2, thick, band), CFrame.new(cx, bottom + thick / 2, cz + zc), color, options)
		end
	end
end

local function inDisc(x: number, z: number, cx: number, cz: number, r: number): boolean
	return (x - cx) ^ 2 + (z - cz) ^ 2 <= r * r
end

-- ===== Торговый ряд: координаты =====

local MARKET_X0 = 48
local MARKET_STEP = 14
local MARKET_ROW_A = 44 -- прилавки смотрят на +Z
local MARKET_ROW_B = 76 -- прилавки смотрят на −Z
local PLAZA_R = 30

local function inMarket(x: number, z: number): boolean
	return x > MARKET_X0 - 12 and x < MARKET_X0 + MARKET_STEP * 8 + 4 and z > MARKET_ROW_A - 10 and z < MARKET_ROW_B + 10
end

local function nearRoad(x: number, z: number, width: number): boolean
	for _, zone in W.Zones do
		if zone.Id ~= "Town" then
			local dir = Vector3.new(zone.Center.X, 0, zone.Center.Z)
			local len = dir.Magnitude
			local unit = dir.Unit
			local point = Vector3.new(x, 0, z)
			local t = math.clamp(point:Dot(unit), 0, len)
			if (point - unit * t).Magnitude < width then
				return true
			end
		end
	end
	return false
end

-- Занятые места: разные объекты не должны пересекаться (дерево не растёт сквозь кузню)
local reserved: { { X: number, Z: number, R: number } } = {}

local function reserve(x: number, z: number, r: number)
	table.insert(reserved, { X = x, Z = z, R = r })
end

local function free(x: number, z: number, r: number): boolean
	for _, o in reserved do
		if (o.X - x) ^ 2 + (o.Z - z) ^ 2 < (o.R + r) ^ 2 then
			return false
		end
	end
	return true
end

-- свободно и не на дороге/рынке; при успехе место занимается
local function claim(x: number, z: number, r: number, roadGap: number): boolean
	if not free(x, z, r) or inMarket(x, z) or nearRoad(x, z, roadGap) then
		return false
	end
	reserve(x, z, r)
	return true
end

local function randomInZone(zone: any, minR: number, maxR: number): (number, number)
	local angle = rng:NextNumber(0, math.pi * 2)
	local r = rng:NextNumber(minR, maxR)
	return zone.Center.X + math.cos(angle) * r, zone.Center.Z + math.sin(angle) * r
end

-- ===== Мелкие помощники =====

local function light(parent: BasePart, color: Color3, range: number, brightness: number)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = parent
end

-- Подпись над зданием. Текст переводит клиент по атрибуту LocKey.
local function sign(parent: BasePart, locKey: string, height: number)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(180, 36)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height, 0)
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Text = locKey
	label:SetAttribute("LocKey", locKey)
	label.TextColor3 = C.White
	label.TextStrokeColor3 = Color3.fromRGB(40, 30, 30)
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	gui.Parent = parent
end

-- Ориентация «лицом» (локальная −Z) к точке, с шагом 15°
local function facing(pos: Vector3, target: Vector3): CFrame
	local d = target - pos
	local yaw = math.atan2(-d.X, -d.Z)
	yaw = math.rad(math.floor(math.deg(yaw) / 15 + 0.5) * 15)
	return CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
end

-- ===== Природа =====

-- Пучок травы: 3-4 травинки веером с наклоном 15°
local function tuft(parent: Instance, pos: Vector3)
	local m = model("Tuft", parent)
	local n = rng:NextInteger(3, 4)
	local base = yaw15()
	for i = 1, n do
		local h = rng:NextNumber(0.8, 1.5)
		local lean = if i % 2 == 0 then 15 else -15
		brick(
			m,
			Vector3.new(0.3, h, 0.3),
			CFrame.new(pos) * CFrame.Angles(0, base + deg(i * 60), 0) * CFrame.Angles(deg(lean), 0, 0) * CFrame.new(0, h / 2, 0),
			C.Tuft,
			{ Pattern = "Studs", Collide = false, Shadow = false }
		)
	end
end

-- Плоский цветок «плюсом»: серединка и 4 лепестка
local function flower(parent: Instance, pos: Vector3, petal: Color3)
	local m = model("Flower", parent)
	local y = pos.Y + 0.15
	brick(m, Vector3.new(0.6, 0.3, 0.6), CFrame.new(pos.X, y + 0.05, pos.Z), C.Gold, { Collide = false, Shadow = false })
	for _, o in { Vector3.new(0.6, 0, 0), Vector3.new(-0.6, 0, 0), Vector3.new(0, 0, 0.6), Vector3.new(0, 0, -0.6) } do
		brick(m, Vector3.new(0.6, 0.3, 0.6), CFrame.new(pos.X + o.X, y, pos.Z + o.Z), petal, { Collide = false, Shadow = false })
	end
end

local FLOWER_COLORS = { C.Red, C.White, Color3.fromRGB(240, 120, 200), Color3.fromRGB(140, 120, 255) }

local function scatter(parent: Instance, zone: any, minR: number, maxR: number, tufts: number, flowers: number)
	for _ = 1, tufts do
		local x, z = randomInZone(zone, minR, maxR)
		if not nearRoad(x, z, 6) and not inMarket(x, z) and free(x, z, 1) then
			tuft(parent, groundPos(x, z))
		end
	end
	for _ = 1, flowers do
		local x, z = randomInZone(zone, minR, maxR)
		if not nearRoad(x, z, 6) and not inMarket(x, z) and free(x, z, 1) then
			flower(parent, groundPos(x, z), FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)])
		end
	end
end

-- Дерево-«блоб» (воксельная сфера на высоком коралловом стволе, корни растут из ствола)
local function blobTree(parent: Instance, pos: Vector3, scale: number, leaf: Color3, leaf2: Color3)
	local m = model("Tree", parent)
	local trunkH = 9 * scale
	local segH = trunkH / 4
	local tw = 2.8 * scale
	for i = 0, 3 do
		local off = if i % 2 == 0 then 0.2 else -0.2
		brick(
			m,
			Vector3.new(tw, segH + 0.3, tw),
			CFrame.new(pos + Vector3.new(off, segH * (i + 0.5), -off)),
			if i % 2 == 0 then C.Coral else C.CoralDark,
			{ Pattern = "Weld" }
		)
	end
	-- корни: из боковины ствола на высоте ~2 вниз под 45°, с «носком» на земле
	for i = 1, 3 do
		local a = deg(120 * i + 30)
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local start = pos + dir * (tw / 2) + Vector3.new(0, 2, 0)
		local toe = pos + dir * (tw / 2 + 1.8) + Vector3.new(0, 0.3, 0)
		local mid = (start + toe) / 2
		brick(m, Vector3.new(1, 1, (start - toe).Magnitude + 0.4), CFrame.lookAt(mid, toe), C.CoralDark, { Pattern = "Weld", Collide = false })
		brick(m, Vector3.new(1.4, 0.6, 1.4), CFrame.new(toe), C.Coral, { Pattern = "Weld", Collide = false })
	end
	-- крона: 6 ярусов по округлому профилю + выступы
	local maxW = 10 * scale
	local profile = { 0.55, 0.85, 1.0, 0.95, 0.75, 0.45 }
	local y0 = pos.Y + trunkH - 1
	for i, k in profile do
		local w = maxW * k
		local cy = y0 + (i - 0.5) * 1.6 * scale
		local jx, jz = rng:NextNumber(-0.8, 0.8), rng:NextNumber(-0.8, 0.8)
		brick(m, Vector3.new(w, 1.6 * scale, w), CFrame.new(pos.X + jx, cy, pos.Z + jz), leaf, { Pattern = "StudsNoGrid", Collide = false })
		if i >= 2 and i <= 5 then
			for _ = 1, 2 do
				local a = rng:NextNumber(0, math.pi * 2)
				local b = rng:NextNumber(1.6, 2.8) * scale
				local r = w / 2
				brick(
					m,
					Vector3.new(b, b * 0.8, b),
					CFrame.new(pos.X + jx + math.cos(a) * r, cy, pos.Z + jz + math.sin(a) * r),
					if rng:NextNumber() < 0.4 then leaf2 else leaf,
					{ Pattern = "StudsNoGrid", Collide = false }
				)
			end
		end
	end
	-- ветка: три звена, каждое поднимается круче и уходит в низ кроны
	local p = pos + Vector3.new(tw / 2, trunkH * 0.6, 0)
	local dir = Vector3.new(1, 0.4, 0.2).Unit
	for i = 1, 3 do
		local nextP = p + dir * (1.8 * scale)
		brick(
			m,
			Vector3.new(0.9 - i * 0.15, 0.9 - i * 0.15, (nextP - p).Magnitude + 0.3),
			CFrame.lookAt((p + nextP) / 2, nextP),
			if i % 2 == 0 then C.Coral else C.CoralDark,
			{ Pattern = "Weld", Collide = false }
		)
		p = nextP
		dir = (dir + Vector3.new(0, 0.45, 0)).Unit
	end
	m.PrimaryPart = m:FindFirstChildWhichIsA("BasePart")
end

-- Ярусная ель (зимний рескин): ярусы 8,5,7,4,5,2 по центру ствола, снежные шапки
local function pineTree(parent: Instance, pos: Vector3, scale: number)
	local m = model("FrostPine", parent)
	local trunkH = 3 * scale
	brick(m, Vector3.new(1.6 * scale, trunkH, 1.6 * scale), CFrame.new(pos + Vector3.new(0, trunkH / 2, 0)), C.WoodDark, { Pattern = "Weld" })
	local widths = { 8, 5, 7, 4, 5, 2 }
	local y = pos.Y + trunkH
	for i, w in widths do
		local ww = w * scale
		local h = 1.4 * scale
		brick(m, Vector3.new(ww, h, ww), CFrame.new(pos.X, y + h / 2, pos.Z), if i % 2 == 0 then C.Frost else C.Ice, { Pattern = "StudsNoGrid", Collide = i == 1 })
		brick(m, Vector3.new(ww * 0.8, 0.3, ww * 0.8), CFrame.new(pos.X, y + h + 0.15, pos.Z), C.Snow, { Pattern = "StudsNoGrid", Collide = false })
		y += h
	end
end

-- Камень: 2-3 плиты с разным поворотом на 15°, узор Inlet только сверху
local function rock(parent: Instance, pos: Vector3, scale: number, tones: { Color3 }): Model
	local m = model("Rock", parent)
	local n = rng:NextInteger(2, 3)
	local y = pos.Y
	for i = 1, n do
		local w = rng:NextNumber(2.6, 4.2) * scale * (1 - (i - 1) * 0.25)
		local h = rng:NextNumber(1.2, 2) * scale
		local d = rng:NextNumber(2.4, 3.8) * scale * (1 - (i - 1) * 0.25)
		brick(
			m,
			Vector3.new(w, h, d),
			CFrame.new(pos.X + rng:NextNumber(-0.4, 0.4), y + h / 2, pos.Z + rng:NextNumber(-0.4, 0.4)) * CFrame.Angles(0, yaw15(), 0),
			tones[rng:NextInteger(1, #tones)],
			{ Rock = true }
		)
		y += h * 0.85
	end
	m.PrimaryPart = m:FindFirstChildWhichIsA("BasePart")
	return m
end

-- Холм: 2-4 перекрывающихся блока земли с травяными шапками (растёт из земли, а не лежит на ней)
local function hill(parent: Instance, pos: Vector3)
	local m = model("Hill", parent)
	local n = rng:NextInteger(2, 4)
	for i = 1, n do
		local w = rng:NextNumber(12, 26)
		local d = rng:NextNumber(10, 22)
		local h = rng:NextNumber(3, 8) * (if i == 1 then 1.2 else 0.8)
		local yaw = deg(15 * rng:NextInteger(0, 2))
		local c = CFrame.new(pos + Vector3.new(rng:NextNumber(-8, 8), 0, rng:NextNumber(-8, 8))) * CFrame.Angles(0, yaw, 0)
		brick(m, Vector3.new(w, h, d), c * CFrame.new(0, h / 2, 0), if i % 2 == 0 then C.DirtRose else C.Dirt)
		brick(m, Vector3.new(w + 2, 1.6, d + 2), c * CFrame.new(0, h + 0.8, 0), C.Grass, { Pattern = "StudsNoGrid" })
	end
	m.Parent = ground
end

-- Плато края карты: 2-3 уменьшающихся яруса, у каждого травяная шапка и «нос»
local function plateau(parent: Instance, center: CFrame, length: number, depth: number, totalH: number, darkLower: boolean): number
	local m = model("Plateau", parent)
	local tiers = if totalH >= 22 then 3 else 2
	local y = 0
	local l, d = length, depth
	for i = 1, tiers do
		local h = totalH / tiers
		local off = CFrame.new(rng:NextNumber(-l * 0.08, l * 0.08), 0, rng:NextNumber(-d * 0.1, d * 0.1))
		local c = center * off
		local tone = if i == 1 and darkLower then C.DirtDeep elseif i % 2 == 0 then C.DirtRose else C.Dirt
		brick(m, Vector3.new(l, h, d), c * CFrame.new(0, y + h / 2, 0), tone)
		brick(m, Vector3.new(l + 2, 1.4, d + 2), c * CFrame.new(0, y + h + 0.7, 0), C.Grass, { Pattern = "StudsNoGrid" })
		-- нос: небольшой выступ, ломающий прямой край
		brick(m, Vector3.new(4, h * 0.6, 3), c * CFrame.new(rng:NextNumber(-l / 3, l / 3), y + h * 0.3, -d / 2 - 1.4), tone)
		y += h
		l *= rng:NextNumber(0.6, 0.75)
		d *= rng:NextNumber(0.6, 0.75)
	end
	m.Parent = ground
	return y + 1.4
end

-- ===== Жила руды =====

local function oreNode(parent: Instance, position: Vector3, oreId: string)
	local ore = Config.Ores[oreId]
	local tones = if oreId == "Moonsilver" then { C.StoneLight, C.Frost } else { C.Stone, C.StoneDark }
	local m = rock(parent, position, 1.3, tones)
	m.Name = oreId .. "Node"
	local main = m.PrimaryPart :: BasePart
	for i = 1, 3 do
		local a = deg(120 * i + rng:NextInteger(0, 2) * 15)
		local r = main.Size.X / 2
		brick(
			m,
			Vector3.new(1.2, rng:NextNumber(1.4, 2.2), 1.2),
			CFrame.new(main.Position + Vector3.new(math.cos(a) * r, rng:NextNumber(0, 1), math.sin(a) * r)) * CFrame.Angles(0, a, deg(15)),
			ore.Color,
			{ Neon = oreId == "Moonsilver", Pattern = "Studs", Collide = false }
		)
	end
	m:SetAttribute("OreId", oreId)
	m:SetAttribute("AutoStyle", false)
	CollectionService:AddTag(m, T.OreNode)
end

-- ===== Город =====

local function lamp(parent: Instance, pos: Vector3)
	local m = model("Lamp", parent)
	brick(m, Vector3.new(1.6, 0.6, 1.6), CFrame.new(pos + Vector3.new(0, 0.3, 0)), C.StoneDark)
	brick(m, Vector3.new(0.8, 8, 0.8), CFrame.new(pos + Vector3.new(0, 4.6, 0)), C.WoodDark, { Pattern = "Weld" })
	brick(m, Vector3.new(1.4, 1.6, 1.4), CFrame.new(pos + Vector3.new(0, 9.4, 0)), C.Iron, { Pattern = "Weld" })
	local core = brick(m, Vector3.new(1, 1, 1.5), CFrame.new(pos + Vector3.new(0, 9.4, 0)), Color3.fromRGB(255, 214, 150), { Neon = true, Collide = false })
	brick(m, Vector3.new(1.8, 0.4, 1.8), CFrame.new(pos + Vector3.new(0, 10.4, 0)), C.Iron, { Pattern = "Weld" })
	light(core, Color3.fromRGB(255, 200, 140), 18, 1.2)
end

local function crate(parent: Instance, cf: CFrame, size: number)
	local m = model("Crate", parent)
	brick(m, Vector3.new(size, size, size), cf, C.Gold, { Pattern = "Weld" })
	local h = size / 2
	for _, x in { -h, h } do
		for _, z in { -h, h } do
			brick(m, Vector3.new(0.4, size + 0.1, 0.4), cf * CFrame.new(x, 0, z), C.WoodDark, { Pattern = "Weld" })
		end
	end
	brick(m, Vector3.new(size + 0.1, 0.4, size + 0.1), cf * CFrame.new(0, h, 0), C.WoodDark, { Pattern = "Weld" })
end

local function buildSmithy(parent: Instance, pos: Vector3)
	local m = model("Smithy", parent)
	local b = facing(pos, Vector3.new(0, pos.Y, 0))
	local function at(x: number, y: number, z: number): CFrame
		return b * CFrame.new(x, y, z)
	end
	-- основание и ступень
	brick(m, Vector3.new(24, 1, 18), at(0, 0.5, 0), C.StoneDark, { Pattern = "StudsNoGrid" })
	brick(m, Vector3.new(10, 0.5, 2), at(0, 0.25, -10), C.Stone)
	-- задняя стена с поясом и окном-нишей
	brick(m, Vector3.new(24, 11, 1), at(0, 6.5, 8.5), C.Dirt, { Pattern = "Studs" })
	brick(m, Vector3.new(24.4, 0.6, 1.4), at(0, 5, 8.5), C.DirtDeep, { Pattern = "Weld" })
	-- боковые полустены
	for _, x in { -11.5, 11.5 } do
		brick(m, Vector3.new(1, 4, 16), at(x, 3, 0.5), C.Dirt, { Pattern = "Studs" })
		brick(m, Vector3.new(1.4, 0.6, 16.4), at(x, 5.3, 0.5), C.DirtDeep, { Pattern = "Weld" })
	end
	-- столбы и балка фасада
	for _, x in { -11.6, 11.6 } do
		for _, z in { -8.6, 8.6 } do
			brick(m, Vector3.new(1.2, 12, 1.2), at(x, 7, z), C.Wood, { Pattern = "Weld" })
		end
	end
	brick(m, Vector3.new(24.6, 1, 1), at(0, 12.6, -8.6), C.WoodDark, { Pattern = "Weld" })
	-- ступенчатая крыша
	for i = 1, 5 do
		local w = 27 - (i - 1) * 3
		local d = 18 - (i - 1) * 3
		brick(m, Vector3.new(w, 1.2, d), at(0, 13.7 + (i - 1) * 1.2, 0), if i % 2 == 0 then C.RoofDark else C.Roof, { Pattern = "StudsNoGrid" })
	end
	-- труба за задней стеной, тлеющая сверху
	brick(m, Vector3.new(3, 22, 3), at(-7, 11, 10.5), C.DirtDeep, { Pattern = "Studs" })
	brick(m, Vector3.new(3.6, 0.6, 3.6), at(-7, 22.3, 10.5), C.StoneDark, { Pattern = "Weld" })
	local ember = brick(m, Vector3.new(2, 0.3, 2), at(-7, 22.7, 10.5), C.Ember, { Neon = true, Collide = false })
	local smoke = Instance.new("ParticleEmitter")
	smoke.Rate = 4
	smoke.Lifetime = NumberRange.new(2, 3)
	smoke.Speed = NumberRange.new(2, 3)
	smoke.Size = NumberSequence.new(1.5, 4)
	smoke.Transparency = NumberSequence.new(0.4, 1)
	smoke.Color = ColorSequence.new(Color3.fromRGB(120, 120, 130))
	smoke.Parent = ember
	-- горн: главный «светящийся» момент сцены
	brick(m, Vector3.new(7, 1, 5), at(-7, 1.5, 5.5), C.StoneDark)
	brick(m, Vector3.new(6, 5, 4), at(-7, 4.5, 5.5), C.RoofDark, { Pattern = "Studs" })
	brick(m, Vector3.new(6.6, 0.8, 4.6), at(-7, 7.4, 5.5), C.StoneDark, { Pattern = "Weld" })
	local fire = brick(m, Vector3.new(3, 2, 0.6), at(-7, 3.6, 3.4), C.Ember, { Neon = true, Collide = false })
	light(fire, Color3.fromRGB(255, 140, 60), 20, 2.5)
	local sparks = Instance.new("ParticleEmitter")
	sparks.Rate = 10
	sparks.Lifetime = NumberRange.new(0.5, 1)
	sparks.Speed = NumberRange.new(2, 4)
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 190, 80), Color3.fromRGB(255, 80, 20))
	sparks.Size = NumberSequence.new(0.4, 0)
	sparks.LightEmission = 1
	sparks.Parent = fire
	-- наковальня (тег Forge)
	local anvil = model("Anvil", m)
	brick(anvil, Vector3.new(3, 0.6, 2.2), at(2, 1.3, -1), C.Iron, { Pattern = "Weld" })
	brick(anvil, Vector3.new(1.6, 1.4, 1.2), at(2, 2.3, -1), C.Iron, { Pattern = "Weld" })
	local top = brick(anvil, Vector3.new(4, 0.8, 1.8), at(2, 3.4, -1), C.Iron, { Pattern = "Weld", Name = "Top" })
	brick(anvil, Vector3.new(1.2, 0.6, 1.2), at(4.6, 3.4, -1), C.Iron, { Pattern = "Weld" })
	brick(anvil, Vector3.new(0.8, 0.4, 0.8), at(5.6, 3.4, -1), C.Iron)
	anvil.PrimaryPart = top
	anvil.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	CollectionService:AddTag(anvil, T.Forge)
	sign(top, "UI_FORGE_TITLE", 6)
	-- бочка для закалки
	brick(m, Vector3.new(3, 2, 3), at(7, 2, 2), C.Wood, { Pattern = "Weld" })
	brick(m, Vector3.new(3.4, 0.4, 3.4), at(7, 2.6, 2), C.WoodDark, { Pattern = "Weld" })
	brick(m, Vector3.new(2.4, 0.2, 2.4), at(7, 3.05, 2), C.Water, { Collide = false })
	-- стойка с инструментами на задней стене
	brick(m, Vector3.new(7, 3, 0.4), at(5, 7, 7.8), C.Wood, { Pattern = "Weld" })
	for i = 1, 3 do
		local x = 2.6 + i * 1.6
		brick(m, Vector3.new(0.3, 2.2, 0.3), at(x, 6.6, 7.4), C.WoodDark)
		brick(m, Vector3.new(1, 0.6, 0.6), at(x, 7.8, 7.4), C.Iron, { Pattern = "Weld" })
	end
	-- изобретение: вагонетка с рассыпанной медью у входа
	local cart = model("OreCart", m)
	brick(cart, Vector3.new(4, 2, 3), at(-9, 2, -12), C.Iron, { Pattern = "Weld" })
	for _, x in { -1.4, 1.4 } do
		brick(cart, Vector3.new(0.6, 1, 3.4), at(-9 + x, 0.6, -12), C.WoodDark, { Pattern = "Weld" })
	end
	for i = 1, 6 do
		local cx = -9 + rng:NextNumber(-1.4, 1.4)
		local cz = -12 + rng:NextNumber(-1, 1)
		brick(cart, Vector3.new(0.8, 0.8, 0.8), at(cx, 3.2, cz) * CFrame.Angles(0, deg(15 * i), 0), Config.Ores.Copper.Color, { Collide = false })
	end
	for i = 1, 3 do
		brick(cart, Vector3.new(0.7, 0.5, 0.7), at(-6.5 + i * 0.9, 0.25, -13.2 + i * 0.4) * CFrame.Angles(0, deg(30 * i), 0), Config.Ores.Copper.Color, { Collide = false })
	end
end

local function buildMerchant(parent: Instance, pos: Vector3)
	local m = model("MerchantStall", parent)
	local b = facing(pos, Vector3.new(0, pos.Y, 0))
	local function at(x: number, y: number, z: number): CFrame
		return b * CFrame.new(x, y, z)
	end
	brick(m, Vector3.new(14, 0.6, 10), at(0, 0.3, 0), C.Wood, { Pattern = "StudsNoGrid" })
	for _, x in { -6.4, 6.4 } do
		for _, z in { -4.4, 4.4 } do
			brick(m, Vector3.new(0.9, 9, 0.9), at(x, 5.1, z), C.WoodDark, { Pattern = "Weld" })
		end
	end
	-- прилавок
	brick(m, Vector3.new(12, 3, 2), at(0, 2.1, -3.6), C.Wood, { Pattern = "Studs" })
	brick(m, Vector3.new(12.6, 0.4, 2.6), at(0, 3.8, -3.6), C.WoodDark, { Pattern = "Weld" })
	-- полки с товаром
	brick(m, Vector3.new(12, 6, 0.8), at(0, 3.6, 4), C.WoodDark, { Pattern = "Weld" })
	for row = 0, 1 do
		brick(m, Vector3.new(11, 0.4, 1.6), at(0, 2.6 + row * 2.4, 3.2), C.Wood, { Pattern = "Weld" })
		for i = 0, 4 do
			local color = ({ C.Red, C.Blue, C.Gold, Config.Ores.Iron.Color, Config.Ores.Copper.Color })[i + 1]
			brick(m, Vector3.new(1, 1.2, 1), at(-4 + i * 2, 3.4 + row * 2.4, 3.2), color, { Collide = false })
		end
	end
	-- полосатый навес и бахрома
	for i = 0, 6 do
		local x = -6 + i * 2
		local color = if i % 2 == 0 then C.Red else C.White
		brick(m, Vector3.new(2, 0.4, 11), at(x, 9.8, 0) * CFrame.Angles(deg(-15), 0, 0), color, { Pattern = "StudsNoGrid" })
		brick(m, Vector3.new(2, 1, 0.3), at(x, 8.6, -5.4), color, { Pattern = "Studs" })
	end
	-- продавец (тег Merchant): кубическая фигура, без шаров
	local npc = model("Merchant", m)
	brick(npc, Vector3.new(2, 3, 1.2), at(0, 2.1, 0.6), C.Blue, { Pattern = "Studs" })
	local body = brick(npc, Vector3.new(2.6, 3, 1.4), at(0, 5.1, 0.6), C.White, { Pattern = "Studs", Name = "Body" })
	brick(npc, Vector3.new(2.2, 2.4, 0.3), at(0, 4.8, -0.2), C.Gold, { Pattern = "Studs" })
	for _, x in { -1.8, 1.8 } do
		brick(npc, Vector3.new(0.9, 2.8, 0.9), at(x, 5, 0.6), C.White, { Pattern = "Studs" })
	end
	brick(npc, Vector3.new(2, 2, 2), at(0, 7.6, 0.6), Color3.fromRGB(240, 200, 160), { Pattern = "Studs" })
	brick(npc, Vector3.new(2.6, 0.4, 2.6), at(0, 8.8, 0.6), C.Red, { Pattern = "Weld" })
	brick(npc, Vector3.new(1.6, 1, 1.6), at(0, 9.5, 0.6), C.Red, { Pattern = "Weld" })
	npc.PrimaryPart = body
	npc.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	CollectionService:AddTag(npc, T.Merchant)
	sign(body, "UI_MERCHANT_TITLE", 6)
	-- ящики и бочка перед лавкой
	crate(m, at(-8.6, 1.1, -2), 2.2)
	crate(m, at(-8.6, 3.3, -2) * CFrame.Angles(0, deg(15), 0), 1.6)
	brick(m, Vector3.new(2.2, 2.6, 2.2), at(8.6, 1.3, -2), C.Wood, { Pattern = "Weld" })
	for _, y in { 0.6, 2 } do
		brick(m, Vector3.new(2.5, 0.3, 2.5), at(8.6, y, -2), C.Iron, { Pattern = "Weld" })
	end
end

local function buildLeaderboards(parent: Instance, origin: Vector3)
	local m = model("Leaderboards", parent)
	for i, board in { "Level", "Damage", "Gates" } do
		local pos = origin + Vector3.new((i - 2) * 15, 0, (i - 2) * 6)
		local b = facing(pos, Vector3.new(0, 0, 0))
		brick(m, Vector3.new(14, 0.6, 3), b * CFrame.new(0, 0.3, 0), C.StoneDark)
		for _, x in { -6.6, 6.6 } do
			brick(m, Vector3.new(1, 14, 1), b * CFrame.new(x, 7.6, 0), C.WoodDark, { Pattern = "Weld" })
		end
		local p = brick(m, Vector3.new(12, 12, 0.8), b * CFrame.new(0, 7.6, 0), Color3.fromRGB(38, 36, 33), { Pattern = "Studs", Name = board .. "Board" })
		brick(m, Vector3.new(15, 0.6, 2.4), b * CFrame.new(0, 14.9, 0), C.Roof, { Pattern = "StudsNoGrid" })
		brick(m, Vector3.new(12, 0.6, 1.6), b * CFrame.new(0, 15.5, 0), C.RoofDark, { Pattern = "StudsNoGrid" })
		p:SetAttribute("Board", board)
		CollectionService:AddTag(p, T.Leaderboard)
	end
	m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
end

local function buildTown(parent: Instance)
	local town = model("Emberhold", parent)
	local floor = model("Plaza", ground)
	disc(floor, 0, 0, PLAZA_R, 0, 0.4, C.StoneLight, { Pattern = "Universal" })
	disc(floor, 0, 0, PLAZA_R - 6, 0, 0.5, C.Stone, { Pattern = "Universal" })
	local top = 0.5

	-- фонтан: ступенчатая квадратная чаша, вода, колонна, Кристалл Системы
	local f = model("Fountain", town)
	brick(f, Vector3.new(18, 0.6, 18), CFrame.new(0, top + 0.3, 0), C.StoneDark, { Pattern = "StudsNoGrid" })
	for _, side in { { 0, 8.2, 18, 1.6 }, { 0, -8.2, 18, 1.6 }, { 8.2, 0, 1.6, 15 }, { -8.2, 0, 1.6, 15 } } do
		brick(f, Vector3.new(side[3], 1.6, side[4]), CFrame.new(side[1], top + 1.4, side[2]), C.Stone, { Pattern = "Weld" })
	end
	brick(f, Vector3.new(14.9, 0.8, 14.9), CFrame.new(0, top + 1.2, 0), C.Water, { Transparency = 0.25, Collide = false })
	brick(f, Vector3.new(4, 2, 4), CFrame.new(0, top + 1.6, 0), C.StoneLight, { Pattern = "Weld" })
	brick(f, Vector3.new(3, 4, 3), CFrame.new(0, top + 4.6, 0), C.Stone, { Pattern = "Studs" })
	brick(f, Vector3.new(4, 0.6, 4), CFrame.new(0, top + 6.9, 0), C.StoneDark, { Pattern = "Weld" })
	local core = brick(f, Vector3.new(3.4, 6, 3.4), CFrame.new(0, top + 12, 0) * CFrame.Angles(0, deg(45), 0), C.SystemBlue, { Neon = true, Collide = false, Name = "SystemCrystal" })
	light(core, C.SystemBlue, 32, 2)
	CollectionService:AddTag(core, T.Spin)

	-- точка появления
	-- площадка утоплена в мощение: без щели над полом
	local spawnPad = brick(town, Vector3.new(10, 1.2, 10), CFrame.new(0, 0.6, 26), C.Stone, { Class = "SpawnLocation", Name = "TownSpawn", Pattern = "StudsNoGrid" }) :: any
	spawnPad.Duration = 0
	spawnPad.Neutral = true
	for _, side in { { 0, 5.3, 10.6, 0.6 }, { 0, -5.3, 10.6, 0.6 }, { 5.3, 0, 0.6, 10 }, { -5.3, 0, 0.6, 10 } } do
		brick(town, Vector3.new(side[3], 0.4, side[4]), CFrame.new(side[1], 1.4, 26 + side[2]), C.Gold, { Pattern = "Weld" })
	end

	reserve(0, 0, PLAZA_R)
	reserve(-40, -26, 17)
	reserve(40, -26, 11)
	reserve(34, -54, 24)
	buildSmithy(town, Vector3.new(-40, 0, -26))
	buildMerchant(town, Vector3.new(40, 0, -26))
	buildLeaderboards(town, Vector3.new(34, 0, -54))

	-- фонари вокруг площади (на траве, за краем мощения)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2 + math.pi / 8
		local x, z = math.cos(a) * (PLAZA_R + 4), math.sin(a) * (PLAZA_R + 4)
		if claim(x, z, 2, 5) then
			lamp(town, Vector3.new(x, 0, z))
		end
	end

	-- деревья кольцом вокруг города (немного и крупные)
	local zone = W.Zones.Town
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2 + rng:NextNumber(-0.12, 0.12)
		local r = rng:NextNumber(50, 64)
		local x, z = math.cos(a) * r, math.sin(a) * r
		if claim(x, z, 7, 9) then
			blobTree(town, groundPos(x, z), rng:NextNumber(0.9, 1.15), C.Grass, C.GrassBright)
		end
	end
	scatter(town, zone, PLAZA_R + 2, 66, 30, 14)
end

-- ===== Торговый ряд =====

local STRIPES = {
	{ C.Red, C.White },
	{ C.Blue, C.White },
	{ C.Gold, C.White },
	{ C.Coral, C.White },
}

-- Прилавок игрока: тег ShopStall, атрибут Slot. ShopService назначает владельца,
-- пишет имя на вывеске (StallSign → Owner) и ставит до 3 предметов на подставки Pedestal1..3.
local function buildStall(parent: Instance, origin: Vector3, yaw: number, slot: number)
	local m = model("Stall" .. slot, parent)
	local look = CFrame.new(origin) * CFrame.Angles(0, yaw, 0)
	local function at(x: number, y: number, z: number): CFrame
		return look * CFrame.new(x, y, z)
	end
	local stripe = STRIPES[(slot - 1) % #STRIPES + 1]
	brick(m, Vector3.new(12, 0.6, 9), at(0, 0.3, 0), C.Wood, { Pattern = "StudsNoGrid" })
	brick(m, Vector3.new(12, 8, 0.6), at(0, 4.6, 4.2), C.WoodDark, { Pattern = "Weld" })
	for _, x in { -5.6, 5.6 } do
		brick(m, Vector3.new(0.8, 8.4, 0.8), at(x, 4.8, -4.2), C.WoodDark, { Pattern = "Weld" })
	end
	for i = 0, 5 do
		brick(m, Vector3.new(2.2, 0.4, 10), at(-5.5 + i * 2.2, 9.2, 0) * CFrame.Angles(deg(15), 0, 0), stripe[(i % 2) + 1], { Pattern = "StudsNoGrid" })
		brick(m, Vector3.new(2.2, 0.8, 0.3), at(-5.5 + i * 2.2, 8.2, -5), stripe[(i % 2) + 1], { Pattern = "Studs" })
	end
	local counter = brick(m, Vector3.new(10, 3, 2.4), at(0, 2.1, -2.8), C.Wood, { Pattern = "Studs", Name = "Counter" })
	brick(m, Vector3.new(10.6, 0.3, 3), at(0, 3.75, -2.8), C.WoodDark, { Pattern = "Weld" })
	for i = 1, 3 do
		brick(m, Vector3.new(1.6, 0.4, 1.6), at((i - 2) * 3.2, 4.1, -2.8), C.StoneDark, { Name = "Pedestal" .. i })
	end
	local signPart = brick(m, Vector3.new(1, 1, 1), at(0, 7.6, -4.4), C.White, { Transparency = 1, Collide = false, Name = "StallSign" })
	local gui = Instance.new("BillboardGui")
	gui.Name = "OwnerGui"
	gui.Size = UDim2.fromOffset(200, 32)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Name = "Owner"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = C.White
	label.TextStrokeColor3 = Color3.fromRGB(40, 30, 30)
	label.TextStrokeTransparency = 0.2
	label.Text = "UI_STALL_FREE"
	label:SetAttribute("LocKey", "UI_STALL_FREE")
	label.Parent = gui
	gui.Parent = signPart

	m.PrimaryPart = counter
	m:SetAttribute("Slot", slot)
	m.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	CollectionService:AddTag(m, T.ShopStall)
end

local function buildMarket(parent: Instance)
	local market = model("MarketRow", parent)
	-- улица: шахматка из плиток 8×8 (стиль «плиточные поля», края ступенчатые сами собой)
	local street = model("MarketStreet", ground)
	for ix = 0, 13 do
		for iz = 0, 4 do
			local x = MARKET_X0 - 6 + ix * 8 + 4
			local z = MARKET_ROW_A - 4 + iz * 8 + 4
			brick(street, Vector3.new(8, 0.3, 8), CFrame.new(x, 0.15, z), if (ix + iz) % 2 == 0 then C.Peach else C.PeachDark, { Pattern = "Universal" })
		end
	end
	local perRow = math.ceil(W.MarketStalls / 2)
	local slot = 0
	for row = 1, 2 do
		for i = 0, perRow - 1 do
			slot += 1
			if slot > W.MarketStalls then
				break
			end
			local x = MARKET_X0 + i * MARKET_STEP
			local z = if row == 1 then MARKET_ROW_A else MARKET_ROW_B
			buildStall(market, Vector3.new(x, 0.3, z), if row == 1 then math.pi else 0, slot)
		end
	end
	for _, x in { MARKET_X0 - 9, MARKET_X0 + MARKET_STEP * 7 + 9 } do
		lamp(market, Vector3.new(x, 0.3, 60))
	end
end

-- ===== Дорожки: поля плиток 4×4 вдоль линий =====

local function buildPaths()
	local paths = model("Paths", ground)
	local used: { [string]: boolean } = {}
	local function blocked(x: number, z: number): boolean
		if inDisc(x, z, 0, 0, PLAZA_R - 1) or inMarket(x, z) then
			return true
		end
		local Z = W.Zones
		return inDisc(x, z, Z.IronQuarry.Center.X, Z.IronQuarry.Center.Z, 80)
			or inDisc(x, z, Z.MoonGrotto.Center.X, Z.MoonGrotto.Center.Z, 80)
	end
	local function road(from: Vector3, to: Vector3, width: number)
		local len = (to - from).Magnitude
		local dir = (to - from).Unit
		local side = Vector3.new(-dir.Z, 0, dir.X)
		for t = 0, len, 2 do
			for s = -width / 2, width / 2, 2 do
				local sample = from + dir * t + side * s
				local cx, cz = math.floor(sample.X / 4), math.floor(sample.Z / 4)
				local key = cx .. ":" .. cz
				local x, z = cx * 4 + 2, cz * 4 + 2
				if not used[key] and not blocked(x, z) then
					used[key] = true
					brick(paths, Vector3.new(4, 0.3, 4), CFrame.new(x, 0.15, z), if (cx + cz) % 2 == 0 then C.Sand else C.Peach)
				end
			end
		end
	end
	for _, zone in W.Zones do
		if zone.Id ~= "Town" and zone.Id ~= "Market" then
			local to = Vector3.new(zone.Center.X, 0, zone.Center.Z)
			road(to.Unit * (PLAZA_R - 2), to - to.Unit * (zone.Radius * 0.55), 8)
		end
	end
	road(Vector3.new(20, 0, 22), Vector3.new(MARKET_X0 - 8, 0, 60), 8)
end

-- ===== Зоны =====

local function buildCopperHills(parent: Instance)
	local zone = W.Zones.CopperHills
	local m = model("CopperHills", parent)
	for _ = 1, 7 do
		local x, z = randomInZone(zone, 30, zone.Radius * 0.95)
		if claim(x, z, 22, 22) then
			hill(m, Vector3.new(x, 0, z))
		end
	end
	-- вытоптанные земляные пятна
	local patches = model("DirtPatches", ground)
	for _ = 1, 5 do
		local x, z = randomInZone(zone, 0, zone.Radius * 0.7)
		for k = 1, 3 do
			brick(patches, Vector3.new(rng:NextNumber(6, 12), 0.2, rng:NextNumber(5, 10)), CFrame.new(x + k * 2, 0.1, z + rng:NextNumber(-2, 2)), C.Dirt)
		end
	end
	for _ = 1, 8 do
		local x, z = randomInZone(zone, 15, zone.Radius * 0.9)
		local pos = groundPos(x, z)
		if pos.Y < 1 and claim(x, z, 7, 8) then
			blobTree(m, pos, rng:NextNumber(0.85, 1.2), if rng:NextNumber() < 0.5 then C.Grass else C.GrassBright, C.GrassDark)
		end
	end
	for _ = 1, 6 do
		local x, z = randomInZone(zone, 10, zone.Radius * 0.9)
		if claim(x, z, 3, 6) then
			rock(m, groundPos(x, z), rng:NextNumber(0.8, 1.2), { C.Dirt, C.DirtRose })
		end
	end
	scatter(m, zone, 5, zone.Radius * 0.95, 40, 16)
end

local function buildQuarry(parent: Instance)
	local zone = W.Zones.IronQuarry
	local m = model("IronQuarry", parent)
	local c = zone.Center
	disc(model("QuarryFloor", ground), c.X, c.Z, zone.Radius * 0.85, 0, 0.4, C.Stone)
	-- каменное кольцо из масс с проходом в сторону города
	local walls = model("QuarryWalls", parent)
	local toTown = math.atan2(-c.Z, -c.X)
	local n = 16
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		local diff = math.abs(math.atan2(math.sin(a - toTown), math.cos(a - toTown)))
		if diff > 0.4 then
			local r = zone.Radius * 0.85 + 6
			local pos = Vector3.new(c.X + math.cos(a) * r, 0, c.Z + math.sin(a) * r)
			local cf = facing(pos, Vector3.new(c.X, 0, c.Z))
			local h = ({ 9, 13, 7, 11, 15, 8 })[i % 6 + 1]
			local mass = model("RockMass", walls)
			local y = 0
			local len, dep = rng:NextNumber(22, 30), rng:NextNumber(10, 14)
			for t = 1, 2 do
				local th = h / 2
				brick(mass, Vector3.new(len, th, dep), cf * CFrame.new(rng:NextNumber(-1, 1), y + th / 2, 0), if t == 1 then C.StoneDark else C.Stone)
				brick(mass, Vector3.new(len + 1, 0.6, dep + 1), cf * CFrame.new(0, y + th + 0.3, 0), C.StoneLight, { Pattern = "StudsNoGrid" })
				y += th
				len *= 0.7
				dep *= 0.75
			end
			mass.Parent = ground
		end
	end
	-- каменные столбы внутри
	for _ = 1, 5 do
		local x, z = randomInZone(zone, 25, zone.Radius * 0.6)
		if not claim(x, z, 5, 6) then
			continue
		end
		local s = model("Spire", ground)
		local y = 0.4
		for k = 1, 3 do
			local w = 6 - k * 1.4
			local h = rng:NextNumber(3, 5)
			brick(s, Vector3.new(w, h, w), CFrame.new(x, y + h / 2, z) * CFrame.Angles(0, deg(15 * k), 0), if k % 2 == 0 then C.Stone else C.StoneDark)
			y += h
		end
	end
	-- опоры шахты с фонарями и вагонетки
	for _ = 1, 4 do
		local x, z = randomInZone(zone, 18, zone.Radius * 0.55)
		if not claim(x, z, 9, 6) then
			continue
		end
		local pos = groundPos(x, z)
		local cf = CFrame.new(pos) * CFrame.Angles(0, yaw15(), 0)
		local f = model("MineFrame", m)
		for _, dx in { -3, 3 } do
			brick(f, Vector3.new(1, 9, 1), cf * CFrame.new(dx, 4.5, 0), C.Wood, { Pattern = "Weld" })
		end
		brick(f, Vector3.new(7.6, 1, 1.2), cf * CFrame.new(0, 9.4, 0), C.WoodDark, { Pattern = "Weld" })
		local lanternCore = brick(f, Vector3.new(0.8, 1, 0.8), cf * CFrame.new(0, 8.3, 0), Color3.fromRGB(255, 214, 150), { Neon = true, Collide = false })
		light(lanternCore, Color3.fromRGB(255, 200, 140), 16, 1)
		local cart = model("Cart", m)
		local cc = cf * CFrame.new(0, 0, 5)
		brick(cart, Vector3.new(4, 2, 3), cc * CFrame.new(0, 1.6, 0), C.Iron, { Pattern = "Weld" })
		for _, dx in { -1.4, 1.4 } do
			brick(cart, Vector3.new(0.6, 0.8, 3.4), cc * CFrame.new(dx, 0.5, 0), C.WoodDark, { Pattern = "Weld" })
		end
		for k = 1, 4 do
			brick(cart, Vector3.new(0.8, 0.8, 0.8), cc * CFrame.new(rng:NextNumber(-1.2, 1.2), 2.9, rng:NextNumber(-0.8, 0.8)) * CFrame.Angles(0, deg(15 * k), 0), Config.Ores.Iron.Color, { Collide = false })
		end
	end
	for _ = 1, 8 do
		local x, z = randomInZone(zone, 10, zone.Radius * 0.75)
		if claim(x, z, 3, 6) then
			rock(m, groundPos(x, z), rng:NextNumber(0.7, 1.1), { C.Stone, C.StoneDark, C.StoneLight })
		end
	end
end

local function buildGrotto(parent: Instance)
	local zone = W.Zones.MoonGrotto
	local m = model("MoonGrotto", parent)
	local c = zone.Center
	disc(model("SnowFloor", ground), c.X, c.Z, zone.Radius * 0.85, 0, 0.4, C.Snow)
	for _ = 1, 10 do
		local x, z = randomInZone(zone, 20, zone.Radius * 0.9)
		local pos = groundPos(x, z)
		if pos.Y < 1 and claim(x, z, 5, 6) then
			pineTree(m, pos, rng:NextNumber(0.9, 1.3))
		end
	end
	-- ледяные кристаллы: ступенчатые столбики с наклоном 15°
	for _ = 1, 12 do
		local x, z = randomInZone(zone, 12, zone.Radius * 0.85)
		if not claim(x, z, 2.5, 6) then
			continue
		end
		local pos = groundPos(x, z)
		local cl = model("IceCrystal", m)
		local base = CFrame.new(pos) * CFrame.Angles(0, yaw15(), deg(15 * rng:NextInteger(-1, 1)))
		local y = 0
		for k = 1, 3 do
			local w = 2.4 - k * 0.5
			local h = rng:NextNumber(2, 3.6)
			brick(cl, Vector3.new(w, h, w), base * CFrame.new(0, y + h / 2, 0), if k % 2 == 0 then C.Ice else C.Frost, { Pattern = "Studs", Collide = k == 1 })
			y += h
		end
	end
	for _ = 1, 6 do
		local x, z = randomInZone(zone, 10, zone.Radius * 0.8)
		if claim(x, z, 3, 6) then
			rock(m, groundPos(x, z), rng:NextNumber(0.8, 1.2), { C.Coral, C.CoralDark })
		end
	end
	for _ = 1, 3 do
		local x, z = randomInZone(zone, 0, 40)
		local p = brick(m, Vector3.new(1, 1, 1), CFrame.new(x, 5, z), C.White, { Transparency = 1, Collide = false })
		light(p, Color3.fromRGB(150, 200, 255), 40, 1.4)
	end
end

local function buildGatePlains(parent: Instance)
	local zone = W.Zones.GatePlains
	local m = model("GatePlains", parent)
	local c = zone.Center
	local pads = model("GatePads", ground)
	for _, offset in { Vector3.new(-38, 0, -30), Vector3.new(38, 0, -30), Vector3.new(-38, 0, 32), Vector3.new(38, 0, 32) } do
		local x, z = c.X + offset.X, c.Z + offset.Z
		reserve(x, z, 12)
		brick(pads, Vector3.new(16, 0.6, 16), CFrame.new(x, 0.3, z), C.StoneDark, { Pattern = "StudsNoGrid" })
		brick(pads, Vector3.new(12, 0.4, 12), CFrame.new(x, 0.8, z), C.Stone, { Pattern = "StudsNoGrid" })
		-- тонкая светящаяся кромка: площадка важна для игры
		for _, s in { { 0, 6.1, 12.4, 0.3 }, { 0, -6.1, 12.4, 0.3 }, { 6.1, 0, 0.3, 12 }, { -6.1, 0, 0.3, 12 } } do
			brick(pads, Vector3.new(s[3], 0.2, s[4]), CFrame.new(x + s[1], 1.05, z + s[2]), C.SystemBlue, { Neon = true, Collide = false })
		end
		for _, px in { -7, 7 } do
			for _, pz in { -7, 7 } do
				brick(m, Vector3.new(1.6, 6, 1.6), CFrame.new(x + px, 3.6, z + pz), C.StoneLight, { Pattern = "Weld" })
				brick(m, Vector3.new(2.2, 0.6, 2.2), CFrame.new(x + px, 6.9, z + pz), C.StoneDark, { Pattern = "Weld" })
			end
		end
		local spawnPoint = brick(m, Vector3.new(6, 1, 6), CFrame.new(x, 1.5, z), C.White, { Transparency = 1, Collide = false, Name = "GateSpawn" })
		CollectionService:AddTag(spawnPoint, T.GateSpawn)
	end
	for _ = 1, 5 do
		local x, z = randomInZone(zone, 60, zone.Radius * 0.95)
		if claim(x, z, 7, 8) then
			blobTree(m, groundPos(x, z), rng:NextNumber(0.9, 1.2), C.GrassBright, C.Grass)
		end
	end
	scatter(m, zone, 10, zone.Radius * 0.95, 30, 18)
end

local function buildLake(parent: Instance)
	local m = model("Lake", parent)
	local cx, cz = 130, 125
	reserve(cx, cz, 34)
	disc(model("LakeBed", ground), cx, cz, 32, 0, 0.2, C.Sand)
	-- одна прозрачная плита воды поверх дна (дно видно — значит глубоко)
	disc(m, cx, cz, 27, 0.2, 0.7, C.Water, { Transparency = 0.35, Collide = false })
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		rock(m, Vector3.new(cx + math.cos(a) * 29, 0.2, cz + math.sin(a) * 29), 0.6, { C.Stone, C.StoneLight })
	end
	-- кувшинки, рогоз и мостки
	for i = 1, 5 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(6, 20)
		local padPos = Vector3.new(cx + math.cos(a) * r, 0.95, cz + math.sin(a) * r)
		brick(m, Vector3.new(2, 0.1, 2), CFrame.new(padPos) * CFrame.Angles(0, deg(15 * i), 0), C.GrassDark, { Collide = false })
		if i == 2 then
			flower(m, padPos, Color3.fromRGB(240, 120, 200))
		end
	end
	for i = 1, 6 do
		local a = deg(200 + i * 8)
		local p = Vector3.new(cx + math.cos(a) * 25, 0.2, cz + math.sin(a) * 25)
		brick(m, Vector3.new(0.3, 2.4, 0.3), CFrame.new(p + Vector3.new(0, 1.2, 0)), C.Tuft, { Collide = false })
		brick(m, Vector3.new(0.5, 0.8, 0.5), CFrame.new(p + Vector3.new(0, 2.6, 0)), C.WoodDark, { Collide = false })
	end
	local dock = model("Dock", m)
	local dockCf = CFrame.new(cx - 28, 0, cz) * CFrame.Angles(0, deg(90), 0)
	for i = 0, 5 do
		brick(dock, Vector3.new(4, 0.4, 1.6), dockCf * CFrame.new(0, 1.4, -i * 1.8), if i % 2 == 0 then C.Wood else C.WoodDark, { Pattern = "Weld" })
	end
	for _, dx in { -2, 2 } do
		for _, dz in { 0, -5, -9 } do
			brick(dock, Vector3.new(0.6, 2, 0.6), dockCf * CFrame.new(dx, 0.6, dz), C.WoodDark, { Pattern = "Weld" })
		end
	end
end

-- ===== Плато по краю карты (барьер без щелей) =====

local function buildBorder(parent: Instance)
	local ring = model("Border", parent)
	local half = W.Size / 2
	local heights = { 16, 24, 19, 27, 17, 22, 26, 18 }
	local k = 0
	for side = 1, 4 do
		local pos = -half
		while pos < half do
			k += 1
			local length = rng:NextNumber(40, 75)
			local depth = rng:NextNumber(18, 34)
			local h = heights[k % #heights + 1]
			local along = pos + length / 2
			-- длинная ось вдоль края, глубина вглубь карты, масса «седлает» край
			local center: CFrame
			if side == 1 then
				center = CFrame.new(along, 0, -half + depth * 0.3) * CFrame.Angles(0, math.pi, 0)
			elseif side == 2 then
				center = CFrame.new(along, 0, half - depth * 0.3)
			elseif side == 3 then
				center = CFrame.new(-half + depth * 0.3, 0, along) * CFrame.Angles(0, -math.pi / 2, 0)
			else
				center = CFrame.new(half - depth * 0.3, 0, along) * CFrame.Angles(0, math.pi / 2, 0)
			end
			local topY = plateau(ring, center, length, depth, h, k % 2 == 0)
			if h >= 24 and k % 2 == 0 then
				local treePos = (center * CFrame.new(0, topY, 0)).Position
				blobTree(ring, treePos, 1, C.GrassBright, C.Grass)
			end
			pos += length * 0.8 -- перекрытие ~20%: щелей нет
		end
	end
	-- невидимые стены поверх: страховка от выхода за карту
	local inner = half - 8
	for _, data in {
		{ Vector3.new(0, 100, -inner), Vector3.new(W.Size, 260, 2) },
		{ Vector3.new(0, 100, inner), Vector3.new(W.Size, 260, 2) },
		{ Vector3.new(-inner, 100, 0), Vector3.new(2, 260, W.Size) },
		{ Vector3.new(inner, 100, 0), Vector3.new(2, 260, W.Size) },
	} do
		local p = Instance.new("Part")
		p.Name = "Bound"
		p.Size = data[2]
		p.CFrame = CFrame.new(data[1])
		p.Anchored = true
		p.Transparency = 1
		p.CanQuery = false
		p.Parent = ring
	end
end

local function placeOres(parent: Instance)
	local m = model("Ores", parent)
	for _, entry in W.OreNodes do
		local zone = W.Zones[entry.Zone]
		local placed: { Vector3 } = {}
		local minR = if zone.Id == "Town" then 44 else 12
		local maxR = if zone.Id == "Town" then 58 else zone.Radius * 0.75
		local tries = 0
		while #placed < entry.Count and tries < entry.Count * 30 do
			tries += 1
			local x, z = randomInZone(zone, minR, maxR)
			local pos = groundPos(x, z)
			if pos.Y < 1 and claim(x, z, 4.5, 6) then
				table.insert(placed, pos)
				oreNode(m, pos, entry.OreId)
			end
		end
	end
end

local function setupLighting()
	-- высокий ключ: солнечно, мягкие тени (стилизованный свет)
	pcall(function()
		Lighting.LightingStyle = Enum.LightingStyle.Soft
	end)
	Lighting.ClockTime = W.Lighting.ClockTime
	Lighting.Brightness = 3
	Lighting.GlobalShadows = true
	Lighting.Ambient = Color3.fromRGB(110, 110, 125)
	Lighting.OutdoorAmbient = Color3.fromRGB(160, 160, 180)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.2
	local function ensure(className: string, props: { [string]: any })
		if Lighting:FindFirstChildOfClass(className) then
			return
		end
		local inst = Instance.new(className)
		for k, v in props do
			(inst :: any)[k] = v
		end
		inst.Parent = Lighting
	end
	ensure("Atmosphere", { Density = 0.22, Offset = 0.1, Color = Color3.fromRGB(205, 225, 255), Decay = Color3.fromRGB(150, 180, 220), Glare = 0, Haze = 1 })
	ensure("BloomEffect", { Intensity = 0.4, Size = 20, Threshold = 1.8 })
	ensure("ColorCorrectionEffect", { Saturation = 0.18, Contrast = 0.04, Brightness = 0.02 })
	ensure("SunRaysEffect", { Intensity = 0.03, Spread = 0.6 })
end

-- Строить ли мир: только если в карте нет своих жил руды
function WorldBuilder.ShouldBuild(): boolean
	return W.AutoBuild and #CollectionService:GetTagged(T.OreNode) == 0
end

function WorldBuilder.Build()
	local started = os.clock()
	root = Instance.new("Folder")
	root.Name = "World"
	root.Parent = workspace
	ground = Instance.new("Folder")
	ground.Name = "Ground"
	ground.Parent = root
	rayParams.FilterDescendantsInstances = { ground }

	-- остров: травяная шапка над лососевой землёй
	brick(ground, Vector3.new(W.Size, 2, W.Size), CFrame.new(0, -1, 0), C.Grass, { Name = "GrassCap" })
	brick(ground, Vector3.new(W.Size, 10, W.Size), CFrame.new(0, -7, 0), C.DirtDeep, { Name = "DirtLayer" })
	local checker = W.CheckerTextureId
	if type(checker) == "string" and checker ~= "" then
		local tex = Instance.new("Texture")
		tex.Texture = checker
		tex.Face = Enum.NormalId.Top
		tex.StudsPerTileU = 8
		tex.StudsPerTileV = 8
		tex.Transparency = 0.8
		tex.Parent = ground:FindFirstChild("GrassCap")
	end

	buildTown(root)
	task.wait() -- не упереться в лимит времени выполнения скрипта
	buildMarket(root)
	buildPaths()
	buildCopperHills(root)
	buildQuarry(root)
	task.wait()
	buildGrotto(root)
	buildGatePlains(root)
	buildLake(root)
	buildBorder(root)
	placeOres(root)
	setupLighting()

	-- шаблонный Baseplate убираем в самом конце, чтобы никто не успел упасть в пустоту
	if W.RemoveDefaultBaseplate then
		for _, name in { "Baseplate", "SpawnLocation" } do
			local inst = workspace:FindFirstChild(name)
			if inst and inst:IsA("BasePart") then
				inst:Destroy()
			end
		end
	end

	WorldBuilder.Built = true
	local count = 0
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			count += 1
		end
	end
	print(`[World] стад-мир построен за {string.format("%.1f", os.clock() - started)} с, деталей: {count}, варианты материалов: {Stud.UsingVariants}`)
end

-- Точка на земле (для мобов): используется WorldMobService
function WorldBuilder.GroundAt(x: number, z: number): number
	return groundAt(x, z)
end

return WorldBuilder
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000061"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000060"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0000005C"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ТОЧКА ВХОДА КЛИЕНТА.
	Клиент только рисует и шлёт запросы; вся игровая логика — на сервере.
	Порядок: :Init() у всех → :Start() у всех.
]]

local Controllers = script:WaitForChild("Controllers")

local ORDER = {
	"DataController",
	"InputController",
	"UIController",
	"LocalizationController",
	"SystemWindowController",
	"HudController",
	"QuestController",
	"ForgeController",
	"InventoryController",
	"MerchantController",
	"CombatController",
	"GateController",
	"FxController",
	"ShopController",
	"TradeController",
	"MenuController",
	"ZoneController",
}

local controllers: { [string]: any } = {}
for _, name in ORDER do
	controllers[name] = require(Controllers:WaitForChild(name) :: ModuleScript)
end

for _, name in ORDER do
	local controller = controllers[name]
	if type(controller.Init) == "function" then
		controller:Init()
	end
end

for _, name in ORDER do
	local controller = controllers[name]
	if type(controller.Start) == "function" then
		local ok, err = pcall(function()
			controller:Start()
		end)
		if not ok then
			warn(`[Client] {name}:Start() — {err}`)
		end
	end
end
]]></ProtectedString></Properties><Item class="Folder" referent="RBX00000055"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX00000044"><Properties><string name="Name">CombatController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	БОЙ НА КЛИЕНТЕ: кнопки «Атака» и «Блок» (справа снизу, левее кнопки прыжка).
	Удержание «Атаки» = автоатака с кулдауном оружия. ПК: ЛКМ — атака, F — блок.
	Геймпад: R2 — атака, L2 — блок. Сервер всё перепроверяет.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Net = require(ReplicatedStorage.Shared.Net)
local WeaponMath = require(ReplicatedStorage.Shared.WeaponMath)
local C = require(script.Parent.Parent.UI.Components)
local Sound = require(script.Parent.Parent.UI.Sound)
local Theme = require(script.Parent.Parent.UI.Theme)
local DataController = require(script.Parent.DataController)
local ForgeController = require(script.Parent.ForgeController)
local InputController = require(script.Parent.InputController)
local UIController = require(script.Parent.UIController)

local S = Theme.S
local player = Players.LocalPlayer

local CombatController = {}

local attackButton: TextButton
local blockButton: TextButton
local attackHeld = false
local blocking = false
local lastAttack = 0
local swingTrack: AnimationTrack? = nil

local cluster: Frame

-- пауза между ударами с учётом черт оружия (Быстрота, Тяжесть)
local function attackCooldown(): number
	local data = DataController:Get()
	if data and data.EquippedWeapon ~= "" then
		return WeaponMath.Cooldown(data.Weapons[data.EquippedWeapon])
	end
	return WeaponMath.Cooldown(nil)
end

-- большие кнопки только на сенсорных экранах; на ПК/геймпаде — подсказка внизу экрана
local function refreshMode()
	cluster.Visible = InputController:IsTouch()
end

local function isAlive(): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

local function loadSwing()
	swingTrack = nil
	local id = Config.Combat.SwingAnimationId
	if id == "" then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if animator then
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		swingTrack = animator:LoadAnimation(animation)
	end
end

local function attack()
	if UIController:GetOpenPanel() ~= nil or ForgeController:IsBusy() or not isAlive() then
		return
	end
	local now = os.clock()
	if now - lastAttack < attackCooldown() then
		return
	end
	lastAttack = now
	Net.Event("CombatAttack"):FireServer()
	Sound.Play("Swing", 0.5, 0.95 + math.random() * 0.1)
	if swingTrack then
		swingTrack:Play(0.05)
	end
	attackButton.BackgroundTransparency = 0.4
	task.delay(0.08, function()
		attackButton.BackgroundTransparency = 0.05
	end)
end

local function setBlock(on: boolean)
	if on and not isAlive() then
		on = false
	end
	if on == blocking then
		return
	end
	blocking = on
	Net.Event("CombatBlock"):FireServer(on)
	blockButton.BackgroundColor3 = if on then Theme.Accent else Theme.Panel
	blockButton.TextColor3 = if on then Theme.Bg else Theme.Text
end

local function isPointer(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function build()
	cluster = C.Make("Frame", {
		Name = "CombatButtons",
		Size = UDim2.fromOffset(S(192), S(100)),
		Position = UDim2.new(1, -S(176), 1, -S(16)),
		AnchorPoint = Vector2.new(1, 1),
		BackgroundTransparency = 1,
		Parent = UIController.Layers.Hud,
	})
	C.Adaptive(cluster)
	attackButton = C.Button({
		Name = "Attack",
		Key = "UI_ATTACK",
		Font = Theme.FontTitle,
		TextSize = 16,
		Size = UDim2.fromOffset(S(96), S(96)),
		Position = UDim2.fromScale(1, 1),
		AnchorPoint = Vector2.new(1, 1),
		Color = Theme.Accent,
		TextColor = Theme.Bg,
		Transparency = 0.05,
		Round = true,
		Silent = true,
		Parent = cluster,
	})
	blockButton = C.Button({
		Name = "Block",
		Key = "UI_BLOCK",
		Font = Theme.FontBold,
		TextSize = 14,
		Size = UDim2.fromOffset(S(72), S(72)),
		Position = UDim2.new(0, 0, 1, 0),
		AnchorPoint = Vector2.new(0, 1),
		Color = Theme.Panel,
		Transparency = 0.05,
		Round = true,
		Silent = true,
		Parent = cluster,
	})

	attackButton.InputBegan:Connect(function(input)
		if isPointer(input) then
			attackHeld = true
			attack()
		end
	end)
	attackButton.InputEnded:Connect(function(input)
		if isPointer(input) then
			attackHeld = false
		end
	end)
	blockButton.InputBegan:Connect(function(input)
		if isPointer(input) then
			setBlock(true)
		end
	end)
	blockButton.InputEnded:Connect(function(input)
		if isPointer(input) then
			setBlock(false)
		end
	end)
end

function CombatController:Start()
	build()
	refreshMode()
	InputController.Changed:Connect(refreshMode)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2 then
			attackHeld = true
			attack()
		elseif input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonL2 then
			setBlock(true)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2 then
			attackHeld = false
		elseif input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonL2 then
			setBlock(false)
		end
	end)

	-- автоатака при удержании
	RunService.Heartbeat:Connect(function()
		if attackHeld then
			attack()
		end
	end)

	player.CharacterAdded:Connect(function(character)
		blocking = false
		attackHeld = false
		blockButton.BackgroundColor3 = Theme.Panel
		character:WaitForChild("Humanoid", 10)
		loadSwing()
	end)
	if player.Character then
		task.spawn(loadSwing)
	end
end

return CombatController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000045"><Properties><string name="Name">DataController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Копия данных игрока на клиенте (только для отображения — истина на сервере).
	DataController.Changed:Connect(function(key) ... end) — key = изменившийся ключ или "*" (полная синхронизация).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Signal)

local DataController = {}

DataController.Data = nil :: any
DataController.Changed = Signal.new()
DataController.Ready = Signal.new()

local function setFull(data: any)
	local first = DataController.Data == nil
	DataController.Data = data
	DataController.Changed:Fire("*")
	if first then
		DataController.Ready:Fire(data)
	end
end

function DataController:Get(): any
	return DataController.Data
end

function DataController:WaitForData(): any
	if DataController.Data then
		return DataController.Data
	end
	return DataController.Ready:Wait()
end

function DataController:Start()
	Net.Event("DataSync").OnClientEvent:Connect(setFull)
	Net.Event("DataPatch").OnClientEvent:Connect(function(patch: { [string]: any })
		local data = DataController.Data
		if not data then
			return
		end
		for key, value in patch do
			data[key] = value
		end
		for key in patch do
			DataController.Changed:Fire(key)
		end
	end)

	-- на случай, если DataSync пришёл раньше, чем мы подписались
	task.spawn(function()
		local remote = Net.Function("RequestData")
		for _ = 1, 60 do
			if DataController.Data then
				return
			end
			local ok, result = pcall(function()
				return remote:InvokeServer()
			end)
			if ok and type(result) == "table" and result.ok and result.data then
				if not DataController.Data then
					setFull(result.data)
				end
				return
			end
			task.wait(2)
		end
	end)
end

return DataController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000046"><Properties><string name="Name">ForgeController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	КУЗНЯ: выбор оружия и руды → мини-игра из 3 шагов → результат.
	Управление одной большой кнопкой (телефон) или пробелом (ПК):
	  1. Меха   — тапай, держи жар в зелёной зоне.
	  2. Заливка — держи, отпусти на линии.
	  3. Молот  — бей в такт, когда кольцо сходится с кругом.
	Клиент только меряет и отправляет сырые замеры; качество считает сервер.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")

local Config = require(ReplicatedStorage.Shared.Config)
local Localization = require(ReplicatedStorage.Shared.Localization)
local Net = require(ReplicatedStorage.Shared.Net)
local WeaponMath = require(ReplicatedStorage.Shared.WeaponMath)
local C = require(script.Parent.Parent.UI.Components)
local Sound = require(script.Parent.Parent.UI.Sound)
local Theme = require(script.Parent.Parent.UI.Theme)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local S = Theme.S
local F = Config.Forging

local ForgeController = {}

-- состояние
local selectedType = "Sword"
local selectedOre = "Copper"
local phase = "idle" -- idle | bellows | pour | hammer | submit
local running = false
local cancelled = false

-- мини-игра
local heat = 0
local pourLevel = 0
local holding = false
local pourDone = false
local hammerParams: any = nil
local beatTimes: { number } = {}
local offsets: { number } = {}

-- UI
local panel: Frame
local selectView: Frame
local gameView: Frame
local resultView: Frame
local weaponButtons: { [string]: TextButton } = {}
local oreButtons: { [string]: TextButton } = {}
local costLabel: TextLabel
local previewLabel: TextLabel
local forgeButton: TextButton
local stepTitle: TextLabel
local stepHint: TextLabel
local actionButton: TextButton
local timerFill: Frame
local bellowsWidget: Frame
local zoneFrame: Frame
local heatFill: Frame
local pourWidget: Frame
local pourFill: Frame
local pourLine: Frame
local hammerWidget: Frame
local hammerRing: Frame
local hammerFeedback: TextLabel
local hammerCounter: TextLabel
local resultQuality: TextLabel
local resultName: TextLabel
local resultDamage: TextLabel
local resultRarity: TextLabel
local resultTraits: TextLabel
local oddsFrame: Frame
local oddsText: TextLabel
local lastWeaponId: string? = nil

local function sortedKeys(tbl: { [string]: any }): { string }
	local keys = {}
	for k in tbl do
		table.insert(keys, k)
	end
	table.sort(keys, function(a, b)
		return (tbl[a].Order or 0) < (tbl[b].Order or 0)
	end)
	return keys
end

local baseSizes: { [GuiObject]: UDim2 } = {}

local function punch(target: GuiObject)
	local size = baseSizes[target]
	if not size then
		size = target.Size
		baseSizes[target] = size
	end
	target.Size = UDim2.new(size.X.Scale, size.X.Offset * 0.96, size.Y.Scale, size.Y.Offset * 0.96)
	TweenService:Create(target, TweenInfo.new(0.14, Theme.Ease, Enum.EasingDirection.Out), { Size = size }):Play()
end

-- ===== Экран выбора =====

local function refreshSelect()
	local data = DataController:Get()
	if not data or not selectView then
		return
	end
	for id, button in weaponButtons do
		local selected = id == selectedType
		button.BackgroundColor3 = if selected then Theme.Accent else Theme.PanelLight
		button.TextColor3 = if selected then Theme.Bg else Theme.Text
	end
	for id, button in oreButtons do
		local ore = Config.Ores[id]
		local locked = data.Level < ore.RequiredLevel
		local selected = id == selectedOre
		if locked then
			C.Bind(button, "UI_REQ_LEVEL", { level = ore.RequiredLevel })
		else
			C.Bind(button, "UI_ORE_COUNT", { ore = "@" .. ore.NameKey, count = data.Ores[id] or 0 })
		end
		button.BackgroundColor3 = if locked then Theme.Disabled elseif selected then Theme.Accent else Theme.PanelLight
		button.TextColor3 = if selected and not locked then Theme.Bg else Theme.Text
	end

	local def = Config.Weapons[selectedType]
	local ore = Config.Ores[selectedOre]
	local have = data.Ores[selectedOre] or 0
	C.Bind(costLabel, "UI_ORE_COST", { count = def.OreCost, ore = "@" .. ore.NameKey, have = have })
	costLabel.TextColor3 = if have >= def.OreCost then Theme.TextDim else Theme.Danger
	C.Bind(previewLabel, "UI_FORGE_PREVIEW", {
		min = WeaponMath.Preview(selectedType, selectedOre, 0),
		max = WeaponMath.Preview(selectedType, selectedOre, 100),
	})
	local canForge = have >= def.OreCost and data.Level >= ore.RequiredLevel
	forgeButton.BackgroundColor3 = if canForge then Theme.Accent else Theme.Disabled
	forgeButton.TextColor3 = if canForge then Theme.Bg else Theme.Muted
end

local function showView(name: string)
	selectView.Visible = name == "select"
	gameView.Visible = name == "game"
	resultView.Visible = name == "result"
	oddsFrame.Visible = false
	if name == "select" then
		refreshSelect()
	end
end

-- ===== Мини-игра =====

local function setStep(titleKey: string, hintKey: string, actionKey: string, widget: Frame?)
	C.Bind(stepTitle, titleKey)
	C.Bind(stepHint, hintKey)
	C.Bind(actionButton, actionKey)
	bellowsWidget.Visible = widget == bellowsWidget
	pourWidget.Visible = widget == pourWidget
	hammerWidget.Visible = widget == hammerWidget
end

local function feedback(key: string, color: Color3)
	C.Bind(hammerFeedback, key)
	hammerFeedback.TextColor3 = color
	hammerFeedback.TextTransparency = 0
	hammerFeedback.TextSize = S(30)
	TweenService:Create(hammerFeedback, TweenInfo.new(0.5), { TextTransparency = 1, TextSize = S(22) }):Play()
end

local function strike()
	local now = os.clock()
	local p = hammerParams
	if not p then
		return
	end
	local bestIndex: number? = nil
	local bestAbs = math.huge
	for i, t in beatTimes do
		if offsets[i] == 9 then
			local a = math.abs(now - t)
			if a < bestAbs and a <= 0.45 then
				bestIndex, bestAbs = i, a
			end
		end
	end
	if not bestIndex then
		feedback("FORGE_MISS", Theme.Danger)
		Sound.Play("ForgeHammerMiss")
		return
	end
	offsets[bestIndex] = now - beatTimes[bestIndex]
	if bestAbs <= F.Hammer.PerfectWindow then
		feedback("FORGE_PERFECT", Theme.Accent)
		Sound.Play("ForgeHammerPerfect")
	elseif bestAbs <= F.Hammer.HitWindow then
		feedback("FORGE_GOOD", Theme.Success)
		Sound.Play("ForgeHammerHit")
	else
		feedback("FORGE_MISS", Theme.Danger)
		Sound.Play("ForgeHammerMiss")
	end
end

local function onPress()
	if phase == "bellows" then
		heat = math.min(1, heat + F.Bellows.HeatPerPump)
		Sound.Play("ForgePump", 0.5, 0.9 + heat * 0.3)
		punch(actionButton)
	elseif phase == "pour" then
		holding = true
		Sound.Play("ForgePour", 0.4)
	elseif phase == "hammer" then
		strike()
		punch(actionButton)
	end
end

local function onRelease()
	if phase == "pour" and holding then
		holding = false
		if pourLevel > 0.02 then
			pourDone = true
		end
	end
end

local function runBellows(p: any): number
	phase = "bellows"
	setStep("FORGE_STEP_BELLOWS", "FORGE_HINT_BELLOWS", "FORGE_PUMP", bellowsWidget)
	zoneFrame.Position = UDim2.fromScale(0, 1 - p.ZoneMax)
	zoneFrame.Size = UDim2.fromScale(1, p.ZoneMax - p.ZoneMin)
	heat = 0.3
	local inZone, t = 0, 0
	while t < p.Duration do
		local dt = RunService.RenderStepped:Wait()
		if cancelled then
			return 0
		end
		t += dt
		heat = math.max(0, heat - p.Decay * dt)
		local inside = heat >= p.ZoneMin and heat <= p.ZoneMax
		if inside then
			inZone += dt
		end
		heatFill.Size = UDim2.fromScale(1, heat)
		heatFill.BackgroundColor3 = if inside then Theme.Success elseif heat > p.ZoneMax then Theme.Danger else Theme.Gold
		timerFill.Size = UDim2.fromScale(1 - t / p.Duration, 1)
	end
	return math.clamp(inZone / p.Duration, 0, 1)
end

local function runPour(p: any): number
	phase = "pour"
	setStep("FORGE_STEP_POUR", "FORGE_HINT_POUR", "FORGE_POUR", pourWidget)
	pourLine.Position = UDim2.fromScale(0.5, 1 - p.Target)
	pourLevel = 0
	holding = false
	pourDone = false
	timerFill.Size = UDim2.fromScale(1, 1)
	local started = os.clock()
	while not pourDone do
		local dt = RunService.RenderStepped:Wait()
		if cancelled then
			return 0
		end
		if holding then
			pourLevel = math.min(1, pourLevel + p.FillPerSecond * dt)
			if pourLevel >= 1 then
				pourDone = true
			end
		elseif os.clock() - started > 8 then
			pourDone = true -- игрок отошёл от экрана
		end
		local close = math.abs(pourLevel - p.Target) <= F.Pour.PerfectTolerance * 2
		pourFill.Size = UDim2.fromScale(1, pourLevel)
		pourFill.BackgroundColor3 = if close then Theme.Success else Theme.Accent
	end
	holding = false
	-- сервер не примет слишком быстрое прохождение — подождём минимум
	local remaining = F.Pour.MinSeconds - (os.clock() - started)
	task.wait(math.max(0.4, remaining))
	return pourLevel
end

local function runHammer(p: any): { number }
	hammerParams = p
	phase = "hammer"
	setStep("FORGE_STEP_HAMMER", "FORGE_HINT_HAMMER", "FORGE_STRIKE", hammerWidget)
	local t0 = os.clock()
	beatTimes = {}
	offsets = {}
	for i = 1, p.Beats do
		beatTimes[i] = t0 + p.LeadIn + i * p.Interval
		offsets[i] = 9 -- промах, пока не ударил
	end
	local base = S(80)
	local finish = beatTimes[p.Beats] + F.Hammer.HitWindow + 0.15
	while os.clock() < finish do
		RunService.RenderStepped:Wait()
		if cancelled then
			return offsets
		end
		local now = os.clock()
		local nextIndex: number? = nil
		for i, t in beatTimes do
			if t + F.Hammer.HitWindow >= now and offsets[i] == 9 then
				nextIndex = i
				break
			end
		end
		if nextIndex then
			local timeTo = beatTimes[nextIndex] - now
			local k = math.clamp(timeTo / p.Interval, 0, 1)
			local size = base * (1 + 1.4 * k)
			hammerRing.Size = UDim2.fromOffset(size, size)
			hammerRing.Visible = true
			C.SetRaw(hammerCounter, `{nextIndex}/{p.Beats}`)
		else
			hammerRing.Visible = false
		end
		timerFill.Size = UDim2.fromScale(math.clamp(1 - (now - t0) / (finish - t0), 0, 1), 1)
	end
	hammerParams = nil
	return offsets
end

local function showResult(result: any)
	local weapon = result.weapon
	lastWeaponId = weapon.Id
	C.Bind(resultQuality, "FORGE_RESULT", { quality = result.quality })
	resultQuality.TextColor3 = if result.quality >= 90
		then Theme.Accent
		elseif result.quality >= 60 then Theme.Success
		else Theme.Text
	C.SetRaw(resultName, Localization.WeaponName(weapon.Type, weapon.Ore))
	C.Bind(resultDamage, "UI_DMG", { value = result.damage })
	local rarity = Config.Rarities[weapon.Rarity] or Config.Rarities.Common
	C.Bind(resultRarity, rarity.NameKey)
	resultRarity.TextColor3 = rarity.Color
	local names = {}
	for _, id in weapon.Traits or {} do
		local t = Config.Traits[id]
		if t then
			table.insert(names, Localization.Get(t.NameKey))
		end
	end
	C.SetRaw(resultTraits, table.concat(names, " · "))
	if rarity.Order >= 4 then
		Sound.Play("Celebrate")
	end
	showView("result")
	resultQuality.TextSize = S(48)
	TweenService:Create(resultQuality, TweenInfo.new(0.35, Theme.Ease, Enum.EasingDirection.Out), { TextSize = S(36) }):Play()
end

local function startForging()
	if running then
		return
	end
	running = true
	cancelled = false
	local response = UIController:Invoke("ForgeStart", selectedType, selectedOre)
	if not UIController:Handle(response) then
		running = false
		return
	end
	showView("game")
	-- ПК: пробел = кнопка действия (и не прыгать во время ковки)
	GuiService.SelectedObject = nil -- иначе кнопка A геймпада нажмёт выделенную кнопку окна
	ContextActionService:BindActionAtPriority("ForgeAction", function(_, state: Enum.UserInputState)
		if state == Enum.UserInputState.Begin then
			onPress()
		elseif state == Enum.UserInputState.End then
			onRelease()
		end
		return Enum.ContextActionResult.Sink
	end, false, 3000, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
	local params = response.params
	local okRun, err = pcall(function()
		local bellows = runBellows(params.Bellows)
		if cancelled then
			return
		end
		local pour = runPour(params.Pour)
		if cancelled then
			return
		end
		local hammer = runHammer(params.Hammer)
		if cancelled then
			return
		end
		phase = "submit"
		setStep("FORGE_STEP_HAMMER", "FORGE_WORKING", "FORGE_STRIKE", nil)
		local result = UIController:Invoke("ForgeSubmit", response.sessionId, {
			Bellows = bellows,
			Pour = pour,
			Hammer = hammer,
		})
		if UIController:Handle(result) then
			showResult(result)
		else
			showView("select")
		end
	end)
	ContextActionService:UnbindAction("ForgeAction")
	if not okRun then
		warn("[Forge]", err)
		showView("select")
	end
	phase = "idle"
	running = false
end

-- ===== Построение окна =====

local function build()
	panel = C.Panel({
		Name = "ForgePanel",
		Size = UDim2.fromOffset(S(540), S(332)),
	})
	C.TitleBar(panel, "UI_FORGE_TITLE", function()
		UIController:ClosePanel()
	end)

	local content = UDim2.new(1, -S(24), 1, -S(60))
	local contentPos = UDim2.fromOffset(S(12), S(48))

	-- выбор
	selectView = C.Make("Frame", { Size = content, Position = contentPos, BackgroundTransparency = 1, Parent = panel })
	C.Text({ Key = "UI_CHOOSE_WEAPON", TextSize = 13, Color = Theme.TextDim, Size = UDim2.new(1, 0, 0, S(16)), Parent = selectView })
	local weaponRow = C.Make("Frame", {
		Size = UDim2.new(1, 0, 0, S(48)),
		Position = UDim2.fromOffset(0, S(20)),
		BackgroundTransparency = 1,
		Parent = selectView,
	})
	C.List(weaponRow, Enum.FillDirection.Horizontal, 8)
	for i, id in sortedKeys(Config.Weapons) do
		weaponButtons[id] = C.Button({
			Key = Config.Weapons[id].NameKey,
			Size = UDim2.new(1 / 3, -S(8), 1, 0),
			LayoutOrder = i,
			TextSize = 17,
			OnClick = function()
				selectedType = id
				refreshSelect()
			end,
			Parent = weaponRow,
		})
	end

	C.Text({
		Key = "UI_CHOOSE_ORE",
		TextSize = 13,
		Color = Theme.TextDim,
		Size = UDim2.new(1, 0, 0, S(16)),
		Position = UDim2.fromOffset(0, S(76)),
		Parent = selectView,
	})
	local oreRow = C.Make("Frame", {
		Size = UDim2.new(1, 0, 0, S(48)),
		Position = UDim2.fromOffset(0, S(92)),
		BackgroundTransparency = 1,
		Parent = selectView,
	})
	C.List(oreRow, Enum.FillDirection.Horizontal, 8)
	for i, id in sortedKeys(Config.Ores) do
		oreButtons[id] = C.Button({
			Size = UDim2.new(1 / 3, -S(8), 1, 0),
			LayoutOrder = i,
			TextSize = 14,
			OnClick = function()
				local data = DataController:Get()
				if data and data.Level >= Config.Ores[id].RequiredLevel then
					selectedOre = id
					refreshSelect()
				end
			end,
			Parent = oreRow,
		})
	end

	costLabel = C.Text({ TextSize = 14, Size = UDim2.new(1, 0, 0, S(18)), Position = UDim2.fromOffset(0, S(148)), Parent = selectView })
	previewLabel = C.Text({
		TextSize = 15,
		Font = Theme.FontBold,
		Color = Theme.Accent,
		Size = UDim2.new(1, 0, 0, S(20)),
		Position = UDim2.fromOffset(0, S(172)),
		Parent = selectView,
	})
	-- шансы редкости (правила Roblox: шансы случайных наград должны быть видны)
	C.Button({
		Key = "UI_ODDS",
		TextSize = 13,
		Size = UDim2.fromOffset(S(84), S(32)),
		Position = UDim2.new(1, 0, 0, S(160)),
		AnchorPoint = Vector2.new(1, 0),
		Color = Theme.PanelLight,
		OnClick = function()
			local lines = { Localization.Get("UI_ODDS_TITLE") }
			local low = WeaponMath.RarityOdds(0, selectedOre)
			local high = WeaponMath.RarityOdds(100, selectedOre)
			for i, o in low do
				local function pct(v: number): string
					return if v >= 0.01 then string.format("%.1f", v * 100) else string.format("%.2f", v * 100)
				end
				table.insert(lines, Localization.Get("UI_ODDS_LINE", {
					rarity = "@" .. Config.Rarities[o.Id].NameKey,
					low = pct(o.Chance),
					high = pct(high[i].Chance),
				}))
			end
			table.insert(lines, Localization.Get("UI_ODDS_HINT"))
			C.SetRaw(oddsText, table.concat(lines, "\n"))
			oddsFrame.Visible = not oddsFrame.Visible
		end,
		Parent = selectView,
	})
	oddsFrame = C.Panel({
		Name = "Odds",
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.fromScale(0.5, 0.5),
		Color = Theme.Bg,
		Transparency = 0.02,
		Visible = false,
		ZIndex = 20,
		Parent = selectView,
	})
	oddsText = C.Text({
		TextSize = 14,
		Wrapped = true,
		ZIndex = 21,
		AlignY = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, -S(20), 1, -S(60)),
		Position = UDim2.fromOffset(S(12), S(8)),
		Parent = oddsFrame,
	})
	C.Button({
		Key = "UI_CLOSE",
		TextSize = 14,
		ZIndex = 21,
		Size = UDim2.fromOffset(S(140), S(40)),
		Position = UDim2.new(0.5, 0, 1, -S(8)),
		AnchorPoint = Vector2.new(0.5, 1),
		OnClick = function()
			oddsFrame.Visible = false
		end,
		Parent = oddsFrame,
	})

	forgeButton = C.Button({
		Key = "UI_FORGE_BUTTON",
		Font = Theme.FontTitle,
		TextSize = 24,
		Size = UDim2.fromOffset(S(240), S(56)),
		Position = UDim2.new(0.5, 0, 1, 0),
		AnchorPoint = Vector2.new(0.5, 1),
		Color = Theme.Accent,
		TextColor = Theme.Bg,
		OnClick = function()
			task.spawn(startForging)
		end,
		Parent = selectView,
	})

	-- мини-игра
	gameView = C.Make("Frame", { Size = content, Position = contentPos, BackgroundTransparency = 1, Visible = false, Parent = panel })
	stepTitle = C.Text({ Font = Theme.FontTitle, TextSize = 20, Color = Theme.Text, Size = UDim2.new(1, 0, 0, S(22)), Parent = gameView })
	stepHint = C.Text({
		TextSize = 14,
		Color = Theme.TextDim,
		Size = UDim2.new(1, 0, 0, S(20)),
		Position = UDim2.fromOffset(0, S(24)),
		Parent = gameView,
	})
	local _, tFill = C.Bar({
		Size = UDim2.new(0.5, 0, 0, S(8)),
		Position = UDim2.new(0, 0, 1, 0),
		AnchorPoint = Vector2.new(0, 1),
		Color = Theme.Accent,
		Value = 1,
		Parent = gameView,
	})
	timerFill = tFill

	local widgetArea = C.Make("Frame", {
		Size = UDim2.new(0.5, 0, 1, -S(64)),
		Position = UDim2.fromOffset(0, S(48)),
		BackgroundTransparency = 1,
		Parent = gameView,
	})

	-- меха: вертикальный термометр с зелёной зоной
	bellowsWidget = C.Make("Frame", {
		Size = UDim2.new(0, S(48), 1, 0),
		Position = UDim2.fromScale(0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Bg,
		Parent = widgetArea,
	})
	C.Corner(bellowsWidget, 6)
	C.Stroke(bellowsWidget)
	zoneFrame = C.Make("Frame", {
		BackgroundColor3 = Theme.Success,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = bellowsWidget,
	})
	heatFill = C.Make("Frame", {
		Size = UDim2.fromScale(1, 0.3),
		Position = UDim2.fromScale(0, 1),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = Theme.Gold,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = bellowsWidget,
	})
	C.Corner(heatFill, 6)

	-- заливка: форма, которая наполняется металлом
	pourWidget = C.Make("Frame", {
		Size = UDim2.new(0, S(72), 1, 0),
		Position = UDim2.fromScale(0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Bg,
		Visible = false,
		Parent = widgetArea,
	})
	C.Corner(pourWidget, 6)
	C.Stroke(pourWidget)
	pourFill = C.Make("Frame", {
		Size = UDim2.fromScale(1, 0),
		Position = UDim2.fromScale(0, 1),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = Color3.fromRGB(255, 140, 40),
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = pourWidget,
	})
	pourLine = C.Make("Frame", {
		Size = UDim2.new(1, S(16), 0, S(4)),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = pourWidget,
	})

	-- молот: круг-цель и сходящееся кольцо
	hammerWidget = C.Make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = widgetArea })
	local target = C.Make("Frame", {
		Size = UDim2.fromOffset(S(80), S(80)),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.PanelLight,
		BackgroundTransparency = 0,
		Parent = hammerWidget,
	})
	C.Round(target)
	C.Stroke(target, Theme.Accent, 2)
	hammerRing = C.Make("Frame", {
		Size = UDim2.fromOffset(S(160), S(160)),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = hammerWidget,
	})
	C.Round(hammerRing)
	C.Stroke(hammerRing, Theme.Text, 2)
	hammerCounter = C.Text({
		Font = Theme.FontBold,
		TextSize = 18,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = target,
	})
	hammerFeedback = C.Text({
		Font = Theme.FontTitle,
		TextSize = 22,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, S(32)),
		Position = UDim2.fromScale(0, 0),
		ZIndex = 3,
		Parent = hammerWidget,
	})

	-- большая кнопка действия
	actionButton = C.Button({
		Font = Theme.FontTitle,
		TextSize = 26,
		Size = UDim2.fromOffset(S(192), S(120)),
		Position = UDim2.new(0.75, 0, 0.55, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = Theme.Accent,
		TextColor = Theme.Bg,
		Silent = true,
		Parent = gameView,
	})
	actionButton.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			onPress()
		end
	end)
	actionButton.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			onRelease()
		end
	end)

	-- результат
	resultView = C.Make("Frame", { Size = content, Position = contentPos, BackgroundTransparency = 1, Visible = false, Parent = panel })
	resultQuality = C.Text({
		Font = Theme.FontTitle,
		TextSize = 36,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, S(52)),
		Position = UDim2.fromOffset(0, S(12)),
		Parent = resultView,
	})
	resultName = C.Text({
		Font = Theme.FontBold,
		TextSize = 20,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, S(28)),
		Position = UDim2.fromOffset(0, S(68)),
		Parent = resultView,
	})
	resultDamage = C.Text({
		TextSize = 17,
		Color = Theme.Accent,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, S(24)),
		Position = UDim2.fromOffset(0, S(96)),
		Parent = resultView,
	})
	resultRarity = C.Text({
		Font = Theme.FontTitle,
		TextSize = 18,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, S(24)),
		Position = UDim2.fromOffset(0, S(120)),
		Parent = resultView,
	})
	resultTraits = C.Text({
		TextSize = 14,
		Color = Theme.TextDim,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, S(20)),
		Position = UDim2.fromOffset(0, S(144)),
		Parent = resultView,
	})
	C.Button({
		Key = "UI_EQUIP",
		Size = UDim2.fromOffset(S(200), S(52)),
		Position = UDim2.new(0.5, -S(8), 1, 0),
		AnchorPoint = Vector2.new(1, 1),
		Color = Theme.Accent,
		TextColor = Theme.Bg,
		OnClick = function()
			if lastWeaponId then
				local result = UIController:Invoke("EquipWeapon", lastWeaponId)
				if UIController:Handle(result) then
					UIController:ClosePanel()
				end
			end
		end,
		Parent = resultView,
	})
	C.Button({
		Key = "FORGE_AGAIN",
		Size = UDim2.fromOffset(S(200), S(52)),
		Position = UDim2.new(0.5, S(8), 1, 0),
		AnchorPoint = Vector2.new(0, 1),
		OnClick = function()
			showView("select")
		end,
		Parent = resultView,
	})
end

function ForgeController:Start()
	build()
	UIController:RegisterPanel("Forge", {
		Frame = panel,
		OnOpen = function()
			if not running then
				showView("select")
			end
		end,
		OnClose = function()
			if running then
				cancelled = true
				Net.Event("ForgeCancel"):FireServer()
			end
		end,
	})

	DataController.Changed:Connect(function(key: string)
		if selectView and selectView.Visible and (key == "*" or key == "Ores" or key == "Level") then
			refreshSelect()
		end
	end)
end

function ForgeController:IsBusy(): boolean
	return phase ~= "idle"
end

return ForgeController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000047"><Properties><string name="Name">FxController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ЭФФЕКТЫ: всплывающие цифры урона, «ПАРИРОВАНИЕ!», искры добычи, вспышка экрана при попадании.
	Всё через пулы объектов (никаких Instance.new на каждый удар) — важно для слабых телефонов.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Localization = require(ReplicatedStorage.Shared.Localization)
local Net = require(ReplicatedStorage.Shared.Net)
local Config = require(ReplicatedStorage.Shared.Config)
local ClientSettings = require(script.Parent.Parent.UI.ClientSettings)
local Sound = require(script.Parent.Parent.UI.Sound)
local Theme = require(script.Parent.Parent.UI.Theme)
local UIController = require(script.Parent.UIController)

local FxController = {}

local POOL_SIZE = 14
local PARTICLE_POOL = 6

type Popup = { Attachment: Attachment, Gui: BillboardGui, Label: TextLabel }
local popups: { Popup } = {}
local popupIndex = 0

type Burst = { Attachment: Attachment, Emitter: ParticleEmitter }
local bursts: { Burst } = {}
local burstIndex = 0

local function build()
	local terrain = workspace.Terrain
	for i = 1, POOL_SIZE do
		local attachment = Instance.new("Attachment")
		attachment.Name = "FxPopup" .. i
		attachment.Parent = terrain
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(160, 50)
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		gui.MaxDistance = 120
		gui.Adornee = attachment
		gui.Enabled = false
		gui.Parent = attachment
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Theme.FontTitle
		label.TextScaled = true
		label.TextStrokeTransparency = 0.2
		label.Parent = gui
		table.insert(popups, { Attachment = attachment, Gui = gui, Label = label })
	end
	for i = 1, PARTICLE_POOL do
		local attachment = Instance.new("Attachment")
		attachment.Name = "FxBurst" .. i
		attachment.Parent = terrain
		local emitter = Instance.new("ParticleEmitter")
		emitter.Enabled = false
		emitter.Lifetime = NumberRange.new(0.3, 0.6)
		emitter.Speed = NumberRange.new(8, 16)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = NumberSequence.new(0.35, 0)
		emitter.LightEmission = 1
		emitter.Acceleration = Vector3.new(0, -30, 0)
		emitter.Parent = attachment
		table.insert(bursts, { Attachment = attachment, Emitter = emitter })
	end
end

local function popup(position: Vector3, text: string, color: Color3, big: boolean?)
	if not ClientSettings.DamageNumbers and not big then
		return
	end
	popupIndex = popupIndex % POOL_SIZE + 1
	local p = popups[popupIndex]
	local offset = Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1)
	p.Attachment.WorldPosition = position + offset
	p.Label.Text = text
	p.Label.TextColor3 = color
	p.Label.TextTransparency = 0
	p.Label.TextStrokeTransparency = 0.2
	p.Gui.Size = if big then UDim2.fromOffset(220, 64) else UDim2.fromOffset(120, 40)
	p.Gui.StudsOffsetWorldSpace = Vector3.zero
	p.Gui.Enabled = true
	local info = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(p.Gui, info, { StudsOffsetWorldSpace = Vector3.new(0, 3, 0) }):Play()
	local fade = TweenService:Create(p.Label, TweenInfo.new(0.35, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.45), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})
	fade:Play()
	local gui = p.Gui
	local label = p.Label
	task.delay(0.85, function()
		if label.Text == text and label.TextTransparency >= 0.99 then
			gui.Enabled = false
		end
	end)
end

local function burst(position: Vector3, color: Color3, count: number)
	if ClientSettings.LowGraphics then
		count = math.ceil(count / 4)
	end
	burstIndex = burstIndex % PARTICLE_POOL + 1
	local b = bursts[burstIndex]
	b.Attachment.WorldPosition = position
	b.Emitter.Color = ColorSequence.new(color)
	b.Emitter:Emit(count)
end

local function onFx(payload: { [string]: any })
	local kind = payload.Kind
	local position = payload.Position
	if typeof(position) ~= "Vector3" then
		return
	end
	local localId = Players.LocalPlayer.UserId

	if kind == "Damage" then
		local mine = payload.ByUserId == localId
		if payload.Crit then
			popup(position, `{Localization.Get("FX_CRIT")} {payload.Amount}`, Color3.fromRGB(255, 120, 40), true)
		else
			popup(position, tostring(payload.Amount), if mine then Theme.Gold else Theme.Text, false)
		end
		burst(position, Color3.fromRGB(255, 220, 160), 6)
		if mine then
			Sound.Play("HitMob", 0.5, 0.9 + math.random() * 0.2)
		end
	elseif kind == "PlayerHit" then
		local isMe = payload.UserId == localId
		if payload.Result == "parry" then
			popup(position + Vector3.new(0, 2, 0), Localization.Get("FX_PARRY"), Theme.Accent, true)
			burst(position, Theme.Accent, 20)
			if isMe then
				Sound.Play("Parry")
			end
		elseif payload.Result == "block" then
			popup(position + Vector3.new(0, 2, 0), `{Localization.Get("FX_BLOCK")} -{payload.Amount}`, Theme.TextDim, false)
			if isMe then
				UIController:FlashHit(0.2)
			end
		else
			popup(position + Vector3.new(0, 2, 0), `-{payload.Amount}`, Theme.Danger, false)
			if isMe then
				UIController:FlashHit(0.5)
			end
		end
	elseif kind == "MineHit" then
		local color = if typeof(payload.Color) == "Color3" then payload.Color else Color3.new(1, 1, 1)
		burst(position, color, 8)
		Sound.Play("MineHit", 0.5, 0.9 + (payload.Progress or 0) * 0.3)
	elseif kind == "OreBreak" then
		local color = if typeof(payload.Color) == "Color3" then payload.Color else Color3.new(1, 1, 1)
		burst(position, color, 25)
		Sound.Play("OreBreak")
	elseif kind == "MobDeath" then
		burst(position, Color3.fromRGB(255, 120, 60), if payload.Boss then 60 else 20)
	elseif kind == "Slam" then
		burst(position, Theme.Danger, 40)
	elseif kind == "Burn" then
		popup(position, tostring(payload.Amount), Color3.fromRGB(255, 140, 50), false)
	elseif kind == "Celebrate" then
		-- редкая ковка: столб света и взрыв частиц цвета редкости (виден всем рядом)
		local rarity = Config.Rarities[payload.Rarity] or Config.Rarities.Legendary
		burst(position, rarity.Color, 80)
		burst(position + Vector3.new(0, 4, 0), Color3.new(1, 1, 1), 40)
		popup(position + Vector3.new(0, 5, 0), Localization.Get(rarity.NameKey), rarity.Color, true)
		local pillar = Instance.new("Part")
		pillar.Anchored = true
		pillar.CanCollide = false
		pillar.CanQuery = false
		pillar.CastShadow = false
		pillar.Material = Enum.Material.Neon
		pillar.Color = rarity.Color
		pillar.Size = Vector3.new(3, 120, 3)
		pillar.CFrame = CFrame.new(position + Vector3.new(0, 60, 0))
		pillar.Transparency = 0.2
		pillar.Parent = workspace.CurrentCamera -- только на этом клиенте
		TweenService:Create(pillar, TweenInfo.new(2.5), { Transparency = 1, Size = Vector3.new(0.5, 120, 0.5) }):Play()
		task.delay(2.6, function()
			pillar:Destroy()
		end)
	end
end

function FxController:Start()
	build()
	Net.UnreliableEvent("Fx").OnClientEvent:Connect(function(payload)
		if type(payload) == "table" then
			onFx(payload)
		end
	end)
end

return FxController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000048"><Properties><string name="Name">GateController</string><ProtectedString name="Source"><![CDATA[--!strict
-- ВРАТА на клиенте: карточка группы (ожидание старта) и забега (волна, время, босс).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Format = require(ReplicatedStorage.Shared.Format)
local Localization = require(ReplicatedStorage.Shared.Localization)
local Net = require(ReplicatedStorage.Shared.Net)
local C = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)
local UIController = require(script.Parent.UIController)

local S = Theme.S

local GateController = {}

local card: Frame
local line1: TextLabel
local line2: TextLabel
local startButton: TextButton
local bossFrame: Frame
local bossName: TextLabel
local bossFill: Frame

local state: { [string]: any } = { Phase = "none" }
local deadline: number? = nil -- os.clock(), когда таймер дойдёт до 0

local function render()
	local phase = state.Phase
	card.Visible = phase == "lobby" or phase == "run"
	bossFrame.Visible = phase == "run" and state.Boss ~= nil
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		-- обычная рамка — тонкая линия; у Красных врат — красная
		stroke.Color = if state.IsRed then Theme.Danger else Theme.Text
		stroke.Transparency = if state.IsRed then 0 else Theme.HairlineTransparency
	end
	line1.TextColor3 = if state.IsRed then Theme.Danger else Theme.Text
	if phase == "lobby" then
		local text = Localization.Get("UI_GATE_LOBBY", { gate = "@" .. state.GateNameKey, count = state.Count, max = state.Max })
		C.SetRaw(line1, if state.IsRed then `{Localization.Get("UI_RED_PREFIX")} · {text}` else text)
		startButton.Visible = state.IsLeader == true
	elseif phase == "run" then
		local text = if state.BossPhase
			then Localization.Get("UI_GATE_BOSS")
			else Localization.Get("UI_GATE_WAVE", { wave = state.Wave, total = state.TotalWaves })
		C.SetRaw(line1, if state.IsRed then `{Localization.Get("UI_RED_PREFIX")} · {text}` else text)
		startButton.Visible = false
		local boss = state.Boss
		if boss then
			C.Bind(bossName, boss.NameKey)
			bossFill.Size = UDim2.fromScale(math.clamp(boss.Health / boss.MaxHealth, 0, 1), 1)
		end
	end
end

local function updateTimer()
	if not card.Visible or not deadline then
		return
	end
	local left = math.max(0, deadline - os.clock())
	if state.Phase == "lobby" then
		C.Bind(line2, "UI_GATE_STARTS_IN", { time = Format.Time(left) })
	else
		local alive = Localization.Get("UI_GATE_ALIVE", { alive = state.Alive or 0, total = state.Total or 0 })
		C.SetRaw(line2, `{Format.Time(left)}   ·   {alive}`)
	end
end

local function build()
	local hud = UIController.Layers.Hud
	card = C.Panel({
		Name = "GateCard",
		Size = UDim2.fromOffset(S(300), S(68)),
		Position = UDim2.new(0.5, 0, 0, S(8)),
		AnchorPoint = Vector2.new(0.5, 0),
		Transparency = 0.15,
		Visible = false,
		Adaptive = true,
		Parent = hud,
	})
	line1 = C.Text({
		Font = Theme.FontBold,
		TextSize = 15,
		Size = UDim2.new(1, -S(100), 0, S(24)),
		Position = UDim2.fromOffset(S(12), S(8)),
		Parent = card,
	})
	line2 = C.Text({
		TextSize = 13,
		Color = Theme.TextDim,
		Size = UDim2.new(1, -S(100), 0, S(20)),
		Position = UDim2.fromOffset(S(12), S(36)),
		Parent = card,
	})
	C.Button({
		Key = "UI_GATE_LEAVE",
		TextSize = 13,
		Size = UDim2.fromOffset(S(80), S(28)),
		Position = UDim2.new(1, -S(8), 0, S(8)),
		AnchorPoint = Vector2.new(1, 0),
		Color = Theme.PanelLight,
		OnClick = function()
			Net.Event("GateLeave"):FireServer()
		end,
		Parent = card,
	})
	startButton = C.Button({
		Key = "UI_GATE_START",
		TextSize = 13,
		Size = UDim2.fromOffset(S(80), S(28)),
		Position = UDim2.new(1, -S(8), 1, -S(8)),
		AnchorPoint = Vector2.new(1, 1),
		Color = Theme.Accent,
		TextColor = Theme.Bg,
		Visible = false,
		OnClick = function()
			Net.Event("GateStart"):FireServer()
		end,
		Parent = card,
	})

	bossFrame = C.Make("Frame", {
		Name = "BossBar",
		Size = UDim2.fromOffset(S(360), S(36)),
		Position = UDim2.new(0.5, 0, 0, S(80)),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = hud,
	})
	C.Adaptive(bossFrame)
	bossName = C.Text({
		Font = Theme.FontTitle,
		TextSize = 14,
		Color = Theme.Danger,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, S(16)),
		Parent = bossFrame,
	})
	local _, fill = C.Bar({
		Size = UDim2.new(1, 0, 0, S(12)),
		Position = UDim2.fromOffset(0, S(20)),
		Color = Theme.Danger,
		Value = 1,
		Parent = bossFrame,
	})
	bossFill = fill
end

function GateController:Start()
	build()
	Localization.Changed:Connect(render)
	Net.Event("GateState").OnClientEvent:Connect(function(payload: { [string]: any })
		state = payload
		if payload.Phase == "lobby" then
			deadline = if payload.StartsIn then os.clock() + payload.StartsIn else nil
		elseif payload.Phase == "run" then
			deadline = os.clock() + (payload.TimeLeft or 0)
		else
			deadline = nil
		end
		render()
		updateTimer()
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.25 then
			acc = 0
			updateTimer()
		end
	end)
end

return GateController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000049"><Properties><string name="Name">HudController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	HUD: ранг, уровень, опыт, золото, бонус опыта, язык (слева сверху);
	кнопки «Меню» и «Инвентарь» справа по центру (не мешают стику и прыжку на телефоне);
	полоса подсказок управления внизу — только для ПК и геймпада.
	Горячие клавиши: I / Y(геймпад) — инвентарь, M / ↑(геймпад) — меню.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local WeaponMath = require(ReplicatedStorage.Shared.WeaponMath)
local C = require(script.Parent.Parent.UI.Components)
local Sound = require(script.Parent.Parent.UI.Sound)
local Theme = require(script.Parent.Parent.UI.Theme)
local DataController = require(script.Parent.DataController)
local InputController = require(script.Parent.InputController)
local LocalizationController = require(script.Parent.LocalizationController)
local UIController = require(script.Parent.UIController)

local S = Theme.S
local player = Players.LocalPlayer

local HudController = {}

local rankLabel: TextLabel
local levelLabel: TextLabel
local xpFill: Frame
local xpLabel: TextLabel
local goldLabel: TextLabel
local bonusLabel: TextLabel
local inventoryButton: TextButton
local controlsBar: TextLabel
local lastGold = -1

local function refresh()
	local data = DataController:Get()
	if not data then
		return
	end
	C.SetRaw(rankLabel, WeaponMath.RankById(data.Rank or "F").Short)
	C.Bind(levelLabel, "UI_LEVEL", { level = data.Level })
	if data.Level >= Config.Leveling.MaxLevel then
		xpFill.Size = UDim2.fromScale(1, 1)
		C.Bind(xpLabel, "UI_MAX_LEVEL")
	else
		local need = WeaponMath.XpToNext(data.Level)
		TweenService:Create(xpFill, TweenInfo.new(0.3), { Size = UDim2.fromScale(math.clamp(data.Xp / need, 0, 1), 1) })
			:Play()
		C.Bind(xpLabel, "UI_XP", { xp = Format.Short(data.Xp), need = Format.Short(need) })
	end
	C.SetRaw(goldLabel, Format.Short(data.Gold))
	if lastGold >= 0 and data.Gold > lastGold then
		Sound.Play("Coins", 0.4)
		goldLabel.TextSize = S(22)
		TweenService:Create(goldLabel, TweenInfo.new(0.25), { TextSize = S(17) }):Play()
	end
	lastGold = data.Gold
end

local function refreshBonus()
	local bonus = player:GetAttribute("XpBonus")
	local pct = if type(bonus) == "number" then math.floor(bonus * 100 + 0.5) else 0
	bonusLabel.Visible = pct > 0
	if pct > 0 then
		C.Bind(bonusLabel, "UI_XP_BONUS", { pct = pct })
	end
end

local function refreshControls()
	local mode = InputController.Mode
	controlsBar.Visible = mode ~= "Touch"
	if mode == "Gamepad" then
		C.Bind(controlsBar, "CONTROLS_PAD")
	else
		C.Bind(controlsBar, "CONTROLS_KBM")
	end
end

local function build()
	local hud = UIController.Layers.Hud

	-- ===== левый верхний блок =====
	local top = C.Panel({
		Name = "TopLeft",
		Size = UDim2.fromOffset(S(252), S(84)),
		Position = UDim2.fromOffset(S(12), S(8)),
		AnchorPoint = Vector2.zero,
		Transparency = 0.2,
		Adaptive = true,
		Parent = hud,
	})

	local badge = C.Make("Frame", {
		Name = "RankBadge",
		Size = UDim2.fromOffset(S(48), S(48)),
		Position = UDim2.fromOffset(S(8), S(8)),
		BackgroundColor3 = Theme.Bg,
		Parent = top,
	})
	C.Corner(badge, 6)
	C.Stroke(badge)
	rankLabel = C.Text({
		Font = Theme.FontTitle,
		TextSize = 30,
		Color = Theme.Text,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Text = "F",
		Parent = badge,
	})

	levelLabel = C.Text({
		Font = Theme.FontTitle,
		TextSize = 18,
		Size = UDim2.new(1, -S(68), 0, S(20)),
		Position = UDim2.fromOffset(S(64), S(8)),
		Parent = top,
	})
	bonusLabel = C.Text({
		Font = Theme.FontBold,
		TextSize = 12,
		Color = Theme.Success,
		AlignX = Enum.TextXAlignment.Right,
		Size = UDim2.new(0, S(92), 0, S(20)),
		Position = UDim2.new(1, -S(8), 0, S(8)),
		AnchorPoint = Vector2.new(1, 0),
		Visible = false,
		Parent = top,
	})
	local _, fill = C.Bar({
		Size = UDim2.new(1, -S(72), 0, S(12)),
		Position = UDim2.fromOffset(S(64), S(28)),
		Parent = top,
	})
	xpFill = fill
	xpLabel = C.Text({
		TextSize = 12,
		Color = Theme.TextDim,
		Size = UDim2.new(1, -S(68), 0, S(16)),
		Position = UDim2.fromOffset(S(64), S(40)),
		Parent = top,
	})

	-- золото
	local goldIcon = C.Make("Frame", {
		Size = UDim2.fromOffset(S(16), S(16)),
		Position = UDim2.fromOffset(S(12), S(64)),
		BackgroundColor3 = Theme.Gold,
		Parent = top,
	})
	C.Round(goldIcon)
	goldLabel = C.Text({
		Font = Theme.FontBold,
		TextSize = 17,
		Color = Theme.Gold,
		Size = UDim2.fromOffset(S(120), S(20)),
		Position = UDim2.fromOffset(S(32), S(60)),
		Text = "0",
		Parent = top,
	})

	-- язык
	C.Button({
		Name = "Language",
		Key = "UI_LANG",
		TextSize = 14,
		Size = UDim2.fromOffset(S(48), S(28)),
		Position = UDim2.new(1, -S(8), 0, S(52)),
		AnchorPoint = Vector2.new(1, 0),
		Color = Theme.PanelLight,
		OnClick = function()
			LocalizationController:Toggle()
		end,
		Parent = top,
	})

	-- ===== правая колонка: Меню и Инвентарь =====
	local column = C.Make("Frame", {
		Name = "RightButtons",
		Size = UDim2.fromOffset(S(84), S(132)),
		Position = UDim2.new(1, -S(12), 0.5, -S(32)),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundTransparency = 1,
		Parent = hud,
	})
	C.Adaptive(column)
	C.List(column, Enum.FillDirection.Vertical, 8)
	local menuButton = C.Button({
		Name = "Menu",
		Key = "UI_MENU",
		TextSize = 13,
		Size = UDim2.fromOffset(S(84), S(60)),
		Color = Theme.Panel,
		Transparency = 0.1,
		LayoutOrder = 1,
		OnClick = function()
			UIController:TogglePanel("Menu")
		end,
		Parent = column,
	})
	C.KeyHint(menuButton, { KeyboardMouse = "M", Gamepad = "↑" })
	inventoryButton = C.Button({
		Name = "Inventory",
		Key = "UI_INVENTORY",
		TextSize = 13,
		Size = UDim2.fromOffset(S(84), S(60)),
		Color = Theme.Panel,
		Transparency = 0.1,
		LayoutOrder = 2,
		OnClick = function()
			UIController:TogglePanel("Inventory")
		end,
		Parent = column,
	})
	C.KeyHint(inventoryButton, { KeyboardMouse = "I", Gamepad = "Y" })

	-- ===== подсказки управления (ПК / геймпад) =====
	controlsBar = C.Make("TextLabel", {
		Name = "Controls",
		Size = UDim2.fromOffset(S(520), S(24)),
		Position = UDim2.new(0.5, 0, 1, -S(8)),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.45,
		Font = Theme.Font,
		TextSize = S(13),
		TextColor3 = Theme.TextDim,
		Parent = hud,
	})
	C.Corner(controlsBar, 6)
	C.Adaptive(controlsBar)
end

-- Подсказка обучения «надень оружие»: кнопка инвентаря получает рамку цвета углей.
-- Статично: мигание без живого события только отвлекает.
function HudController:SetInventoryPulse(enabled: boolean)
	local stroke = inventoryButton:FindFirstChildOfClass("UIStroke")
	if not stroke then
		return
	end
	if enabled then
		stroke.Color = Theme.Accent
		stroke.Thickness = S(2)
		stroke.Transparency = 0
	else
		stroke.Color = Theme.Text
		stroke.Thickness = S(1)
		stroke.Transparency = Theme.HairlineTransparency
	end
end

local function bindShortcut(name: string, panel: string, ...: Enum.KeyCode)
	ContextActionService:BindAction(name, function(_, state)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		UIController:TogglePanel(panel)
		return Enum.ContextActionResult.Sink
	end, false, ...)
end

function HudController:Start()
	build()
	DataController.Changed:Connect(function(key: string)
		if key == "*" or key == "Level" or key == "Xp" or key == "Gold" or key == "Rank" then
			refresh()
		end
	end)
	player:GetAttributeChangedSignal("XpBonus"):Connect(refreshBonus)
	InputController.Changed:Connect(refreshControls)
	refresh()
	refreshBonus()
	refreshControls()

	bindShortcut("ToggleInventory", "Inventory", Enum.KeyCode.I, Enum.KeyCode.ButtonY)
	bindShortcut("ToggleMenu", "Menu", Enum.KeyCode.M, Enum.KeyCode.DPadUp)
end

return HudController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000004A"><Properties><string name="Name">InputController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ТИП УПРАВЛЕНИЯ: Touch (телефон/планшет) | KeyboardMouse (ПК) | Gamepad (консоль, геймпад на ПК).
	Меняется на лету по последнему вводу: подключил геймпад к ПК — интерфейс сразу перестроится.
	Интерфейс по нему решает: показывать ли большие сенсорные кнопки, какие подсказки клавиш писать,
	включать ли навигацию геймпадом по окнам.
]]

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Signal = require(ReplicatedStorage.Shared.Signal)
local C = require(script.Parent.Parent.UI.Components)

local InputController = {}

InputController.Mode = "KeyboardMouse"
InputController.Changed = Signal.new() -- (mode)

local function modeFor(t: Enum.UserInputType): string?
	if t == Enum.UserInputType.Touch then
		return "Touch"
	elseif string.sub(t.Name, 1, 7) == "Gamepad" then
		return "Gamepad"
	elseif
		t == Enum.UserInputType.Keyboard
		or t == Enum.UserInputType.MouseButton1
		or t == Enum.UserInputType.MouseButton2
		or t == Enum.UserInputType.MouseMovement
		or t == Enum.UserInputType.MouseWheel
	then
		return "KeyboardMouse"
	end
	return nil
end

local function setMode(mode: string)
	if mode == InputController.Mode then
		return
	end
	InputController.Mode = mode
	C.SetInputMode(mode)
	InputController.Changed:Fire(mode)
end

function InputController:Init()
	local initial = modeFor(UserInputService:GetLastInputType())
	if not initial then
		if GuiService:IsTenFootInterface() then
			initial = "Gamepad" -- консоль / телевизор
		elseif UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
			initial = "Touch"
		elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
			initial = "Gamepad"
		else
			initial = "KeyboardMouse"
		end
	end
	InputController.Mode = initial :: string
	C.SetInputMode(InputController.Mode)
end

function InputController:Start()
	UserInputService.LastInputTypeChanged:Connect(function(t)
		local mode = modeFor(t)
		if mode then
			setMode(mode)
		end
	end)
end

function InputController:IsTouch(): boolean
	return InputController.Mode == "Touch"
end

function InputController:IsGamepad(): boolean
	return InputController.Mode == "Gamepad"
end

return InputController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000004B"><Properties><string name="Name">InventoryController</string><ProtectedString name="Source"><![CDATA[--!strict
-- ИНВЕНТАРЬ: руда, кирки, оружие. Тап по карточке — надеть оружие.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Localization = require(ReplicatedStorage.Shared.Localization)
local C = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)
local WeaponCard = require(script.Parent.Parent.UI.WeaponCard)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local S = Theme.S

local InventoryController = {}

local panel: Frame
local slotsLabel: TextLabel
local sideList: Frame
local grid: ScrollingFrame
local emptyLabel: TextLabel

local function sortedIds(tbl: { [string]: any }): { string }
	local ids = {}
	for id in tbl do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		return tbl[a].Order < tbl[b].Order
	end)
	return ids
end

local function refresh()
	local data = DataController:Get()
	if not data or not panel.Visible then
		return
	end

	-- слева: руда и кирки
	for _, child in sideList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end
	C.Text({ Key = "UI_ORES", Font = Theme.FontBold, TextSize = 13, Color = Theme.Muted, Size = UDim2.new(1, 0, 0, S(20)), LayoutOrder = nextOrder(), Parent = sideList })
	for _, id in sortedIds(Config.Ores) do
		C.Text({
			Key = "UI_ORE_COUNT",
			Args = { ore = "@" .. Config.Ores[id].NameKey, count = data.Ores[id] or 0 },
			TextSize = 13,
			Size = UDim2.new(1, 0, 0, S(20)),
			LayoutOrder = nextOrder(),
			Parent = sideList,
		})
	end
	C.Text({ Key = "UI_PICKAXES", Font = Theme.FontBold, TextSize = 13, Color = Theme.Muted, Size = UDim2.new(1, 0, 0, S(24)), AlignY = Enum.TextYAlignment.Bottom, LayoutOrder = nextOrder(), Parent = sideList })
	for _, id in sortedIds(Config.Pickaxes) do
		if data.OwnedPickaxes[id] then
			local def = Config.Pickaxes[id]
			local equipped = data.Pickaxe == id
			C.Button({
				Text = `{Localization.Get(def.NameKey)} · {Localization.Get("UI_POWER", { value = def.Power })}`,
				TextSize = 12,
				Size = UDim2.new(1, 0, 0, S(36)),
				Color = if equipped then Theme.AccentDim else Theme.PanelLight,
				StrokeColor = if equipped then Theme.Accent else nil,
				LayoutOrder = nextOrder(),
				OnClick = function()
					if not equipped then
						UIController:Handle(UIController:Invoke("EquipPickaxe", id))
					end
				end,
				Parent = sideList,
			})
		end
	end

	-- справа: оружие
	WeaponCard.Clear(grid)
	local list = WeaponCard.Sorted(data.Weapons)
	C.Bind(slotsLabel, "UI_SLOTS", { count = #list, max = Config.Economy.InventoryCapacity })
	emptyLabel.Visible = #list == 0
	for i, weapon in list do
		local equipped = data.EquippedWeapon == weapon.Id
		local listed = data.Shop.Listings[weapon.Id] ~= nil
		WeaponCard.Create({
			Weapon = weapon,
			Equipped = equipped,
			Listed = listed,
			LayoutOrder = i,
			Parent = grid,
			OnClick = function()
				if equipped then
					return
				end
				if listed then
					UIController:Toast("ERR_LISTED", nil, "error")
					return
				end
				local result = UIController:Invoke("EquipWeapon", weapon.Id)
				if UIController:Handle(result) then
					UIController:Toast("TOAST_EQUIPPED", { item = `@WEAPON:{weapon.Type}:{weapon.Ore}` }, "success")
				end
			end,
		})
	end
end

local function build()
	panel = C.Panel({ Name = "InventoryPanel", Size = UDim2.fromOffset(S(540), S(332)) })
	C.TitleBar(panel, "UI_INVENTORY", function()
		UIController:ClosePanel()
	end)
	slotsLabel = C.Text({
		TextSize = 14,
		Color = Theme.TextDim,
		AlignX = Enum.TextXAlignment.Right,
		Size = UDim2.fromOffset(S(80), S(36)),
		Position = UDim2.new(1, -S(56), 0, S(8)),
		AnchorPoint = Vector2.new(1, 0),
		Parent = panel,
	})

	sideList = C.Make("ScrollingFrame", {
		Size = UDim2.new(0, S(172), 1, -S(112)),
		Position = UDim2.fromOffset(S(12), S(48)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = S(4),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = panel,
	})
	C.List(sideList, Enum.FillDirection.Vertical, 4)
	C.Button({
		Name = "MyShop",
		Key = "UI_MY_SHOP",
		TextSize = 15,
		Size = UDim2.fromOffset(S(172), S(44)),
		Position = UDim2.new(0, S(12), 1, -S(12)),
		AnchorPoint = Vector2.new(0, 1),
		OnClick = function()
			UIController:OpenPanel("Shop", { Mode = "manage" })
		end,
		Parent = panel,
	})

	grid = WeaponCard.Grid(panel, UDim2.new(1, -S(204), 1, -S(60)), UDim2.fromOffset(S(192), S(48)))
	emptyLabel = C.Text({
		Key = "UI_EMPTY_INV",
		TextSize = 15,
		Color = Theme.TextDim,
		Wrapped = true,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -S(204), 0, S(60)),
		Position = UDim2.fromOffset(S(192), S(120)),
		Visible = false,
		Parent = panel,
	})
end

function InventoryController:Start()
	build()
	UIController:RegisterPanel("Inventory", {
		Frame = panel,
		OnOpen = refresh,
	})
	DataController.Changed:Connect(function(key: string)
		if
			key == "*"
			or key == "Weapons"
			or key == "EquippedWeapon"
			or key == "Ores"
			or key == "Pickaxe"
			or key == "OwnedPickaxes"
			or key == "Shop"
		then
			refresh()
		end
	end)
	Localization.Changed:Connect(refresh)
end

return InventoryController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000004C"><Properties><string name="Name">LocalizationController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Выбор языка: сохранённый в профиле → иначе язык аккаунта Roblox (RU для русскоязычных) → EN.
	Переводит ProximityPrompt по атрибутам ActionKey/ObjectKey, которые ставит сервер.
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Localization = require(ReplicatedStorage.Shared.Localization)
local Net = require(ReplicatedStorage.Shared.Net)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local LocalizationController = {}

local function localizePrompt(prompt: ProximityPrompt)
	local action = prompt:GetAttribute("ActionKey")
	local object = prompt:GetAttribute("ObjectKey")
	if type(action) == "string" then
		prompt.ActionText = Localization.Get(action)
	end
	if type(object) == "string" then
		prompt.ObjectText = Localization.Get(object)
	end
end

-- ===== Тексты в мире (имена мобов, доски лидеров) =====
-- Сервер ставит на TextLabel атрибут LocKey, остальные атрибуты — аргументы ({name}, {level}).
local worldLabels: { [TextLabel]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function renderWorld(label: TextLabel)
	local key = label:GetAttribute("LocKey")
	if type(key) ~= "string" then
		return
	end
	local args = {}
	for name, value in label:GetAttributes() do
		if name ~= "LocKey" then
			args[name] = value
		end
	end
	label.Text = Localization.Get(key, args)
end

local function trackWorld(inst: Instance)
	if not inst:IsA("TextLabel") or worldLabels[inst] then
		return
	end
	worldLabels[inst] = true
	inst.AttributeChanged:Connect(function()
		renderWorld(inst)
	end)
	renderWorld(inst)
end

function LocalizationController:Init()
	-- до загрузки данных — язык аккаунта, чтобы первый экран был понятен
	Localization.SetLanguage(Localization.Detect(Players.LocalPlayer.LocaleId))
end

function LocalizationController:Start()
	ProximityPromptService.PromptShown:Connect(function(prompt)
		localizePrompt(prompt)
	end)

	workspace.DescendantAdded:Connect(trackWorld)
	for _, inst in workspace:GetDescendants() do
		trackWorld(inst)
	end
	Localization.Changed:Connect(function()
		for label in worldLabels do
			if label.Parent then
				renderWorld(label)
			end
		end
		-- подсказки «Добыть», «Ковать»… переводятся сразу, а не при следующем показе
		for _, inst in workspace:GetDescendants() do
			if inst:IsA("ProximityPrompt") then
				localizePrompt(inst)
			end
		end
	end)

	task.spawn(function()
		local data = DataController:WaitForData()
		local saved = data.Settings and data.Settings.Language
		if type(saved) == "string" and Localization.IsSupported(saved) then
			Localization.SetLanguage(saved)
		end
	end)
end

-- Язык на сервер уходит через секунду после последнего нажатия: при быстром переключении
-- сервер (лимит 2 запроса подряд) иначе мог сохранить не тот язык.
local toggleToken = 0

function LocalizationController:Toggle()
	local list = Localization.Supported
	local index = table.find(list, Localization.GetLanguage()) or 1
	local nextLang = list[(index % #list) + 1]
	Localization.SetLanguage(nextLang)
	UIController:Toast("TOAST_LANG")
	toggleToken += 1
	local token = toggleToken
	task.delay(1, function()
		if token == toggleToken then
			Net.Event("SetLanguage"):FireServer(Localization.GetLanguage())
		end
	end)
end

return LocalizationController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000004D"><Properties><string name="Name">MenuController</string><ProtectedString name="Source"><![CDATA[--!strict
-- МЕНЮ: ежедневные задания и серия входов, коды, настройки, статистика.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Localization = require(ReplicatedStorage.Shared.Localization)
local Net = require(ReplicatedStorage.Shared.Net)
local C = require(script.Parent.Parent.UI.Components)
local ClientSettings = require(script.Parent.Parent.UI.ClientSettings)
local Sound = require(script.Parent.Parent.UI.Sound)
local Theme = require(script.Parent.Parent.UI.Theme)
local DataController = require(script.Parent.DataController)
local LocalizationController = require(script.Parent.LocalizationController)
local UIController = require(script.Parent.UIController)

local S = Theme.S

local MenuController = {}

local panel: Frame
local tabButtons: { [string]: TextButton } = {}
local tabFrames: { [string]: Frame } = {}
local currentTab = "Quests"
local questList: ScrollingFrame
local streakLabel: TextLabel
local codeBox: TextBox
local settingsList: ScrollingFrame
local statsList: ScrollingFrame

local SETTINGS = {
	{ Key = "Sfx", TitleKey = "UI_SET_SFX" },
	{ Key = "Music", TitleKey = "UI_SET_MUSIC" },
	{ Key = "DamageNumbers", TitleKey = "UI_SET_DMG" },
	{ Key = "LowGraphics", TitleKey = "UI_SET_LOW" },
}

local STATS = {
	"OresMined",
	"WeaponsForged",
	"BestQuality",
	"BestDamage",
	"MythicForged",
	"MobsKilled",
	"BossesKilled",
	"EliteKills",
	"GatesCleared",
	"Parries",
	"GoldEarned",
	"Trades",
	"ShopSales",
}

local function clear(frame: Instance)
	for _, child in frame:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function scroll(parent: Instance): ScrollingFrame
	local list = C.Make("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = S(4),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = parent,
	})
	C.List(list, Enum.FillDirection.Vertical, 6)
	return list
end

local function row(parent: Instance, order: number, height: number?): Frame
	local frame = C.Make("Frame", {
		Size = UDim2.new(1, -S(8), 0, S(height or 44)),
		BackgroundColor3 = Theme.PanelLight,
		BackgroundTransparency = 0.2,
		LayoutOrder = order,
		Parent = parent,
	})
	C.Corner(frame, 6)
	return frame
end

local function questDef(id: string): any
	for _, q in Config.Daily.QuestPool do
		if q.Id == id then
			return q
		end
	end
	return nil
end

local function refreshQuests(data: any)
	clear(questList)
	local daily = data.Daily
	C.Bind(streakLabel, "UI_STREAK", { days = daily.Streak, next = daily.Streak + 1 })
	for i, q in daily.Quests do
		local def = questDef(q.Id)
		if def then
			local r = row(questList, i, 58)
			C.Text({
				Key = def.TitleKey,
				Args = { count = def.Count },
				Font = Theme.FontBold,
				TextSize = 14,
				Color = if q.Done then Theme.Success else Theme.Text,
				Size = UDim2.new(0.65, 0, 0, S(20)),
				Position = UDim2.fromOffset(S(12), S(8)),
				Parent = r,
			})
			C.Text({
				Key = "UI_REWARD",
				Args = { gold = def.RewardGold, xp = def.RewardXp },
				TextSize = 12,
				Color = Theme.Gold,
				AlignX = Enum.TextXAlignment.Right,
				Size = UDim2.new(0.35, -S(16), 0, S(20)),
				Position = UDim2.new(0.65, 0, 0, S(8)),
				Parent = r,
			})
			C.Bar({
				Size = UDim2.new(0.7, 0, 0, S(12)),
				Position = UDim2.fromOffset(S(12), S(36)),
				Value = math.clamp(q.Progress / def.Count, 0, 1),
				Color = if q.Done then Theme.Success else Theme.Accent,
				Parent = r,
			})
			C.Text({
				Text = if q.Done then Localization.Get("UI_DONE") else `{q.Progress}/{def.Count}`,
				TextSize = 13,
				Font = Theme.FontBold,
				Color = if q.Done then Theme.Success else Theme.TextDim,
				AlignX = Enum.TextXAlignment.Right,
				Size = UDim2.new(0.3, -S(16), 0, S(20)),
				Position = UDim2.new(0.7, 0, 0, S(32)),
				Parent = r,
			})
		end
	end
end

local function refreshSettings(data: any)
	clear(settingsList)
	-- язык
	local langRow = row(settingsList, 0)
	C.Text({ Key = "UI_SET_LANGUAGE", TextSize = 15, Size = UDim2.new(0.6, 0, 1, 0), Position = UDim2.fromOffset(S(10), 0), Parent = langRow })
	C.Button({
		Key = "UI_LANG",
		TextSize = 14,
		Size = UDim2.fromOffset(S(92), S(36)),
		Position = UDim2.new(1, -S(8), 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		OnClick = function()
			LocalizationController:Toggle()
		end,
		Parent = langRow,
	})
	for i, setting in SETTINGS do
		local value = data.Settings[setting.Key]
		if value == nil then
			value = (ClientSettings :: any)[setting.Key]
		end
		local r = row(settingsList, i)
		C.Text({ Key = setting.TitleKey, TextSize = 15, Size = UDim2.new(0.6, 0, 1, 0), Position = UDim2.fromOffset(S(10), 0), Parent = r })
		C.Button({
			Key = if value then "UI_ON" else "UI_OFF",
			TextSize = 14,
			Size = UDim2.fromOffset(S(92), S(36)),
			Position = UDim2.new(1, -S(8), 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Color = if value then Theme.Accent else Theme.Disabled,
			TextColor = if value then Theme.Bg else Theme.Text,
			OnClick = function()
				local newValue = not value
				data.Settings[setting.Key] = newValue
				ClientSettings.Set(setting.Key, newValue)
				Net.Event("SetSetting"):FireServer(setting.Key, newValue)
				refreshSettings(data)
			end,
			Parent = r,
		})
	end
end

local function refreshStats(data: any)
	clear(statsList)
	for i, key in STATS do
		local r = row(statsList, i, 30)
		C.Text({
			Key = "UI_STAT_LINE",
			Args = { name = "@STAT_" .. string.upper(key), value = Format.Short(data.Stats[key] or 0) },
			TextSize = 14,
			Size = UDim2.new(1, -S(20), 1, 0),
			Position = UDim2.fromOffset(S(12), 0),
			Parent = r,
		})
	end
end

local function refresh()
	local data = DataController:Get()
	if not data or not panel.Visible then
		return
	end
	for name, button in tabButtons do
		local active = name == currentTab
		button.BackgroundColor3 = if active then Theme.Accent else Theme.PanelLight
		button.TextColor3 = if active then Theme.Bg else Theme.Text
		tabFrames[name].Visible = active
	end
	if currentTab == "Quests" then
		refreshQuests(data)
	elseif currentTab == "Settings" then
		refreshSettings(data)
	elseif currentTab == "Stats" then
		refreshStats(data)
	end
end

local function redeem()
	local code = codeBox.Text
	if code == "" then
		return
	end
	local result = UIController:Invoke("RedeemCode", code)
	if UIController:Handle(result) then
		codeBox.Text = ""
		Sound.Play("Coins")
		UIController:Toast("TOAST_CODE_OK", nil, "success")
	end
end

local function build()
	panel = C.Panel({ Name = "MenuPanel", Size = UDim2.fromOffset(S(540), S(332)) })
	C.TitleBar(panel, "UI_MENU", function()
		UIController:ClosePanel()
	end)

	local tabs = C.Make("Frame", {
		Size = UDim2.new(1, -S(24), 0, S(36)),
		Position = UDim2.fromOffset(S(12), S(48)),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	C.List(tabs, Enum.FillDirection.Horizontal, 6)
	local contentSize = UDim2.new(1, -S(24), 1, -S(100))
	local contentPos = UDim2.fromOffset(S(12), S(88))
	for i, info in {
		{ "Quests", "UI_TAB_QUESTS" },
		{ "Codes", "UI_TAB_CODES" },
		{ "Settings", "UI_TAB_SETTINGS" },
		{ "Stats", "UI_TAB_STATS" },
	} do
		local name, key = info[1], info[2]
		tabButtons[name] = C.Button({
			Key = key,
			TextSize = 14,
			Size = UDim2.new(0.25, -S(4), 1, 0),
			LayoutOrder = i,
			OnClick = function()
				currentTab = name
				refresh()
			end,
			Parent = tabs,
		})
		tabFrames[name] = C.Make("Frame", { Size = contentSize, Position = contentPos, BackgroundTransparency = 1, Visible = false, Parent = panel })
	end

	-- задания
	streakLabel = C.Text({ TextSize = 13, Color = Theme.Gold, Size = UDim2.new(1, 0, 0, S(20)), Parent = tabFrames.Quests })
	local questHolder = C.Make("Frame", {
		Size = UDim2.new(1, 0, 1, -S(24)),
		Position = UDim2.fromOffset(0, S(24)),
		BackgroundTransparency = 1,
		Parent = tabFrames.Quests,
	})
	questList = scroll(questHolder)

	-- коды
	local codes = tabFrames.Codes
	codeBox = C.Make("TextBox", {
		Size = UDim2.new(1, -S(152), 0, S(48)),
		Position = UDim2.fromOffset(0, S(20)),
		BackgroundColor3 = Theme.Bg,
		Font = Theme.FontBold,
		TextSize = S(18),
		TextColor3 = Theme.Text,
		PlaceholderColor3 = Theme.TextDim,
		ClearTextOnFocus = false,
		Text = "",
		Parent = codes,
	})
	C.Corner(codeBox, 6)
	C.Stroke(codeBox)
	C.Button({
		Key = "UI_REDEEM",
		TextSize = 16,
		Size = UDim2.fromOffset(S(140), S(48)),
		Position = UDim2.new(1, 0, 0, S(20)),
		AnchorPoint = Vector2.new(1, 0),
		Color = Theme.Accent,
		TextColor = Theme.Bg,
		OnClick = redeem,
		Parent = codes,
	})
	codeBox.FocusLost:Connect(function(enter)
		if enter then
			redeem()
		end
	end)
	C.Text({
		Key = "UI_CODES_HINT",
		TextSize = 13,
		Color = Theme.TextDim,
		Wrapped = true,
		Size = UDim2.new(1, 0, 0, S(40)),
		Position = UDim2.fromOffset(0, S(80)),
		Parent = codes,
	})

	settingsList = scroll(tabFrames.Settings)
	statsList = scroll(tabFrames.Stats)
end

local function applySettings(data: any)
	for _, setting in SETTINGS do
		local value = data.Settings[setting.Key]
		if type(value) == "boolean" then
			ClientSettings.Set(setting.Key, value)
		end
	end
end

function MenuController:Start()
	build()
	-- плейсхолдер у TextBox — через PlaceholderText, а не Text
	Localization.Changed:Connect(function()
		codeBox.PlaceholderText = Localization.Get("UI_CODE_PLACEHOLDER")
		refresh()
	end)
	codeBox.PlaceholderText = Localization.Get("UI_CODE_PLACEHOLDER")

	UIController:RegisterPanel("Menu", { Frame = panel, OnOpen = refresh })
	DataController.Changed:Connect(function(key: string)
		if key == "*" then
			applySettings(DataController:Get())
		end
		if key == "*" or key == "Daily" or key == "Stats" or key == "Settings" then
			refresh()
		end
	end)
	local data = DataController:Get()
	if data then
		applySettings(data)
	end
end

return MenuController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000004E"><Properties><string name="Name">MerchantController</string><ProtectedString name="Source"><![CDATA[--!strict
-- ТОРГОВЕЦ: продать оружие (выбор нескольких + подтверждение), продать руду, купить кирки.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Localization = require(ReplicatedStorage.Shared.Localization)
local WeaponMath = require(ReplicatedStorage.Shared.WeaponMath)
local C = require(script.Parent.Parent.UI.Components)
local Sound = require(script.Parent.Parent.UI.Sound)
local Theme = require(script.Parent.Parent.UI.Theme)
local WeaponCard = require(script.Parent.Parent.UI.WeaponCard)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local S = Theme.S

local MerchantController = {}

local panel: Frame
local tabButtons: { [string]: TextButton } = {}
local tabFrames: { [string]: Frame } = {}
local currentTab = "Weapons"
local selected: { [string]: boolean } = {}
local confirmUntil = 0

local weaponGrid: ScrollingFrame
local sellButton: TextButton
local oreList: ScrollingFrame
local pickList: ScrollingFrame

local function sortedIds(tbl: { [string]: any }): { string }
	local ids = {}
	for id in tbl do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		return tbl[a].Order < tbl[b].Order
	end)
	return ids
end

local function clear(frame: Instance)
	for _, child in frame:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function selectedTotal(data: any): (number, number)
	local gold, count = 0, 0
	for id in selected do
		local w = data.Weapons[id]
		if w then
			gold += WeaponMath.SellPrice(w)
			count += 1
		end
	end
	return gold, count
end

local function refreshSellButton(data: any)
	local gold, count = selectedTotal(data)
	if count == 0 then
		C.Bind(sellButton, "UI_SELL_NOTHING")
		sellButton.BackgroundColor3 = Theme.Disabled
	elseif os.clock() < confirmUntil then
		C.Bind(sellButton, "UI_CONFIRM")
		sellButton.BackgroundColor3 = Theme.Danger
	else
		C.Bind(sellButton, "UI_SELL_SELECTED", { gold = gold })
		sellButton.BackgroundColor3 = Theme.Accent
	end
end

local function refreshWeapons(data: any)
	WeaponCard.Clear(weaponGrid)
	-- выбросить из выбора то, чего больше нет
	for id in selected do
		if not data.Weapons[id] or data.EquippedWeapon == id then
			selected[id] = nil
		end
	end
	local i = 0
	for _, weapon in WeaponCard.Sorted(data.Weapons) do
		if data.Shop.Listings[weapon.Id] then
			continue -- выставленное в лавке торговцу не продаётся
		end
		i += 1
		local equipped = data.EquippedWeapon == weapon.Id
		WeaponCard.Create({
			Weapon = weapon,
			Equipped = equipped,
			Selected = selected[weapon.Id] == true,
			ShowPrice = true,
			LayoutOrder = i,
			Parent = weaponGrid,
			OnClick = function()
				if equipped then
					UIController:Toast("ERR_EQUIPPED", nil, "error")
					return
				end
				selected[weapon.Id] = if selected[weapon.Id] then nil else true
				confirmUntil = 0
				refreshWeapons(DataController:Get())
			end,
		})
	end
	refreshSellButton(data)
end

local function row(parent: Instance, order: number): Frame
	local frame = C.Make("Frame", {
		Size = UDim2.new(1, -S(8), 0, S(48)),
		BackgroundColor3 = Theme.PanelLight,
		BackgroundTransparency = 0.2,
		LayoutOrder = order,
		Parent = parent,
	})
	C.Corner(frame, 6)
	return frame
end

local function refreshOres(data: any)
	clear(oreList)
	for i, id in sortedIds(Config.Ores) do
		local ore = Config.Ores[id]
		local count = data.Ores[id] or 0
		local r = row(oreList, i)
		C.Text({
			Key = "UI_ORE_COUNT",
			Args = { ore = "@" .. ore.NameKey, count = count },
			Font = Theme.FontBold,
			TextSize = 14,
			Size = UDim2.new(0.45, 0, 1, 0),
			Position = UDim2.fromOffset(S(12), 0),
			Parent = r,
		})
		C.Text({
			Key = "UI_PRICE",
			Args = { gold = ore.SellPrice },
			TextSize = 12,
			Color = Theme.Gold,
			Size = UDim2.new(0.2, 0, 1, 0),
			Position = UDim2.fromScale(0.42, 0),
			Parent = r,
		})
		local function sell(amount: number)
			local result = UIController:Invoke("SellOres", id, amount)
			if UIController:Handle(result) then
				Sound.Play("Coins")
				UIController:Toast("TOAST_SOLD", { count = result.count, gold = result.gold }, "gold")
			end
		end
		C.Button({
			Key = "UI_SELL_ONE",
			TextSize = 12,
			Size = UDim2.new(0.17, 0, 0, S(36)),
			Position = UDim2.new(0.63, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Color = if count > 0 then Theme.PanelLight else Theme.Disabled,
			OnClick = function()
				if count > 0 then
					sell(1)
				end
			end,
			Parent = r,
		})
		C.Button({
			Key = "UI_SELL_ALL",
			TextSize = 12,
			Size = UDim2.new(0.17, 0, 0, S(36)),
			Position = UDim2.new(1, -S(8), 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Color = if count > 0 then Theme.PanelLight else Theme.Disabled,
			OnClick = function()
				if count > 0 then
					sell(count)
				end
			end,
			Parent = r,
		})
	end
end

local function refreshPickaxes(data: any)
	clear(pickList)
	for i, id in sortedIds(Config.Pickaxes) do
		local def = Config.Pickaxes[id]
		local owned = data.OwnedPickaxes[id] == true
		local r = row(pickList, i)
		C.Text({
			Text = `{Localization.Get(def.NameKey)} · {Localization.Get("UI_POWER", { value = def.Power })}`,
			Font = Theme.FontBold,
			TextSize = 14,
			Size = UDim2.new(0.6, 0, 1, 0),
			Position = UDim2.fromOffset(S(12), 0),
			Parent = r,
		})
		local key, args, color
		if owned then
			key, args, color = "UI_OWNED", nil, Theme.Disabled
		elseif data.Level < def.RequiredLevel then
			key, args, color = "UI_REQ_LEVEL", { level = def.RequiredLevel }, Theme.Disabled
		else
			key, args, color = "UI_BUY", { price = def.Price }, if data.Gold >= def.Price then Theme.Accent else Theme.Disabled
		end
		C.Button({
			Key = key,
			Args = args,
			TextSize = 13,
			TextColor = if color == Theme.Accent then Theme.Bg else Theme.Text,
			Size = UDim2.new(0.34, 0, 0, S(36)),
			Position = UDim2.new(1, -S(8), 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Color = color,
			OnClick = function()
				if owned then
					return
				end
				local result = UIController:Invoke("BuyPickaxe", id)
				if UIController:Handle(result) then
					Sound.Play("Coins")
					UIController:Toast("TOAST_BOUGHT", { item = "@" .. def.NameKey }, "success")
				end
			end,
			Parent = r,
		})
	end
end

local function refresh()
	local data = DataController:Get()
	if not data or not panel.Visible then
		return
	end
	for name, button in tabButtons do
		local active = name == currentTab
		button.BackgroundColor3 = if active then Theme.Accent else Theme.PanelLight
		button.TextColor3 = if active then Theme.Bg else Theme.Text
		tabFrames[name].Visible = active
	end
	if currentTab == "Weapons" then
		refreshWeapons(data)
	elseif currentTab == "Ores" then
		refreshOres(data)
	else
		refreshPickaxes(data)
	end
end

local function sellSelected()
	local data = DataController:Get()
	if not data then
		return
	end
	local ids = {}
	for id in selected do
		table.insert(ids, id)
	end
	if #ids == 0 then
		return
	end
	if os.clock() > confirmUntil then
		-- первый тап — просим подтвердить
		confirmUntil = os.clock() + 3
		refreshSellButton(data)
		task.delay(3.05, function()
			local d = DataController:Get()
			if d and panel.Visible then
				refreshSellButton(d)
			end
		end)
		return
	end
	confirmUntil = 0
	local result = UIController:Invoke("SellWeapons", ids)
	if UIController:Handle(result) then
		table.clear(selected)
		Sound.Play("Coins")
		UIController:Toast("TOAST_SOLD", { count = result.count, gold = result.gold }, "gold")
	end
	refresh()
end

local function build()
	panel = C.Panel({ Name = "MerchantPanel", Size = UDim2.fromOffset(S(540), S(332)) })
	C.TitleBar(panel, "UI_MERCHANT_TITLE", function()
		UIController:ClosePanel()
	end)

	local tabs = C.Make("Frame", {
		Size = UDim2.new(1, -S(24), 0, S(40)),
		Position = UDim2.fromOffset(S(12), S(48)),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	C.List(tabs, Enum.FillDirection.Horizontal, 6)
	for i, info in { { "Weapons", "UI_WEAPONS" }, { "Ores", "UI_ORES" }, { "Pickaxes", "UI_PICKAXES" } } do
		local name, key = info[1], info[2]
		tabButtons[name] = C.Button({
			Key = key,
			TextSize = 15,
			Size = UDim2.new(1 / 3, -S(4), 1, 0),
			LayoutOrder = i,
			OnClick = function()
				currentTab = name
				refresh()
			end,
			Parent = tabs,
		})
	end

	local contentSize = UDim2.new(1, -S(24), 1, -S(100))
	local contentPos = UDim2.fromOffset(S(12), S(92))

	-- оружие
	local weaponsFrame = C.Make("Frame", { Size = contentSize, Position = contentPos, BackgroundTransparency = 1, Parent = panel })
	weaponGrid = WeaponCard.Grid(weaponsFrame, UDim2.new(1, 0, 1, -S(52)), UDim2.new())
	-- быстро выбрать весь «мусор» (обычное оружие, кроме надетого)
	C.Button({
		Key = "UI_SELECT_COMMON",
		TextSize = 13,
		Size = UDim2.new(0.34, -S(4), 0, S(48)),
		Position = UDim2.fromScale(0, 1),
		AnchorPoint = Vector2.new(0, 1),
		Color = Theme.PanelLight,
		OnClick = function()
			local data = DataController:Get()
			if not data then
				return
			end
			for id, w in data.Weapons do
				if w.Rarity == "Common" and id ~= data.EquippedWeapon and not data.Shop.Listings[id] then
					selected[id] = true
				end
			end
			confirmUntil = 0
			refresh()
		end,
		Parent = weaponsFrame,
	})
	sellButton = C.Button({
		Font = Theme.FontTitle,
		TextSize = 16,
		TextColor = Theme.Bg,
		Size = UDim2.new(0.66, -S(4), 0, S(48)),
		Position = UDim2.fromScale(1, 1),
		AnchorPoint = Vector2.new(1, 1),
		Color = Theme.Accent,
		OnClick = sellSelected,
		Parent = weaponsFrame,
	})
	tabFrames.Weapons = weaponsFrame

	-- руда
	local oresFrame = C.Make("Frame", { Size = contentSize, Position = contentPos, BackgroundTransparency = 1, Parent = panel })
	oreList = C.Make("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = S(4),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = oresFrame,
	})
	C.List(oreList, Enum.FillDirection.Vertical, 6)
	tabFrames.Ores = oresFrame

	-- кирки
	local picksFrame = C.Make("Frame", { Size = contentSize, Position = contentPos, BackgroundTransparency = 1, Parent = panel })
	pickList = C.Make("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = S(4),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = picksFrame,
	})
	C.List(pickList, Enum.FillDirection.Vertical, 6)
	tabFrames.Pickaxes = picksFrame
end

function MerchantController:Start()
	build()
	UIController:RegisterPanel("Merchant", {
		Frame = panel,
		OnOpen = function()
			table.clear(selected)
			confirmUntil = 0
			refresh()
		end,
	})
	DataController.Changed:Connect(function(key: string)
		if
			key == "*"
			or key == "Weapons"
			or key == "EquippedWeapon"
			or key == "Ores"
			or key == "Gold"
			or key == "Level"
			or key == "OwnedPickaxes"
			or key == "Shop"
		then
			refresh()
		end
	end)
	Localization.Changed:Connect(refresh)
end

return MerchantController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000004F"><Properties><string name="Name">QuestController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ТРЕКЕР КВЕСТА СИСТЕМЫ + луч-подсказка от персонажа к цели.
	Во время обучения — текущий шаг обучения, после — первое невыполненное ежедневное задание.
	Цели ищутся по тегам CollectionService на клиенте (кузня и торговец всегда подгружены:
	ModelStreamingMode = Persistent).
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local C = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)
local DataController = require(script.Parent.DataController)
local HudController = require(script.Parent.HudController)
local UIController = require(script.Parent.UIController)

local S = Theme.S

local QuestController = {}

-- куда вести луч для событий ежедневных заданий
local EVENT_TARGET: { [string]: string } = {
	OreMined = Config.Tags.OreNode,
	WeaponForged = Config.Tags.Forge,
	QualityForge80 = Config.Tags.Forge,
	ItemSold = Config.Tags.Merchant,
	GateCleared = Config.Tags.GatePortal,
}

type Current = {
	TitleKey: string,
	Count: number,
	Progress: number,
	Event: string,
	TargetTag: string?,
	TargetOre: string?,
	Daily: boolean,
}

local box: Frame
local headerLabel: TextLabel
local titleLabel: TextLabel
local progressLabel: TextLabel
local beam: Beam
local fromAttachment: Attachment
local toAttachment: Attachment

local function positionOf(instance: Instance): Vector3?
	if instance:IsA("BasePart") then
		return instance.Position
	elseif instance:IsA("Model") then
		return instance:GetPivot().Position
	end
	return nil
end

local function current(): Current?
	local data = DataController:Get()
	if not data then
		return nil
	end
	if not data.Tutorial.Done then
		local step = Config.Tutorial.Steps[data.Tutorial.Step]
		if not step then
			return nil
		end
		return {
			TitleKey = step.TitleKey,
			Count = step.Count,
			Progress = data.Tutorial.Progress,
			Event = step.Event,
			TargetTag = step.TargetTag,
			TargetOre = step.TargetOre,
			Daily = false,
		}
	end
	for _, q in data.Daily.Quests do
		if not q.Done then
			for _, def in Config.Daily.QuestPool do
				if def.Id == q.Id then
					return {
						TitleKey = def.TitleKey,
						Count = def.Count,
						Progress = q.Progress,
						Event = def.Event,
						TargetTag = EVENT_TARGET[def.Event],
						TargetOre = nil,
						Daily = true,
					}
				end
			end
		end
	end
	return nil
end

local function findTarget(q: Current, from: Vector3): Vector3?
	if not q.TargetTag then
		return nil
	end
	local data = DataController:Get()
	local best: Vector3? = nil
	local bestDist = math.huge
	for _, instance in CollectionService:GetTagged(q.TargetTag) do
		if instance:IsDescendantOf(workspace) then
			local ok = true
			local oreId = instance:GetAttribute("OreId")
			if q.TargetOre and oreId ~= q.TargetOre then
				ok = false
			end
			-- для «добудь руду» — только руда, доступная по уровню
			if ok and q.TargetTag == Config.Tags.OreNode and type(oreId) == "string" and data then
				local ore = Config.Ores[oreId]
				ok = ore ~= nil and data.Level >= ore.RequiredLevel
			end
			local pos = positionOf(instance)
			if ok and pos then
				local d = (pos - from).Magnitude
				if d < bestDist then
					best, bestDist = pos, d
				end
			end
		end
	end
	return best
end

local function refreshText()
	local q = current()
	if not q then
		box.Visible = false
		HudController:SetInventoryPulse(false)
		return
	end
	box.Visible = true
	C.Bind(headerLabel, if q.Daily then "QUEST_DAILY_HEADER" else "QUEST_HEADER")
	C.Bind(titleLabel, q.TitleKey, { count = q.Count })
	C.Bind(progressLabel, "QUEST_PROGRESS", { progress = q.Progress, count = q.Count })
	HudController:SetInventoryPulse(q.Event == "WeaponEquipped")
end

local function updateBeam()
	local q = current()
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not q or not root or UIController:GetOpenPanel() ~= nil then
		beam.Enabled = false
		return
	end
	local target = findTarget(q, root.Position)
	if q.TargetTag == Config.Tags.GatePortal then
		if target then
			refreshText()
		else
			C.Bind(progressLabel, "QUEST_WAIT_GATE")
		end
	end
	if not target then
		beam.Enabled = false
		return
	end
	if fromAttachment.Parent ~= root then
		fromAttachment.Parent = root
	end
	toAttachment.WorldPosition = target + Vector3.new(0, 2, 0)
	beam.Enabled = (target - root.Position).Magnitude > 6
end

local function build()
	box = C.Panel({
		Name = "Quest",
		Size = UDim2.fromOffset(S(252), S(64)),
		Position = UDim2.fromOffset(S(12), S(100)),
		AnchorPoint = Vector2.zero,
		Transparency = 0.2,
		Visible = false,
		Adaptive = true,
		Parent = UIController.Layers.Hud,
	})
	headerLabel = C.Text({
		Key = "QUEST_HEADER",
		Font = Theme.FontBold,
		TextSize = 11,
		Color = Theme.System,
		Size = UDim2.new(1, -S(16), 0, S(16)),
		Position = UDim2.fromOffset(S(8), S(8)),
		Parent = box,
	})
	titleLabel = C.Text({
		Font = Theme.FontBold,
		TextSize = 15,
		Size = UDim2.new(1, -S(16), 0, S(20)),
		Position = UDim2.fromOffset(S(8), S(24)),
		Parent = box,
	})
	progressLabel = C.Text({
		TextSize = 13,
		Color = Theme.TextDim,
		Size = UDim2.new(1, -S(16), 0, S(16)),
		Position = UDim2.fromOffset(S(8), S(44)),
		Parent = box,
	})

	fromAttachment = Instance.new("Attachment")
	fromAttachment.Name = "QuestBeamFrom"
	toAttachment = Instance.new("Attachment")
	toAttachment.Name = "QuestBeamTo"
	toAttachment.Parent = workspace.Terrain

	beam = Instance.new("Beam")
	beam.Attachment0 = fromAttachment
	beam.Attachment1 = toAttachment
	beam.Color = ColorSequence.new(Theme.System)
	beam.Transparency = NumberSequence.new(0.25, 0.6)
	beam.Width0 = 0.35
	beam.Width1 = 0.35
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Segments = 1
	beam.Enabled = false
	beam.Parent = workspace.Terrain
end

function QuestController:Start()
	build()
	DataController.Changed:Connect(function(key: string)
		if key == "*" or key == "Tutorial" or key == "Daily" then
			refreshText()
		end
	end)
	refreshText()
	task.spawn(function()
		while true do
			pcall(updateBeam)
			task.wait(0.4)
		end
	end)
end

return QuestController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000050"><Properties><string name="Name">ShopController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ЛАВКА.
	• Моя лавка (Инвентарь → «Моя лавка» или свой прилавок): выбрать оружие, указать цену, выставить;
	  справа — выставленное, кнопка «Снять».
	• Чужая лавка (подойти к прилавку → «Лавка»): выбрать предмет и купить (второе нажатие подтверждает).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Localization = require(ReplicatedStorage.Shared.Localization)
local WeaponMath = require(ReplicatedStorage.Shared.WeaponMath)
local C = require(script.Parent.Parent.UI.Components)
local Sound = require(script.Parent.Parent.UI.Sound)
local Theme = require(script.Parent.Parent.UI.Theme)
local WeaponCard = require(script.Parent.Parent.UI.WeaponCard)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local S = Theme.S
local SH = Config.Trading.Shop
local player = Players.LocalPlayer

local ShopController = {}

local panel: Frame
local title: TextLabel
local manageFrame: Frame
local browseFrame: Frame
-- моя лавка
local summaryLabel: TextLabel
local noStallLabel: TextLabel
local ownGrid: ScrollingFrame
local priceBox: TextBox
local listButton: TextButton
local listedList: ScrollingFrame
local pickedId: string? = nil
-- чужая лавка
local browseGrid: ScrollingFrame
local emptyLabel: TextLabel
local buyButton: TextButton
local browse: { [string]: any } = {}
local browsePick: { Weapon: any, Price: number }? = nil
local confirmUntil = 0

local mode = "manage"

local function clear(frame: Instance)
	for _, child in frame:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function suggestedPrice(weapon: any): number
	return math.max(SH.MinPrice, math.floor(WeaponMath.SellPrice(weapon) * SH.SuggestedPriceMult))
end

-- ===== Моя лавка =====

local function refreshManage()
	local data = DataController:Get()
	if not data then
		return
	end
	local count = 0
	for _ in data.Shop.Listings do
		count += 1
	end
	C.Bind(summaryLabel, "UI_SHOP_LISTINGS", {
		count = count,
		max = SH.MaxListings,
		fee = math.floor(SH.TaxRate * 100 + 0.5),
	})
	noStallLabel.Visible = player:GetAttribute("HasStall") ~= true

	-- оружие, которое можно выставить
	WeaponCard.Clear(ownGrid)
	if pickedId and (not data.Weapons[pickedId] or data.Shop.Listings[pickedId]) then
		pickedId = nil
	end
	local order = 0
	for _, weapon in WeaponCard.Sorted(data.Weapons) do
		if weapon.Id ~= data.EquippedWeapon and not data.Shop.Listings[weapon.Id] then
			order += 1
			WeaponCard.Create({
				Weapon = weapon,
				Selected = pickedId == weapon.Id,
				LayoutOrder = order,
				Parent = ownGrid,
				OnClick = function()
					pickedId = weapon.Id
					priceBox.Text = tostring(suggestedPrice(weapon))
					refreshManage()
				end,
			})
		end
	end
	listButton.BackgroundColor3 = if pickedId then Theme.Accent else Theme.Disabled
	listButton.TextColor3 = if pickedId then Theme.Bg else Theme.Muted

	-- выставленное
	clear(listedList)
	local rows = {}
	for id, price in data.Shop.Listings do
		local weapon = data.Weapons[id]
		if weapon then
			table.insert(rows, { Weapon = weapon, Price = price })
		end
	end
	table.sort(rows, function(a, b)
		return a.Price > b.Price
	end)
	for i, entry in rows do
		local row = C.Make("Frame", {
			Size = UDim2.new(1, -S(8), 0, S(48)),
			BackgroundColor3 = Theme.PanelLight,
			LayoutOrder = i,
			Parent = listedList,
		})
		C.Corner(row, 6)
		C.Text({
			Text = Localization.WeaponName(entry.Weapon.Type, entry.Weapon.Ore),
			Font = Theme.FontBold,
			TextSize = 13,
			Size = UDim2.new(1, -S(96), 0, S(20)),
			Position = UDim2.fromOffset(S(8), S(4)),
			Parent = row,
		})
		C.Text({
			Key = "UI_PRICE_LINE",
			Args = { gold = Format.Short(entry.Price) },
			TextSize = 12,
			Color = Theme.Gold,
			Size = UDim2.new(1, -S(96), 0, S(16)),
			Position = UDim2.fromOffset(S(8), S(24)),
			Parent = row,
		})
		C.Button({
			Key = "UI_SHOP_UNLIST",
			TextSize = 12,
			Size = UDim2.fromOffset(S(80), S(32)),
			Position = UDim2.new(1, -S(8), 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			OnClick = function()
				UIController:Handle(UIController:Invoke("ShopUnlist", entry.Weapon.Id))
			end,
			Parent = row,
		})
	end
end

local function listPicked()
	local id = pickedId
	if not id then
		return
	end
	local price = tonumber(priceBox.Text)
	if not price or price ~= math.floor(price) or price < SH.MinPrice or price > SH.MaxPrice then
		UIController:Toast("ERR_PRICE", { min = SH.MinPrice, max = SH.MaxPrice }, "error")
		return
	end
	local result = UIController:Invoke("ShopList", id, price)
	if UIController:Handle(result) then
		pickedId = nil
		UIController:Toast("TOAST_LISTED", { price = price }, "success")
	end
end

-- ===== Чужая лавка =====

local function refreshBuyButton()
	local pick = browsePick
	if not pick then
		C.Bind(buyButton, "UI_SHOP_PICK")
		buyButton.BackgroundColor3 = Theme.Disabled
		buyButton.TextColor3 = Theme.Muted
	elseif os.clock() < confirmUntil then
		C.Bind(buyButton, "UI_CONFIRM")
		buyButton.BackgroundColor3 = Theme.Danger
		buyButton.TextColor3 = Theme.Text
	else
		C.Bind(buyButton, "UI_BUY", { price = Format.Short(pick.Price) })
		buyButton.BackgroundColor3 = Theme.Accent
		buyButton.TextColor3 = Theme.Bg
	end
end

local function refreshBrowse()
	C.Bind(title, "UI_SHOP_TITLE", { name = browse.OwnerName or "" })
	WeaponCard.Clear(browseGrid)
	local listings = browse.Listings or {}
	emptyLabel.Visible = #listings == 0
	local pickStillThere = false
	for i, entry in listings do
		local selected = browsePick ~= nil and browsePick.Weapon.Id == entry.Weapon.Id
		if selected then
			pickStillThere = true
		end
		WeaponCard.Create({
			Weapon = entry.Weapon,
			Selected = selected,
			PriceText = Format.Short(entry.Price),
			LayoutOrder = i,
			Parent = browseGrid,
			OnClick = function()
				browsePick = entry
				confirmUntil = 0
				refreshBrowse()
			end,
		})
	end
	if not pickStillThere then
		browsePick = nil
	end
	refreshBuyButton()
end

local function reloadBrowse()
	local result = UIController:Invoke("ShopFetch", browse.OwnerUserId)
	if type(result) == "table" and result.ok then
		browse = result
	else
		UIController:Handle(result)
		browse.Listings = {}
	end
	refreshBrowse()
end

local function buyPicked()
	local pick = browsePick
	if not pick then
		return
	end
	if os.clock() > confirmUntil then
		confirmUntil = os.clock() + 3
		refreshBuyButton()
		task.delay(3.05, function()
			if panel.Visible and mode == "browse" then
				refreshBuyButton()
			end
		end)
		return
	end
	confirmUntil = 0
	local result = UIController:Invoke("ShopBuy", browse.OwnerUserId, pick.Weapon.Id, pick.Price)
	if UIController:Handle(result) then
		Sound.Play("Coins")
		UIController:Toast("TOAST_BOUGHT", { item = `@WEAPON:{pick.Weapon.Type}:{pick.Weapon.Ore}` }, "success")
	end
	browsePick = nil
	reloadBrowse()
end

-- ===== Окно =====

local function build()
	panel = C.Panel({ Name = "ShopPanel", Size = UDim2.fromOffset(S(540), S(332)) })
	title = C.TitleBar(panel, "UI_MY_SHOP", function()
		UIController:ClosePanel()
	end)
	local contentSize = UDim2.new(1, -S(32), 1, -S(64))
	local contentPos = UDim2.fromOffset(S(16), S(52))

	-- моя лавка
	manageFrame = C.Make("Frame", { Size = contentSize, Position = contentPos, BackgroundTransparency = 1, Parent = panel })
	summaryLabel = C.Text({ TextSize = 13, Color = Theme.TextDim, Size = UDim2.new(1, 0, 0, S(16)), Parent = manageFrame })
	noStallLabel = C.Text({
		Key = "UI_SHOP_NO_STALL",
		TextSize = 12,
		Color = Theme.Muted,
		Wrapped = true,
		Size = UDim2.new(1, 0, 0, S(16)),
		Position = UDim2.fromOffset(0, S(16)),
		Visible = false,
		Parent = manageFrame,
	})
	local left = C.Make("Frame", {
		Size = UDim2.new(0.5, -S(8), 1, -S(36)),
		Position = UDim2.fromOffset(0, S(36)),
		BackgroundTransparency = 1,
		Parent = manageFrame,
	})
	ownGrid = WeaponCard.Grid(left, UDim2.new(1, 0, 1, -S(52)), UDim2.new())
	priceBox = C.Make("TextBox", {
		Size = UDim2.new(1, -S(104), 0, S(44)),
		Position = UDim2.fromScale(0, 1),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = Theme.Bg,
		Font = Theme.FontBold,
		TextSize = S(16),
		TextColor3 = Theme.Text,
		PlaceholderColor3 = Theme.Muted,
		ClearTextOnFocus = false,
		Text = "",
		Parent = left,
	})
	C.Corner(priceBox, 8)
	C.Stroke(priceBox)
	listButton = C.Button({
		Key = "UI_SHOP_LIST",
		TextSize = 14,
		Size = UDim2.fromOffset(S(96), S(44)),
		Position = UDim2.fromScale(1, 1),
		AnchorPoint = Vector2.new(1, 1),
		Color = Theme.Disabled,
		OnClick = listPicked,
		Parent = left,
	})
	listedList = C.Make("ScrollingFrame", {
		Size = UDim2.new(0.5, -S(8), 1, -S(36)),
		Position = UDim2.new(0.5, S(8), 0, S(36)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = S(4),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = manageFrame,
	})
	C.List(listedList, Enum.FillDirection.Vertical, 8)

	-- чужая лавка
	browseFrame = C.Make("Frame", { Size = contentSize, Position = contentPos, BackgroundTransparency = 1, Visible = false, Parent = panel })
	browseGrid = WeaponCard.Grid(browseFrame, UDim2.new(1, 0, 1, -S(56)), UDim2.new())
	emptyLabel = C.Text({
		Key = "UI_SHOP_EMPTY",
		TextSize = 15,
		Color = Theme.TextDim,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, S(40)),
		Position = UDim2.fromOffset(0, S(64)),
		Visible = false,
		Parent = browseFrame,
	})
	buyButton = C.Button({
		Font = Theme.FontTitle,
		TextSize = 16,
		Size = UDim2.new(1, 0, 0, S(48)),
		Position = UDim2.fromScale(0, 1),
		AnchorPoint = Vector2.new(0, 1),
		OnClick = buyPicked,
		Parent = browseFrame,
	})
end

function ShopController:Start()
	build()
	priceBox.PlaceholderText = Localization.Get("UI_SHOP_PRICE")
	Localization.Changed:Connect(function()
		priceBox.PlaceholderText = Localization.Get("UI_SHOP_PRICE")
		if panel.Visible and mode == "manage" then
			refreshManage()
		end
	end)

	UIController:RegisterPanel("Shop", {
		Frame = panel,
		OnOpen = function(payload: any)
			mode = if type(payload) == "table" and payload.Mode == "browse" then "browse" else "manage"
			manageFrame.Visible = mode == "manage"
			browseFrame.Visible = mode == "browse"
			if mode == "browse" then
				browse = payload
				browsePick = nil
				confirmUntil = 0
				refreshBrowse()
			else
				C.Bind(title, "UI_MY_SHOP")
				pickedId = nil
				priceBox.Text = ""
				refreshManage()
			end
		end,
	})

	DataController.Changed:Connect(function(key: string)
		if not panel.Visible then
			return
		end
		if mode == "manage" and (key == "*" or key == "Weapons" or key == "Shop" or key == "EquippedWeapon") then
			refreshManage()
		end
	end)
	player:GetAttributeChangedSignal("HasStall"):Connect(function()
		if panel.Visible and mode == "manage" then
			refreshManage()
		end
	end)
end

return ShopController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000051"><Properties><string name="Name">SystemWindowController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ОКНО СИСТЕМЫ — главная фишка. Синее окно в стиле маньхуа:
	мерцание рамки → окно выезжает → текст «печатается» → само закрывается или по тапу.
	Окна идут очередью; если их много — показываются быстрее.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Localization = require(ReplicatedStorage.Shared.Localization)
local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local C = require(script.Parent.Parent.UI.Components)
local Sound = require(script.Parent.Parent.UI.Sound)
local Theme = require(script.Parent.Parent.UI.Theme)
local UIController = require(script.Parent.UIController)

local S = Theme.S

local SystemWindowController = {}

local queue: { Types.NotifyPayload } = {}
local showing = false

local KIND_STYLE: { [string]: { Color: Color3, Sound: string, Duration: number } } = {
	Awakening = { Color = Theme.System, Sound = "SystemOpen", Duration = 6 },
	Quest = { Color = Theme.System, Sound = "SystemOpen", Duration = 3.5 },
	QuestDone = { Color = Theme.Success, Sound = "SystemQuestDone", Duration = 3 },
	LevelUp = { Color = Theme.Gold, Sound = "SystemLevelUp", Duration = 3.5 },
	Reward = { Color = Theme.Gold, Sound = "SystemQuestDone", Duration = 4 },
	Info = { Color = Theme.System, Sound = "SystemOpen", Duration = 3.5 },
	Warning = { Color = Theme.Danger, Sound = "SystemWarning", Duration = 3.5 },
	Boss = { Color = Theme.Danger, Sound = "SystemBoss", Duration = 4 },
	GateCleared = { Color = Theme.Gold, Sound = "SystemQuestDone", Duration = 4.5 },
	GateFailed = { Color = Theme.Danger, Sound = "SystemWarning", Duration = 4 },
	Forge = { Color = Theme.System, Sound = "ForgeDone", Duration = 3.5 },
	Daily = { Color = Theme.Gold, Sound = "SystemQuestDone", Duration = 4 },
	RankUp = { Color = Theme.Gold, Sound = "SystemLevelUp", Duration = 5 },
	Legendary = { Color = Color3.fromRGB(255, 80, 110), Sound = "Celebrate", Duration = 5 },
	Elite = { Color = Theme.Danger, Sound = "EliteAlarm", Duration = 5 },
	Penalty = { Color = Theme.Danger, Sound = "SystemWarning", Duration = 4 },
	Trade = { Color = Theme.System, Sound = "SystemOpen", Duration = 3.5 },
	Shop = { Color = Theme.Gold, Sound = "Coins", Duration = 4 },
}

-- элементы окна
local root: CanvasGroup
local frame: Frame
local stroke: UIStroke
local header: TextLabel
local title: TextLabel
local body: TextLabel
local closeRequested = false

local function build()
	root = C.Make("CanvasGroup", {
		Name = "SystemWindow",
		Size = UDim2.fromOffset(S(432), S(152)),
		Position = UDim2.new(0.5, 0, 0, S(88)),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		Parent = UIController.Layers.Overlay,
	})
	C.Adaptive(root)

	frame = C.Make("Frame", {
		Size = UDim2.new(1, -S(8), 1, -S(8)),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.SystemBg,
		BackgroundTransparency = 0.06,
		Parent = root,
	})
	C.Corner(frame, 6)
	stroke = C.Stroke(frame, Theme.System, 1.5, 0)
	C.Padding(frame, 12)
	C.List(frame, Enum.FillDirection.Vertical, 4)

	header = C.Text({
		Name = "Header",
		Font = Theme.FontBold,
		TextSize = 14,
		Color = Theme.System,
		Size = UDim2.new(1, 0, 0, S(20)),
		LayoutOrder = 1,
		Parent = frame,
	})
	C.Make("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.System,
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
		LayoutOrder = 2,
		Parent = frame,
	})
	title = C.Text({
		Name = "Title",
		Font = Theme.FontTitle,
		TextSize = 21,
		Wrapped = true,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 3,
		Parent = frame,
	})
	body = C.Text({
		Name = "Body",
		TextSize = 15,
		Color = Theme.TextDim,
		Wrapped = true,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 4,
		Parent = frame,
	})
	C.Text({
		Name = "Hint",
		Key = "SYS_TAP_TO_CLOSE",
		TextSize = 11,
		Color = Theme.TextDim,
		AlignX = Enum.TextXAlignment.Right,
		Size = UDim2.new(1, 0, 0, S(16)),
		LayoutOrder = 5,
		Parent = frame,
	})

	local tap = C.Make("TextButton", {
		Name = "Tap",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 5,
		Parent = root,
	})
	tap.Activated:Connect(function()
		closeRequested = true
	end)
end

local function typewriter(label: TextLabel, seconds: number)
	local length = utf8.len(label.ContentText) or #label.ContentText
	label.MaxVisibleGraphemes = 0
	local started = os.clock()
	while label.MaxVisibleGraphemes ~= -1 do
		local p = math.clamp((os.clock() - started) / seconds, 0, 1)
		if p >= 1 or closeRequested then
			label.MaxVisibleGraphemes = -1
			break
		end
		label.MaxVisibleGraphemes = math.floor(length * p)
		task.wait()
	end
end

local function fitHeight()
	-- подогнать высоту CanvasGroup под содержимое
	local layout = frame:FindFirstChildOfClass("UIListLayout")
	if layout then
		local h = layout.AbsoluteContentSize.Y + S(24) + S(8)
		root.Size = UDim2.fromOffset(S(432), math.max(S(112), h))
	end
end

local function show(payload: Types.NotifyPayload)
	local style = KIND_STYLE[payload.Kind] or KIND_STYLE.Info
	closeRequested = false

	-- фирменная деталь: «[Система] · Вид» холодным синим
	C.SetRaw(header, `[{Localization.Get("SYS_HEADER")}] · {Localization.Get("SYS_KIND_" .. string.upper(payload.Kind))}`)
	header.TextColor3 = style.Color
	stroke.Color = style.Color
	C.SetRaw(title, Localization.Get(payload.Title, payload.Args))
	if payload.Body then
		C.SetRaw(body, Localization.Get(payload.Body, payload.Args))
		body.Visible = true
	else
		body.Visible = false
	end
	title.MaxVisibleGraphemes = 0
	body.MaxVisibleGraphemes = 0

	root.Visible = true
	task.wait() -- дать AutomaticSize посчитаться
	fitHeight()

	Sound.Play(style.Sound)

	-- появление: короткий подъём на 8px и проявление, без пружины
	local targetPos = UDim2.new(0.5, 0, 0, S(88))
	root.Position = targetPos + UDim2.fromOffset(0, S(8))
	root.GroupTransparency = 1
	TweenService:Create(root, TweenInfo.new(0.32, Theme.Ease, Enum.EasingDirection.Out), {
		Position = targetPos,
		GroupTransparency = 0,
	}):Play()
	task.wait(0.12)

	typewriter(title, 0.35)
	if body.Visible then
		typewriter(body, 0.5)
	end

	local duration = style.Duration
	if #queue >= 3 then
		duration = 1.5
	end
	local started = os.clock()
	while os.clock() - started < duration and not closeRequested do
		task.wait(0.05)
	end

	local tween = TweenService:Create(root, TweenInfo.new(0.2, Theme.Ease, Enum.EasingDirection.Out), {
		GroupTransparency = 1,
	})
	tween:Play()
	tween.Completed:Wait()
	root.Visible = false
end

local function pump()
	if showing then
		return
	end
	showing = true
	while #queue > 0 do
		local payload = table.remove(queue, 1) :: Types.NotifyPayload
		local ok, err = pcall(show, payload)
		if not ok then
			warn("[SystemWindow]", err)
			root.Visible = false
		end
	end
	showing = false
end

function SystemWindowController:Notify(payload: Types.NotifyPayload)
	table.insert(queue, payload)
	task.spawn(pump)
end

function SystemWindowController:Start()
	build()
	Net.Event("SystemNotify").OnClientEvent:Connect(function(payload: Types.NotifyPayload)
		if type(payload) == "table" and type(payload.Title) == "string" then
			SystemWindowController:Notify(payload)
		end
	end)
end

return SystemWindowController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000052"><Properties><string name="Name">TradeController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ОБМЕН НА КЛИЕНТЕ.
	• Приглашение: карточка сверху «{имя} предлагает обмен» с кнопками «Принять»/«Отказать».
	• Окно обмена: слева твоё оружие (нажатие добавляет/убирает из предложения) и золото,
	  справа — что отдаёт другой игрок, с настоящими характеристиками.
	• Кнопка внизу: «Готов» → после готовности обоих отсчёт → «Подтвердить обмен».
	Всё решает сервер; клиент только показывает состояние и шлёт намерения.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Format = require(ReplicatedStorage.Shared.Format)
local Localization = require(ReplicatedStorage.Shared.Localization)
local Net = require(ReplicatedStorage.Shared.Net)
local C = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)
local WeaponCard = require(script.Parent.Parent.UI.WeaponCard)
local DataController = require(script.Parent.DataController)
local InputController = require(script.Parent.InputController)
local UIController = require(script.Parent.UIController)

local S = Theme.S
local player = Players.LocalPlayer

local TradeController = {}

-- приглашение
local invite: Frame
local inviteText: TextLabel
local inviteFrom = 0
local inviteToken = 0

-- окно
local panel: Frame
local title: TextLabel
local theirHeader: TextLabel
local yourGrid: ScrollingFrame
local theirGrid: ScrollingFrame
local goldBox: TextBox
local theirGold: TextLabel
local theirStatus: TextLabel
local actionButton: TextButton

local state: { [string]: any }? = nil
local confirmDeadline = 0 -- os.clock(), когда станет можно подтвердить
local closingByServer = false

-- ===== Приглашение =====

local function hideInvite()
	invite.Visible = false
	inviteFrom = 0
end

local function showInvite(payload: { [string]: any })
	inviteFrom = payload.FromUserId
	C.Bind(inviteText, "UI_TRADE_INVITE", { name = payload.FromName })
	invite.Visible = true
	if InputController:IsGamepad() then
		GuiService.SelectedObject = invite:FindFirstChild("Accept") :: GuiObject?
	end
	inviteToken += 1
	local token = inviteToken
	task.delay(payload.Timeout or 20, function()
		if token == inviteToken then
			hideInvite()
		end
	end)
end

local function answer(accept: boolean)
	if inviteFrom ~= 0 then
		Net.Event("TradeRespond"):FireServer(inviteFrom, accept)
	end
	hideInvite()
end

-- ===== Окно обмена =====

local function offeredIds(): { string }
	local ids = {}
	if state then
		for _, w in state.You.Weapons do
			table.insert(ids, w.Id)
		end
	end
	return ids
end

local function sendOffer(ids: { string }, gold: number)
	local s = state
	if not s then
		return
	end
	UIController:Handle(UIController:Invoke("TradeSetOffer", s.Id, ids, gold))
end

local function toggleWeapon(id: string)
	local s = state
	if not s then
		return
	end
	local ids = offeredIds()
	local index = table.find(ids, id)
	if index then
		table.remove(ids, index)
	else
		table.insert(ids, id)
	end
	sendOffer(ids, s.You.Gold)
end

local function refreshButton()
	local s = state
	if not s then
		return
	end
	local left = confirmDeadline - os.clock()
	local function set(key: string, args: { [string]: any }?, active: boolean)
		C.Bind(actionButton, key, args)
		actionButton.BackgroundColor3 = if active then Theme.Accent else Theme.PanelLight
		actionButton.TextColor3 = if active then Theme.Bg else Theme.TextDim
	end
	if s.Phase == "confirm" then
		if s.You.Confirmed then
			set("UI_TRADE_WAITING", { name = s.PartnerName }, false)
		elseif left > 0 then
			set("UI_TRADE_WAIT", { sec = math.ceil(left) }, false)
		else
			set("UI_TRADE_CONFIRM", nil, true)
		end
	elseif s.You.Ready then
		set("UI_TRADE_WAITING", { name = s.PartnerName }, false)
	else
		set("UI_TRADE_READY", nil, true)
	end
end

local function render()
	local s = state
	local data = DataController:Get()
	if not s or not data then
		return
	end
	C.Bind(title, "UI_TRADE_TITLE", { name = s.PartnerName })
	C.Bind(theirHeader, "UI_TRADE_THEIRS", { name = s.PartnerName })

	-- моё оружие: всё, что можно отдать (не надето, не в лавке); выбранное — в предложении
	local offered: { [string]: boolean } = {}
	for _, w in s.You.Weapons do
		offered[w.Id] = true
	end
	WeaponCard.Clear(yourGrid)
	local order = 0
	for _, weapon in WeaponCard.Sorted(data.Weapons) do
		if weapon.Id ~= data.EquippedWeapon and not data.Shop.Listings[weapon.Id] then
			order += 1
			WeaponCard.Create({
				Weapon = weapon,
				Selected = offered[weapon.Id] == true,
				LayoutOrder = order,
				Parent = yourGrid,
				OnClick = function()
					toggleWeapon(weapon.Id)
				end,
			})
		end
	end
	if not goldBox:IsFocused() then
		goldBox.Text = if s.You.Gold > 0 then tostring(s.You.Gold) else ""
	end

	-- их предложение
	WeaponCard.Clear(theirGrid)
	for i, weapon in s.Them.Weapons do
		WeaponCard.Create({ Weapon = weapon, LayoutOrder = i, Parent = theirGrid })
	end
	C.Bind(theirGold, "UI_TRADE_GOLD_LINE", { gold = Format.Short(s.Them.Gold) })
	local themReady = s.Them.Ready or s.Them.Confirmed
	C.Bind(theirStatus, if themReady then "UI_TRADE_READY" else "UI_TRADE_UNREADY")
	theirStatus.TextColor3 = if themReady then Theme.Success else Theme.Muted
	refreshButton()
end

local function onAction()
	local s = state
	if not s then
		return
	end
	if s.Phase == "confirm" then
		if not s.You.Confirmed and os.clock() >= confirmDeadline then
			Net.Event("TradeConfirm"):FireServer(s.Id, s.Version)
		end
	else
		Net.Event("TradeReady"):FireServer(s.Id, s.Version, not s.You.Ready)
	end
end

local function applyGold()
	local s = state
	if not s then
		return
	end
	local gold = tonumber(goldBox.Text) or 0
	gold = math.max(0, math.floor(gold))
	if gold ~= s.You.Gold then
		sendOffer(offeredIds(), gold)
	end
end

local function build()
	-- приглашение
	invite = C.Panel({
		Name = "TradeInvite",
		Size = UDim2.fromOffset(S(320), S(96)),
		Position = UDim2.new(0.5, 0, 0, S(160)),
		AnchorPoint = Vector2.new(0.5, 0),
		Visible = false,
		Adaptive = true,
		Parent = UIController.Layers.Overlay,
	})
	inviteText = C.Text({
		Font = Theme.FontBold,
		TextSize = 15,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -S(24), 0, S(24)),
		Position = UDim2.fromOffset(S(12), S(12)),
		Parent = invite,
	})
	C.Button({
		Name = "Accept",
		Key = "UI_ACCEPT",
		TextSize = 14,
		Size = UDim2.new(0.5, -S(16), 0, S(40)),
		Position = UDim2.new(0, S(12), 1, -S(12)),
		AnchorPoint = Vector2.new(0, 1),
		Color = Theme.Accent,
		TextColor = Theme.Bg,
		OnClick = function()
			answer(true)
		end,
		Parent = invite,
	})
	C.Button({
		Name = "Decline",
		Key = "UI_DECLINE",
		TextSize = 14,
		Size = UDim2.new(0.5, -S(16), 0, S(40)),
		Position = UDim2.new(1, -S(12), 1, -S(12)),
		AnchorPoint = Vector2.new(1, 1),
		OnClick = function()
			answer(false)
		end,
		Parent = invite,
	})

	-- окно обмена
	panel = C.Panel({ Name = "TradePanel", Size = UDim2.fromOffset(S(540), S(332)) })
	title = C.TitleBar(panel, "UI_TRADE_TITLE", function()
		UIController:ClosePanel()
	end)
	local top = S(48)
	local bottom = S(92)
	C.Text({
		Key = "UI_TRADE_YOURS",
		Font = Theme.FontBold,
		TextSize = 13,
		Color = Theme.TextDim,
		Size = UDim2.new(0.5, -S(24), 0, S(16)),
		Position = UDim2.fromOffset(S(16), top),
		Parent = panel,
	})
	yourGrid = WeaponCard.Grid(panel, UDim2.new(0.5, -S(24), 1, -(top + S(20) + bottom)), UDim2.fromOffset(S(16), top + S(20)))
	goldBox = C.Make("TextBox", {
		Size = UDim2.new(0.5, -S(24), 0, S(32)),
		Position = UDim2.new(0, S(16), 1, -(bottom - S(4))),
		BackgroundColor3 = Theme.Bg,
		Font = Theme.FontBold,
		TextSize = S(14),
		TextColor3 = Theme.Gold,
		PlaceholderColor3 = Theme.Muted,
		ClearTextOnFocus = false,
		Text = "",
		Parent = panel,
	})
	C.Corner(goldBox, 8)
	C.Stroke(goldBox)
	goldBox.FocusLost:Connect(applyGold)

	theirHeader = C.Text({
		Font = Theme.FontBold,
		TextSize = 13,
		Color = Theme.TextDim,
		Size = UDim2.new(0.5, -S(24), 0, S(16)),
		Position = UDim2.new(0.5, S(8), 0, top),
		Parent = panel,
	})
	theirGrid = WeaponCard.Grid(panel, UDim2.new(0.5, -S(24), 1, -(top + S(20) + bottom)), UDim2.new(0.5, S(8), 0, top + S(20)))
	theirGold = C.Text({
		Font = Theme.FontBold,
		TextSize = 14,
		Color = Theme.Gold,
		Size = UDim2.new(0.25, 0, 0, S(32)),
		Position = UDim2.new(0.5, S(8), 1, -(bottom - S(4))),
		Parent = panel,
	})
	theirStatus = C.Text({
		Font = Theme.FontBold,
		TextSize = 13,
		AlignX = Enum.TextXAlignment.Right,
		Size = UDim2.new(0.25, -S(16), 0, S(32)),
		Position = UDim2.new(0.75, 0, 1, -(bottom - S(4))),
		Parent = panel,
	})
	C.Text({
		Key = "UI_TRADE_HINT",
		TextSize = 11,
		Color = Theme.Muted,
		Wrapped = true,
		Size = UDim2.new(0.5, -S(24), 0, S(44)),
		Position = UDim2.new(0, S(16), 1, -S(56)),
		Parent = panel,
	})
	actionButton = C.Button({
		Key = "UI_TRADE_READY",
		Font = Theme.FontTitle,
		TextSize = 16,
		Size = UDim2.new(0.5, -S(24), 0, S(44)),
		Position = UDim2.new(1, -S(16), 1, -S(12)),
		AnchorPoint = Vector2.new(1, 1),
		Color = Theme.Accent,
		TextColor = Theme.Bg,
		OnClick = onAction,
		Parent = panel,
	})
end

-- своя подсказка «Обмен» над собственным персонажем не нужна
local function hideOwnPrompt(character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local prompt = root and root:WaitForChild("TradePrompt", 10)
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Enabled = false
	end
end

function TradeController:Start()
	build()
	goldBox.PlaceholderText = Localization.Get("UI_TRADE_GOLD_LINE", { gold = 0 })
	Localization.Changed:Connect(function()
		goldBox.PlaceholderText = Localization.Get("UI_TRADE_GOLD_LINE", { gold = 0 })
		render()
	end)

	UIController:RegisterPanel("Trade", {
		Frame = panel,
		OnOpen = function()
			render()
		end,
		OnClose = function()
			-- окно закрыл сам игрок → отменить обмен на сервере
			local s = state
			if s and not closingByServer then
				Net.Event("TradeCancel"):FireServer(s.Id)
			end
			state = nil
		end,
	})

	Net.Event("TradeInvite").OnClientEvent:Connect(showInvite)
	Net.Event("TradeState").OnClientEvent:Connect(function(payload: { [string]: any })
		if payload.Phase == "open" or payload.Phase == "confirm" then
			state = payload
			confirmDeadline = os.clock() + (payload.ConfirmIn or 0)
			hideInvite()
			if UIController:GetOpenPanel() ~= "Trade" then
				UIController:OpenPanel("Trade")
			else
				render()
			end
		else
			if UIController:GetOpenPanel() == "Trade" then
				closingByServer = true
				UIController:ClosePanel()
				closingByServer = false
			end
			state = nil
		end
	end)

	DataController.Changed:Connect(function(key: string)
		if state and (key == "Weapons" or key == "Shop" or key == "EquippedWeapon") then
			render()
		end
	end)

	-- обратный отсчёт до «Подтвердить»
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.2 and state and state.Phase == "confirm" then
			acc = 0
			refreshButton()
		end
	end)

	player.CharacterAdded:Connect(hideOwnPrompt)
	if player.Character then
		task.spawn(hideOwnPrompt, player.Character)
	end
end

return TradeController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000053"><Properties><string name="Name">UIController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Корневой ScreenGui, слои, окна (одно открытое за раз), тосты, обработка ответов сервера.
	Окно регистрируется так:
		UIController:RegisterPanel("Forge", { Frame = frame, OnOpen = fn(payload), OnClose = fn() })
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Localization = require(ReplicatedStorage.Shared.Localization)
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Signal)
local C = require(script.Parent.Parent.UI.Components)
local Sound = require(script.Parent.Parent.UI.Sound)
local Theme = require(script.Parent.Parent.UI.Theme)
local InputController = require(script.Parent.InputController)

local S = Theme.S

local UIController = {}

UIController.Gui = nil :: any
UIController.Layers = {} :: { [string]: Frame }
UIController.PanelChanged = Signal.new() -- (name or nil)

type Panel = { Frame: GuiObject, OnOpen: ((any) -> ())?, OnClose: (() -> ())? }
local panels: { [string]: Panel } = {}
local openName: string? = nil

local toastContainer: Frame
local hitFlash: Frame
local toastCounter = 0

function UIController:Init()
	-- дождаться реального размера экрана
	local camera = workspace.CurrentCamera
	for _ = 1, 50 do
		if camera and camera.ViewportSize.X > 10 then
			break
		end
		task.wait(0.05)
		camera = workspace.CurrentCamera
	end
	Theme.UpdateScale()

	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = Instance.new("ScreenGui")
	gui.Name = "SystemBlacksmith"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	gui.Parent = playerGui
	UIController.Gui = gui

	for i, name in { "Hud", "Panels", "Overlay", "Toasts" } do
		local layer = Instance.new("Frame")
		layer.Name = name
		layer.Size = UDim2.fromScale(1, 1)
		layer.BackgroundTransparency = 1
		layer.ZIndex = i * 10
		layer.Parent = gui
		UIController.Layers[name] = layer
	end

	-- тосты внизу по центру
	toastContainer = C.Make("Frame", {
		Name = "ToastList",
		Size = UDim2.new(0, S(360), 0, S(200)),
		Position = UDim2.new(0.5, 0, 1, -S(120)),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		Parent = UIController.Layers.Toasts,
	})
	C.List(toastContainer, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom)
	C.Adaptive(toastContainer)

	-- красная вспышка по краям экрана при получении урона
	hitFlash = C.Make("Frame", {
		Name = "HitFlash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Danger,
		BackgroundTransparency = 1,
		Parent = UIController.Layers.Overlay,
	})
	C.Make("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(0.25, 1),
			NumberSequenceKeypoint.new(0.75, 1),
			NumberSequenceKeypoint.new(1, 0.2),
		}),
		Parent = hitFlash,
	})
end

-- Геймпад: выделить первую кнопку открытого окна (кроме крестика)
local function focusPanel(frame: GuiObject)
	if not InputController:IsGamepad() then
		return
	end
	local best: GuiObject? = nil
	for _, d in frame:GetDescendants() do
		if d:IsA("GuiButton") and d.Visible and d.Name ~= "Close" and d.Selectable then
			best = d
			break
		end
	end
	GuiService.SelectedObject = best
end

local function watchViewport()
	local connection: RBXScriptConnection? = nil
	local function hook()
		if connection then
			connection:Disconnect()
		end
		local camera = workspace.CurrentCamera
		if camera then
			connection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
				C.SetAdaptiveFactor(Theme.ComputeScale() / Theme.Scale)
			end)
			C.SetAdaptiveFactor(Theme.ComputeScale() / Theme.Scale)
		end
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hook)
	hook()
end

function UIController:Start()
	watchViewport()
	InputController.Changed:Connect(function(mode: string)
		if openName and mode == "Gamepad" then
			focusPanel(panels[openName].Frame)
		elseif mode ~= "Gamepad" then
			GuiService.SelectedObject = nil
		end
	end)
	Net.Event("Toast").OnClientEvent:Connect(function(payload: { [string]: any })
		UIController:Toast(payload.Key, payload.Args, payload.Color)
	end)
	Net.Event("OpenPanel").OnClientEvent:Connect(function(payload: { [string]: any })
		UIController:OpenPanel(payload.Panel, payload)
	end)
end

-- ===== Окна =====

function UIController:RegisterPanel(name: string, panel: Panel)
	panels[name] = panel
	panel.Frame.Visible = false
	panel.Frame.Parent = UIController.Layers.Panels
	C.Adaptive(panel.Frame)
end

function UIController:OpenPanel(name: string, payload: any?)
	local panel = panels[name]
	if not panel then
		return
	end
	if openName and openName ~= name then
		UIController:ClosePanel()
	end
	openName = name
	panel.Frame.Visible = true
	if panel.OnOpen then
		panel.OnOpen(payload)
	end
	-- геймпад: B закрывает окно, фокус на первую кнопку
	ContextActionService:BindActionAtPriority("UIClosePanel", function(_, state)
		if state == Enum.UserInputState.Begin then
			UIController:ClosePanel()
		end
		return Enum.ContextActionResult.Sink
	end, false, 2500, Enum.KeyCode.ButtonB)
	focusPanel(panel.Frame)
	UIController.PanelChanged:Fire(name)
end

function UIController:ClosePanel()
	local name = openName
	if not name then
		return
	end
	openName = nil
	ContextActionService:UnbindAction("UIClosePanel")
	GuiService.SelectedObject = nil
	local panel = panels[name]
	panel.Frame.Visible = false
	if panel.OnClose then
		panel.OnClose()
	end
	UIController.PanelChanged:Fire(nil)
end

function UIController:TogglePanel(name: string)
	if openName == name then
		UIController:ClosePanel()
	else
		UIController:OpenPanel(name)
	end
end

function UIController:GetOpenPanel(): string?
	return openName
end

-- ===== Тосты =====

local TOAST_COLORS: { [string]: Color3 } = {
	error = Theme.Danger,
	ore = Theme.Gold,
	gold = Theme.Gold,
	success = Theme.Success,
}

function UIController:Toast(key: string, args: { [string]: any }?, color: string?)
	if not toastContainer then
		return
	end
	local text = Localization.Get(key, args)
	toastCounter += 1
	local toast = C.Make("TextLabel", {
		LayoutOrder = toastCounter,
		Size = UDim2.new(0, S(340), 0, S(32)),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.25,
		Font = Theme.FontBold,
		TextSize = S(16),
		TextColor3 = (color and TOAST_COLORS[color]) or Theme.Text,
		TextWrapped = true,
		Text = text,
		Parent = toastContainer,
	})
	C.Corner(toast, 6)
	if color == "error" then
		Sound.Play("SystemWarning", 0.3)
	end
	-- не больше 5 тостов одновременно
	local list = {}
	for _, child in toastContainer:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(list, child)
		end
	end
	if #list > 5 then
		list[1]:Destroy()
	end
	task.delay(2.2, function()
		if toast.Parent then
			local tween = TweenService:Create(toast, TweenInfo.new(0.35), { TextTransparency = 1, BackgroundTransparency = 1 })
			tween:Play()
			tween.Completed:Wait()
			toast:Destroy()
		end
	end)
end

-- Ответ RemoteFunction: показать ошибку тостом. Возвращает ok.
function UIController:Handle(result: any): boolean
	if type(result) ~= "table" then
		UIController:Toast("ERR_SERVER", nil, "error")
		return false
	end
	if not result.ok then
		UIController:Toast(result.err or "ERR_SERVER", result.args, "error")
		return false
	end
	return true
end

-- Безопасный вызов RemoteFunction
function UIController:Invoke(name: string, ...: any): any
	local remote = Net.Function(name)
	local args = table.pack(...)
	local ok, result = pcall(function()
		return remote:InvokeServer(table.unpack(args, 1, args.n))
	end)
	if not ok then
		return { ok = false, err = "ERR_SERVER" }
	end
	return result
end

function UIController:FlashHit(strength: number)
	hitFlash.BackgroundTransparency = math.clamp(1 - strength, 0.35, 1)
	TweenService:Create(hitFlash, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
end

return UIController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000054"><Properties><string name="Name">ZoneController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ЗОНЫ: баннер «Медные холмы · Рекомендуемый ур. 1+» при входе в зону, музыка зоны,
	вращение Кристалла Системы (тег Spin), режим «слабая графика» для телефонов.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local C = require(script.Parent.Parent.UI.Components)
local ClientSettings = require(script.Parent.Parent.UI.ClientSettings)
local Theme = require(script.Parent.Parent.UI.Theme)
local UIController = require(script.Parent.UIController)

local S = Theme.S
local player = Players.LocalPlayer

local ZoneController = {}

local banner: CanvasGroup
local bannerTitle: TextLabel
local bannerSub: TextLabel
local currentZone: string? = nil
local music: Sound

local function zoneAt(position: Vector3): any
	local best: any = nil
	for _, zone in Config.World.Zones do
		local offset = position - zone.Center
		local d = Vector3.new(offset.X, 0, offset.Z).Magnitude
		if d <= zone.Radius and (best == nil or zone.Radius < best.Radius) then
			best = zone
		end
	end
	return best
end

local function showBanner(zone: any)
	C.Bind(bannerTitle, zone.NameKey)
	if zone.Safe then
		C.Bind(bannerSub, "UI_ZONE_SAFE")
		bannerSub.TextColor3 = Theme.Success
	else
		C.Bind(bannerSub, "UI_ZONE_LEVEL", { level = zone.Level })
		bannerSub.TextColor3 = Theme.TextDim
	end
	banner.Visible = true
	banner.GroupTransparency = 1
	TweenService:Create(banner, TweenInfo.new(0.4), { GroupTransparency = 0 }):Play()
	task.delay(2.6, function()
		if currentZone == zone.Id then
			local t = TweenService:Create(banner, TweenInfo.new(0.6), { GroupTransparency = 1 })
			t:Play()
		end
	end)
end

local function playMusic(zone: any?)
	local id = if zone then Config.Audio[zone.Music] else nil
	if not ClientSettings.Music or not id or id == "" then
		music:Stop()
		return
	end
	if music.SoundId == id and music.IsPlaying then
		return
	end
	music.SoundId = id
	music.Volume = 0
	music:Play()
	TweenService:Create(music, TweenInfo.new(2), { Volume = 0.3 }):Play()
end

local function applyGraphics()
	local low = ClientSettings.LowGraphics
	for _, effect in Lighting:GetChildren() do
		if effect:IsA("PostEffect") then
			effect.Enabled = not low
		end
	end
	Lighting.GlobalShadows = not low
end

local function build()
	banner = C.Make("CanvasGroup", {
		Name = "ZoneBanner",
		Size = UDim2.fromOffset(S(420), S(72)),
		Position = UDim2.new(0.5, 0, 0.26, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		Parent = UIController.Layers.Overlay,
	})
	C.Adaptive(banner)
	bannerTitle = C.Text({
		Font = Theme.FontTitle,
		TextSize = 30,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, S(40)),
		Parent = banner,
	})
	bannerTitle.TextStrokeTransparency = 0.4
	bannerSub = C.Text({
		Font = Theme.FontBold,
		TextSize = 15,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, S(24)),
		Position = UDim2.fromOffset(0, S(40)),
		Parent = banner,
	})
	bannerSub.TextStrokeTransparency = 0.5

	music = Instance.new("Sound")
	music.Name = "ZoneMusic"
	music.Looped = true
	music.Parent = SoundService
end

function ZoneController:Start()
	build()
	applyGraphics()
	ClientSettings.Changed:Connect(function(key: string)
		if key == "LowGraphics" then
			applyGraphics()
		elseif key == "Music" then
			if ClientSettings.Music then
				local id = currentZone
				playMusic(if id then Config.World.Zones[id] else nil)
			else
				music:Stop()
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local zone = zoneAt(root.Position)
				local id = if zone then zone.Id else nil
				if id ~= currentZone then
					currentZone = id
					if zone then
						showBanner(zone)
					end
					playMusic(zone)
				end
			end
		end
	end)

	-- вращение деталей с тегом Spin (только на клиенте, сервер не нагружается)
	RunService.RenderStepped:Connect(function(dt)
		for _, inst in CollectionService:GetTagged(Config.Tags.Spin) do
			if inst:IsA("BasePart") then
				inst.CFrame = inst.CFrame * CFrame.Angles(0, dt * 0.8, 0)
			end
		end
	end)
end

return ZoneController
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX0000005B"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX00000056"><Properties><string name="Name">ClientSettings</string><ProtectedString name="Source"><![CDATA[--!strict
-- Текущие настройки игрока на клиенте (звук, музыка, цифры урона, слабая графика).
-- Берутся из профиля, меняются в Меню → Настройки.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Shared.Signal)

local ClientSettings = {
	Sfx = true,
	Music = true,
	DamageNumbers = true,
	LowGraphics = false,
	Changed = Signal.new(), -- (key, value)
}

function ClientSettings.Set(key: string, value: boolean)
	if (ClientSettings :: any)[key] == value then
		return
	end;
	(ClientSettings :: any)[key] = value
	ClientSettings.Changed:Fire(key, value)
end

return ClientSettings
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000057"><Properties><string name="Name">Components</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Строительные блоки интерфейса. Весь текст — через ключи локализации:
		C.Text({ Key = "UI_LEVEL", Args = { level = 5 }, ... })
	При смене языка все привязанные тексты обновятся сами.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Localization = require(ReplicatedStorage.Shared.Localization)
local Theme = require(script.Parent.Theme)
local Sound = require(script.Parent.Sound)

local S = Theme.S

local C = {}

-- ===== Локализация текста =====

type Binding = { Key: string, Args: { [string]: any }? }
local bindings: { [Instance]: Binding } = setmetatable({}, { __mode = "k" }) :: any

local function render(obj: Instance, b: Binding)
	(obj :: any).Text = Localization.Get(b.Key, b.Args)
end

function C.Bind(obj: Instance, key: string, args: { [string]: any }?)
	local b = { Key = key, Args = args }
	bindings[obj] = b
	render(obj, b)
end

-- Обычный текст без перевода (числа, имена игроков)
function C.SetRaw(obj: Instance, text: string)
	bindings[obj] = nil;
	(obj :: any).Text = text
end

Localization.Changed:Connect(function()
	for obj, b in bindings do
		if obj.Parent then
			render(obj, b)
		end
	end
end)

-- ===== Адаптивность =====
-- Корневые блоки интерфейса получают UIScale: при изменении размера окна/повороте экрана
-- UIController пересчитывает масштаб, и всё увеличивается/уменьшается от своей точки привязки.

local adaptive: { [UIScale]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local adaptiveFactor = 1

function C.Adaptive(obj: GuiObject): GuiObject
	local scale = Instance.new("UIScale")
	scale.Name = "AdaptiveScale"
	scale.Scale = adaptiveFactor
	scale.Parent = obj
	adaptive[scale] = true
	return obj
end

function C.SetAdaptiveFactor(factor: number)
	adaptiveFactor = factor
	for scale in adaptive do
		if scale.Parent then
			scale.Scale = factor
		end
	end
end

-- Подсказки клавиш: { KeyboardMouse = "F", Gamepad = "L2" } — видны только в нужном режиме
type Hint = { Label: TextLabel, Keys: { [string]: string } }
local hints: { Hint } = {}
local inputMode = "KeyboardMouse"

local function applyHint(h: Hint)
	local key = h.Keys[inputMode]
	h.Label.Visible = key ~= nil
	if key then
		h.Label.Text = key
	end
end

function C.SetInputMode(mode: string)
	inputMode = mode
	for i = #hints, 1, -1 do
		local h = hints[i]
		if h.Label.Parent then
			applyHint(h)
		else
			table.remove(hints, i)
		end
	end
end

function C.KeyHint(parent: GuiObject, keys: { [string]: string }): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = "KeyHint"
	label.Size = UDim2.fromOffset(Theme.S(28), Theme.S(20))
	label.Position = UDim2.new(1, Theme.S(4), 0, -Theme.S(4))
	label.AnchorPoint = Vector2.new(1, 0)
	label.BackgroundColor3 = Color3.fromRGB(240, 240, 250)
	label.TextColor3 = Color3.fromRGB(20, 25, 40)
	label.Font = Enum.Font.GothamBold
	label.TextSize = Theme.S(11)
	label.ZIndex = (parent.ZIndex or 1) + 2
	label.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, Theme.S(4))
	corner.Parent = label
	local h = { Label = label, Keys = keys }
	table.insert(hints, h)
	applyHint(h)
	return label
end

-- ===== Базовые =====

function C.Make(className: string, props: { [string]: any }, children: { Instance }?): any
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(inst :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function C.Corner(parent: Instance, radius: number?): UICorner
	return C.Make("UICorner", { CornerRadius = UDim.new(0, S(radius or 8)), Parent = parent })
end

function C.Round(parent: Instance): UICorner
	return C.Make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = parent })
end

-- Без цвета — тонкая линия (основной текст на 10%). С цветом — осознанный акцент.
function C.Stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	return C.Make("UIStroke", {
		Color = color or Theme.Text,
		Thickness = math.max(1, S(thickness or 1)),
		Transparency = transparency or (if color then 0 else Theme.HairlineTransparency),
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function C.Padding(parent: Instance, px: number): UIPadding
	local p = UDim.new(0, S(px))
	return C.Make("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p, Parent = parent })
end

function C.List(
	parent: Instance,
	direction: Enum.FillDirection,
	padding: number,
	hAlign: Enum.HorizontalAlignment?,
	vAlign: Enum.VerticalAlignment?
): UIListLayout
	return C.Make("UIListLayout", {
		FillDirection = direction,
		Padding = UDim.new(0, S(padding)),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

-- Окно в стиле Системы
function C.Panel(props: { [string]: any }): Frame
	local frame = C.Make("Frame", {
		Name = props.Name or "Panel",
		Size = props.Size,
		Position = props.Position or UDim2.fromScale(0.5, 0.5),
		AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5),
		BackgroundColor3 = props.Color or Theme.Panel,
		BackgroundTransparency = props.Transparency or 0.06,
		Visible = if props.Visible == nil then true else props.Visible,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	if props.Adaptive then
		C.Adaptive(frame)
	end
	C.Corner(frame, props.Radius or 16)
	C.Stroke(frame, props.StrokeColor, props.StrokeThickness or 1)
	return frame
end

function C.Text(props: { [string]: any }): TextLabel
	local label = C.Make("TextLabel", {
		Name = props.Name or "Text",
		Size = props.Size or UDim2.fromScale(1, 0),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundTransparency = 1,
		Font = props.Font or Theme.Font,
		TextSize = S(props.TextSize or 16),
		TextColor3 = props.Color or Theme.Text,
		TextXAlignment = props.AlignX or Enum.TextXAlignment.Left,
		TextYAlignment = props.AlignY or Enum.TextYAlignment.Center,
		TextWrapped = props.Wrapped or false,
		TextTruncate = if props.Wrapped then Enum.TextTruncate.None else Enum.TextTruncate.AtEnd,
		RichText = props.RichText or false,
		AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.None,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Visible = if props.Visible == nil then true else props.Visible,
		Text = props.Text or "",
		Parent = props.Parent,
	})
	if props.Key then
		C.Bind(label, props.Key, props.Args)
	end
	return label
end

-- Крупная кнопка с «нажатием» (удобно пальцем)
function C.Button(props: { [string]: any }): TextButton
	local color: Color3 = props.Color or Theme.PanelLight
	local button = C.Make("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		BackgroundTransparency = props.Transparency or 0,
		AutoButtonColor = false,
		Font = props.Font or Theme.FontBold,
		TextSize = S(props.TextSize or 18),
		TextColor3 = props.TextColor or Theme.Text,
		TextWrapped = true,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Visible = if props.Visible == nil then true else props.Visible,
		Text = props.Text or "",
		Parent = props.Parent,
	})
	C.Corner(button, props.Radius or 8)
	if props.Round then
		(button:FindFirstChildOfClass("UICorner") :: UICorner).CornerRadius = UDim.new(1, 0)
	end
	C.Stroke(button, props.StrokeColor)
	if props.Key then
		C.Bind(button, props.Key, props.Args)
	end

	button.MouseButton1Down:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.12, Theme.Ease), { BackgroundTransparency = 0.2 }):Play()
	end)
	local function release()
		TweenService:Create(button, TweenInfo.new(0.16, Theme.Ease), { BackgroundTransparency = props.Transparency or 0 }):Play()
	end
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)

	if props.OnClick then
		button.Activated:Connect(function()
			if not props.Silent then
				Sound.Play("UiClick")
			end
			props.OnClick()
		end)
	end
	return button
end

-- Полоса прогресса: возвращает (рамка, заливка)
function C.Bar(props: { [string]: any }): (Frame, Frame)
	local bg = C.Make("Frame", {
		Name = props.Name or "Bar",
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = props.BgColor or Theme.Bg,
		BackgroundTransparency = 0.2,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	C.Corner(bg, 4)
	local fill = C.Make("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(props.Value or 0, 1),
		BackgroundColor3 = props.Color or Theme.Accent,
		Parent = bg,
	})
	C.Corner(fill, 4)
	return bg, fill
end

-- Кнопка-заголовок окна с крестиком
function C.TitleBar(panel: Frame, titleKey: string, onClose: () -> ()): TextLabel
	local title = C.Text({
		Key = titleKey,
		Font = Theme.FontTitle,
		TextSize = 22,
		Color = Theme.Text,
		Size = UDim2.new(1, -S(64), 0, S(32)),
		Position = UDim2.fromOffset(S(16), S(8)),
		Parent = panel,
	})
	C.Button({
		Name = "Close",
		Text = "×",
		Size = UDim2.fromOffset(S(40), S(40)),
		Position = UDim2.new(1, -S(8), 0, S(8)),
		AnchorPoint = Vector2.new(1, 0),
		Color = Theme.PanelLight,
		TextSize = 20,
		OnClick = onClose,
		Parent = panel,
	})
	return title
end

return C
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000058"><Properties><string name="Name">Sound</string><ProtectedString name="Source"><![CDATA[--!strict
-- Звуки интерфейса и эффектов. ID задаются в Shared/Config/Audio (пусто = тишина).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)
local ClientSettings = require(script.Parent.ClientSettings)

local Sound = {}

local cache: { [string]: Sound } = {}

function Sound.Play(key: string, volume: number?, pitch: number?)
	local id = Config.Audio[key]
	if not ClientSettings.Sfx or not id or id == "" then
		return
	end
	local sound = cache[key]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = key
		sound.SoundId = id
		sound.Parent = SoundService
		cache[key] = sound
	end
	local s = sound :: Sound
	s.Volume = volume or 0.6
	s.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(s)
end

return Sound
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000059"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Направление: ночная кузня. Интерфейс — тихий тёплый графит (копоть, металл),
	главное действие — цвет углей. Холодный синий свет есть только у Системы:
	окно Системы и заголовок «[Система]» в трекере задания.
	Без неоновых обводок и градиентов: глубина от ступеней поверхности и тонких линий.

	S(n) — размер в пикселях, масштабированный под экран (телефон ≈ 0.9, ПК до 1.6).
	Базовые размеры — на сетке 4px. Интерфейс рассчитан на телефон в альбомной ориентации (~640×380 точек).
]]

local Theme = {
	Scale = 1,

	-- тёплая нейтральная шкала (поверхности и текст)
	Bg = Color3.fromRGB(18, 17, 15), -- самая глубокая поверхность
	Panel = Color3.fromRGB(28, 26, 24), -- окна и блоки
	PanelLight = Color3.fromRGB(38, 36, 33), -- поднятая: кнопки, строки, поля
	Text = Color3.fromRGB(239, 233, 222), -- основной
	TextDim = Color3.fromRGB(170, 163, 152), -- второстепенный
	Muted = Color3.fromRGB(138, 132, 122), -- подписи и мета
	HairlineTransparency = 0.9, -- линии = основной текст на 10%

	-- угли кузни: главное действие, выбор, таймер
	Accent = Color3.fromRGB(238, 137, 64),
	AccentDim = Color3.fromRGB(58, 44, 34), -- выбранная строка: поверхность с оттенком углей

	-- холодный свет Системы (только окно Системы и заголовок «[Система]»)
	System = Color3.fromRGB(88, 190, 255),
	SystemBg = Color3.fromRGB(10, 22, 40),

	-- смысловые цвета, приглушённые под шкалу
	Gold = Color3.fromRGB(232, 190, 90), -- золото как валюта
	Danger = Color3.fromRGB(229, 72, 77),
	Success = Color3.fromRGB(76, 195, 138),
	Disabled = Color3.fromRGB(34, 32, 30),

	-- веса 400 и 500; иерархия — размером и цветом, а не жирностью
	Font = Enum.Font.Gotham,
	FontBold = Enum.Font.GothamMedium,
	FontTitle = Enum.Font.GothamMedium,

	-- одна кривая для всей анимации (ease-out), без пружин
	Ease = Enum.EasingStyle.Quint,
}

-- Масштаб для текущего экрана (не меняет Theme.Scale)
function Theme.ComputeScale(): number
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	if size.X < 10 or size.Y < 10 then
		size = Vector2.new(1280, 720)
	end
	-- телефон в портретной ориентации: ориентируемся на ширину
	if size.Y > size.X then
		return math.clamp(size.X / 600, 0.6, 1.3) -- окна 540 точек должны влезть по ширине
	end
	return math.clamp(math.min(size.X / 640, size.Y / 380), 0.75, 1.6)
end

-- Масштаб, с которым строится интерфейс (вызывается один раз при запуске)
function Theme.UpdateScale()
	Theme.Scale = Theme.ComputeScale()
end

function Theme.S(n: number): number
	return math.floor(n * Theme.Scale + 0.5)
end

return Theme
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000005A"><Properties><string name="Name">WeaponCard</string><ProtectedString name="Source"><![CDATA[--!strict
-- Карточка оружия для инвентаря и торговца.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Localization = require(ReplicatedStorage.Shared.Localization)
local WeaponMath = require(ReplicatedStorage.Shared.WeaponMath)
local C = require(script.Parent.Components)
local Theme = require(script.Parent.Theme)

local S = Theme.S

local WeaponCard = {}

export type CardProps = {
	Weapon: any,
	Equipped: boolean?,
	Selected: boolean?,
	ShowPrice: boolean?, -- цена у торговца
	Listed: boolean?, -- выставлено в лавке
	PriceText: string?, -- своя подпись цены (цена в лавке)
	LayoutOrder: number?,
	OnClick: (() -> ())?,
	Parent: Instance,
}

function WeaponCard.Create(props: CardProps): TextButton
	local weapon = props.Weapon
	local rarity = Config.Rarities[weapon.Rarity] or Config.Rarities.Common

	local card = C.Make("TextButton", {
		Name = weapon.Id,
		BackgroundColor3 = if props.Selected then Theme.AccentDim else Theme.PanelLight,
		AutoButtonColor = true,
		Text = "",
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	C.Corner(card, 6)
	-- рамка только у надетого и выбранного; редкость показывает полоска слева
	if props.Equipped or props.Selected then
		C.Stroke(card, Theme.Accent, 1.5)
	else
		C.Stroke(card)
	end

	C.Make("Frame", {
		Name = "RarityStrip",
		Size = UDim2.new(0, S(4), 1, -S(12)),
		Position = UDim2.fromOffset(S(4), S(4)),
		BackgroundColor3 = rarity.Color,
		BorderSizePixel = 0,
		Parent = card,
	})

	C.Text({
		Text = Localization.WeaponName(weapon.Type, weapon.Ore),
		Font = Theme.FontBold,
		TextSize = 14,
		Size = UDim2.new(1, -S(20), 0, S(20)),
		Position = UDim2.fromOffset(S(16), S(4)),
		Parent = card,
	})
	C.Text({
		Key = rarity.NameKey,
		TextSize = 11,
		Color = rarity.Color,
		Size = UDim2.new(1, -S(20), 0, S(12)),
		Position = UDim2.fromOffset(S(16), S(24)),
		Parent = card,
	})
	C.Text({
		Key = "UI_DMG",
		Args = { value = WeaponMath.Damage(weapon) },
		Font = Theme.FontBold,
		TextSize = 14,
		Color = Theme.Accent,
		Size = UDim2.new(0.5, -S(12), 0, S(16)),
		Position = UDim2.fromOffset(S(16), S(40)),
		Parent = card,
	})
	C.Text({
		Key = "UI_QUALITY",
		Args = { value = weapon.Quality },
		TextSize = 11,
		Color = Theme.TextDim,
		AlignX = Enum.TextXAlignment.Right,
		Size = UDim2.new(1, -S(20), 0, S(12)),
		Position = UDim2.fromOffset(S(16), S(24)),
		Parent = card,
	})
	-- черты оружия
	local traits = {}
	for _, id in weapon.Traits or {} do
		local t = Config.Traits[id]
		if t then
			table.insert(traits, Localization.Get(t.NameKey))
		end
	end
	if #traits > 0 then
		C.Text({
			Text = table.concat(traits, " · "),
			TextSize = 11,
			Font = Theme.FontBold,
			Color = Theme.TextDim,
			Size = UDim2.new(1, -S(20), 0, S(16)),
			Position = UDim2.fromOffset(S(16), S(56)),
			Parent = card,
		})
	end

	if props.Equipped then
		C.Text({
			Key = "UI_EQUIPPED",
			Font = Theme.FontBold,
			TextSize = 11,
			Color = Theme.Accent,
			AlignX = Enum.TextXAlignment.Right,
			Size = UDim2.new(0.5, -S(8), 0, S(16)),
			Position = UDim2.new(0.5, 0, 0, S(40)),
			Parent = card,
		})
	elseif props.Listed or props.PriceText then
		C.Text({
			Text = props.PriceText,
			Key = if props.PriceText then nil else "UI_LISTED",
			Font = Theme.FontBold,
			TextSize = if props.PriceText then 13 else 11,
			Color = if props.PriceText then Theme.Gold else Theme.Muted,
			AlignX = Enum.TextXAlignment.Right,
			Size = UDim2.new(0.5, -S(8), 0, S(16)),
			Position = UDim2.new(0.5, 0, 0, S(40)),
			Parent = card,
		})
	elseif props.ShowPrice then
		C.Text({
			Text = `+{WeaponMath.SellPrice(weapon)}`,
			Font = Theme.FontBold,
			TextSize = 13,
			Color = Theme.Gold,
			AlignX = Enum.TextXAlignment.Right,
			Size = UDim2.new(0.5, -S(8), 0, S(16)),
			Position = UDim2.new(0.5, 0, 0, S(40)),
			Parent = card,
		})
	end

	if props.OnClick then
		card.Activated:Connect(props.OnClick)
	end
	return card
end

-- Оружие игрока, отсортированное по урону (сильное сверху)
function WeaponCard.Sorted(weapons: { [string]: any }): { any }
	local list = {}
	for _, w in weapons do
		table.insert(list, w)
	end
	table.sort(list, function(a, b)
		local da, db = WeaponMath.Damage(a), WeaponMath.Damage(b)
		if da ~= db then
			return da > db
		end
		return a.CreatedAt > b.CreatedAt
	end)
	return list
end

-- Скролл с сеткой карточек
function WeaponCard.Grid(parent: Instance, size: UDim2, position: UDim2): ScrollingFrame
	local scroll = C.Make("ScrollingFrame", {
		Size = size,
		Position = position,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = S(6),
		ScrollBarImageColor3 = Theme.Muted,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	})
	C.Make("UIGridLayout", {
		CellSize = UDim2.fromOffset(S(160), S(76)),
		CellPadding = UDim2.fromOffset(S(8), S(8)),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = scroll,
	})
	return scroll
end

function WeaponCard.Clear(scroll: ScrollingFrame)
	for _, child in scroll:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

return WeaponCard
]]></ProtectedString></Properties></Item></Item></Item></Item></Item></roblox>