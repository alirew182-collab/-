			RewardGold = 10,
		},
		{
			Id = "EquipWeapon",
			TitleKey = "Q_EQUIP",
			Event = "WeaponEquipped",
			Count = 1,
			RewardXp = 10,
			RewardGold = 0,
		},
		{
			Id = "VisitMerchant",
			TitleKey = "Q_MERCHANT",
			Event = "MerchantOpened",
			Count = 1,
			TargetTag = "Merchant",
			RewardXp = 10,
			RewardGold = 15,
		},
		{
			Id = "EnterGate",
			TitleKey = "Q_ENTER_GATE",
			Event = "GateEntered",
			Count = 1,
			TargetTag = "GatePortal",
			RewardXp = 20,
			RewardGold = 0,
		},
		{
			Id = "ClearGate",
			TitleKey = "Q_CLEAR_GATE",
			Event = "GateCleared",
			Count = 1,
			RewardXp = 60,
			RewardGold = 50,
		},
	},
}

return Tutorial
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Weapons</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ТИПЫ ОРУЖИЯ.
	Урон = BaseDamage * PowerMult руды * множитель качества * множитель редкости * бонус уровня.
	Arc — косинус половины угла удара (0.3 ≈ широкий взмах, 0.7 ≈ узкий выпад).
	Модель: ServerStorage/WeaponModels/<Id> (Model или BasePart). Если нет — рисуется заглушка размером Size.
]]

export type WeaponDef = {
	Id: string,
	NameKey: string,
	Order: number,
	OreCost: number, -- сколько руды уходит на ковку
	BaseDamage: number,
	AttackCooldown: number,
	Range: number,
	Arc: number,
	MaxTargets: number,
	SellMult: number,
	Size: Vector3,
}

local Weapons: { [string]: WeaponDef } = {
	Sword = {
		Id = "Sword",
		NameKey = "WPN_SWORD",
		Order = 1,
		OreCost = 3,
		BaseDamage = 10,
		AttackCooldown = 0.5,
		Range = 7,
		Arc = 0.3,
		MaxTargets = 3,
		SellMult = 1.0,
		Size = Vector3.new(0.3, 0.6, 4),
	},
	Axe = {
		Id = "Axe",
		NameKey = "WPN_AXE",
		Order = 2,
		OreCost = 4,
		BaseDamage = 16,
		AttackCooldown = 0.8,
		Range = 7,
		Arc = 0.2,
		MaxTargets = 4,
		SellMult = 1.25,
		Size = Vector3.new(0.4, 1.4, 3.4),
	},
	Spear = {
		Id = "Spear",
		NameKey = "WPN_SPEAR",
		Order = 3,
		OreCost = 3,
		BaseDamage = 9,
		AttackCooldown = 0.55,
		Range = 10,
		Arc = 0.7,
		MaxTargets = 2,
		SellMult = 1.0,
		Size = Vector3.new(0.3, 0.3, 6),
	},
}

return Weapons
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	МИР. Если в карте нет ни одного объекта с тегом OreNode, сервер сам строит полный мир
	(Terrain + постройки): город, 4 зоны, озеро, горы по краю. Как только поставишь свои
	объекты с тегами — автопостройка отключится (или выключи AutoBuild вручную).

	Зоны используются и для автопостройки, и для мобов, и для баннера «Ты вошёл в зону».
]]

export type ZoneDef = {
	Id: string,
	NameKey: string,
	Center: Vector3,
	Radius: number,
	Level: number, -- рекомендуемый уровень (баннер)
	Safe: boolean, -- мобы сюда не заходят
	Music: string, -- ключ в Config.Audio
}

export type MobSpawnDef = { Zone: string, Mob: string, Max: number, RespawnSeconds: number }

local World = {
	AutoBuild = true,
	Seed = 1337, -- одинаковый мир при каждом запуске
	Size = 760,
	RemoveDefaultBaseplate = true, -- убрать Baseplate/SpawnLocation шаблона Studio при автопостройке

	Zones = {
		Town = {
			Id = "Town",
			NameKey = "ZONE_TOWN",
			Center = Vector3.new(0, 0, 0),
			Radius = 70,
			Level = 1,
			Safe = true,
			Music = "MusicTown",
		},
		CopperHills = {
			Id = "CopperHills",
			NameKey = "ZONE_COPPER",
			Center = Vector3.new(-200, 0, 20),
			Radius = 100,
			Level = 1,
			Safe = false,
			Music = "MusicWild",
		},
		IronQuarry = {
			Id = "IronQuarry",
			NameKey = "ZONE_QUARRY",
			Center = Vector3.new(10, 0, -210),
			Radius = 100,
			Level = 4,
			Safe = false,
			Music = "MusicWild",
		},
		MoonGrotto = {
			Id = "MoonGrotto",
			NameKey = "ZONE_GROTTO",
			Center = Vector3.new(210, 0, -10),
			Radius = 95,
			Level = 7,
			Safe = false,
			Music = "MusicWild",
		},
		Market = {
			Id = "Market",
			NameKey = "ZONE_MARKET",
			Center = Vector3.new(96, 0, 60),
			Radius = 52,
			Level = 1,
			Safe = true,
			Music = "MusicTown",
		},
		GatePlains = {
			Id = "GatePlains",
			NameKey = "ZONE_PLAINS",
			Center = Vector3.new(0, 0, 210),
			Radius = 105,
			Level = 1,
			Safe = true,
			Music = "MusicGate",
		},
	} :: { [string]: ZoneDef },

	-- Сколько руды ставить в зону при автопостройке
	OreNodes = {
		{ Zone = "CopperHills", OreId = "Copper", Count = 14 },
