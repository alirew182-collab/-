	WalkSpeed: number,
	XpReward: number,
	GoldReward: number,
	Size: Vector3,
	Color: Color3,
	Drops: { Drop }?,
	-- только боссы
	SlamDamage: number?,
	SlamRadius: number?,
	SlamWindup: number?,
	SlamCooldown: number?,
	SlamTriggerRange: number?,
}

