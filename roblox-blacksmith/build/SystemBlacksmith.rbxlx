]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ОБУЧЕНИЕ / КВЕСТЫ СИСТЕМЫ первого захода.
	Event — событие, которое шлют сервисы (OreMined, WeaponForged, WeaponEquipped,
	MerchantOpened, GateEntered, GateCleared). TargetTag — куда рисовать луч-подсказку.
]]

export type TutorialStep = {
	Id: string,
	TitleKey: string,
	Event: string,
	Count: number,
	OreId: string?,
	TargetTag: string?,
	TargetOre: string?,
	RewardXp: number,
	RewardGold: number,
}

local Tutorial: { Steps: { TutorialStep } } = {
	Steps = {
		{
			Id = "MineCopper",
			TitleKey = "Q_MINE_COPPER",
			Event = "OreMined",
