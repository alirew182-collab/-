<roblox version="4"><Item class="Workspace" referent="RBX00000044"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">true</bool></Properties></Item><Item class="ReplicatedStorage" referent="RBX00000045"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000016"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ЕДИНАЯ ТОЧКА ВХОДА В БАЛАНС.
	Все числа игры — в соседних модулях этой папки. Код читает их только через Config.
]]

local Config = {
	Ores = require(script.Ores),
	Pickaxes = require(script.Pickaxes),
	Weapons = require(script.Weapons),
	Rarities = require(script.Rarities),
	Forging = require(script.Forging),
	Leveling = require(script.Leveling),
	Mobs = require(script.Mobs),
	Gates = require(script.Gates),
	Combat = require(script.Combat),
	Economy = require(script.Economy),
	Tutorial = require(script.Tutorial),
	Network = require(script.Network),
	Audio = require(script.Audio),

	Data = {
		StoreName = "PlayerData_v1", -- смена имени = чистый вайп, не трогай без нужды
		SchemaVersion = 1,
	},

	Debug = {
		-- В Studio первый портал появляется через 5 секунд
		StudioFastGates = true,
		-- Выводить в Output события анти-чита
		LogSuspicious = true,
	},

	Tags = {
		OreNode = "OreNode",
		Forge = "Forge",
		Merchant = "Merchant",
		GateSpawn = "GateSpawn",
		GatePortal = "GatePortal",
	},
}

return Config
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Audio</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ЗВУКИ. Вставь сюда ID своих звуков из Creator Store ("rbxassetid://123...").
	Пустая строка = звук отключён (игра работает без звуков).
]]

local Audio: { [string]: string } = {
	SystemOpen = "", -- появление окна Системы
	SystemLevelUp = "",
	SystemQuestDone = "",
	SystemWarning = "",
	SystemBoss = "",
	MineHit = "",
	OreBreak = "",
	ForgePump = "",
	ForgePour = "",
	ForgeHammerPerfect = "",
	ForgeHammerHit = "",
	ForgeHammerMiss = "",
	ForgeDone = "",
	Swing = "",
	HitMob = "",
	Parry = "",
	Coins = "",
	UiClick = "",
}

return Audio
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[--!strict
-- БОЙ: блок, парирование, кулаки (если оружие не надето).

local Combat = {
	BlockDamageReduction = 0.6, -- блок снимает 60% урона
	ParryWindowSeconds = 0.3, -- нажал блок не раньше чем за 0.3с до удара → парирование (0 урона)
	ParryStunSeconds = 1.5, -- моб оглушён после парирования
	BlockToggleCooldown = 0.35, -- защита от спама блоком ради парирования
	BlockWalkSpeed = 8,
	DefaultWalkSpeed = 16,

	Fists = {
		Damage = 3,
		AttackCooldown = 0.6,
		Range = 5,
		Arc = 0.3,
		MaxTargets = 1,
	},

	-- Анимация взмаха (Animation ID из Creator Store / своя). Пусто = без анимации.
	SwingAnimationId = "",

	MobAiTickSeconds = 0.15,
	DamageFxRadius = 150, -- кому показывать цифры урона
}

return Combat
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Economy</string><ProtectedString name="Source"><![CDATA[--!strict
-- ЭКОНОМИКА, ИНВЕНТАРЬ, ДОБЫЧА, ДИСТАНЦИИ.

local Economy = {
	StartingGold = 0,
	StartingPickaxe = "Stone",
	InventoryCapacity = 30, -- слотов под оружие (x2 — геймпасс в Этапе 3)
	WeaponSellBonus = 1.5, -- оружие продаётся дороже, чем руда, из которой сделано
	MaxSellBatch = 50,

	Mining = {
		HitCooldownSeconds = 0.3,
		MaxDistance = 14,
	},

	InteractMaxDistance = 18, -- дистанция до кузни/торговца для действий
}

return Economy
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Forging</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	КОВКА — мини-игра из 3 шагов. Итоговое качество 0–100%.
	Качество = 100 * (Bellows.Weight * счёт_мехов + Pour.Weight * счёт_заливки + Hammer.Weight * счёт_молота)
	Счёт каждого шага 0..1 считает СЕРВЕР из сырых замеров клиента.
]]

local Forging = {
	-- Качество 0% → оружие с уроном x0.7, 100% → x1.3
	QualityMultMin = 0.7,
	QualityMultMax = 1.3,

	SessionTimeoutSeconds = 90, -- сессия ковки протухает
	MinDurationTolerance = 0.85, -- сервер не примет результат быстрее 85% от минимальной длительности мини-игры

	XpBase = 10, -- опыт за ковку = XpBase + OreCost * XpPerOre руды * XpOreFactor
	XpOreFactor = 0.5,

	Bellows = {
		Weight = 0.3,
		DurationSeconds = 4, -- сколько длится шаг
		HeatDecayPerSecond = 0.55, -- насколько остывает горн в секунду (0..1)
		HeatPerPump = 0.16, -- сколько добавляет одно нажатие
		ZoneWidth = 0.22, -- ширина «зелёной зоны»
		ZoneCenterMin = 0.55, -- центр зоны случайный в этом диапазоне
		ZoneCenterMax = 0.75,
		FullScoreFraction = 0.8, -- если в зоне ≥80% времени → 100% счёта
	},

	Pour = {
		Weight = 0.3,
		FillPerSecond = 0.5, -- скорость заполнения формы при удержании
		TargetMin = 0.55, -- целевой уровень — случайный в диапазоне
		TargetMax = 0.85,
		PerfectTolerance = 0.03, -- ближе этого → 100%
		Tolerance = 0.2, -- дальше этого → 0%
		MinSeconds = 0.8, -- минимальная реальная длительность шага
	},

	Hammer = {
		Weight = 0.4,
		Beats = 5,
		IntervalMin = 0.75, -- интервал между ударами (с), случайный
		IntervalMax = 0.95,
		LeadInSeconds = 1.0, -- пауза до первого удара
		PerfectWindow = 0.07, -- ±с для 100%
		HitWindow = 0.25, -- ±с, дальше — промах
	},
}

return Forging
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Gates</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ВРАТА (ДАНЖИ).
	Порталы появляются на Part с тегом "GateSpawn". Новый тип Врат = новая запись в Types.
	Арена: ServerStorage/Arenas/<Arena> (Model, внутри Part с именами "PlayerSpawn" и "MobSpawn").
	Если модели нет — сервер построит простую арену-заглушку.
]]

export type WaveEntry = { Mob: string, Count: number }
export type OreDrop = { OreId: string, Chance: number, Min: number, Max: number }
export type GateTypeDef = {
	Id: string,
	Rank: string,
	NameKey: string,
	RequiredLevel: number,
	SpawnWeight: number,
	Arena: string,
	Waves: { { WaveEntry } },
	Boss: string,
	Rewards: { Gold: number, Xp: number, OreDrops: { OreDrop } },
	PortalColor: Color3,
}

local Gates = {
	FirstSpawnDelaySeconds = 25,
	SpawnIntervalSeconds = 90,
	MaxActivePortals = 2,
	PortalLifetimeSeconds = 240,
	LobbyCountdownSeconds = 20,
	MaxPartySize = 4,
	LobbyLeaveRadius = 60, -- ушёл дальше от портала — вылетаешь из группы
	RunTimeLimitSeconds = 300,
	WaveStartDelaySeconds = 3,
	ReturnDelaySeconds = 6, -- через сколько секунд после победы/поражения вернуть в лобби

	-- Масштаб сложности под группу: +60% HP мобам за каждого игрока сверх первого
	HealthPerExtraPlayer = 0.6,
	-- Бонус опыта за игру в группе: +10% за каждого игрока сверх первого
	PartyXpBonusPerPlayer = 0.1,

	Arena = {
		Origin = Vector3.new(6000, 300, 0), -- далеко от лобби
		SlotSpacing = 800,
		MaxConcurrentRuns = 6,
		FallbackSize = 140,
	},

	Types = {
		E = {
			Id = "E",
			Rank = "E",
			NameKey = "GATE_E",
			RequiredLevel = 1,
			SpawnWeight = 1,
			Arena = "GateArena",
			Waves = {
				{ { Mob = "Ashling", Count = 4 } },
				{ { Mob = "Ashling", Count = 3 }, { Mob = "CinderHound", Count = 2 } },
			},
			Boss = "CinderWarden",
			Rewards = {
				Gold = 60,
				Xp = 150,
				OreDrops = {
					{ OreId = "Copper", Chance = 1.0, Min = 2, Max = 4 },
					{ OreId = "Iron", Chance = 0.6, Min = 1, Max = 3 },
					{ OreId = "Moonsilver", Chance = 0.12, Min = 1, Max = 1 },
				},
			},
			PortalColor = Color3.fromRGB(60, 170, 255),
		},
	} :: { [string]: GateTypeDef },
}

return Gates
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Leveling</string><ProtectedString name="Source"><![CDATA[--!strict
-- УРОВНИ. Опыт до следующего уровня = floor(XpBase * level ^ XpExponent).

local Leveling = {
	MaxLevel = 100,
	XpBase = 40,
	XpExponent = 1.45,

	BaseHealth = 100,
	HealthPerLevel = 6,
	DamagePerLevel = 0.03, -- +3% урона за уровень

	-- Ранг пока только визуальный (испытания рангов — Этап 2)
	StartingRank = "F",
}

return Leveling
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Mobs</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	МОБЫ И БОССЫ.
	Модель: ServerStorage/Mobs/<Id> — Model с Humanoid и HumanoidRootPart.
	Если модели нет — сервер соберёт блок-заглушку размером Size и цветом Color.
]]

export type MobDef = {
	Id: string,
	NameKey: string,
	IsBoss: boolean,
	MaxHealth: number,
	Damage: number,
	AttackRange: number,
	AttackCooldown: number,
	WindupSeconds: number, -- «замах» перед ударом: окно для блока/парирования
	WalkSpeed: number,
	XpReward: number,
	GoldReward: number,
	Size: Vector3,
	Color: Color3,
	-- только боссы
	SlamDamage: number?,
	SlamRadius: number?,
	SlamWindup: number?,
	SlamCooldown: number?,
	SlamTriggerRange: number?,
}

local Mobs: { [string]: MobDef } = {
	Ashling = {
		Id = "Ashling",
		NameKey = "MOB_ASHLING",
		IsBoss = false,
		MaxHealth = 40,
		Damage = 6,
		AttackRange = 5,
		AttackCooldown = 1.6,
		WindupSeconds = 0.5,
		WalkSpeed = 12,
		XpReward = 8,
		GoldReward = 3,
		Size = Vector3.new(2, 3, 2),
		Color = Color3.fromRGB(90, 70, 70),
	},
	CinderHound = {
		Id = "CinderHound",
		NameKey = "MOB_CINDERHOUND",
		IsBoss = false,
		MaxHealth = 70,
		Damage = 9,
		AttackRange = 5.5,
		AttackCooldown = 1.4,
		WindupSeconds = 0.45,
		WalkSpeed = 15,
		XpReward = 14,
		GoldReward = 5,
		Size = Vector3.new(2.5, 2.5, 4),
		Color = Color3.fromRGB(150, 60, 30),
	},
	CinderWarden = {
		Id = "CinderWarden",
		NameKey = "MOB_CINDERWARDEN",
		IsBoss = true,
		MaxHealth = 900,
		Damage = 14,
		AttackRange = 8,
		AttackCooldown = 2.2,
		WindupSeconds = 0.7,
		WalkSpeed = 10,
		XpReward = 120,
		GoldReward = 40,
		Size = Vector3.new(6, 9, 5),
		Color = Color3.fromRGB(60, 30, 25),
		SlamDamage = 28,
		SlamRadius = 13,
		SlamWindup = 1.3,
		SlamCooldown = 8,
		SlamTriggerRange = 18,
	},
}

return Mobs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Network</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	RATE-LIMIT на все Remote: token bucket на игрока.
	PerSecond — скорость восстановления токенов, Burst — максимум подряд.
	Remote без записи получают Default.
]]

export type Limit = { PerSecond: number, Burst: number }

local Network: { Default: Limit, Limits: { [string]: Limit } } = {
	Default = { PerSecond = 2, Burst = 4 },
	Limits = {
		RequestData = { PerSecond = 0.5, Burst = 3 },
		CombatAttack = { PerSecond = 8, Burst = 10 },
		CombatBlock = { PerSecond = 6, Burst = 8 },
		ForgeStart = { PerSecond = 1, Burst = 3 },
		ForgeSubmit = { PerSecond = 1, Burst = 3 },
		ForgeCancel = { PerSecond = 2, Burst = 4 },
		EquipWeapon = { PerSecond = 3, Burst = 5 },
		EquipPickaxe = { PerSecond = 2, Burst = 4 },
		SellWeapons = { PerSecond = 2, Burst = 4 },
		SellOres = { PerSecond = 3, Burst = 6 },
		BuyPickaxe = { PerSecond = 1, Burst = 3 },
		SetLanguage = { PerSecond = 0.5, Burst = 2 },
		GateStart = { PerSecond = 1, Burst = 2 },
		GateLeave = { PerSecond = 1, Burst = 2 },
	},
}

return Network
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Ores</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	РУДЫ.
	Новая руда = новая запись здесь + в карте Part с тегом "OreNode" и атрибутом OreId = "<Id>".
	Названия берутся из таблицы локализации по ключу NameKey.
]]

export type OreDef = {
	Id: string,
	NameKey: string,
	Order: number, -- порядок в интерфейсе
	RequiredLevel: number, -- уровень игрока для добычи и ковки
	RequiredPickaxeTier: number, -- минимальный тир кирки
	NodeHealth: number, -- сколько «силы добычи» нужно, чтобы разбить жилу
	YieldMin: number,
	YieldMax: number,
	RespawnSeconds: number,
	XpPerOre: number,
	SellPrice: number, -- цена 1 руды у торговца
	PowerMult: number, -- множитель урона оружия из этой руды
	Color: Color3,
	Material: Enum.Material,
}

local Ores: { [string]: OreDef } = {
	Copper = {
		Id = "Copper",
		NameKey = "ORE_COPPER",
		Order = 1,
		RequiredLevel = 1,
		RequiredPickaxeTier = 1,
