--[[
	ЭФФЕКТЫ: всплывающие цифры урона, «ПАРИРОВАНИЕ!», искры добычи, вспышка экрана при попадании.
	Всё через пулы объектов (никаких Instance.new на каждый удар) — важно для слабых телефонов.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Localization = require(ReplicatedStorage.Shared.Localization)
local Net = require(ReplicatedStorage.Shared.Net)
local Sound = require(script.Parent.Parent.UI.Sound)
local Theme = require(script.Parent.Parent.UI.Theme)
local UIController = require(script.Parent.UIController)

local FxController = {}

local POOL_SIZE = 14
local PARTICLE_POOL = 6

type Popup = { Attachment: Attachment, Gui: BillboardGui, Label: TextLabel }
local popups: { Popup } = {}
local popupIndex = 0

type Burst = { Attachment: Attachment, Emitter: ParticleEmitter }
local bursts: { Burst } = {}
local burstIndex = 0

local function build()
	local terrain = workspace.Terrain
	for i = 1, POOL_SIZE do
		local attachment = Instance.new("Attachment")
		attachment.Name = "FxPopup" .. i
		attachment.Parent = terrain
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(160, 50)
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		gui.MaxDistance = 120
		gui.Adornee = attachment
		gui.Enabled = false
		gui.Parent = attachment
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Theme.FontTitle
		label.TextScaled = true
		label.TextStrokeTransparency = 0.2
		label.Parent = gui
		table.insert(popups, { Attachment = attachment, Gui = gui, Label = label })
	end
	for i = 1, PARTICLE_POOL do
		local attachment = Instance.new("Attachment")
		attachment.Name = "FxBurst" .. i
		attachment.Parent = terrain
		local emitter = Instance.new("ParticleEmitter")
		emitter.Enabled = false
		emitter.Lifetime = NumberRange.new(0.3, 0.6)
		emitter.Speed = NumberRange.new(8, 16)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = NumberSequence.new(0.35, 0)
		emitter.LightEmission = 1
		emitter.Acceleration = Vector3.new(0, -30, 0)
		emitter.Parent = attachment
		table.insert(bursts, { Attachment = attachment, Emitter = emitter })
	end
end

local function popup(position: Vector3, text: string, color: Color3, big: boolean?)
	popupIndex = popupIndex % POOL_SIZE + 1
	local p = popups[popupIndex]
	local offset = Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1)
	p.Attachment.WorldPosition = position + offset
	p.Label.Text = text
	p.Label.TextColor3 = color
	p.Label.TextTransparency = 0
	p.Label.TextStrokeTransparency = 0.2
	p.Gui.Size = if big then UDim2.fromOffset(220, 64) else UDim2.fromOffset(120, 40)
	p.Gui.StudsOffsetWorldSpace = Vector3.zero
	p.Gui.Enabled = true
	local info = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(p.Gui, info, { StudsOffsetWorldSpace = Vector3.new(0, 3, 0) }):Play()
	local fade = TweenService:Create(p.Label, TweenInfo.new(0.35, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.45), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})
	fade:Play()
	local gui = p.Gui
	local label = p.Label
	task.delay(0.85, function()
		if label.Text == text and label.TextTransparency >= 0.99 then
			gui.Enabled = false
		end
	end)
end

local function burst(position: Vector3, color: Color3, count: number)
	burstIndex = burstIndex % PARTICLE_POOL + 1
	local b = bursts[burstIndex]
	b.Attachment.WorldPosition = position
	b.Emitter.Color = ColorSequence.new(color)
	b.Emitter:Emit(count)
end

local function onFx(payload: { [string]: any })
	local kind = payload.Kind
	local position = payload.Position
	if typeof(position) ~= "Vector3" then
		return
	end
	local localId = Players.LocalPlayer.UserId

	if kind == "Damage" then
		local mine = payload.ByUserId == localId
		popup(position, tostring(payload.Amount), if mine then Theme.Gold else Theme.Text, false)
		burst(position, Color3.fromRGB(255, 220, 160), 6)
		if mine then
			Sound.Play("HitMob", 0.5, 0.9 + math.random() * 0.2)
		end
	elseif kind == "PlayerHit" then
		local isMe = payload.UserId == localId
		if payload.Result == "parry" then
			popup(position + Vector3.new(0, 2, 0), Localization.Get("FX_PARRY"), Theme.Accent, true)
			burst(position, Theme.Accent, 20)
			if isMe then
				Sound.Play("Parry")
			end
		elseif payload.Result == "block" then
			popup(position + Vector3.new(0, 2, 0), `{Localization.Get("FX_BLOCK")} -{payload.Amount}`, Theme.TextDim, false)
			if isMe then
				UIController:FlashHit(0.2)
			end
		else
			popup(position + Vector3.new(0, 2, 0), `-{payload.Amount}`, Theme.Danger, false)
			if isMe then
				UIController:FlashHit(0.5)
			end
		end
	elseif kind == "MineHit" then
		local color = if typeof(payload.Color) == "Color3" then payload.Color else Color3.new(1, 1, 1)
		burst(position, color, 8)
		Sound.Play("MineHit", 0.5, 0.9 + (payload.Progress or 0) * 0.3)
	elseif kind == "OreBreak" then
		local color = if typeof(payload.Color) == "Color3" then payload.Color else Color3.new(1, 1, 1)
		burst(position, color, 25)
		Sound.Play("OreBreak")
	elseif kind == "MobDeath" then
		burst(position, Color3.fromRGB(255, 120, 60), if payload.Boss then 60 else 20)
	elseif kind == "Slam" then
		burst(position, Theme.Danger, 40)
	end
end

function FxController:Start()
	build()
	Net.UnreliableEvent("Fx").OnClientEvent:Connect(function(payload)
		if type(payload) == "table" then
			onFx(payload)
		end
	end)
end

return FxController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">GateController</string><ProtectedString name="Source"><![CDATA[--!strict
-- ВРАТА на клиенте: карточка группы (ожидание старта) и забега (волна, время, босс).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Format = require(ReplicatedStorage.Shared.Format)
local Localization = require(ReplicatedStorage.Shared.Localization)
local Net = require(ReplicatedStorage.Shared.Net)
local C = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)
local UIController = require(script.Parent.UIController)

local S = Theme.S

local GateController = {}

local card: Frame
local line1: TextLabel
local line2: TextLabel
local startButton: TextButton
local bossFrame: Frame
local bossName: TextLabel
local bossFill: Frame

local state: { [string]: any } = { Phase = "none" }
local deadline: number? = nil -- os.clock(), когда таймер дойдёт до 0

local function render()
	local phase = state.Phase
	card.Visible = phase == "lobby" or phase == "run"
	bossFrame.Visible = phase == "run" and state.Boss ~= nil
	if phase == "lobby" then
		C.Bind(line1, "UI_GATE_LOBBY", { gate = "@" .. state.GateNameKey, count = state.Count, max = state.Max })
		startButton.Visible = state.IsLeader == true
	elseif phase == "run" then
		if state.BossPhase then
			C.Bind(line1, "UI_GATE_BOSS")
		else
			C.Bind(line1, "UI_GATE_WAVE", { wave = state.Wave, total = state.TotalWaves })
		end
		startButton.Visible = false
		local boss = state.Boss
		if boss then
			C.Bind(bossName, boss.NameKey)
			bossFill.Size = UDim2.fromScale(math.clamp(boss.Health / boss.MaxHealth, 0, 1), 1)
		end
	end
end

local function updateTimer()
	if not card.Visible or not deadline then
		return
	end
	local left = math.max(0, deadline - os.clock())
	if state.Phase == "lobby" then
		C.Bind(line2, "UI_GATE_STARTS_IN", { time = Format.Time(left) })
	else
		local alive = Localization.Get("UI_GATE_ALIVE", { alive = state.Alive or 0, total = state.Total or 0 })
		C.SetRaw(line2, `{Format.Time(left)}   ·   {alive}`)
	end
end

local function build()
	local hud = UIController.Layers.Hud
	card = C.Panel({
		Name = "GateCard",
		Size = UDim2.fromOffset(S(300), S(66)),
		Position = UDim2.new(0.5, 0, 0, S(8)),
		AnchorPoint = Vector2.new(0.5, 0),
		Transparency = 0.15,
		Visible = false,
		Parent = hud,
	})
	line1 = C.Text({
		Font = Theme.FontBold,
		TextSize = 15,
		Size = UDim2.new(1, -S(100), 0, S(22)),
		Position = UDim2.fromOffset(S(10), S(8)),
		Parent = card,
	})
	line2 = C.Text({
		TextSize = 13,
		Color = Theme.TextDim,
		Size = UDim2.new(1, -S(100), 0, S(20)),
		Position = UDim2.fromOffset(S(10), S(34)),
		Parent = card,
	})
	C.Button({
		Key = "UI_GATE_LEAVE",
		TextSize = 13,
		Size = UDim2.fromOffset(S(80), S(26)),
		Position = UDim2.new(1, -S(8), 0, S(6)),
		AnchorPoint = Vector2.new(1, 0),
		Color = Theme.PanelLight,
		OnClick = function()
			Net.Event("GateLeave"):FireServer()
		end,
		Parent = card,
	})
	startButton = C.Button({
		Key = "UI_GATE_START",
		TextSize = 13,
		Size = UDim2.fromOffset(S(80), S(26)),
		Position = UDim2.new(1, -S(8), 1, -S(6)),
		AnchorPoint = Vector2.new(1, 1),
		Color = Theme.Success,
		TextColor = Theme.Bg,
		Visible = false,
		OnClick = function()
			Net.Event("GateStart"):FireServer()
		end,
		Parent = card,
	})

	bossFrame = C.Make("Frame", {
		Name = "BossBar",
		Size = UDim2.fromOffset(S(360), S(34)),
		Position = UDim2.new(0.5, 0, 0, S(80)),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = hud,
	})
	bossName = C.Text({
		Font = Theme.FontTitle,
		TextSize = 14,
		Color = Theme.Danger,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, S(16)),
		Parent = bossFrame,
	})
	local _, fill = C.Bar({
		Size = UDim2.new(1, 0, 0, S(12)),
		Position = UDim2.fromOffset(0, S(18)),
		Color = Theme.Danger,
		Value = 1,
		Parent = bossFrame,
	})
	bossFill = fill
end

function GateController:Start()
	build()
	Net.Event("GateState").OnClientEvent:Connect(function(payload: { [string]: any })
		state = payload
		if payload.Phase == "lobby" then
			deadline = if payload.StartsIn then os.clock() + payload.StartsIn else nil
		elseif payload.Phase == "run" then
			deadline = os.clock() + (payload.TimeLeft or 0)
		else
			deadline = nil
		end
		render()
		updateTimer()
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.25 then
			acc = 0
			updateTimer()
		end
	end)
end

return GateController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">HudController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	HUD: ранг, уровень, полоса опыта, золото, кнопка языка (слева сверху),
	кнопка инвентаря (справа по центру — не мешает стику и прыжку на телефоне).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local WeaponMath = require(ReplicatedStorage.Shared.WeaponMath)
local C = require(script.Parent.Parent.UI.Components)
local Sound = require(script.Parent.Parent.UI.Sound)
local Theme = require(script.Parent.Parent.UI.Theme)
local DataController = require(script.Parent.DataController)
local LocalizationController = require(script.Parent.LocalizationController)
local UIController = require(script.Parent.UIController)

local S = Theme.S

local HudController = {}

local rankLabel: TextLabel
local levelLabel: TextLabel
local xpFill: Frame
local xpLabel: TextLabel
local goldLabel: TextLabel
local inventoryButton: TextButton
local pulseTween: Tween? = nil
local lastGold = -1

local function refresh()
	local data = DataController:Get()
	if not data then
		return
	end
	C.SetRaw(rankLabel, data.Rank or "F")
	C.Bind(levelLabel, "UI_LEVEL", { level = data.Level })
	if data.Level >= Config.Leveling.MaxLevel then
		xpFill.Size = UDim2.fromScale(1, 1)
		C.Bind(xpLabel, "UI_MAX_LEVEL")
	else
		local need = WeaponMath.XpToNext(data.Level)
		TweenService:Create(xpFill, TweenInfo.new(0.3), { Size = UDim2.fromScale(math.clamp(data.Xp / need, 0, 1), 1) })
			:Play()
		C.Bind(xpLabel, "UI_XP", { xp = Format.Short(data.Xp), need = Format.Short(need) })
	end
	C.SetRaw(goldLabel, Format.Short(data.Gold))
	if lastGold >= 0 and data.Gold > lastGold then
		Sound.Play("Coins", 0.4)
		goldLabel.TextSize = S(22)
		TweenService:Create(goldLabel, TweenInfo.new(0.25), { TextSize = S(17) }):Play()
	end
	lastGold = data.Gold
end

local function build()
	local hud = UIController.Layers.Hud

	-- ===== левый верхний блок =====
	local top = C.Panel({
		Name = "TopLeft",
		Size = UDim2.fromOffset(S(250), S(84)),
		Position = UDim2.fromOffset(S(10), S(8)),
		AnchorPoint = Vector2.zero,
		Transparency = 0.2,
		Parent = hud,
	})

	local badge = C.Make("Frame", {
		Name = "RankBadge",
		Size = UDim2.fromOffset(S(46), S(46)),
		Position = UDim2.fromOffset(S(8), S(8)),
		BackgroundColor3 = Theme.Bg,
		Parent = top,
	})
	C.Corner(badge, 6)
	C.Stroke(badge, Theme.Accent, 2)
	rankLabel = C.Text({
		Font = Theme.FontTitle,
		TextSize = 30,
		Color = Theme.Accent,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Text = "F",
		Parent = badge,
	})

	levelLabel = C.Text({
		Font = Theme.FontTitle,
		TextSize = 18,
		Size = UDim2.new(1, -S(66), 0, S(20)),
		Position = UDim2.fromOffset(S(62), S(6)),
		Parent = top,
	})
	local _, fill = C.Bar({
		Size = UDim2.new(1, -S(72), 0, S(10)),
		Position = UDim2.fromOffset(S(62), S(29)),
		Parent = top,
	})
	xpFill = fill
	xpLabel = C.Text({
		TextSize = 12,
		Color = Theme.TextDim,
		Size = UDim2.new(1, -S(66), 0, S(14)),
		Position = UDim2.fromOffset(S(62), S(41)),
		Parent = top,
	})

	-- золото
	local goldIcon = C.Make("Frame", {
		Size = UDim2.fromOffset(S(16), S(16)),
		Position = UDim2.fromOffset(S(10), S(62)),
		BackgroundColor3 = Theme.Gold,
		Parent = top,
	})
	C.Round(goldIcon)
	goldLabel = C.Text({
		Font = Theme.FontBold,
		TextSize = 17,
		Color = Theme.Gold,
		Size = UDim2.fromOffset(S(120), S(20)),
		Position = UDim2.fromOffset(S(32), S(60)),
		Text = "0",
		Parent = top,
	})

	-- язык
	C.Button({
		Name = "Language",
		Key = "UI_LANG",
		TextSize = 14,
		Size = UDim2.fromOffset(S(46), S(26)),
		Position = UDim2.new(1, -S(8), 0, S(56)),
		AnchorPoint = Vector2.new(1, 0),
		Color = Theme.PanelLight,
		OnClick = function()
			LocalizationController:Toggle()
		end,
		Parent = top,
	})

	-- ===== кнопка инвентаря =====
	inventoryButton = C.Button({
		Name = "Inventory",
		Key = "UI_INVENTORY",
		TextSize = 13,
		Size = UDim2.fromOffset(S(84), S(60)),
		Position = UDim2.new(1, -S(10), 0.5, -S(40)),
		AnchorPoint = Vector2.new(1, 0.5),
		Color = Theme.Panel,
		Transparency = 0.1,
		OnClick = function()
			UIController:TogglePanel("Inventory")
		end,
		Parent = hud,
	})
end

-- Пульсация кнопки инвентаря (подсказка обучения «надень оружие»)
function HudController:SetInventoryPulse(enabled: boolean)
	if pulseTween then
		pulseTween:Cancel()
		pulseTween = nil
	end
	local stroke = inventoryButton:FindFirstChildOfClass("UIStroke")
	if not stroke then
		return
	end
	if enabled then
		stroke.Color = Theme.Gold
		stroke.Thickness = S(3)
		local tween = TweenService:Create(
			stroke,
			TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Transparency = 0.8 }
		)
		tween:Play()
		pulseTween = tween
	else
		stroke.Color = Theme.Accent
		stroke.Thickness = S(1.5)
		stroke.Transparency = 0.25
	end
end

function HudController:Start()
	build()
	DataController.Changed:Connect(function(key: string)
		if key == "*" or key == "Level" or key == "Xp" or key == "Gold" or key == "Rank" then
			refresh()
		end
	end)
	refresh()
end

return HudController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000037"><Properties><string name="Name">InventoryController</string><ProtectedString name="Source"><![CDATA[--!strict
-- ИНВЕНТАРЬ: руда, кирки, оружие. Тап по карточке — надеть оружие.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Localization = require(ReplicatedStorage.Shared.Localization)
local C = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)
local WeaponCard = require(script.Parent.Parent.UI.WeaponCard)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local S = Theme.S

local InventoryController = {}

local panel: Frame
local slotsLabel: TextLabel
local sideList: Frame
local grid: ScrollingFrame
local emptyLabel: TextLabel

local function sortedIds(tbl: { [string]: any }): { string }
	local ids = {}
	for id in tbl do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		return tbl[a].Order < tbl[b].Order
	end)
	return ids
end

local function refresh()
	local data = DataController:Get()
	if not data or not panel.Visible then
		return
	end

	-- слева: руда и кирки
	for _, child in sideList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end
	C.Text({ Key = "UI_ORES", Font = Theme.FontBold, TextSize = 13, Color = Theme.Accent, Size = UDim2.new(1, 0, 0, S(18)), LayoutOrder = nextOrder(), Parent = sideList })
	for _, id in sortedIds(Config.Ores) do
		C.Text({
			Key = "UI_ORE_COUNT",
			Args = { ore = "@" .. Config.Ores[id].NameKey, count = data.Ores[id] or 0 },
			TextSize = 13,
			Size = UDim2.new(1, 0, 0, S(18)),
			LayoutOrder = nextOrder(),
			Parent = sideList,
		})
	end
	C.Text({ Key = "UI_PICKAXES", Font = Theme.FontBold, TextSize = 13, Color = Theme.Accent, Size = UDim2.new(1, 0, 0, S(22)), AlignY = Enum.TextYAlignment.Bottom, LayoutOrder = nextOrder(), Parent = sideList })
	for _, id in sortedIds(Config.Pickaxes) do
		if data.OwnedPickaxes[id] then
			local def = Config.Pickaxes[id]
			local equipped = data.Pickaxe == id
			C.Button({
				Text = `{Localization.Get(def.NameKey)} · {Localization.Get("UI_POWER", { value = def.Power })}`,
				TextSize = 12,
				Size = UDim2.new(1, 0, 0, S(34)),
				Color = if equipped then Theme.AccentDim else Theme.PanelLight,
				StrokeColor = if equipped then Theme.Gold else Theme.Accent,
				LayoutOrder = nextOrder(),
				OnClick = function()
					if not equipped then
						UIController:Handle(UIController:Invoke("EquipPickaxe", id))
					end
				end,
				Parent = sideList,
			})
		end
	end

	-- справа: оружие
	WeaponCard.Clear(grid)
	local list = WeaponCard.Sorted(data.Weapons)
	C.Bind(slotsLabel, "UI_SLOTS", { count = #list, max = Config.Economy.InventoryCapacity })
	emptyLabel.Visible = #list == 0
	for i, weapon in list do
		local equipped = data.EquippedWeapon == weapon.Id
		WeaponCard.Create({
			Weapon = weapon,
			Equipped = equipped,
			LayoutOrder = i,
			Parent = grid,
			OnClick = function()
				if equipped then
					return
				end
				local result = UIController:Invoke("EquipWeapon", weapon.Id)
				if UIController:Handle(result) then
					UIController:Toast("TOAST_EQUIPPED", { item = `@WEAPON:{weapon.Type}:{weapon.Ore}` }, "success")
				end
			end,
		})
	end
end

local function build()
	panel = C.Panel({ Name = "InventoryPanel", Size = UDim2.fromOffset(S(540), S(330)) })
	C.TitleBar(panel, "UI_INVENTORY", function()
		UIController:ClosePanel()
	end)
	slotsLabel = C.Text({
		TextSize = 14,
		Color = Theme.TextDim,
		AlignX = Enum.TextXAlignment.Right,
		Size = UDim2.fromOffset(S(80), S(34)),
		Position = UDim2.new(1, -S(56), 0, S(6)),
		AnchorPoint = Vector2.new(1, 0),
		Parent = panel,
	})

	sideList = C.Make("ScrollingFrame", {
		Size = UDim2.new(0, S(170), 1, -S(60)),
		Position = UDim2.fromOffset(S(12), S(48)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = S(4),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = panel,
	})
	C.List(sideList, Enum.FillDirection.Vertical, 4)

	grid = WeaponCard.Grid(panel, UDim2.new(1, -S(202), 1, -S(60)), UDim2.fromOffset(S(192), S(48)))
	emptyLabel = C.Text({
		Key = "UI_EMPTY_INV",
		TextSize = 15,
		Color = Theme.TextDim,
		Wrapped = true,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -S(202), 0, S(60)),
		Position = UDim2.fromOffset(S(192), S(120)),
		Visible = false,
		Parent = panel,
	})
end

function InventoryController:Start()
	build()
	UIController:RegisterPanel("Inventory", {
		Frame = panel,
		OnOpen = refresh,
	})
	DataController.Changed:Connect(function(key: string)
		if
			key == "*"
			or key == "Weapons"
			or key == "EquippedWeapon"
			or key == "Ores"
			or key == "Pickaxe"
			or key == "OwnedPickaxes"
		then
			refresh()
		end
	end)
	Localization.Changed:Connect(refresh)
end

return InventoryController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">LocalizationController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Выбор языка: сохранённый в профиле → иначе язык аккаунта Roblox (RU для русскоязычных) → EN.
	Переводит ProximityPrompt по атрибутам ActionKey/ObjectKey, которые ставит сервер.
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Localization = require(ReplicatedStorage.Shared.Localization)
local Net = require(ReplicatedStorage.Shared.Net)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local LocalizationController = {}

local function localizePrompt(prompt: ProximityPrompt)
	local action = prompt:GetAttribute("ActionKey")
	local object = prompt:GetAttribute("ObjectKey")
	if type(action) == "string" then
		prompt.ActionText = Localization.Get(action)
	end
	if type(object) == "string" then
		prompt.ObjectText = Localization.Get(object)
	end
end

function LocalizationController:Init()
	-- до загрузки данных — язык аккаунта, чтобы первый экран был понятен
	Localization.SetLanguage(Localization.Detect(Players.LocalPlayer.LocaleId))
end

function LocalizationController:Start()
	ProximityPromptService.PromptShown:Connect(function(prompt)
		localizePrompt(prompt)
	end)

	task.spawn(function()
		local data = DataController:WaitForData()
		local saved = data.Settings and data.Settings.Language
		if type(saved) == "string" and Localization.IsSupported(saved) then
			Localization.SetLanguage(saved)
		end
	end)
end

function LocalizationController:Toggle()
	local list = Localization.Supported
	local index = table.find(list, Localization.GetLanguage()) or 1
	local nextLang = list[(index % #list) + 1]
	Localization.SetLanguage(nextLang)
	Net.Event("SetLanguage"):FireServer(nextLang)
	UIController:Toast("TOAST_LANG")
end

return LocalizationController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">MerchantController</string><ProtectedString name="Source"><![CDATA[--!strict
-- ТОРГОВЕЦ: продать оружие (выбор нескольких + подтверждение), продать руду, купить кирки.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Localization = require(ReplicatedStorage.Shared.Localization)
local WeaponMath = require(ReplicatedStorage.Shared.WeaponMath)
local C = require(script.Parent.Parent.UI.Components)
local Sound = require(script.Parent.Parent.UI.Sound)
local Theme = require(script.Parent.Parent.UI.Theme)
local WeaponCard = require(script.Parent.Parent.UI.WeaponCard)
local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local S = Theme.S

local MerchantController = {}

local panel: Frame
local tabButtons: { [string]: TextButton } = {}
local tabFrames: { [string]: Frame } = {}
local currentTab = "Weapons"
local selected: { [string]: boolean } = {}
local confirmUntil = 0

local weaponGrid: ScrollingFrame
local sellButton: TextButton
local oreList: ScrollingFrame
local pickList: ScrollingFrame

local function sortedIds(tbl: { [string]: any }): { string }
	local ids = {}
	for id in tbl do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		return tbl[a].Order < tbl[b].Order
	end)
	return ids
end

local function clear(frame: Instance)
	for _, child in frame:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function selectedTotal(data: any): (number, number)
	local gold, count = 0, 0
	for id in selected do
		local w = data.Weapons[id]
		if w then
			gold += WeaponMath.SellPrice(w)
			count += 1
		end
	end
	return gold, count
end

local function refreshSellButton(data: any)
	local gold, count = selectedTotal(data)
	if count == 0 then
		C.Bind(sellButton, "UI_SELL_NOTHING")
		sellButton.BackgroundColor3 = Theme.Disabled
	elseif os.clock() < confirmUntil then
		C.Bind(sellButton, "UI_CONFIRM")
		sellButton.BackgroundColor3 = Theme.Danger
	else
		C.Bind(sellButton, "UI_SELL_SELECTED", { gold = gold })
		sellButton.BackgroundColor3 = Theme.Gold
	end
end

local function refreshWeapons(data: any)
	WeaponCard.Clear(weaponGrid)
	-- выбросить из выбора то, чего больше нет
	for id in selected do
		if not data.Weapons[id] or data.EquippedWeapon == id then
			selected[id] = nil
		end
	end
	for i, weapon in WeaponCard.Sorted(data.Weapons) do
		local equipped = data.EquippedWeapon == weapon.Id
		WeaponCard.Create({
			Weapon = weapon,
			Equipped = equipped,
			Selected = selected[weapon.Id] == true,
			ShowPrice = true,
			LayoutOrder = i,
			Parent = weaponGrid,
			OnClick = function()
				if equipped then
					UIController:Toast("ERR_EQUIPPED", nil, "error")
					return
				end
				selected[weapon.Id] = if selected[weapon.Id] then nil else true
				confirmUntil = 0
				refreshWeapons(DataController:Get())
			end,
		})
	end
	refreshSellButton(data)
end

local function row(parent: Instance, order: number): Frame
	local frame = C.Make("Frame", {
		Size = UDim2.new(1, -S(8), 0, S(46)),
		BackgroundColor3 = Theme.PanelLight,
		BackgroundTransparency = 0.2,
		LayoutOrder = order,
		Parent = parent,
	})
	C.Corner(frame, 6)
	return frame
end

local function refreshOres(data: any)
	clear(oreList)
	for i, id in sortedIds(Config.Ores) do
		local ore = Config.Ores[id]
		local count = data.Ores[id] or 0
		local r = row(oreList, i)
		C.Text({
			Key = "UI_ORE_COUNT",
			Args = { ore = "@" .. ore.NameKey, count = count },
			Font = Theme.FontBold,
			TextSize = 14,
			Size = UDim2.new(0.45, 0, 1, 0),
			Position = UDim2.fromOffset(S(10), 0),
			Parent = r,
		})
		C.Text({
			Key = "UI_PRICE",
			Args = { gold = ore.SellPrice },
			TextSize = 12,
			Color = Theme.Gold,
			Size = UDim2.new(0.2, 0, 1, 0),
			Position = UDim2.fromScale(0.42, 0),
			Parent = r,
		})
		local function sell(amount: number)
			local result = UIController:Invoke("SellOres", id, amount)
			if UIController:Handle(result) then
				Sound.Play("Coins")
				UIController:Toast("TOAST_SOLD", { count = result.count, gold = result.gold }, "gold")
			end
		end
		C.Button({
			Key = "UI_SELL_ONE",
			TextSize = 12,
			Size = UDim2.new(0.17, 0, 0, S(36)),
			Position = UDim2.new(0.63, 0, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Color = if count > 0 then Theme.AccentDim else Theme.Disabled,
			OnClick = function()
				if count > 0 then
					sell(1)
				end
			end,
			Parent = r,
		})
		C.Button({
			Key = "UI_SELL_ALL",
			TextSize = 12,
			Size = UDim2.new(0.17, 0, 0, S(36)),
			Position = UDim2.new(1, -S(6), 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Color = if count > 0 then Theme.AccentDim else Theme.Disabled,
			OnClick = function()
				if count > 0 then
					sell(count)
				end
			end,
			Parent = r,
		})
	end
end

local function refreshPickaxes(data: any)
	clear(pickList)
	for i, id in sortedIds(Config.Pickaxes) do
		local def = Config.Pickaxes[id]
		local owned = data.OwnedPickaxes[id] == true
		local r = row(pickList, i)
		C.Text({
			Text = `{Localization.Get(def.NameKey)} · {Localization.Get("UI_POWER", { value = def.Power })}`,
			Font = Theme.FontBold,
			TextSize = 14,
			Size = UDim2.new(0.6, 0, 1, 0),
			Position = UDim2.fromOffset(S(10), 0),
			Parent = r,
		})
		local key, args, color
		if owned then
			key, args, color = "UI_OWNED", nil, Theme.Disabled
		elseif data.Level < def.RequiredLevel then
			key, args, color = "UI_REQ_LEVEL", { level = def.RequiredLevel }, Theme.Disabled
		else
			key, args, color = "UI_BUY", { price = def.Price }, if data.Gold >= def.Price then Theme.Gold else Theme.Disabled
		end
		C.Button({
			Key = key,
			Args = args,
			TextSize = 13,
			TextColor = if color == Theme.Gold then Theme.Bg else Theme.Text,
			Size = UDim2.new(0.34, 0, 0, S(36)),
			Position = UDim2.new(1, -S(6), 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Color = color,
			OnClick = function()
				if owned then
					return
				end
				local result = UIController:Invoke("BuyPickaxe", id)
				if UIController:Handle(result) then
					Sound.Play("Coins")
					UIController:Toast("TOAST_BOUGHT", { item = "@" .. def.NameKey }, "success")
				end
			end,
			Parent = r,
		})
	end
end

local function refresh()
	local data = DataController:Get()
	if not data or not panel.Visible then
		return
	end
	for name, button in tabButtons do
		local active = name == currentTab
		button.BackgroundColor3 = if active then Theme.Accent else Theme.PanelLight
		button.TextColor3 = if active then Theme.Bg else Theme.Text
		tabFrames[name].Visible = active
	end
	if currentTab == "Weapons" then
		refreshWeapons(data)
	elseif currentTab == "Ores" then
		refreshOres(data)
	else
		refreshPickaxes(data)
	end
end

local function sellSelected()
	local data = DataController:Get()
	if not data then
		return
	end
	local ids = {}
	for id in selected do
		table.insert(ids, id)
	end
	if #ids == 0 then
		return
	end
	if os.clock() > confirmUntil then
		-- первый тап — просим подтвердить
		confirmUntil = os.clock() + 3
		refreshSellButton(data)
		task.delay(3.05, function()
			local d = DataController:Get()
			if d and panel.Visible then
				refreshSellButton(d)
			end
		end)
		return
	end
	confirmUntil = 0
	local result = UIController:Invoke("SellWeapons", ids)
	if UIController:Handle(result) then
		table.clear(selected)
		Sound.Play("Coins")
		UIController:Toast("TOAST_SOLD", { count = result.count, gold = result.gold }, "gold")
	end
	refresh()
end

local function build()
	panel = C.Panel({ Name = "MerchantPanel", Size = UDim2.fromOffset(S(540), S(330)) })
	C.TitleBar(panel, "UI_MERCHANT_TITLE", function()
		UIController:ClosePanel()
	end)

	local tabs = C.Make("Frame", {
		Size = UDim2.new(1, -S(24), 0, S(38)),
		Position = UDim2.fromOffset(S(12), S(46)),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	C.List(tabs, Enum.FillDirection.Horizontal, 6)
	for i, info in { { "Weapons", "UI_WEAPONS" }, { "Ores", "UI_ORES" }, { "Pickaxes", "UI_PICKAXES" } } do
		local name, key = info[1], info[2]
		tabButtons[name] = C.Button({
			Key = key,
			TextSize = 15,
			Size = UDim2.new(1 / 3, -S(4), 1, 0),
			LayoutOrder = i,
			OnClick = function()
				currentTab = name
				refresh()
			end,
			Parent = tabs,
		})
	end

	local contentSize = UDim2.new(1, -S(24), 1, -S(100))
	local contentPos = UDim2.fromOffset(S(12), S(90))

	-- оружие
	local weaponsFrame = C.Make("Frame", { Size = contentSize, Position = contentPos, BackgroundTransparency = 1, Parent = panel })
	weaponGrid = WeaponCard.Grid(weaponsFrame, UDim2.new(1, 0, 1, -S(52)), UDim2.new())
	sellButton = C.Button({
		Font = Theme.FontTitle,
		TextSize = 16,
		TextColor = Theme.Bg,
		Size = UDim2.new(1, 0, 0, S(46)),
		Position = UDim2.fromScale(0, 1),
		AnchorPoint = Vector2.new(0, 1),
		Color = Theme.Gold,
		OnClick = sellSelected,
		Parent = weaponsFrame,
	})
	tabFrames.Weapons = weaponsFrame

	-- руда
	local oresFrame = C.Make("Frame", { Size = contentSize, Position = contentPos, BackgroundTransparency = 1, Parent = panel })
	oreList = C.Make("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = S(4),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = oresFrame,
	})
	C.List(oreList, Enum.FillDirection.Vertical, 6)
	tabFrames.Ores = oresFrame

	-- кирки
	local picksFrame = C.Make("Frame", { Size = contentSize, Position = contentPos, BackgroundTransparency = 1, Parent = panel })
	pickList = C.Make("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = S(4),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = picksFrame,
	})
	C.List(pickList, Enum.FillDirection.Vertical, 6)
	tabFrames.Pickaxes = picksFrame
end

function MerchantController:Start()
	build()
	UIController:RegisterPanel("Merchant", {
		Frame = panel,
		OnOpen = function()
			table.clear(selected)
			confirmUntil = 0
			refresh()
		end,
	})
	DataController.Changed:Connect(function(key: string)
		if
			key == "*"
			or key == "Weapons"
			or key == "EquippedWeapon"
			or key == "Ores"
			or key == "Gold"
			or key == "Level"
			or key == "OwnedPickaxes"
		then
			refresh()
		end
	end)
	Localization.Changed:Connect(refresh)
end

return MerchantController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">QuestController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ТРЕКЕР КВЕСТА СИСТЕМЫ + луч-подсказка от персонажа к цели (жила, кузня, торговец, портал).
	Цели ищутся по тегам CollectionService на клиенте.
	ВАЖНО для StreamingEnabled: у кузни/торговца поставь ModelStreamingMode = Persistent (см. README),
	иначе луч появится только когда объект подгрузится рядом.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local C = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)
local DataController = require(script.Parent.DataController)
local HudController = require(script.Parent.HudController)
local UIController = require(script.Parent.UIController)

local S = Theme.S

local QuestController = {}

local box: Frame
local titleLabel: TextLabel
local progressLabel: TextLabel
local beam: Beam
local fromAttachment: Attachment
local toAttachment: Attachment

local function positionOf(instance: Instance): Vector3?
	if instance:IsA("BasePart") then
		return instance.Position
	elseif instance:IsA("Model") then
		return instance:GetPivot().Position
	end
	return nil
end

local function findTarget(step: any, from: Vector3): Vector3?
	if not step.TargetTag then
		return nil
	end
	local best: Vector3? = nil
	local bestDist = math.huge
	for _, instance in CollectionService:GetTagged(step.TargetTag) do
		if instance:IsDescendantOf(workspace) then
			local ok = true
			if step.TargetOre and instance:GetAttribute("OreId") ~= step.TargetOre then
				ok = false
			end
			local pos = positionOf(instance)
			if ok and pos then
				local d = (pos - from).Magnitude
				if d < bestDist then
					best, bestDist = pos, d
				end
			end
		end
	end
	return best
end

local function currentStep(): (any, any)
	local data = DataController:Get()
	if not data or data.Tutorial.Done then
		return nil, data
	end
	return Config.Tutorial.Steps[data.Tutorial.Step], data
end

local function refreshText()
	local step, data = currentStep()
	if not step then
		box.Visible = false
		HudController:SetInventoryPulse(false)
		return
	end
	box.Visible = true
	C.Bind(titleLabel, step.TitleKey)
	C.Bind(progressLabel, "QUEST_PROGRESS", { progress = data.Tutorial.Progress, count = step.Count })
	HudController:SetInventoryPulse(step.Event == "WeaponEquipped")
end

local function updateBeam()
	local step = currentStep()
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not step or not root or UIController:GetOpenPanel() ~= nil then
		beam.Enabled = false
		return
	end
	local target = findTarget(step, root.Position)
	if step.TargetTag == Config.Tags.GatePortal then
		if target then
			refreshText()
		else
			C.Bind(progressLabel, "QUEST_WAIT_GATE")
		end
	end
	if not target then
		beam.Enabled = false
		return
	end
	if fromAttachment.Parent ~= root then
		fromAttachment.Parent = root
	end
	toAttachment.WorldPosition = target + Vector3.new(0, 2, 0)
	beam.Enabled = (target - root.Position).Magnitude > 6
end

local function build()
	box = C.Panel({
		Name = "Quest",
		Size = UDim2.fromOffset(S(250), S(58)),
		Position = UDim2.fromOffset(S(10), S(100)),
		AnchorPoint = Vector2.zero,
		Transparency = 0.2,
		StrokeColor = Theme.Gold,
		Visible = false,
		Parent = UIController.Layers.Hud,
	})
	C.Text({
		Key = "QUEST_HEADER",
		Font = Theme.FontBold,
		TextSize = 11,
		Color = Theme.Gold,
		Size = UDim2.new(1, -S(16), 0, S(14)),
		Position = UDim2.fromOffset(S(8), S(5)),
		Parent = box,
	})
	titleLabel = C.Text({
		Font = Theme.FontBold,
		TextSize = 15,
		Size = UDim2.new(1, -S(16), 0, S(18)),
		Position = UDim2.fromOffset(S(8), S(20)),
		Parent = box,
	})
	progressLabel = C.Text({
		TextSize = 13,
		Color = Theme.TextDim,
		Size = UDim2.new(1, -S(16), 0, S(15)),
		Position = UDim2.fromOffset(S(8), S(39)),
		Parent = box,
	})

	fromAttachment = Instance.new("Attachment")
	fromAttachment.Name = "QuestBeamFrom"
	toAttachment = Instance.new("Attachment")
	toAttachment.Name = "QuestBeamTo"
	toAttachment.Parent = workspace.Terrain

	beam = Instance.new("Beam")
	beam.Attachment0 = fromAttachment
	beam.Attachment1 = toAttachment
	beam.Color = ColorSequence.new(Theme.Gold)
	beam.Transparency = NumberSequence.new(0.25, 0.6)
	beam.Width0 = 0.35
	beam.Width1 = 0.35
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Segments = 1
	beam.Enabled = false
	beam.Parent = workspace.Terrain
end

function QuestController:Start()
	build()
	DataController.Changed:Connect(function(key: string)
		if key == "*" or key == "Tutorial" then
			refreshText()
		end
	end)
	refreshText()
	task.spawn(function()
		while true do
			pcall(updateBeam)
			task.wait(0.4)
		end
	end)
end

return QuestController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003B"><Properties><string name="Name">SystemWindowController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ОКНО СИСТЕМЫ — главная фишка. Синее окно в стиле маньхуа:
	мерцание рамки → окно выезжает → текст «печатается» → само закрывается или по тапу.
	Окна идут очередью; если их много — показываются быстрее.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Localization = require(ReplicatedStorage.Shared.Localization)
local Net = require(ReplicatedStorage.Shared.Net)
local Types = require(ReplicatedStorage.Shared.Types)
local C = require(script.Parent.Parent.UI.Components)
local Sound = require(script.Parent.Parent.UI.Sound)
local Theme = require(script.Parent.Parent.UI.Theme)
local UIController = require(script.Parent.UIController)

local S = Theme.S

local SystemWindowController = {}

local queue: { Types.NotifyPayload } = {}
local showing = false

local KIND_STYLE: { [string]: { Color: Color3, Sound: string, Duration: number } } = {
	Awakening = { Color = Theme.Accent, Sound = "SystemOpen", Duration = 6 },
	Quest = { Color = Theme.Accent, Sound = "SystemOpen", Duration = 3.5 },
	QuestDone = { Color = Theme.Success, Sound = "SystemQuestDone", Duration = 3 },
	LevelUp = { Color = Theme.Gold, Sound = "SystemLevelUp", Duration = 3.5 },
	Reward = { Color = Theme.Gold, Sound = "SystemQuestDone", Duration = 4 },
	Info = { Color = Theme.Accent, Sound = "SystemOpen", Duration = 3.5 },
	Warning = { Color = Theme.Danger, Sound = "SystemWarning", Duration = 3.5 },
	Boss = { Color = Theme.Danger, Sound = "SystemBoss", Duration = 4 },
	GateCleared = { Color = Theme.Gold, Sound = "SystemQuestDone", Duration = 4.5 },
	GateFailed = { Color = Theme.Danger, Sound = "SystemWarning", Duration = 4 },
	Forge = { Color = Theme.Accent, Sound = "ForgeDone", Duration = 3.5 },
}

-- элементы окна
local root: CanvasGroup
local frame: Frame
local stroke: UIStroke
local header: TextLabel
local title: TextLabel
local body: TextLabel
local closeRequested = false

local function build()
	root = C.Make("CanvasGroup", {
		Name = "SystemWindow",
		Size = UDim2.fromOffset(S(430), S(150)),
		Position = UDim2.new(0.5, 0, 0, S(86)),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		Parent = UIController.Layers.Overlay,
	})

	frame = C.Make("Frame", {
		Size = UDim2.new(1, -S(8), 1, -S(8)),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.08,
		Parent = root,
	})
	C.Corner(frame, 6)
	stroke = C.Stroke(frame, Theme.Accent, 2, 0)
	C.Make("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(40, 80, 140), Color3.fromRGB(10, 20, 45)),
		Parent = frame,
	})
	C.Padding(frame, 12)
	C.List(frame, Enum.FillDirection.Vertical, 4)

	header = C.Text({
		Name = "Header",
		Font = Theme.FontBold,
		TextSize = 14,
		Color = Theme.Accent,
		Size = UDim2.new(1, 0, 0, S(18)),
		LayoutOrder = 1,
		Parent = frame,
	})
	C.Make("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
		LayoutOrder = 2,
		Parent = frame,
	})
	title = C.Text({
		Name = "Title",
		Font = Theme.FontTitle,
		TextSize = 21,
		Wrapped = true,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 3,
		Parent = frame,
	})
	body = C.Text({
		Name = "Body",
		TextSize = 15,
		Color = Theme.TextDim,
		Wrapped = true,
		AlignX = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 4,
		Parent = frame,
	})
	C.Text({
		Name = "Hint",
		Key = "SYS_TAP_TO_CLOSE",
		TextSize = 11,
		Color = Theme.TextDim,
		AlignX = Enum.TextXAlignment.Right,
		Size = UDim2.new(1, 0, 0, S(14)),
		LayoutOrder = 5,
		Parent = frame,
	})

	local tap = C.Make("TextButton", {
		Name = "Tap",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 5,
		Parent = root,
	})
	tap.Activated:Connect(function()
		closeRequested = true
	end)
end

local function typewriter(label: TextLabel, seconds: number)
	local length = utf8.len(label.ContentText) or #label.ContentText
	label.MaxVisibleGraphemes = 0
	local started = os.clock()
	while label.MaxVisibleGraphemes ~= -1 do
		local p = math.clamp((os.clock() - started) / seconds, 0, 1)
		if p >= 1 or closeRequested then
			label.MaxVisibleGraphemes = -1
			break
		end
		label.MaxVisibleGraphemes = math.floor(length * p)
		task.wait()
	end
end

local function fitHeight()
	-- подогнать высоту CanvasGroup под содержимое
	local layout = frame:FindFirstChildOfClass("UIListLayout")
	if layout then
		local h = layout.AbsoluteContentSize.Y + S(24) + S(8)
		root.Size = UDim2.fromOffset(S(430), math.max(S(110), h))
	end
end

local function show(payload: Types.NotifyPayload)
	local style = KIND_STYLE[payload.Kind] or KIND_STYLE.Info
	closeRequested = false

	C.SetRaw(header, `[ {Localization.Get("SYS_HEADER")} ]  {Localization.Get("SYS_KIND_" .. string.upper(payload.Kind))}`)
	header.TextColor3 = style.Color
	stroke.Color = style.Color
	C.SetRaw(title, Localization.Get(payload.Title, payload.Args))
	if payload.Body then
		C.SetRaw(body, Localization.Get(payload.Body, payload.Args))
		body.Visible = true
	else
		body.Visible = false
	end
	title.MaxVisibleGraphemes = 0
	body.MaxVisibleGraphemes = 0

	root.Visible = true
	task.wait() -- дать AutomaticSize посчитаться
	fitHeight()

	Sound.Play(style.Sound)

	-- появление: мерцание рамки + выезд сверху
	local targetPos = UDim2.new(0.5, 0, 0, S(86))
	root.Position = targetPos - UDim2.fromOffset(0, S(18))
	root.GroupTransparency = 1
	TweenService:Create(root, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = targetPos,
		GroupTransparency = 0,
	}):Play()
	for i = 1, 4 do
		stroke.Transparency = if i % 2 == 1 then 0.8 else 0
		task.wait(0.05)
	end
	stroke.Transparency = 0

	typewriter(title, 0.35)
	if body.Visible then
		typewriter(body, 0.5)
	end

	local duration = style.Duration
	if #queue >= 3 then
		duration = 1.5
	end
	local started = os.clock()
	while os.clock() - started < duration and not closeRequested do
		task.wait(0.05)
	end

	local tween = TweenService:Create(root, TweenInfo.new(0.2), {
		GroupTransparency = 1,
		Position = targetPos - UDim2.fromOffset(0, S(10)),
	})
	tween:Play()
	tween.Completed:Wait()
	root.Visible = false
end

local function pump()
	if showing then
		return
	end
	showing = true
	while #queue > 0 do
		local payload = table.remove(queue, 1) :: Types.NotifyPayload
		local ok, err = pcall(show, payload)
		if not ok then
			warn("[SystemWindow]", err)
			root.Visible = false
		end
	end
	showing = false
end

function SystemWindowController:Notify(payload: Types.NotifyPayload)
	table.insert(queue, payload)
	task.spawn(pump)
end

function SystemWindowController:Start()
	build()
	Net.Event("SystemNotify").OnClientEvent:Connect(function(payload: Types.NotifyPayload)
		if type(payload) == "table" and type(payload.Title) == "string" then
			SystemWindowController:Notify(payload)
		end
	end)
end

return SystemWindowController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003C"><Properties><string name="Name">UIController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Корневой ScreenGui, слои, окна (одно открытое за раз), тосты, обработка ответов сервера.
	Окно регистрируется так:
		UIController:RegisterPanel("Forge", { Frame = frame, OnOpen = fn(payload), OnClose = fn() })
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Localization = require(ReplicatedStorage.Shared.Localization)
local Net = require(ReplicatedStorage.Shared.Net)
local Signal = require(ReplicatedStorage.Shared.Signal)
local C = require(script.Parent.Parent.UI.Components)
local Sound = require(script.Parent.Parent.UI.Sound)
local Theme = require(script.Parent.Parent.UI.Theme)

local S = Theme.S

local UIController = {}

UIController.Gui = nil :: any
UIController.Layers = {} :: { [string]: Frame }
UIController.PanelChanged = Signal.new() -- (name or nil)

type Panel = { Frame: GuiObject, OnOpen: ((any) -> ())?, OnClose: (() -> ())? }
local panels: { [string]: Panel } = {}
local openName: string? = nil

local toastContainer: Frame
local hitFlash: Frame
local toastCounter = 0

function UIController:Init()
	-- дождаться реального размера экрана
	local camera = workspace.CurrentCamera
	for _ = 1, 50 do
		if camera and camera.ViewportSize.X > 10 then
			break
		end
		task.wait(0.05)
		camera = workspace.CurrentCamera
	end
	Theme.UpdateScale()

	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = Instance.new("ScreenGui")
	gui.Name = "SystemBlacksmith"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	gui.Parent = playerGui
	UIController.Gui = gui

	for i, name in { "Hud", "Panels", "Overlay", "Toasts" } do
		local layer = Instance.new("Frame")
		layer.Name = name
		layer.Size = UDim2.fromScale(1, 1)
		layer.BackgroundTransparency = 1
		layer.ZIndex = i * 10
		layer.Parent = gui
		UIController.Layers[name] = layer
	end

	-- тосты внизу по центру
	toastContainer = C.Make("Frame", {
		Name = "ToastList",
		Size = UDim2.new(0, S(360), 0, S(200)),
		Position = UDim2.new(0.5, 0, 1, -S(120)),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		Parent = UIController.Layers.Toasts,
	})
	C.List(toastContainer, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom)

	-- красная вспышка по краям экрана при получении урона
	hitFlash = C.Make("Frame", {
		Name = "HitFlash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Danger,
		BackgroundTransparency = 1,
		Parent = UIController.Layers.Overlay,
	})
	C.Make("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(0.25, 1),
			NumberSequenceKeypoint.new(0.75, 1),
			NumberSequenceKeypoint.new(1, 0.2),
		}),
		Parent = hitFlash,
	})
end

function UIController:Start()
	Net.Event("Toast").OnClientEvent:Connect(function(payload: { [string]: any })
		UIController:Toast(payload.Key, payload.Args, payload.Color)
	end)
	Net.Event("OpenPanel").OnClientEvent:Connect(function(payload: { [string]: any })
		UIController:OpenPanel(payload.Panel, payload)
	end)
end

-- ===== Окна =====

function UIController:RegisterPanel(name: string, panel: Panel)
	panels[name] = panel
	panel.Frame.Visible = false
	panel.Frame.Parent = UIController.Layers.Panels
end

function UIController:OpenPanel(name: string, payload: any?)
	local panel = panels[name]
	if not panel then
		return
	end
	if openName and openName ~= name then
		UIController:ClosePanel()
	end
	openName = name
	panel.Frame.Visible = true
	if panel.OnOpen then
		panel.OnOpen(payload)
	end
	UIController.PanelChanged:Fire(name)
end

function UIController:ClosePanel()
	local name = openName
	if not name then
		return
	end
	openName = nil
	local panel = panels[name]
	panel.Frame.Visible = false
	if panel.OnClose then
		panel.OnClose()
	end
	UIController.PanelChanged:Fire(nil)
end

function UIController:TogglePanel(name: string)
	if openName == name then
		UIController:ClosePanel()
	else
		UIController:OpenPanel(name)
	end
end

function UIController:GetOpenPanel(): string?
	return openName
end

-- ===== Тосты =====

local TOAST_COLORS: { [string]: Color3 } = {
	error = Theme.Danger,
	ore = Theme.Gold,
	gold = Theme.Gold,
	success = Theme.Success,
}

function UIController:Toast(key: string, args: { [string]: any }?, color: string?)
	if not toastContainer then
		return
	end
	local text = Localization.Get(key, args)
	toastCounter += 1
	local toast = C.Make("TextLabel", {
		LayoutOrder = toastCounter,
		Size = UDim2.new(0, S(340), 0, S(30)),
		BackgroundColor3 = Theme.Bg,
		BackgroundTransparency = 0.25,
		Font = Theme.FontBold,
		TextSize = S(16),
		TextColor3 = (color and TOAST_COLORS[color]) or Theme.Text,
		TextWrapped = true,
		Text = text,
		Parent = toastContainer,
	})
	C.Corner(toast, 6)
	if color == "error" then
		Sound.Play("SystemWarning", 0.3)
	end
	-- не больше 5 тостов одновременно
	local list = {}
	for _, child in toastContainer:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(list, child)
		end
	end
	if #list > 5 then
		list[1]:Destroy()
	end
	task.delay(2.2, function()
		if toast.Parent then
			local tween = TweenService:Create(toast, TweenInfo.new(0.35), { TextTransparency = 1, BackgroundTransparency = 1 })
			tween:Play()
			tween.Completed:Wait()
			toast:Destroy()
		end
	end)
end

-- Ответ RemoteFunction: показать ошибку тостом. Возвращает ok.
function UIController:Handle(result: any): boolean
	if type(result) ~= "table" then
		UIController:Toast("ERR_SERVER", nil, "error")
		return false
	end
	if not result.ok then
		UIController:Toast(result.err or "ERR_SERVER", result.args, "error")
		return false
	end
	return true
end

-- Безопасный вызов RemoteFunction
function UIController:Invoke(name: string, ...: any): any
	local remote = Net.Function(name)
	local args = table.pack(...)
	local ok, result = pcall(function()
		return remote:InvokeServer(table.unpack(args, 1, args.n))
	end)
	if not ok then
		return { ok = false, err = "ERR_SERVER" }
	end
	return result
end

function UIController:FlashHit(strength: number)
	hitFlash.BackgroundTransparency = math.clamp(1 - strength, 0.35, 1)
	TweenService:Create(hitFlash, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
end

return UIController
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000042"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX0000003E"><Properties><string name="Name">Components</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Строительные блоки интерфейса. Весь текст — через ключи локализации:
		C.Text({ Key = "UI_LEVEL", Args = { level = 5 }, ... })
	При смене языка все привязанные тексты обновятся сами.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Localization = require(ReplicatedStorage.Shared.Localization)
local Theme = require(script.Parent.Theme)
local Sound = require(script.Parent.Sound)

local S = Theme.S

local C = {}

-- ===== Локализация текста =====

type Binding = { Key: string, Args: { [string]: any }? }
local bindings: { [Instance]: Binding } = setmetatable({}, { __mode = "k" }) :: any

local function render(obj: Instance, b: Binding)
	(obj :: any).Text = Localization.Get(b.Key, b.Args)
end

function C.Bind(obj: Instance, key: string, args: { [string]: any }?)
	local b = { Key = key, Args = args }
	bindings[obj] = b
	render(obj, b)
end

-- Обычный текст без перевода (числа, имена игроков)
function C.SetRaw(obj: Instance, text: string)
	bindings[obj] = nil;
	(obj :: any).Text = text
end

Localization.Changed:Connect(function()
	for obj, b in bindings do
		if obj.Parent then
			render(obj, b)
		end
	end
end)

-- ===== Базовые =====

function C.Make(className: string, props: { [string]: any }, children: { Instance }?): any
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(inst :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function C.Corner(parent: Instance, radius: number?): UICorner
	return C.Make("UICorner", { CornerRadius = UDim.new(0, S(radius or 8)), Parent = parent })
end

function C.Round(parent: Instance): UICorner
	return C.Make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = parent })
end

function C.Stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	return C.Make("UIStroke", {
		Color = color or Theme.Accent,
		Thickness = math.max(1, S(thickness or 1.5)),
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function C.Padding(parent: Instance, px: number): UIPadding
	local p = UDim.new(0, S(px))
	return C.Make("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p, Parent = parent })
end

function C.List(
	parent: Instance,
	direction: Enum.FillDirection,
	padding: number,
	hAlign: Enum.HorizontalAlignment?,
	vAlign: Enum.VerticalAlignment?
): UIListLayout
	return C.Make("UIListLayout", {
		FillDirection = direction,
		Padding = UDim.new(0, S(padding)),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

-- Окно в стиле Системы
function C.Panel(props: { [string]: any }): Frame
	local frame = C.Make("Frame", {
		Name = props.Name or "Panel",
		Size = props.Size,
		Position = props.Position or UDim2.fromScale(0.5, 0.5),
		AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5),
		BackgroundColor3 = props.Color or Theme.Panel,
		BackgroundTransparency = props.Transparency or 0.06,
		Visible = if props.Visible == nil then true else props.Visible,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	C.Corner(frame, props.Radius or 10)
	C.Stroke(frame, props.StrokeColor or Theme.Accent, props.StrokeThickness or 2, 0.1)
	C.Make("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 160, 190)),
		Parent = frame,
	})
	return frame
end

function C.Text(props: { [string]: any }): TextLabel
	local label = C.Make("TextLabel", {
		Name = props.Name or "Text",
		Size = props.Size or UDim2.fromScale(1, 0),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundTransparency = 1,
		Font = props.Font or Theme.Font,
		TextSize = S(props.TextSize or 16),
		TextColor3 = props.Color or Theme.Text,
		TextXAlignment = props.AlignX or Enum.TextXAlignment.Left,
		TextYAlignment = props.AlignY or Enum.TextYAlignment.Center,
		TextWrapped = props.Wrapped or false,
		TextTruncate = if props.Wrapped then Enum.TextTruncate.None else Enum.TextTruncate.AtEnd,
		RichText = props.RichText or false,
		AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.None,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Visible = if props.Visible == nil then true else props.Visible,
		Text = props.Text or "",
		Parent = props.Parent,
	})
	if props.Key then
		C.Bind(label, props.Key, props.Args)
	end
	return label
end

-- Крупная кнопка с «нажатием» (удобно пальцем)
function C.Button(props: { [string]: any }): TextButton
	local color: Color3 = props.Color or Theme.AccentDim
	local button = C.Make("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		BackgroundTransparency = props.Transparency or 0,
		AutoButtonColor = false,
		Font = props.Font or Theme.FontBold,
		TextSize = S(props.TextSize or 18),
		TextColor3 = props.TextColor or Theme.Text,
		TextWrapped = true,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Visible = if props.Visible == nil then true else props.Visible,
		Text = props.Text or "",
		Parent = props.Parent,
	})
	C.Corner(button, props.Radius or 8)
	if props.Round then
		(button:FindFirstChildOfClass("UICorner") :: UICorner).CornerRadius = UDim.new(1, 0)
	end
	C.Stroke(button, props.StrokeColor or Theme.Accent, 1.5, 0.25)
	if props.Key then
		C.Bind(button, props.Key, props.Args)
	end

	button.MouseButton1Down:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.06), { BackgroundTransparency = 0.35 }):Play()
	end)
	local function release()
		TweenService:Create(button, TweenInfo.new(0.12), { BackgroundTransparency = props.Transparency or 0 }):Play()
	end
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)

	if props.OnClick then
		button.Activated:Connect(function()
			if not props.Silent then
				Sound.Play("UiClick")
			end
			props.OnClick()
		end)
	end
	return button
end

-- Полоса прогресса: возвращает (рамка, заливка)
function C.Bar(props: { [string]: any }): (Frame, Frame)
	local bg = C.Make("Frame", {
		Name = props.Name or "Bar",
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = props.BgColor or Theme.Bg,
		BackgroundTransparency = 0.2,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	C.Corner(bg, 4)
	local fill = C.Make("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(props.Value or 0, 1),
		BackgroundColor3 = props.Color or Theme.Accent,
		Parent = bg,
	})
	C.Corner(fill, 4)
	return bg, fill
end

-- Кнопка-заголовок окна с крестиком
function C.TitleBar(panel: Frame, titleKey: string, onClose: () -> ()): TextLabel
	local title = C.Text({
		Key = titleKey,
		Font = Theme.FontTitle,
		TextSize = 22,
		Color = Theme.Accent,
		Size = UDim2.new(1, -S(60), 0, S(34)),
		Position = UDim2.fromOffset(S(14), S(6)),
		Parent = panel,
	})
	C.Button({
		Name = "Close",
		Text = "X",
		Size = UDim2.fromOffset(S(40), S(40)),
		Position = UDim2.new(1, -S(6), 0, S(6)),
		AnchorPoint = Vector2.new(1, 0),
		Color = Theme.PanelLight,
		TextSize = 20,
		OnClick = onClose,
		Parent = panel,
	})
	return title
end

return C
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003F"><Properties><string name="Name">Sound</string><ProtectedString name="Source"><![CDATA[--!strict
-- Звуки интерфейса и эффектов. ID задаются в Shared/Config/Audio (пусто = тишина).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)

local Sound = {}

local cache: { [string]: Sound } = {}

function Sound.Play(key: string, volume: number?, pitch: number?)
	local id = Config.Audio[key]
	if not id or id == "" then
		return
	end
	local sound = cache[key]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = key
		sound.SoundId = id
		sound.Parent = SoundService
		cache[key] = sound
	end
	local s = sound :: Sound
	s.Volume = volume or 0.6
	s.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(s)
end

return Sound
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Стиль «Системы»: тёмно-синие окна, неоновая голубая обводка.
	S(n) — размер в пикселях, масштабированный под экран (телефон ≈ 0.9, ПК до 1.6).
	Интерфейс спроектирован под экран телефона в альбомной ориентации (~640×380 точек).
]]

local Theme = {
	Scale = 1,

	Bg = Color3.fromRGB(6, 12, 28),
	Panel = Color3.fromRGB(10, 22, 46),
	PanelLight = Color3.fromRGB(18, 36, 70),
	Accent = Color3.fromRGB(70, 195, 255),
	AccentDim = Color3.fromRGB(35, 95, 150),
	Text = Color3.fromRGB(228, 242, 255),
	TextDim = Color3.fromRGB(140, 168, 200),
	Gold = Color3.fromRGB(255, 205, 80),
	Danger = Color3.fromRGB(255, 80, 95),
	Success = Color3.fromRGB(90, 230, 140),
	Disabled = Color3.fromRGB(70, 80, 100),

	Font = Enum.Font.GothamMedium,
	FontBold = Enum.Font.GothamBold,
	FontTitle = Enum.Font.GothamBlack,
}

function Theme.UpdateScale()
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	if size.X < 10 or size.Y < 10 then
		size = Vector2.new(1280, 720)
	end
	Theme.Scale = math.clamp(math.min(size.X / 640, size.Y / 380), 0.75, 1.6)
end

function Theme.S(n: number): number
	return math.floor(n * Theme.Scale + 0.5)
end

return Theme
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000041"><Properties><string name="Name">WeaponCard</string><ProtectedString name="Source"><![CDATA[--!strict
-- Карточка оружия для инвентаря и торговца.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Localization = require(ReplicatedStorage.Shared.Localization)
local WeaponMath = require(ReplicatedStorage.Shared.WeaponMath)
local C = require(script.Parent.Components)
local Theme = require(script.Parent.Theme)

local S = Theme.S

local WeaponCard = {}

export type CardProps = {
	Weapon: any,
	Equipped: boolean?,
	Selected: boolean?,
	ShowPrice: boolean?,
	LayoutOrder: number?,
	OnClick: (() -> ())?,
	Parent: Instance,
}

function WeaponCard.Create(props: CardProps): TextButton
	local weapon = props.Weapon
	local rarity = Config.Rarities[weapon.Rarity] or Config.Rarities.Common

	local card = C.Make("TextButton", {
		Name = weapon.Id,
		BackgroundColor3 = if props.Selected then Theme.AccentDim else Theme.PanelLight,
		AutoButtonColor = true,
		Text = "",
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	C.Corner(card, 6)
	C.Stroke(card, if props.Equipped then Theme.Gold elseif props.Selected then Theme.Accent else rarity.Color, if props.Selected or props.Equipped then 2.5 else 1.2, 0.1)

	C.Make("Frame", {
		Name = "RarityStrip",
		Size = UDim2.new(0, S(4), 1, -S(10)),
		Position = UDim2.fromOffset(S(5), S(5)),
		BackgroundColor3 = rarity.Color,
		BorderSizePixel = 0,
		Parent = card,
	})

	C.Text({
		Text = Localization.WeaponName(weapon.Type, weapon.Ore),
		Font = Theme.FontBold,
		TextSize = 14,
		Size = UDim2.new(1, -S(18), 0, S(18)),
		Position = UDim2.fromOffset(S(14), S(5)),
		Parent = card,
	})
	C.Text({
		Key = rarity.NameKey,
		TextSize = 11,
		Color = rarity.Color,
		Size = UDim2.new(1, -S(18), 0, S(13)),
		Position = UDim2.fromOffset(S(14), S(23)),
		Parent = card,
	})
	C.Text({
		Key = "UI_DMG",
		Args = { value = WeaponMath.Damage(weapon) },
		Font = Theme.FontBold,
		TextSize = 14,
		Color = Theme.Accent,
		Size = UDim2.new(0.5, -S(10), 0, S(16)),
		Position = UDim2.fromOffset(S(14), S(38)),
		Parent = card,
	})
	C.Text({
		Key = "UI_QUALITY",
		Args = { value = weapon.Quality },
		TextSize = 12,
		Color = Theme.TextDim,
		Size = UDim2.new(1, -S(18), 0, S(14)),
		Position = UDim2.fromOffset(S(14), S(56)),
		Parent = card,
	})

	if props.Equipped then
		C.Text({
			Key = "UI_EQUIPPED",
			Font = Theme.FontBold,
			TextSize = 11,
			Color = Theme.Gold,
			AlignX = Enum.TextXAlignment.Right,
			Size = UDim2.new(0.5, -S(6), 0, S(16)),
			Position = UDim2.new(0.5, 0, 0, S(38)),
			Parent = card,
		})
	elseif props.ShowPrice then
		C.Text({
			Text = `+{WeaponMath.SellPrice(weapon)}`,
			Font = Theme.FontBold,
			TextSize = 13,
			Color = Theme.Gold,
			AlignX = Enum.TextXAlignment.Right,
			Size = UDim2.new(0.5, -S(6), 0, S(16)),
			Position = UDim2.new(0.5, 0, 0, S(38)),
			Parent = card,
		})
	end

	if props.OnClick then
		card.Activated:Connect(props.OnClick)
	end
	return card
end

-- Оружие игрока, отсортированное по урону (сильное сверху)
function WeaponCard.Sorted(weapons: { [string]: any }): { any }
	local list = {}
	for _, w in weapons do
		table.insert(list, w)
	end
	table.sort(list, function(a, b)
		local da, db = WeaponMath.Damage(a), WeaponMath.Damage(b)
		if da ~= db then
			return da > db
		end
		return a.CreatedAt > b.CreatedAt
	end)
	return list
end

-- Скролл с сеткой карточек
function WeaponCard.Grid(parent: Instance, size: UDim2, position: UDim2): ScrollingFrame
	local scroll = C.Make("ScrollingFrame", {
		Size = size,
		Position = position,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = S(6),
		ScrollBarImageColor3 = Theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	})
	C.Make("UIGridLayout", {
		CellSize = UDim2.fromOffset(S(158), S(76)),
		CellPadding = UDim2.fromOffset(S(6), S(6)),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = scroll,
	})
	return scroll
end

function WeaponCard.Clear(scroll: ScrollingFrame)
	for _, child in scroll:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

return WeaponCard
]]></ProtectedString></Properties></Item></Item></Item></Item></Item></roblox>