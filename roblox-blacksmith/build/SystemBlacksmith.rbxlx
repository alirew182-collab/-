		Color = Color3.fromRGB(150, 200, 240),
		SlamDamage = 55,
		SlamRadius = 16,
		SlamWindup = 1.2,
		SlamCooldown = 6,
		SlamTriggerRange = 20,
	},
}

return Mobs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Network</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	RATE-LIMIT на все Remote: token bucket на игрока.
	PerSecond — скорость восстановления токенов, Burst — максимум подряд.
	Remote без записи получают Default.
]]

export type Limit = { PerSecond: number, Burst: number }

local Network: { Default: Limit, Limits: { [string]: Limit } } = {
	Default = { PerSecond = 2, Burst = 4 },
	Limits = {
		RequestData = { PerSecond = 0.5, Burst = 3 },
		CombatAttack = { PerSecond = 8, Burst = 10 },
		CombatBlock = { PerSecond = 6, Burst = 8 },
		ForgeStart = { PerSecond = 1, Burst = 3 },
		ForgeSubmit = { PerSecond = 1, Burst = 3 },
		ForgeCancel = { PerSecond = 2, Burst = 4 },
		EquipWeapon = { PerSecond = 3, Burst = 5 },
		EquipPickaxe = { PerSecond = 2, Burst = 4 },
		SellWeapons = { PerSecond = 2, Burst = 4 },
		SellOres = { PerSecond = 3, Burst = 6 },
		BuyPickaxe = { PerSecond = 1, Burst = 3 },
		SetLanguage = { PerSecond = 0.5, Burst = 2 },
		GateStart = { PerSecond = 1, Burst = 2 },
		GateLeave = { PerSecond = 1, Burst = 2 },
		RedeemCode = { PerSecond = 0.3, Burst = 3 },
		SetSetting = { PerSecond = 2, Burst = 6 },
		TradeRespond = { PerSecond = 1, Burst = 3 },
		TradeSetOffer = { PerSecond = 4, Burst = 8 },
		TradeReady = { PerSecond = 3, Burst = 6 },
		TradeConfirm = { PerSecond = 2, Burst = 4 },
		TradeCancel = { PerSecond = 1, Burst = 3 },
		ShopList = { PerSecond = 2, Burst = 4 },
		ShopUnlist = { PerSecond = 2, Burst = 4 },
		ShopBuy = { PerSecond = 1, Burst = 3 },
		ShopFetch = { PerSecond = 2, Burst = 4 },
	},
}

return Network
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Ores</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	РУДЫ.
	Новая руда = новая запись здесь + в карте Part с тегом "OreNode" и атрибутом OreId = "<Id>".
	Названия берутся из таблицы локализации по ключу NameKey.
]]

export type OreDef = {
	Id: string,
	NameKey: string,
	Order: number, -- порядок в интерфейсе
	RequiredLevel: number, -- уровень игрока для добычи и ковки
	RequiredPickaxeTier: number, -- минимальный тир кирки
	NodeHealth: number, -- сколько «силы добычи» нужно, чтобы разбить жилу
	YieldMin: number,
	YieldMax: number,
	RespawnSeconds: number,
	XpPerOre: number,
	SellPrice: number, -- цена 1 руды у торговца
	PowerMult: number, -- множитель урона оружия из этой руды
	RarityLuck: number, -- бонус к шансам редкости при ковке
	Color: Color3,
	Material: Enum.Material,
}

local Ores: { [string]: OreDef } = {
	Copper = {
		Id = "Copper",
		NameKey = "ORE_COPPER",
		Order = 1,
		RequiredLevel = 1,
		RequiredPickaxeTier = 1,
		NodeHealth = 3,
		YieldMin = 1,
		YieldMax = 2,
		RespawnSeconds = 8,
		XpPerOre = 4,
		SellPrice = 3,
		PowerMult = 1.0,
		RarityLuck = 0,
		Color = Color3.fromRGB(201, 116, 62),
		Material = Enum.Material.Slate,
	},
	Iron = {
		Id = "Iron",
		NameKey = "ORE_IRON",
		Order = 2,
		RequiredLevel = 3,
		RequiredPickaxeTier = 2,
		NodeHealth = 6,
		YieldMin = 1,
		YieldMax = 2,
		RespawnSeconds = 12,
		XpPerOre = 9,
		SellPrice = 8,
		PowerMult = 1.6,
		RarityLuck = 0.15,
		Color = Color3.fromRGB(140, 146, 156),
		Material = Enum.Material.Slate,
	},
	Moonsilver = {
		Id = "Moonsilver",
		NameKey = "ORE_MOONSILVER",
		Order = 3,
		RequiredLevel = 6,
		RequiredPickaxeTier = 3,
		NodeHealth = 10,
		YieldMin = 1,
		YieldMax = 1,
		RespawnSeconds = 20,
		XpPerOre = 20,
		SellPrice = 22,
		PowerMult = 2.6,
		RarityLuck = 0.35,
		Color = Color3.fromRGB(170, 210, 255),
		Material = Enum.Material.Glass,
	},
}

return Ores
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">Pickaxes</string><ProtectedString name="Source"><![CDATA[--!strict
-- КИРКИ. Power — урон по жиле за удар, Tier — какие руды можно добывать.

export type PickaxeDef = {
	Id: string,
	NameKey: string,
	Order: number,
	Tier: number,
	Power: number,
	Price: number, -- 0 = выдаётся бесплатно
	RequiredLevel: number,
}

local Pickaxes: { [string]: PickaxeDef } = {
	Stone = { Id = "Stone", NameKey = "PICK_STONE", Order = 1, Tier = 1, Power = 1, Price = 0, RequiredLevel = 1 },
	Iron = { Id = "Iron", NameKey = "PICK_IRON", Order = 2, Tier = 2, Power = 2, Price = 150, RequiredLevel = 3 },
	Moonsilver = {
		Id = "Moonsilver",
		NameKey = "PICK_MOONSILVER",
		Order = 3,
		Tier = 3,
		Power = 3,
		Price = 900,
		RequiredLevel = 6,
	},
}

return Pickaxes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Ranks</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	РАНГИ ОХОТНИКА-КУЗНЕЦА. Ранг растёт с уровнем и даёт постоянный бонус к урону.
	Испытание Системы (бой с боссом за ранг) — следующий этап; пороги останутся теми же.
]]

export type RankDef = {
	Id: string,
	Short: string, -- буква на значке
	NameKey: string,
	MinLevel: number,
	DamageBonus: number,
}

local Ranks: { RankDef } = {
	{ Id = "F", Short = "F", NameKey = "RANK_F", MinLevel = 1, DamageBonus = 0 },
	{ Id = "E", Short = "E", NameKey = "RANK_E", MinLevel = 5, DamageBonus = 0.04 },
	{ Id = "D", Short = "D", NameKey = "RANK_D", MinLevel = 10, DamageBonus = 0.08 },
	{ Id = "C", Short = "C", NameKey = "RANK_C", MinLevel = 16, DamageBonus = 0.13 },
	{ Id = "B", Short = "B", NameKey = "RANK_B", MinLevel = 24, DamageBonus = 0.19 },
	{ Id = "A", Short = "A", NameKey = "RANK_A", MinLevel = 32, DamageBonus = 0.26 },
	{ Id = "S", Short = "S", NameKey = "RANK_S", MinLevel = 42, DamageBonus = 0.35 },
	{ Id = "National", Short = "N", NameKey = "RANK_NATIONAL", MinLevel = 55, DamageBonus = 0.45 },
	{ Id = "Unknown", Short = "?", NameKey = "RANK_UNKNOWN", MinLevel = 75, DamageBonus = 0.6 },
}

return Ranks
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Rarities</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	РЕДКОСТИ ОРУЖИЯ.
	Weight — базовый «вес» шанса. Итоговый шанс зависит от качества ковки и руды:
		вес_редкости = Weight * удача ^ (Order - 1),   удача = 1 + качество% * RarityLuckPerQuality + RarityLuck руды
	Шансы показываются игроку в кузне (кнопка «Шансы») — так требуют правила Roblox для случайных наград.
	Traits — сколько случайных черт получает оружие этой редкости.
]]

export type RarityDef = {
	Id: string,
	NameKey: string,
	Order: number,
	Weight: number,
	Traits: number,
	DamageMult: number,
	SellMult: number,
	Color: Color3,
}

local Rarities: { [string]: RarityDef } = {
	Common = {
		Id = "Common",
		NameKey = "RARITY_COMMON",
		Order = 1,
		Weight = 75,
		Traits = 0,
		DamageMult = 1.0,
		SellMult = 1.0,
		Color = Color3.fromRGB(190, 196, 206),
	},
	Rare = {
		Id = "Rare",
		NameKey = "RARITY_RARE",
		Order = 2,
		Weight = 20,
		Traits = 1,
		DamageMult = 1.2,
		SellMult = 1.6,
		Color = Color3.fromRGB(70, 150, 255),
	},
	Epic = {
		Id = "Epic",
		NameKey = "RARITY_EPIC",
		Order = 3,
		Weight = 4,
		Traits = 1,
		DamageMult = 1.45,
		SellMult = 2.6,
		Color = Color3.fromRGB(170, 90, 255),
	},
	Legendary = {
		Id = "Legendary",
		NameKey = "RARITY_LEGENDARY",
		Order = 4,
		Weight = 0.6,
		Traits = 2,
		DamageMult = 1.8,
		SellMult = 4.5,
		Color = Color3.fromRGB(255, 170, 40),
	},
	Mythic = {
		Id = "Mythic",
		NameKey = "RARITY_MYTHIC",
		Order = 5,
		Weight = 0.08,
		Traits = 2,
		DamageMult = 2.3,
		SellMult = 8,
		Color = Color3.fromRGB(255, 60, 90),
	},
	Divine = {
		Id = "Divine",
		NameKey = "RARITY_DIVINE",
		Order = 6,
		Weight = 0.008,
		Traits = 3,
		DamageMult = 3.0,
		SellMult = 15,
		Color = Color3.fromRGB(255, 250, 200),
	},
}

return Rarities
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Social</string><ProtectedString name="Source"><![CDATA[--!strict
-- СОЦИАЛЬНЫЕ БОНУСЫ: игра с друзьями и участие в группе дают больше опыта.

local Social = {
	GroupId = 0, -- ID твоей группы Roblox (0 = бонус за группу выключен)
	GroupXpBonus = 0.1, -- +10% опыта участникам группы
	FriendXpBonusPerFriend = 0.05, -- +5% за каждого друга на сервере
	MaxFriendXpBonus = 0.2,
}

return Social
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Trading</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ОБМЕН МЕЖДУ ИГРОКАМИ И ЛАВКИ.

	Обмен: подойди к игроку → подсказка «Обмен». Оба кладут оружие и золото.
	Защита от скама: любое изменение сбрасывает готовность у обоих, «Подтвердить»
	доступно через ConfirmDelaySeconds после того, как оба готовы, и сервер проверяет,
	что игрок подтверждает именно ту версию предложения, которую видел.

	Лавка: у каждого игрока на сервере свой прилавок в Торговом ряду (тег ShopStall).
	Пока владелец не в игре, лавка продаёт NPC-покупателям, но ограниченно (Offline).
]]

local Trading = {
	Trade = {
		MinLevel = 2, -- обмен с 2-го уровня: защита от фарма на твинках
		RequestTimeoutSeconds = 20,
		PromptDistance = 10,
		MaxItems = 6, -- предметов с одной стороны
		MaxGold = 10000000,
		ConfirmDelaySeconds = 3,
	},

	Shop = {
		MaxListings = 6, -- второй слот лавки за геймпасс — позже (монетизация)
		TaxRate = 0.05, -- комиссия рынка: золото уходит из экономики
		MinPrice = 1,
		MaxPrice = 10000000,
		SuggestedPriceMult = 1.5, -- подсказка цены = цена у торговца × 1.5
		InteractDistance = 16,

		Offline = {
			MinAwaySeconds = 600, -- меньше 10 минут не считается
			MaxHours = 8, -- дольше не копится
			SalesPerHour = 1,
			MaxSales = 6,
			-- NPC платят твою цену, но не больше цены у торговца × MaxPriceMult
			MaxPriceMult = 1.5,
		},
	},

	LogStoreName = "MarketLog_v1", -- DataStore с журналом сделок
}

return Trading
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Traits</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ЧЕРТЫ ОРУЖИЯ (случайные, число зависит от редкости).
	Все эффекты считает сервер (CombatService / MiningService).
]]

export type TraitDef = {
	Id: string,
	NameKey: string,
	Weight: number,
	Color: Color3,
	-- эффекты (любое подмножество)
	DamageMult: number?, -- множитель урона (виден в карточке)
	CooldownMult: number?, -- множитель паузы между ударами
	CritChance: number?,
	CritMult: number?,
	LifeSteal: number?, -- доля урона в лечение
	BurnFraction: number?, -- урон огнём в секунду = доля от урона удара
	BurnSeconds: number?,
	ExtraOreChance: number?, -- шанс +1 руды при добыче, когда оружие надето
}

local Traits: { [string]: TraitDef } = {
	Fire = {
		Id = "Fire",
		NameKey = "TRAIT_FIRE",
		Weight = 1,
		Color = Color3.fromRGB(255, 120, 40),
		BurnFraction = 0.25,
		BurnSeconds = 3,
	},
	Vampiric = {
		Id = "Vampiric",
		NameKey = "TRAIT_VAMPIRIC",
		Weight = 1,
		Color = Color3.fromRGB(220, 40, 70),
		LifeSteal = 0.08,
	},
	Critical = {
		Id = "Critical",
		NameKey = "TRAIT_CRITICAL",
		Weight = 1,
		Color = Color3.fromRGB(255, 220, 60),
		CritChance = 0.15,
		CritMult = 2,
	},
	Swift = {
		Id = "Swift",
		NameKey = "TRAIT_SWIFT",
		Weight = 1,
		Color = Color3.fromRGB(120, 255, 200),
		CooldownMult = 0.82,
	},
	Heavy = {
		Id = "Heavy",
		NameKey = "TRAIT_HEAVY",
		Weight = 0.8,
		Color = Color3.fromRGB(160, 140, 120),
		DamageMult = 1.25,
		CooldownMult = 1.15,
	},
	Lucky = {
		Id = "Lucky",
		NameKey = "TRAIT_LUCKY",
		Weight = 0.7,
		Color = Color3.fromRGB(120, 230, 90),
		ExtraOreChance = 0.25,
	},
}

return Traits
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ОБУЧЕНИЕ / КВЕСТЫ СИСТЕМЫ первого захода.
	Event — событие, которое шлют сервисы (OreMined, WeaponForged, WeaponEquipped,
	MerchantOpened, GateEntered, GateCleared). TargetTag — куда рисовать луч-подсказку.
]]

export type TutorialStep = {
	Id: string,
	TitleKey: string,
	Event: string,
	Count: number,
	OreId: string?,
	TargetTag: string?,
	TargetOre: string?,
	RewardXp: number,
	RewardGold: number,
}

local Tutorial: { Steps: { TutorialStep } } = {
