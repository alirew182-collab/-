<roblox version="4"><Item class="Workspace" referent="RBX0000005D"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">true</bool></Properties></Item><Item class="ReplicatedStorage" referent="RBX0000005E"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX0000001D"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ЕДИНАЯ ТОЧКА ВХОДА В БАЛАНС.
	Все числа игры — в соседних модулях этой папки. Код читает их только через Config.
]]

local Config = {
	Ores = require(script.Ores),
	Pickaxes = require(script.Pickaxes),
	Weapons = require(script.Weapons),
	Rarities = require(script.Rarities),
	Traits = require(script.Traits),
	Ranks = require(script.Ranks),
	Forging = require(script.Forging),
	Leveling = require(script.Leveling),
	Mobs = require(script.Mobs),
	Gates = require(script.Gates),
	Combat = require(script.Combat),
	Economy = require(script.Economy),
	Tutorial = require(script.Tutorial),
	Daily = require(script.Daily),
	Codes = require(script.Codes),
	Social = require(script.Social),
	World = require(script.World),
	Trading = require(script.Trading),
	Network = require(script.Network),
	Audio = require(script.Audio),

	Data = {
		StoreName = "PlayerData_v1", -- смена имени = чистый вайп, не трогай без нужды
		SchemaVersion = 1,
	},

	Debug = {
		-- В Studio первый портал появляется через 5 секунд
		StudioFastGates = true,
		-- Выводить в Output события анти-чита
		LogSuspicious = true,
	},

	Tags = {
		OreNode = "OreNode",
		Forge = "Forge",
		Merchant = "Merchant",
		GateSpawn = "GateSpawn",
		GatePortal = "GatePortal",
		Leaderboard = "Leaderboard",
		ShopStall = "ShopStall",
		Spin = "Spin", -- клиент медленно вращает такие детали
	},
}

return Config
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Audio</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ЗВУКИ. Вставь сюда ID своих звуков из Creator Store ("rbxassetid://123...").
	Пустая строка = звук отключён (игра работает без звуков).
]]

local Audio: { [string]: string } = {
	SystemOpen = "", -- появление окна Системы
	SystemLevelUp = "",
	SystemQuestDone = "",
	SystemWarning = "",
	SystemBoss = "",
	MineHit = "",
	OreBreak = "",
	ForgePump = "",
	ForgePour = "",
	ForgeHammerPerfect = "",
	ForgeHammerHit = "",
	ForgeHammerMiss = "",
	ForgeDone = "",
	Swing = "",
	HitMob = "",
	Parry = "",
	Coins = "",
	UiClick = "",
	Celebrate = "", -- Legendary+ ковка
	EliteAlarm = "", -- появление элитного монстра
	-- Музыка (зацикленная) по зонам
	MusicTown = "",
	MusicWild = "",
	MusicGate = "",
}

return Audio
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Codes</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	КОДЫ для раздачи в соцсетях. Ключ — сам код (ЗАГЛАВНЫМИ буквами).
	Expires: 0 = бессрочно, иначе unix-время окончания (https://www.unixtimestamp.com).
	Каждый игрок может активировать код один раз.
]]

export type CodeDef = {
	Gold: number?,
	Xp: number?,
	Ores: { [string]: number }?,
	Expires: number,
}

local Codes: { [string]: CodeDef } = {
	RELEASE = { Gold = 250, Xp = 100, Ores = { Copper = 10 }, Expires = 0 },
	SYSTEM = { Gold = 150, Ores = { Iron = 5 }, Expires = 0 },
	FORGEMASTER = { Gold = 500, Expires = 0 },
}

return Codes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[--!strict
-- БОЙ: блок, парирование, кулаки (если оружие не надето).

local Combat = {
	BlockDamageReduction = 0.6, -- блок снимает 60% урона
	ParryWindowSeconds = 0.3, -- нажал блок не раньше чем за 0.3с до удара → парирование (0 урона)
	ParryStunSeconds = 1.5, -- моб оглушён после парирования
	BlockToggleCooldown = 0.35, -- защита от спама блоком ради парирования
	BlockWalkSpeed = 8,
	DefaultWalkSpeed = 16,

	Fists = {
		Damage = 3,
		AttackCooldown = 0.6,
		Range = 5,
		Arc = 0.3,
		MaxTargets = 1,
	},

	-- Анимация взмаха (Animation ID из Creator Store / своя). Пусто = без анимации.
	SwingAnimationId = "",

	MobAiTickSeconds = 0.15,
	DamageFxRadius = 150, -- кому показывать цифры урона
}

return Combat
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Daily</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ЕЖЕДНЕВНОЕ: награда за вход (7-дневный цикл, серия входов) и задания Системы на день.
	День считается по UTC. Задания выбираются случайно из пула.
]]

export type DailyReward = { Gold: number, Ores: { [string]: number }? }
export type DailyQuest = {
	Id: string,
	TitleKey: string,
	Event: string,
	Count: number,
	RewardGold: number,
	RewardXp: number,
}

local Daily: {
	Rewards: { DailyReward },
	QuestCount: number,
	QuestPool: { DailyQuest },
} = {
	Rewards = {
		{ Gold = 50 },
		{ Gold = 80, Ores = { Copper = 6 } },
		{ Gold = 120 },
		{ Gold = 150, Ores = { Iron = 4 } },
		{ Gold = 200 },
		{ Gold = 260, Ores = { Iron = 6 } },
		{ Gold = 400, Ores = { Moonsilver = 3 } },
	},
	QuestCount = 3,
	QuestPool = {
		{ Id = "Mine20", TitleKey = "DQ_MINE", Event = "OreMined", Count = 20, RewardGold = 60, RewardXp = 80 },
		{ Id = "Forge3", TitleKey = "DQ_FORGE", Event = "WeaponForged", Count = 3, RewardGold = 70, RewardXp = 90 },
		{ Id = "Kill25", TitleKey = "DQ_KILL", Event = "MobKilled", Count = 25, RewardGold = 90, RewardXp = 120 },
		{ Id = "Gate1", TitleKey = "DQ_GATE", Event = "GateCleared", Count = 1, RewardGold = 120, RewardXp = 150 },
		{ Id = "Parry5", TitleKey = "DQ_PARRY", Event = "Parry", Count = 5, RewardGold = 80, RewardXp = 100 },
		{ Id = "Sell5", TitleKey = "DQ_SELL", Event = "ItemSold", Count = 5, RewardGold = 40, RewardXp = 60 },
		{ Id = "Quality80", TitleKey = "DQ_QUALITY", Event = "QualityForge80", Count = 1, RewardGold = 100, RewardXp = 120 },
	},
}

return Daily
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Economy</string><ProtectedString name="Source"><![CDATA[--!strict
-- ЭКОНОМИКА, ИНВЕНТАРЬ, ДОБЫЧА, ДИСТАНЦИИ.

local Economy = {
	StartingGold = 0,
	StartingPickaxe = "Stone",
	InventoryCapacity = 30, -- слотов под оружие (x2 — геймпасс в Этапе 3)
	WeaponSellBonus = 1.5, -- оружие продаётся дороже, чем руда, из которой сделано
	MaxSellBatch = 50,

	Mining = {
		HitCooldownSeconds = 0.3,
		MaxDistance = 14,
	},

	InteractMaxDistance = 18, -- дистанция до кузни/торговца для действий
}

return Economy
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Forging</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	КОВКА — мини-игра из 3 шагов. Итоговое качество 0–100%.
	Качество = 100 * (Bellows.Weight * счёт_мехов + Pour.Weight * счёт_заливки + Hammer.Weight * счёт_молота)
	Счёт каждого шага 0..1 считает СЕРВЕР из сырых замеров клиента.
]]

local Forging = {
	-- Качество 0% → оружие с уроном x0.7, 100% → x1.3
	QualityMultMin = 0.7,
	QualityMultMax = 1.3,

	SessionTimeoutSeconds = 90, -- сессия ковки протухает
	MinDurationTolerance = 0.85, -- сервер не примет результат быстрее 85% от минимальной длительности мини-игры

	-- Редкость: удача = 1 + качество(0..1) * RarityLuckPerQuality + RarityLuck руды
	RarityLuckPerQuality = 0.6,
	AnnounceMinRarity = "Mythic", -- объявление на весь сервер
	CelebrateMinRarity = "Legendary", -- большой эффект у самого игрока

	XpBase = 10, -- опыт за ковку = XpBase + OreCost * XpPerOre руды * XpOreFactor
	XpOreFactor = 0.5,

	Bellows = {
		Weight = 0.3,
		DurationSeconds = 4, -- сколько длится шаг
		HeatDecayPerSecond = 0.55, -- насколько остывает горн в секунду (0..1)
		HeatPerPump = 0.16, -- сколько добавляет одно нажатие
		ZoneWidth = 0.22, -- ширина «зелёной зоны»
		ZoneCenterMin = 0.55, -- центр зоны случайный в этом диапазоне
		ZoneCenterMax = 0.75,
		FullScoreFraction = 0.8, -- если в зоне ≥80% времени → 100% счёта
	},

	Pour = {
		Weight = 0.3,
		FillPerSecond = 0.5, -- скорость заполнения формы при удержании
		TargetMin = 0.55, -- целевой уровень — случайный в диапазоне
		TargetMax = 0.85,
		PerfectTolerance = 0.03, -- ближе этого → 100%
		Tolerance = 0.2, -- дальше этого → 0%
		MinSeconds = 0.8, -- минимальная реальная длительность шага
	},

	Hammer = {
		Weight = 0.4,
		Beats = 5,
		IntervalMin = 0.75, -- интервал между ударами (с), случайный
		IntervalMax = 0.95,
		LeadInSeconds = 1.0, -- пауза до первого удара
		PerfectWindow = 0.07, -- ±с для 100%
		HitWindow = 0.25, -- ±с, дальше — промах
	},
}

return Forging
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Gates</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ВРАТА (ДАНЖИ).
	Порталы появляются на Part с тегом "GateSpawn". Новый тип Врат = новая запись в Types.
	Арена: ServerStorage/Arenas/<Arena> (Model, внутри Part с именами "PlayerSpawn" и "MobSpawn").
	Если модели нет — сервер построит простую арену-заглушку.
]]

export type WaveEntry = { Mob: string, Count: number }
export type OreDrop = { OreId: string, Chance: number, Min: number, Max: number }
export type GateTypeDef = {
	Id: string,
	Rank: string,
	NameKey: string,
	RequiredLevel: number,
	SpawnWeight: number,
	Arena: string,
	Waves: { { WaveEntry } },
	Boss: string,
	Rewards: { Gold: number, Xp: number, OreDrops: { OreDrop } },
	PortalColor: Color3,
}

local Gates = {
	FirstSpawnDelaySeconds = 25,
	SpawnIntervalSeconds = 90,
	MaxActivePortals = 3,
	PortalLifetimeSeconds = 240,
	LobbyCountdownSeconds = 20,
	MaxPartySize = 4,
	LobbyLeaveRadius = 60, -- ушёл дальше от портала — вылетаешь из группы
	RunTimeLimitSeconds = 300,
	WaveStartDelaySeconds = 3,
	ReturnDelaySeconds = 6, -- через сколько секунд после победы/поражения вернуть в лобби

	-- Масштаб сложности под группу: +60% HP мобам за каждого игрока сверх первого
	HealthPerExtraPlayer = 0.6,
	-- Бонус опыта за игру в группе: +10% за каждого игрока сверх первого
	PartyXpBonusPerPlayer = 0.1,

	-- КРАСНЫЕ ВРАТА: редкое событие — мобы сильнее, награда больше
	RedGate = {
		Chance = 0.1,
		HealthMult = 1.6,
		DamageMult = 1.3,
		RewardMult = 2.5,
		Color = Color3.fromRGB(255, 40, 40),
	},

	Arena = {
		Origin = Vector3.new(6000, 300, 0), -- далеко от лобби
		SlotSpacing = 800,
		MaxConcurrentRuns = 6,
		FallbackSize = 140,
	},

	Types = {
		E = {
			Id = "E",
			Rank = "E",
			NameKey = "GATE_E",
			RequiredLevel = 1,
			SpawnWeight = 1,
			Arena = "GateArena",
			Waves = {
				{ { Mob = "Ashling", Count = 4 } },
				{ { Mob = "Ashling", Count = 3 }, { Mob = "CinderHound", Count = 2 } },
			},
			Boss = "CinderWarden",
			Rewards = {
				Gold = 60,
				Xp = 150,
				OreDrops = {
					{ OreId = "Copper", Chance = 1.0, Min = 2, Max = 4 },
					{ OreId = "Iron", Chance = 0.6, Min = 1, Max = 3 },
					{ OreId = "Moonsilver", Chance = 0.12, Min = 1, Max = 1 },
				},
			},
			PortalColor = Color3.fromRGB(60, 170, 255),
		},
		D = {
			Id = "D",
			Rank = "D",
			NameKey = "GATE_D",
			RequiredLevel = 8,
			SpawnWeight = 0.6,
			Arena = "GateArena",
			Waves = {
				{ { Mob = "QuarryCrawler", Count = 4 } },
				{ { Mob = "QuarryCrawler", Count = 3 }, { Mob = "CinderHound", Count = 3 } },
				{ { Mob = "CinderHound", Count = 5 } },
			},
			Boss = "StoneColossus",
			Rewards = {
				Gold = 180,
				Xp = 600,
				OreDrops = {
					{ OreId = "Iron", Chance = 1.0, Min = 3, Max = 6 },
					{ OreId = "Moonsilver", Chance = 0.4, Min = 1, Max = 2 },
				},
			},
			PortalColor = Color3.fromRGB(120, 255, 140),
		},
		C = {
			Id = "C",
			Rank = "C",
			NameKey = "GATE_C",
			RequiredLevel = 15,
			SpawnWeight = 0.35,
			Arena = "GateArena",
			Waves = {
				{ { Mob = "FrostWisp", Count = 4 } },
				{ { Mob = "FrostWisp", Count = 3 }, { Mob = "GraveSentinel", Count = 2 } },
				{ { Mob = "GraveSentinel", Count = 4 } },
			},
			Boss = "RimeTyrant",
			Rewards = {
				Gold = 450,
				Xp = 1500,
				OreDrops = {
					{ OreId = "Moonsilver", Chance = 1.0, Min = 2, Max = 4 },
				},
			},
			PortalColor = Color3.fromRGB(190, 110, 255),
		},
	} :: { [string]: GateTypeDef },
}

return Gates
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Leveling</string><ProtectedString name="Source"><![CDATA[--!strict
-- УРОВНИ. Опыт до следующего уровня = floor(XpBase * level ^ XpExponent).

local Leveling = {
	MaxLevel = 100,
	XpBase = 40,
	XpExponent = 1.45,

	BaseHealth = 100,
	HealthPerLevel = 6,
	DamagePerLevel = 0.03, -- +3% урона за уровень

	-- Ранг пока только визуальный (испытания рангов — Этап 2)
	StartingRank = "F",
}

return Leveling
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Mobs</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	МОБЫ И БОССЫ.
	Модель: ServerStorage/Mobs/<Id> — Model с Humanoid и HumanoidRootPart.
	Если модели нет — сервер соберёт блок-заглушку размером Size и цветом Color.
	Level — уровень, который видят игроки над мобом. Drops — руда с моба в открытом мире.
]]

export type Drop = { OreId: string, Chance: number, Min: number, Max: number }

export type MobDef = {
