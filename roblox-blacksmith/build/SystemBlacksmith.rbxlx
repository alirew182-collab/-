		YieldMin = 1,
		YieldMax = 2,
		RespawnSeconds = 8,
		XpPerOre = 4,
		SellPrice = 3,
		PowerMult = 1.0,
		Color = Color3.fromRGB(201, 116, 62),
		Material = Enum.Material.Slate,
	},
	Iron = {
		Id = "Iron",
		NameKey = "ORE_IRON",
		Order = 2,
		RequiredLevel = 3,
		RequiredPickaxeTier = 2,
		NodeHealth = 6,
		YieldMin = 1,
		YieldMax = 2,
		RespawnSeconds = 12,
		XpPerOre = 9,
		SellPrice = 8,
		PowerMult = 1.6,
		Color = Color3.fromRGB(140, 146, 156),
		Material = Enum.Material.Slate,
	},
	Moonsilver = {
		Id = "Moonsilver",
		NameKey = "ORE_MOONSILVER",
		Order = 3,
		RequiredLevel = 6,
		RequiredPickaxeTier = 3,
		NodeHealth = 10,
		YieldMin = 1,
		YieldMax = 1,
		RespawnSeconds = 20,
		XpPerOre = 20,
		SellPrice = 22,
		PowerMult = 2.6,
		Color = Color3.fromRGB(170, 210, 255),
		Material = Enum.Material.Glass,
	},
}

return Ores
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Pickaxes</string><ProtectedString name="Source"><![CDATA[--!strict
-- КИРКИ. Power — урон по жиле за удар, Tier — какие руды можно добывать.

export type PickaxeDef = {
	Id: string,
	NameKey: string,
	Order: number,
	Tier: number,
	Power: number,
	Price: number, -- 0 = выдаётся бесплатно
	RequiredLevel: number,
}

local Pickaxes: { [string]: PickaxeDef } = {
	Stone = { Id = "Stone", NameKey = "PICK_STONE", Order = 1, Tier = 1, Power = 1, Price = 0, RequiredLevel = 1 },
	Iron = { Id = "Iron", NameKey = "PICK_IRON", Order = 2, Tier = 2, Power = 2, Price = 150, RequiredLevel = 3 },
	Moonsilver = {
		Id = "Moonsilver",
		NameKey = "PICK_MOONSILVER",
		Order = 3,
		Tier = 3,
		Power = 3,
		Price = 900,
		RequiredLevel = 6,
	},
}

return Pickaxes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Rarities</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	РЕДКОСТИ. В Этапе 1 вся ковка даёт Common; таблица уже здесь, чтобы данные оружия
	не пришлось мигрировать, когда в Этапе 2 появятся шансы редкостей.
]]

export type RarityDef = {
	Id: string,
	NameKey: string,
	Order: number,
	DamageMult: number,
