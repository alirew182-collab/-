--!strict
--[[
	МОБЫ И БОССЫ.
	Модель: ServerStorage/Mobs/<Id> — Model с Humanoid и HumanoidRootPart.
	Если модели нет — сервер соберёт блок-заглушку размером Size и цветом Color.
	Level — уровень, который видят игроки над мобом. Drops — руда с моба в открытом мире.
]]

export type Drop = { OreId: string, Chance: number, Min: number, Max: number }

export type MobDef = {
	Id: string,
	NameKey: string,
	IsBoss: boolean,
	Level: number,
	MaxHealth: number,
	Damage: number,
	AttackRange: number,
	AttackCooldown: number,
	WindupSeconds: number, -- «замах» перед ударом: окно для блока/парирования
	WalkSpeed: number,
	XpReward: number,
	GoldReward: number,
	Size: Vector3,
	Color: Color3,
	Drops: { Drop }?,
	-- только боссы
	SlamDamage: number?,
	SlamRadius: number?,
	SlamWindup: number?,
	SlamCooldown: number?,
